<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
  ******************************************************************************
  **                          Load Per-User Settings                          **
  ******************************************************************************
  -->

  <!--
      NOTE: If the per-user settings file exists, import it now.  The contained
            settings, if any, will override the default ones provided below.
  -->
  <Import Condition="'$(BadgeDir)' != '' And
                     !HasTrailingSlash('$(BadgeDir)') And
                     Exists('$(BadgeDir)\Targets\Badge.Builds.Settings.targets.user')"
          Project="$(BadgeDir)\Targets\Badge.Builds.Settings.targets.user" />

  <!--
  ******************************************************************************
  **                       Badge Build Type Properties                        **
  ******************************************************************************
  -->

  <PropertyGroup>
    <!--
        HACK: If the Harpy build type is set, use it for the Badge plugin as
              well.
    -->
    <BadgeBuildType Condition="'$(HarpyBuildType)' != ''">$(HarpyBuildType)</BadgeBuildType>
  </PropertyGroup>
</Project>
