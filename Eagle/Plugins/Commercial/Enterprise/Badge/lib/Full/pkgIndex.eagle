###############################################################################

if {![package vsatisfies [package provide Tcl] 8.4]} then {return}
if {![package vsatisfies [package provide Eagle] 1.0]} then {return}

###############################################################################

if {[info exists tag]} then {
  package ifneeded Badge.Enterprise 1.0 \
      [list load -publickeytoken $tag \
      -maybeverifiedonly -maybetrustedonly -- \
      [file join $dir Badge.dll] Badge.Enterprise] +Locked
} else {
  package ifneeded Badge.Enterprise 1.0 \
      [list load -maybeverifiedonly -maybetrustedonly -- \
      [file join $dir Badge.dll] Badge.Enterprise] +Locked
}

###############################################################################

#
# NOTE: This package is shared with the "Badge.Basic.dll" assembly
#       from the "Basic" SKU.
#
if {[info exists tag]} then {
  package ifneeded Security.Certificates 1.0 \
      [list load -publickeytoken $tag \
      -maybeverifiedonly -maybetrustedonly -- \
      [file join $dir Badge.dll] Security.Certificates] +Locked
} else {
  package ifneeded Security.Certificates 1.0 \
      [list load -maybeverifiedonly -maybetrustedonly -- \
      [file join $dir Badge.dll] Security.Certificates] +Locked
}
