        [file join $libraryResourcesDirectory [file rootname $name]]]

    #
    # NOTE: If the file does not exist on the file system, just skip it.
    #
    if {[file exists $fileName]} then {
      if {[catch {
        #
        # NOTE: Attempt to read the script associated with this resource
        #       name (e.g. for later evaluation, etc).  In general, this
        #       will only work when the script is actually present on the
        #       file system -OR- embedded within the core library itself.
        #       Since the Harpy policies are now active, this will also
        #       [indirectly] verify the signature on the associated script.
        #
        interp readorgetscriptfile -scriptflags $resource_flags(plugin) \
            -- "" $fileName
      } error] == 0} then {
        lappend errors Ok
      } else {
        lappend errors $error
      }
    } else {
      lappend errors FileNotFound
    }
  }

  set errors
} -cleanup {
  catch {badgeEnableTracing true}

  unset -nocomplain error fileName name errors

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy
} -constraints {eagle command.certificate command.keyring\
file_library.resources file_packages.resources} -result \
[lrepeat $resource_counts(nonScript) Ok]}

###############################################################################

runTest {test badge-6.1 {enable sub-command (white-box)} -setup {
  catch {unloadSecurityCertificates}
  catch {unloadBadgeEnterprise}

  package require Badge.Enterprise

  set savedEnabled [badge enable]
} -body {
  list [badge enable true] [badge enable] \
      [catch {badge test badgeEmpty} result] $result \
      [badge enable false] [badge enable] \
      [catch {badge test badgeEmpty} result] $result
} -cleanup {
  catch {badge enable $savedEnabled}
  catch {package require Security.Certificates}

  unset -nocomplain result savedEnabled
} -constraints {eagle command.badge} -result \
{True True 0 {} False False 1 {string not found}}}

###############################################################################

runTest {test badge-6.2 {enable sub-command (black-box)} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  restoreLicensePolicy savedPolicy

  catch {unloadSecurityCertificates}
  catch {unloadBadgeEnterprise}

  package require Badge.Enterprise

  set savedEnabled [badge enable]
} -body {
  list [badge enable true] [badge enable] \
      [catch {interp readorgetscriptfile -- "" badgeEmpty} result] $result \
      [badge enable false] [badge enable] \
      [catch {interp readorgetscriptfile -- "" badgeEmpty} result] $result
} -cleanup {
  catch {badge enable $savedEnabled}
  catch {package require Security.Certificates}

  unset -nocomplain result savedEnabled

  restorePolicy savedPolicy
} -constraints {eagle command.certificate command.badge} -result {True True 0\
{} False False 1 {couldn't read or get file "badgeEmpty": no such file or\
directory}}}

###############################################################################

runTest {test badge-7.1 {[gs]etstring sub-commands (white-box)} -setup {
  catch {unloadSecurityCertificates}
  catch {unloadBadgeEnterprise}

  package require Badge.Enterprise

  badge clearstrings
  set name [appendArgs badge_string_ [pid]]
} -body {
  list [badge clearstrings] [badge liststrings] \
      [catch {badge getstring $name} result] $result \
      [catch {badge removestring $name} result] $result \
      [catch {badge setstring $name ""} result] $result \
      [badge liststrings] [catch {badge getstring $name} result] $result \
      [catch {badge setstring $name ""} result] $result \
      [badge liststrings] [catch {badge getstring $name} result] $result \
      [catch {badge resetstring $name reset} result] $result \
      [badge liststrings] [catch {badge getstring $name} result] $result \
      [catch {badge removestring $name} result] $result \
      [badge liststrings] [catch {badge getstring $name} result] $result \
      [badge clearstrings] [badge liststrings]
} -cleanup {
  catch {badge clearstrings}
  catch {package require Security.Certificates}

  unset -nocomplain result name
} -constraints {eagle command.badge} -match regexp -result {^\d+ \{\} 1 \{key\
not present\} 1 \{key not present\} 0 True badge_string_\d+ 0 \{\} 1 \{key\
already present\} badge_string_\d+ 0 \{\} 0 False badge_string_\d+ 0 reset 0\
\{\} \{\} 1 \{key not present\} 0 \{\}$}}

###############################################################################

runTest {test badge-7.2 {(re)nullstring sub-commands (mixed-box)} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  restoreLicensePolicy savedPolicy

  catch {unloadSecurityCertificates}
  catch {unloadBadgeEnterprise}

  package require Badge.Enterprise

  badge clearstrings
} -body {
  list [catch {badge test badgeEmpty} result] $result \
      [catch {interp readorgetscriptfile -- "" badgeEmpty} result] $result \
      [catch {badge nullstring badgeEmpty} result] $result \
      [badge liststrings] [catch {badge test badgeEmpty} result] $result \
      [catch {interp readorgetscriptfile -- "" badgeEmpty} result] $result \
      [catch {badge nullstring badgeEmpty} result] $result \
      [catch {badge renullstring badgeEmpty} result] $result \
      [badge liststrings] [badge clearstrings] [badge liststrings]
} -cleanup {
  catch {badge clearstrings}
  catch {package require Security.Certificates}

  unset -nocomplain result

  restorePolicy savedPolicy
} -constraints {eagle command.certificate command.badge} -result {0 {} 0 {} 0\
True badgeEmpty 1 {string not found} 1 {couldn't read or get file "badgeEmpty":\
no such file or directory} 1 {key already present} 0 False badgeEmpty 1 {}}}

###############################################################################

#
# HACK: This test does not really belong in this file as it does not actually
#       use any of the Badge resources; however, it does require Harpy and it
#       is related to the use of embedded script signatures.
#
runTest {test badge-8.1 {reading script library embedded-only data} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  certificate policy -enabled true

  badgeEnableTracing false
} -body {
  set errors [list]

  foreach name $resource_names(libraryOnly) {
    if {[catch {
      #
      # NOTE: The "NoXml" flag is required because without it the script
      #       engine will try to treat script certificates as scripts in
      #       the XML format.  The "NoPolicy" flag is required because
      #       without it, the Harpy policies will require signatures on
      #       the signature files themselves, which will not work.
      #
      interp readorgetscriptfile -scriptflags [combineFlags \
          $resource_flags(library) "+NoXml NoPolicy"] -- "" $name
    } error] == 0} then {
      lappend errors Ok
    } else {
      lappend errors $error
    }
  }

  set errors
} -cleanup {
  catch {badgeEnableTracing true}

  unset -nocomplain error name errors

  restorePolicy savedPolicy
} -constraints {eagle command.certificate command.keyring} -result \
[lrepeat $resource_counts(libraryOnly) Ok]}

###############################################################################

#
# HACK: This test does not really belong in this file as it does not actually
#       use any of the Badge resources; however, it does require Harpy and it
#       is related to the use of embedded script signatures.
#
runTest {test badge-9.1 {verifying script library embedded-only data} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  certificate policy -enabled true

  saveKeyRing savedKeyRing; resetKeyRing

  badgeEnableTracing false

  set savedPwd [pwd]; # save current directory
  cd ~; # change to somewhere outside install
} -body {
  set errors [list]

  foreach name $resource_names(libraryOnly) {
    set rootName [file rootname $name]

    if {[catch {
      #
      # NOTE: Attempt to read the script associated with this resource
      #       name (e.g. for later evaluation, etc).  This will only
      #       work when the script is also embedded within the core
      #       library itself.  Since the Harpy policies are now active,
      #       this will also [indirectly] verify the signature on the
      #       script.
      #
      interp readorgetscriptfile -- "" $rootName
    } error] == 0} then {
      lappend errors Ok
    } else {
      lappend errors $error
    }
  }

  set errors
} -cleanup {
  catch {cd $savedPwd}; # restore saved current directory

  catch {badgeEnableTracing true}

  unset -nocomplain error rootName name errors savedPwd

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy
} -constraints \
{eagle command.certificate command.keyring compile.EMBEDDED_LIBRARY} -result \
[lrepeat $resource_counts(libraryOnly) Ok]}

###############################################################################

runTest {test badge-10.1 {primary unloading} -setup {
  unset -nocomplain loaded
} -body {
  unloadBadgeEnterprise
} -cleanup {
  unset -nocomplain loaded
} -constraints {eagle} -match regexp -result \
{^\{Badge\.Enterprise, Badge, Version=1\.0\.\d+\.\d+, Culture=neutral,\
PublicKeyToken=[0-9a-f]{16}\} 1\.0\.\d+\.\d+$}}

###############################################################################

runTest {test badge-10.2 {secondary unloading} -setup {
  unset -nocomplain loaded
} -body {
  unloadSecurityCertificates
} -cleanup {
  unset -nocomplain loaded
} -constraints {eagle} -match regexp -result \
{^\{Security\.Certificates, Badge, Version=1\.0\.\d+\.\d+, Culture=neutral,\
PublicKeyToken=[0-9a-f]{16}\} 1\.0\.\d+\.\d+$}}

###############################################################################

if {![info exists no(reloadBadgePlugin)] && \
    ![info exists no(reloadBadgeEnterprise)]} then {
  #
  # NOTE: Check if this file (i.e. "basic.eagle") or the "all.eagle" file
  #       (if applicable) caused the Badge plugin to be loaded.   If not,
  #       attempt to reload it now.
  #
  if {(([haveConstraint runtime.Badge_Enterprise_All_Already_Loaded] || \
        [haveConstraint runtime.Badge_Enterprise_All_Not_Loaded]) && \
       ([haveConstraint runtime.Badge_Enterprise_All_Already_Loaded] && \
        ![haveConstraint runtime.Badge_Enterprise_All_Not_Loaded])) || \
      ((![haveConstraint runtime.Badge_Enterprise_All_Already_Loaded] && \
        ![haveConstraint runtime.Badge_Enterprise_All_Not_Loaded]) && \
       ([haveConstraint runtime.Badge_Enterprise_Basic_Already_Loaded] && \
        ![haveConstraint runtime.Badge_Enterprise_Basic_Not_Loaded]))} then {
    #
    # NOTE: Since the Badge plugin was apparently pre-loaded (i.e. from the
    #       perspective of the test suite -OR- this test file), reload it
    #       now as there may be other, external tests that rely on it being
    #       loaded.
    #
    if {[catch {package require Badge.Enterprise} error] == 0} then {
      tputs $test_channel \
          "---- plugin \"Badge.Enterprise\" was reloaded\n"
    } else {
      tputs $test_channel [appendArgs \
          "---- failed to reload plugin: " $error \n]
    }

    unset -nocomplain error
  }
}

###############################################################################

if {![info exists no(reloadBadgePlugin)] && \
    ![info exists no(reloadSecurityCertificates)]} then {
  if {(([haveConstraint runtime.Security_Certificates_All_Already_Loaded] || \
        [haveConstraint runtime.Security_Certificates_All_Not_Loaded]) && \
       ([haveConstraint runtime.Security_Certificates_All_Already_Loaded] && \
        ![haveConstraint runtime.Security_Certificates_All_Not_Loaded])) || \
      ((![haveConstraint runtime.Security_Certificates_All_Already_Loaded] && \
        ![haveConstraint runtime.Security_Certificates_All_Not_Loaded]) && \
       ([haveConstraint runtime.Security_Certificates_Basic_Already_Loaded] && \
        ![haveConstraint runtime.Security_Certificates_Basic_Not_Loaded]))} then {
    #
    # NOTE: Since the Badge plugin was apparently pre-loaded (i.e. from the
    #       perspective of the test suite -OR- this test file), reload it
    #       now as there may be other, external tests that rely on it being
    #       loaded.
    #
    if {[catch {package require Security.Certificates} error] == 0} then {
      tputs $test_channel \
          "---- plugin \"Security.Certificates\" was reloaded\n"
    } else {
      tputs $test_channel [appendArgs \
          "---- failed to reload plugin: " $error \n]
    }

    unset -nocomplain error
  }
}

###############################################################################

rename unloadSecurityCertificates ""
rename unloadBadgeEnterprise ""
rename badgeEnableTracing ""
rename getErrorMessages ""
rename getPeerNameOnly ""

###############################################################################

unset -nocomplain resource_flags resource_counts resource_names

###############################################################################

unset -nocomplain libraryResourcesDirectory libraryResourcesFile \
    packagesResourcesFile

###############################################################################

runTestEpilogue
