###############################################################################

#
# NOTE: This is the list of embedded resources that refer to script files
#       that are not part of the core script library nor the test script
#       library.
#
# TODO: Always double-check this when adding or removing loader package,
#       library package, or test package files.
#
set resource_names(nonLibrary) [lrange $resource_names(all) 37 end]

#
# NOTE: This is the list of embedded resources that refer to the bundled
#       embedded resources files for the core library, which contain the
#       embedded core script library and test script library files.
#
set resource_names(nonScript) [lrange $resource_names(all) end-1 end]

#
# NOTE: These scripts -AND- their associated script certificates actually
#       reside entirely within the core library itself, not this plugin;
#       however, it is easier to test them here.
#
set resource_names(libraryOnly) [list \
    enableSecurity.harpy \
    disableSecurity.harpy \
    removeCommands.harpy \
    removeVariables.harpy \
    fetchKeyRing.harpy \
    mergeKeyRing.harpy]

###############################################################################

set resource_counts(all) [llength $resource_names(all)]
set resource_counts(nonLibrary) [llength $resource_names(nonLibrary)]

###############################################################################

set resource_counts(library) [expr {
  $resource_counts(all) - $resource_counts(nonLibrary)
}]

###############################################################################

#
# NOTE: The "empty" and "badgeEmpty" resources are not certificates.  They
#       are empty strings, which cannot be signed.
#
set resource_counts(nonCertificate) 2

###############################################################################

#
# NOTE: The resources named "*.resources" are not scripts; however, they do
#       have associated certificates.
#
set resource_counts(nonScript) [llength $resource_names(nonScript)]

###############################################################################

#
# NOTE: The "temporary-isolated.eagle" script file will be generated by the
#       [test2] core library command during test suite runs.  It does have
#       an associated script certificate; however, that certificate file name
#       reflects the file name as it is used during actual runs of the test
#       suite, not the file name as it exists within source checkout, which
#       is (core library) test data directory.
#
set resource_counts(temporary) 1

###############################################################################

set resource_counts(allCertificate) [expr {
  $resource_counts(all) - $resource_counts(nonCertificate)
}]

set resource_counts(libraryVerify) [expr {
  $resource_counts(library) - $resource_counts(nonCertificate)
}]

set resource_counts(tests) [llength \
    [regexp -all -inline -- {lib/Tests/} $resource_names(all)]]

set resource_counts(testsNonTemporary) [expr {
  $resource_counts(tests) - $resource_counts(temporary)
}]

set resource_counts(libraryVerifyExternalOk) [expr {
  $resource_counts(allCertificate) - \
  $resource_counts(tests) - $resource_counts(nonScript)
}]

set resource_counts(libraryVerifyExternalNotFound) [expr {
  $resource_counts(allCertificate) - \
  $resource_counts(libraryVerifyExternalOk)
}]

set resource_counts(libraryOnly) [llength $resource_names(libraryOnly)]

###############################################################################

#
# NOTE: These script flags are used to make the associated tests run faster
#       by skipping various superfluous alternative code paths and resource
#       names.
#
set resource_flags(plugin) {
  +NoFileSystem NoResourceManager NoAssemblyManifest
  NoPluginResourceName SkipFileName SkipRelative
  SkipNonQualified SkipLibraryToLib SkipTestsToLib
}

set resource_flags(embedded) {
  +NoFileSystem
}

set resource_flags(library) {
  +CoreAssemblyOnly SkipFileName SkipRelative
  SkipNonQualified SkipLibraryToLib SkipTestsToLib
}

###############################################################################
