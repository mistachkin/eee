###############################################################################

package require Eagle.Library
package require Eagle.Test

runTestPrologue

###############################################################################

set scriptFile [file join $path data secureTest.eagle]
set encryptedFile(1) [file join $path data encrypted.eagle]
set encryptedFile(2) [file join $path data secureTest2.eagle]
set encryptedFile(3) [file join $path data encrypted2.eagle]
set boltFile [file join $core_bin_path libBolt.dylib]

###############################################################################

#
# NOTE: Check test constraints specific to tests in this file that do not
#       require the plugin to be loaded.
#
if {![haveConstraint [appendArgs file_ [file tail $scriptFile]]]} then {
  checkForFile $test_channel $scriptFile
}

if {![haveConstraint [appendArgs file_ [file tail $encryptedFile(1)]]]} then {
  checkForFile $test_channel $encryptedFile(1)
}

if {![haveConstraint [appendArgs file_ [file tail $encryptedFile(2)]]]} then {
  checkForFile $test_channel $encryptedFile(2)
}

if {![haveConstraint [appendArgs file_ [file tail $encryptedFile(3)]]]} then {
  checkForFile $test_channel $encryptedFile(3)
}

if {![haveConstraint [appendArgs file_ [file tail $boltFile]]]} then {
  checkForFile $test_channel $boltFile
}

###############################################################################

#
# NOTE: We need to make sure the plugin is actually loaded prior to
#       querying the compile options.
#
if {[catch {package require Zeus.Enterprise} error] == 0} then {
  #
  # HACK: Pre-check for the [zeus] command now so that we can show
  #       the plugin compile options.
  #
  if {![haveConstraint command.zeus]} then {
    checkForCommand $test_channel zeus
  }

  #
  # NOTE: Now, check if the [zeus] command is actually available.
  #       If so, report the plugin compile options; otherwise, report
  #       that we cannot.
  #
  if {[haveConstraint command.zeus]} then {
    tputs $test_channel [appendArgs \
        "---- plugin \"Zeus.Enterprise\" compile options: " \
        [formatList [zeus options]] \n]
  } else {
    tputs $test_channel [appendArgs \
        "---- zeus command not available\n"]
  }
} else {
  tputs $test_channel [appendArgs \
      "---- failed to load plugin: " $error \n]
}

unset -nocomplain error
tputs $test_channel "---- checking for plugin isolation... "

if {[isEagle] && ![haveConstraint zeus.isolated]} then {
  #
  # NOTE: We need to make sure the plugin is actually loaded prior to
  #       querying the plugin flags.
  #
  if {[catch {package present Zeus.Enterprise}] == 0} then {
    #
    # NOTE: Query the plugin flags for the plugin and search them for the
    #       "Isolated" flag.  If this flag is present then the plugin has
    #       been loaded into an isolated AppDomain and some functionality
    #       will be unavailable.
    #
    if {[lsearch -exact -- \
        [getPluginFlags {^Zeus\.Enterprise, }] Isolated] != -1} then {
      #
      # NOTE: This plugin is running in isolated mode.
      #
      addConstraint zeus.isolated

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel error\n
  }
} else {
  tputs $test_channel skipped\n
}

###############################################################################

if {[isEagle]} then {setupStateForZeus true}

###############################################################################

if {[isEagle] && [llength [info commands object]] > 0} then {
  set zzzz_new_line [object invoke Environment NewLine]
} else {
  set zzzz_new_line \n
}

###############################################################################

proc registerTestProcedures { varName channel {quiet false} } {
  upvar 1 $varName registration

  set registration(1) [zeus register {
    # positional, no args
    return [appendArgs "SUCCESS: " [info level [info level]]]
  }]

  if {!$quiet} then {
    tputs $channel [appendArgs "==== REGISTERED: " $registration(1) \n]
  }

  set registration(2) [zeus register { one two } {
    # positional, two args
    return [appendArgs "SUCCESS: " [info level [info level]]]
  }]

  if {!$quiet} then {
    tputs $channel [appendArgs "==== REGISTERED: " $registration(2) \n]
  }

  set registration(3) [zeus register -flags +NamedArguments { one two } {
    # named, two args
    return [appendArgs "SUCCESS: " [info level [info level]]]
  }]

  if {!$quiet} then {
    tputs $channel [appendArgs "==== REGISTERED: " $registration(3) \n]
  }

  set registration(4) [zeus register -flags +NamedArguments {
    # named, no args
    return [appendArgs "SUCCESS: " [info level [info level]]]
  }]

  if {!$quiet} then {
    tputs $channel [appendArgs "==== REGISTERED: " $registration(4) \n]
  }

  set registration(5) [zeus register -flags +PositionalArguments { one } {
    # positional, one arg
    return [appendArgs "SUCCESS: " [info level [info level]]]
  }]

  if {!$quiet} then {
    tputs $channel [appendArgs "==== REGISTERED: " $registration(5) \n]
  }

  return ""
}

###############################################################################

proc unregisterTestProcedures { varName channel {quiet false} } {
  upvar 1 $varName registration

  foreach id [lsort -integer [array names registration]] {
    zeus unregister $registration($id)

    if {!$quiet} then {
      tputs $channel [appendArgs "==== UNREGISTERED: " $registration($id) \n]
    }
  }

  return ""
}

###############################################################################

proc getRegisteredProcedureResults { {withInfoBody false} } {
  set result [list]

  if {$withInfoBody} then {
    lappend result 1 \
        [appendArgs {procedure "07019b200246d2d0f189ca2e74f2a0bbb355fa8ed668} \
        {cf5ef2e318a8bfd8d14bb342a96b9189e63b0ce10383d6701c4d5c9671543994f66} \
        {a61f41ad580baf57d" body is unavailable}]
  }

  lappend result \
      [appendArgs {SUCCESS: 07019b200246d2d0f189ca2e74f2a0bbb355fa8ed668cf5e} \
      {f2e318a8bfd8d14bb342a96b9189e63b0ce10383d6701c4d5c9671543994f66a61f41} \
      {ad580baf57d}] \
      [appendArgs {SUCCESS: 489ccffcb9c7508fe6223c86d718b249e957de07de4f30d3} \
      {c73423ec6e60a98d3a39d77f56ce2e0536dc23578e02e1570c7e7fc012257a9b29562} \
      {c9d77461e7b 1 2}] \
      [appendArgs {SUCCESS: daa6fd2201417536bf59ae8241c4ed6411292b2e5d6385b5} \
      {3fe310ebeb3da0edb900ff1b03b473fcd46447757ef41385ec991c0df8ac8489dfa92} \
      {041b9a1c1d2 one 1 two 2}] \
      [appendArgs {SUCCESS: a0632c4b619d4ab5203b12a2878ecfba4b78f351d7ace028} \
      {375d85e63ed4dc50145f282370fb23383970c25f071be10c04c36a510d7e8cc7424a0} \
      {59637741cee}] \
      [appendArgs {SUCCESS: 1206fe8577a0e7a4263a364e5b96f451ab4eaed87b483c83} \
      {b2a57a1cf24cb186d99441602ce2127610a4f7ace957852a1adc9928f678f1372477b} \
      {0ffd7397dd9 1}]

  return $result
}

###############################################################################

runTest {test zeus-1.1 {encryptScript syntax} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  encryptScript
} -constraints {eagle} -returnCodes 1 -result {wrong # args: should be\
"encryptScript script encodingName password salt iterationCount\
hashAlgorithmName"}}

###############################################################################

runTest {test zeus-1.2 {decryptScript syntax} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  decryptScript
} -constraints {eagle} -returnCodes 1 -result {wrong # args: should be\
"decryptScript script encodingName password salt iterationCount\
hashAlgorithmName"}}

###############################################################################

runTest {test zeus-1.3 {isEncryptedScript syntax} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  isEncryptedScript
} -constraints {eagle} -returnCodes 1 -result \
{wrong # args: should be "isEncryptedScript script ?strict?"}}

###############################################################################

runTest {test zeus-2.1 {encryptScript failure result} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  encryptScript {puts stdout hi} "" password test 1000 ""
} -constraints [fixConstraints {eagle !dotNetCore60 !dotNetCore70\
!dotNetCore80 !dotNetCore90 !dotNetCore100}] -returnCodes 1 -match regexp \
-result { System\.ArgumentException: (?:Salt is not at least eight bytes\.|Salt\
< 8 bytes)}}

###############################################################################

runTest {test zeus-2.2 {encryptScript success result} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  encryptScript {puts stdout hi} "" password test1234 1000 ""
} -constraints {eagle} -result [string map [list \n $zzzz_new_line] \
{# <<ENCRYPTED-1.0>>
appendArgs {
/uGe0YPKNv0WQ+VthR8+jw==
}
}]}

###############################################################################

runTest {test zeus-3.1.1 {decryptScript failure result} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  decryptScript [eval {# <<ENCRYPTED-1.0>>
appendArgs {
/uGe0YPKNv0WQ+UthR8+jw==
}
}] "" password test1234 1000 ""
} -constraints [fixConstraints {eagle !dotNetCore}] -returnCodes 1 -match \
regexp -result { System\.Security\.Cryptography\.CryptographicException:\
(?:Padding is invalid and cannot be removed\.|Bad PKCS7 padding\. Invalid\
length 141\.)}}

###############################################################################

runTest {test zeus-3.1.2 {decryptScript failure result} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  decryptScript [eval {# <<ENCRYPTED-1.0>>
appendArgs {
/uGe0YPKNv0WQ+UthR8+jw==
}
}] "" password test1234 1000 ""
} -constraints {eagle dotNetCore} -returnCodes 1 -match regexp -result \
{ System\.Security\.Cryptography\.CryptographicException: (?:Specified padding\
mode is not valid for this algorithm\.|Padding is invalid and cannot be\
removed\.)}}

###############################################################################

runTest {test zeus-3.2 {decryptScript success result} -setup {
