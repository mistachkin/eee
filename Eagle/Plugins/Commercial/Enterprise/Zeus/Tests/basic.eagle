###############################################################################

runTest {test zeus-11.1 {encrypted local ".eagle" script} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography

  set string [object create String {
    set typeName Eagle._Interfaces.Public.IRfc2898Data

    provider -type $typeName Password password
    provider -type $typeName Salt test1234
    provider -type $typeName IterationCount 1000
    provider -type $typeName HashAlgorithmName ""

    unset typeName
  }]

  set clientData [object create ClientData $string]

  set zeus(providerAssemblyName) ""
  set zeus(providerTypeName) Script
  set zeus(providerClientData) $clientData
} -body {
  sourceEncrypted $encryptedFile(1)
} -cleanup {
  catch {rename helloWorld ""}

  unset -nocomplain zeus(providerClientData)
  unset -nocomplain zeus(providerTypeName)
  unset -nocomplain zeus(providerAssemblyName)

  unset -nocomplain clientData string
} -constraints {eagle command.object file_encrypted.eagle} -output \
[appendArgs "Hello World - " $encryptedFile(1) \n] -result {}}

###############################################################################

#
# NOTE: This virtual output must be reset between these tests.
#
if {[isEagle]} then {
  debug vout stdout false
  debug vout stdout true
}

###############################################################################

#
# WARNING: This test *MUST* create a new managed assembly file (DLL) in the
#          same directory as the executable itself.  The created temporary
#          files cannot be deleted if the Zeus plugin has not been loaded
#          into an isolated application domain.
#
runTest {test zeus-12.1 {encrypted local ".eagle" other} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography

  set id [object invoke Interpreter.GetActive NextId]

  set assemblyFileName [file nativename \
      [file join $core_bin_path Dynamic.Test${id}.dll]]

  set typeName _Dynamic${id}.Test${id}

  set baseTypeName [expr {[haveConstraint zeus.isolated] ? \
      "ScriptMarshalByRefObject," : ""}]

  unset -nocomplain results errors

  set code [lindex [compileCSharp [subst {
    using Eagle._Components.Public;
    using Eagle._Interfaces.Public;

    namespace _Dynamic${id}
    {
        public sealed class Test${id} :
            [appendArgs $baseTypeName IHaveInterpreter, \
                IHaveClientData, IRfc2898DataProvider]
        {
            #region IGetClientData / ISetClientData Members
            public IClientData ClientData
            {
                get { return null; }
                set { }
            }
            #endregion

            ///////////////////////////////////////////////////////////////////

            #region IGetInterpreter / ISetInterpreter Members
            public Interpreter Interpreter
            {
                get { return null; }
                set { }
            }
            #endregion

            ///////////////////////////////////////////////////////////////////

            #region IRfc2898DataProvider Members
            public ReturnCode GetData(
                string fileName,
                string encodingName,
                ref string password,
                ref string salt,
                ref int iterationCount,
                ref string hashAlgorithmName,
                ref string signature,
                ref Result error)
            {
                password = "password";
                salt = "test1234";
                iterationCount = 1000;
                hashAlgorithmName = null;
                signature = null;

                ///////////////////////////////////////////////////////////////

                return ReturnCode.Ok;
            }
            #endregion

            ///////////////////////////////////////////////////////////////////

            static void Main()
            {
                // do nothing.
            }
        }
    }
  }] false true true results errors OutputAssembly $assemblyFileName \
      ReferencedAssemblies.Add [lindex [info assembly] end]] 0]

  if {$code ne "Ok"} then {
    error [expr {[info exists errors] ? $errors : "compile error"}]
  }

  unset -nocomplain id code results errors

  set assemblyName [object invoke -tostring \
      System.Reflection.AssemblyName GetAssemblyName \
      $assemblyFileName]

  set zeus(providerAssemblyName) $assemblyName
  set zeus(providerTypeName) $typeName
  set zeus(providerClientData) ""

  #
  # HACK: When running on .NET Core, the generated assembly cannot be loaded
  #       using the Assembly.Load() method for reasons that are not entirely
  #       clear; however, it does work when using Assembly.LoadFrom().  This
  #       event handler should make things work for Assembly.Load().
  #
  if {[info exists no(dotNetCoreOnly)] || \
      ([isDotNetCore] && ![info exists no(dotNetCore)])} then {
    proc resolveProviderAssembly { sender e } {
      if {[isNonNullObjectHandle $e]} then {
        if {[$e Name] eq $::assemblyName} then {
          tlog [appendArgs "---- resolved assembly \"" $::assemblyName \"\n]

          return [set ::assembly \
              [object load -loadtype File $::assemblyFileName]]
        }
      }

      return null
    }

    object invoke -marshalflags +DynamicCallback \
        AppDomain.CurrentDomain add_AssemblyResolve resolveProviderAssembly

    tlog "---- added custom assembly resolver\n"
  }
} -body {
  sourceEncrypted $encryptedFile(1)
} -cleanup {
  catch {rename helloWorld ""}

  if {[info exists no(dotNetCoreOnly)] || \
      ([isDotNetCore] && ![info exists no(dotNetCore)])} then {
    catch {object dispose $assembly}
    unset -nocomplain assembly

    object invoke -marshalflags +DynamicCallback \
        AppDomain.CurrentDomain remove_AssemblyResolve resolveProviderAssembly

    tlog "---- removed custom assembly resolver\n"

    catch {rename resolveProviderAssembly ""}
    catch {object removecallback resolveProviderAssembly}
  }

  catch {file delete $assemblyFileName}

  unset -nocomplain zeus(providerClientData)
  unset -nocomplain zeus(providerTypeName)
  unset -nocomplain zeus(providerAssemblyName)

  unset -nocomplain id code results errors
  unset -nocomplain baseTypeName typeName assemblyName assemblyFileName
} -constraints {eagle command.object command.zeus compileCSharp\
file_encrypted.eagle compile.EMIT} -output \
[appendArgs "Hello World - " $encryptedFile(1) \n] -result {}}

###############################################################################

#
# NOTE: This virtual output must be reset between these tests.
#
if {[isEagle]} then {
  debug vout stdout false
  debug vout stdout true
}

###############################################################################

if {[isEagle]} then {
  #
  # NOTE: Grab the Zeus plugin path.  This is needed after the following three
  #       tests in order to delete the compiled managed assemblies containing
  #       the custom RFC 2898 data providers.
  #
  set plugin_path [file normalize [getPluginPath {^Zeus\.Enterprise, }]]
  set plugin_dir [file dirname $plugin_path]
}

###############################################################################

#
# WARNING: This test *MUST* create a new managed assembly file (DLL) in the
#          same directory as the Zeus plugin itself.  The created temporary
#          files will be deleted before the end of this test script file.
#
# NOTE: This test requires the Zeus plugin to be loaded into an isolated
#       application domain because that is the only way the CLR assembly
#       loader can actually find the newly compiled managed assembly as
#       well as both assemblies it depends on (e.g. "Eagle" and "Zeus").
#
runTest {test zeus-13.1 {encrypted local ".eagle" other} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography

  set id [object invoke Interpreter.GetActive NextId]

  set assemblyFileName [file nativename \
      [file join $plugin_dir Dynamic.Test${id}.dll]]

  set typeName _Dynamic${id}.Test${id}

  unset -nocomplain results errors

  set code [lindex [compileCSharp [subst {
    using Eagle._Components.Public;

    namespace _Dynamic${id}
    {
        public sealed class Test${id} : Zeus.Providers.Core
        {
            #region IRfc2898DataProvider Members
            public override ReturnCode GetData(
                string fileName,
                string encodingName,
                ref string password,
                ref string salt,
                ref int iterationCount,
                ref string hashAlgorithmName,
                ref string signature,
                ref Result error)
            {
                base.Password = "password";
                base.Salt = "test1234";
                base.IterationCount = 1000;
                base.HashAlgorithmName = null;
                base.Signature = null;

                ///////////////////////////////////////////////////////////////

                return base.GetData(
                    fileName, encodingName, ref password, ref salt,
                    ref iterationCount, ref hashAlgorithmName,
                    ref signature, ref error);
            }
            #endregion

            ///////////////////////////////////////////////////////////////////

            static void Main()
            {
                // do nothing.
            }
        }
    }
  }] false true true results errors OutputAssembly $assemblyFileName \
      ReferencedAssemblies.Add [lindex [info assembly] end] \
      ReferencedAssemblies.Add [file nativename $plugin_path]] 0]

  if {$code ne "Ok"} then {
    error [expr {[info exists errors] ? $errors : "compile error"}]
  }

  unset -nocomplain id code results errors

  set assemblyName [object invoke -tostring \
      System.Reflection.AssemblyName GetAssemblyName \
      $assemblyFileName]

  set zeus(providerAssemblyName) $assemblyName
  set zeus(providerTypeName) $typeName
  set zeus(providerClientData) ""

  #
  # HACK: When running on .NET Core, the generated assembly cannot be loaded
  #       using the Assembly.Load() method for reasons that are not entirely
  #       clear; however, it does work when using Assembly.LoadFrom().  This
  #       event handler should make things work for Assembly.Load().
  #
  if {[info exists no(dotNetCoreOnly)] || \
      ([isDotNetCore] && ![info exists no(dotNetCore)])} then {
    proc resolveProviderAssembly { sender e } {
      if {[isNonNullObjectHandle $e]} then {
        if {[$e Name] eq $::assemblyName} then {
          tlog [appendArgs "---- resolved assembly \"" $::assemblyName \"\n]

          return [set ::assembly \
              [object load -loadtype File $::assemblyFileName]]
        }
      }

      return null
    }

    object invoke -marshalflags +DynamicCallback \
        AppDomain.CurrentDomain add_AssemblyResolve resolveProviderAssembly

    tlog "---- added custom assembly resolver\n"
  }
} -body {
  sourceEncrypted $encryptedFile(1)
} -cleanup {
  catch {rename helloWorld ""}

  if {[info exists no(dotNetCoreOnly)] || \
      ([isDotNetCore] && ![info exists no(dotNetCore)])} then {
    catch {object dispose $assembly}
    unset -nocomplain assembly

    object invoke -marshalflags +DynamicCallback \
        AppDomain.CurrentDomain remove_AssemblyResolve resolveProviderAssembly

    tlog "---- removed custom assembly resolver\n"

    catch {rename resolveProviderAssembly ""}
    catch {object removecallback resolveProviderAssembly}
  }

  catch {file delete $assemblyFileName}

  unset -nocomplain zeus(providerClientData)
  unset -nocomplain zeus(providerTypeName)
  unset -nocomplain zeus(providerAssemblyName)

  unset -nocomplain id code results errors
  unset -nocomplain typeName assemblyName assemblyFileName
} -constraints {eagle command.object command.zeus compileCSharp zeus.isolated\
file_encrypted.eagle compile.EMIT} -output \
[appendArgs "Hello World - " $encryptedFile(1) \
\n] -result {}}

###############################################################################

runTest {test zeus-14.1 {create/use/delete registered procedures} -setup {
  package require Zeus.Enterprise

  registerTestProcedures registration stdout
} -body {
  list [[lindex $registration(1) end]] \
      [[lindex $registration(2) end] 1 2] \
      [[lindex $registration(3) end] one 1 two 2] \
      [[lindex $registration(4) end]] \
      [[lindex $registration(5) end] 1]
} -cleanup {
  unregisterTestProcedures registration stdout
  unset -nocomplain registration
} -constraints {eagle command.object} -result [getRegisteredProcedureResults]}

###############################################################################

runTest {test zeus-14.2 {create/use/delete obfuscated procedures} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography

  set zeus(providerAssemblyName) ""
  set zeus(providerTypeName) Test
  set zeus(providerClientData) ""

  set provider [zeus_createProvider]
  zeus proc $provider

  registerTestProcedures registration stdout
} -body {
  list [catch {info body [lindex $registration(1) end]} error] $error \
      [[lindex $registration(1) end]] \
      [[lindex $registration(2) end] 1 2] \
      [[lindex $registration(3) end] one 1 two 2] \
      [[lindex $registration(4) end]] \
      [[lindex $registration(5) end] 1]
} -cleanup {
  unregisterTestProcedures registration stdout
  unset -nocomplain registration

  catch {zeus proc null}

  catch {object dispose $provider}
  unset -nocomplain provider

  unset -nocomplain zeus(providerClientData)
  unset -nocomplain zeus(providerTypeName)
  unset -nocomplain zeus(providerAssemblyName)
} -constraints {eagle command.object} -result [getRegisteredProcedureResults 1]}

###############################################################################

runTest {test zeus-15.1 {self-test: method hooking, et al} -setup {
  package require Zeus.Enterprise
} -body {
  zeus selftest
} -constraints {eagle dotNetOrDotNetCore} -constraintExpression \
{![info exists tcl_platform(os)] || $tcl_platform(os) ne "Darwin" || \
[haveConstraint file_libBolt.dylib]} -result {PASSED}}

###############################################################################

runTest {test zeus-15.2 {advanced method hooking} -setup {
  package require Zeus.Enterprise

  unset -nocomplain state
} -body {
  set state(result) [list]

  lappend state(result) [set state(test) \
      [object create -alias Eagle._Tests.Default]]

  lappend state(result) [set state(proc,1) [zeus register { value } {
    return [list \
        "HOOKED #1" [getStringFromObjectHandle $value] [clock seconds]]
  }]]

  lappend state(result) [set state(proc,2) [zeus register { value } {
    return [list \
        "HOOKED #2" [getStringFromObjectHandle $value] [clock seconds]]
  }]]

  lappend state(result) [set state(callback,1) [zeus callback $state(proc,1)]]
  lappend state(result) [set state(callback,2) [zeus callback $state(proc,2)]]

  set state(value,1) zeus-15.2-static
  set state(value,2) zeus-15.2-instance

  lappend state(result) [object invoke -flags +NonPublic \
      Eagle._Tests.Default TestStaticStringMethod $state(value,1)]

  lappend state(result) [$state(test) -flags +NonPublic \
      TestInstanceStringMethod $state(value,2)]

  lappend state(result) [set state(hook,1) [zeus hook \
      -callback $state(callback,1) -methodtype Eagle._Tests.Default \
      -methodname TestStaticStringMethod -bindingflags +NonPublic]]

  lappend state(result) [set state(hook,2) [zeus hook \
      -callback $state(callback,2) -methodtype Eagle._Tests.Default \
      -methodname TestInstanceStringMethod -bindingflags +NonPublic]]

  lappend state(result) [object invoke -flags +NonPublic \
      Eagle._Tests.Default TestStaticStringMethod $state(value,1)]

  lappend state(result) [$state(test) -flags +NonPublic \
      TestInstanceStringMethod $state(value,2)]

  unset state(hook,2); # NOTE: Unhooks via [object dispose].
  unset state(hook,1); # NOTE: Unhooks via [object dispose].

  lappend state(result) [object invoke -flags +NonPublic \
      Eagle._Tests.Default TestStaticStringMethod $state(value,1)]

  lappend state(result) [$state(test) -flags +NonPublic \
      TestInstanceStringMethod $state(value,2)]

  set state(result)
} -cleanup {
  catch {object removecallback $state(callback,2)}
  catch {object removecallback $state(callback,1)}

  catch {zeus unregister $state(proc,2)}
  catch {zeus unregister $state(proc,1)}

  unset -nocomplain state
} -constraints [fixConstraints {eagle dotNetOrDotNetCore !zeus.isolated}] \
-constraintExpression {![info exists tcl_platform(os)] || \
$tcl_platform(os) ne "Darwin" || [haveConstraint file_libBolt.dylib]} \
-match regexp -result [appendArgs \
{^Default#\d+ \{\d+ ddb54e9e56eb9f7398190081dc07f856737f3d284a4cc9c9e38212} \
{f405e519d0619739930452327e6b8a1993e82823cf1a49aba21a7d3ec703946a7f1d19b00f\}\
\{\d+ 1e24dda0421f7842bc5e84e43526ee5a0d84b984441cbdf1f679ed7c07aa6f4879f9} \
{df8c28e890eec6cff5c3d3f739c8e820b10f8bf01b4e3a80501384a34576\} ddb54e9e56} \
{eb9f7398190081dc07f856737f3d284a4cc9c9e38212f405e519d0619739930452327e6b8} \
{a1993e82823cf1a49aba21a7d3ec703946a7f1d19b00f 1e24dda0421f7842bc5e84e4352} \
{6ee5a0d84b984441cbdf1f679ed7c07aa6f4879f9df8c28e890eec6cff5c3d3f739c8e820} \
{b10f8bf01b4e3a80501384a34576 zeus-15\.2-static zeus-15\.2-instance\
Zeus\.Components\.Private\.HookOps\+HookClientData#\d+\
Zeus\.Components\.Private\.HookOps\+HookClientData#\d+ \{\{HOOKED #1\}\
zeus-15\.2-static \d+\} \{\{HOOKED #2\} zeus-15\.2-instance \d+\}\
zeus-15\.2-static zeus-15\.2-instance$}]}

###############################################################################

runTest {test zeus-16.1 {verify plugin "pi" function} -setup {
  if {[haveConstraint ieee754r2008]} then {
    saveAndResetPrecision 14
  }
} -body {
  list [catch {expr {pi()}} result] $result \
      [catch {expr {pi(1)}} result] $result
} -cleanup {
  if {[haveConstraint ieee754r2008]} then {
    restorePrecision
  }

  unset -nocomplain result
} -constraints {eagle} -result {0 3.14159265358979 0 2}}

###############################################################################

runTest {test zeus-17.1 {unloading non-isolated plugin} -setup {
  package require Zeus.Enterprise
} -body {
  set plugin [lindex [info loaded "" *Zeus.Enterprise*] 0]

  list [llength [info commands zeus]] \
      [unload -- [lindex $plugin 0] [lindex $plugin 1]] \
      [llength [info commands zeus]] \
      [object assemblies "Zeus, *"]
} -cleanup {
  unset -nocomplain plugin
} -constraints [fixConstraints {eagle command.object command.zeus\
!zeus.isolated}] -match regexp -result {^1 \{\{Zeus\.Enterprise, Zeus,\
Version=\d+\.\d+\.\d+\.\d+, Culture=neutral, PublicKeyToken=[0-9a-f]{16}\}\
\d+\.\d+\.\d+\.\d+\} 0 \{\{Zeus, Version=\d+\.\d+\.\d+\.\d+, Culture=neutral,\
PublicKeyToken=[0-9a-f]{16}\}\}$}}

###############################################################################

runTest {test zeus-17.2 {unloading isolated plugin} -setup {
  package require Zeus.Enterprise
} -body {
  set plugin [lindex [info loaded "" *Zeus.Enterprise*] 0]

  list [llength [info commands zeus]] \
      [unload -- [lindex $plugin 0] [lindex $plugin 1]] \
      [llength [info commands zeus]] \
      [object assemblies "Zeus, *"]
} -cleanup {
  unset -nocomplain plugin
} -constraints {eagle command.object command.zeus zeus.isolated} -match \
regexp -result {^1 \{\{Zeus\.Enterprise, Zeus, Version=\d+\.\d+\.\d+\.\d+,\
Culture=neutral, PublicKeyToken=[0-9a-f]{16}\} \d+\.\d+\.\d+\.\d+\} 0 \{\}$}}

###############################################################################

runTest {test zeus-18.1 {verify core "pi" function restored} -setup {
  if {[haveConstraint ieee754r2008]} then {
    saveAndResetPrecision 14
  }
} -body {
  list [catch {expr {pi()}} result] $result \
      [catch {expr {pi(1)}} result] $result
} -cleanup {
  if {[haveConstraint ieee754r2008]} then {
    restorePrecision
  }

  unset -nocomplain result
} -constraints {eagle} -result \
{0 3.14159265358979 1 {too many arguments for math function "pi"}}}

###############################################################################

if {[isEagle]} then {
  #
  # NOTE: Check if the plugin directory is set.  This is needed to assist in
  #       the deletion of any temporary managed assemblies containing custom
  #       RFC 2898 data providers compiled by the above tests.  It should be
  #       noted here that the test suite does *NOT* currently check for any
  #       extra (leaked) files in the plugin directories; however, we should
  #       still make a concerted effort to clean them up.
  #
  if {[string length $plugin_dir] > 0 && \
      [file isdirectory $plugin_dir]} then {
    set testFileNames [list]

    try {
      eval lappend testFileNames [glob -nocomplain -- \
          [file join $plugin_dir Dynamic.Test*.pdb]]

      eval lappend testFileNames [glob -nocomplain -- \
          [file join $plugin_dir Dynamic.Test*.dll]]

      if {[llength $testFileNames] > 0} then {
        catch {eval file delete $testFileNames}
      }
    } finally {
      unset -nocomplain testFileNames
    }
  }

  #
  # NOTE: Check if the binary path is set.  Attempt to delete any temporary
  #       managed assemblies created by the above tests.  This deletion may
  #       fail if one or more of the managed assemblies are still loaded
  #       into an application domain (i.e. the default application domain).
  #
  if {[string length $core_bin_path] > 0 && \
      [file isdirectory $core_bin_path]} then {
    set testFileNames [list]

    try {
      eval lappend testFileNames [glob -nocomplain -- \
          [file join $core_bin_path Dynamic.Test*.pdb]]

      eval lappend testFileNames [glob -nocomplain -- \
          [file join $core_bin_path Dynamic.Test*.dll]]

      if {[llength $testFileNames] > 0} then {
        catch {eval file delete $testFileNames}
      }
    } finally {
      unset -nocomplain testFileNames
    }
  }
}

###############################################################################

if {[isEagle]} then {debug vout stdout false}

###############################################################################

rename getRegisteredProcedureResults ""
rename unregisterTestProcedures ""
rename registerTestProcedures ""

###############################################################################

unset -nocomplain zzzz_new_line

###############################################################################

unset -nocomplain plugin_dir plugin_path boltFile encryptedFile scriptFile

###############################################################################

unset -nocomplain zeus(magic)
if {[array size zeus] == 0} then {unset -nocomplain zeus}

###############################################################################

runTestEpilogue
