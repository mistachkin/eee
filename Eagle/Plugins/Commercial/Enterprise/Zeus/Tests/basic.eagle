runTest {test zeus-10.1 {encrypted local ".eagle" remote XML} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography

  set uri [object create \
      Uri [appendArgs [getScriptBaseUri] scripts/rfc2898.xml]]

  set typeName [object invoke $uri GetType.AssemblyQualifiedName]

  set pair [object create \
      [appendArgs "AnyPair`2\[\[" $typeName \
      "\], System.Nullable`1\[System.Boolean\]\]"] \
      $uri null]

  set clientData [object create ClientData $pair]

  set zeus(providerAssemblyName) ""
  set zeus(providerTypeName) Remote
  set zeus(providerClientData) $clientData
} -body {
  sourceEncrypted $encryptedFile(1)
} -cleanup {
  catch {rename helloWorld ""}

  unset -nocomplain zeus(providerClientData)
  unset -nocomplain zeus(providerTypeName)
  unset -nocomplain zeus(providerAssemblyName)

  unset -nocomplain clientData pair typeName uri
} -constraints {eagle command.object tlsOk file_encrypted.eagle} -output \
[appendArgs "Hello World - " $encryptedFile(1) \n] -result {}}

