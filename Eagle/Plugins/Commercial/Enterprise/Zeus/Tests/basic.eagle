}
}] "" password test1234 1000 ""
} -constraints {eagle} -result {puts stdout hi}}

###############################################################################

runTest {test zeus-4.1 {isEncryptedScript false results} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  set script dGVzdA==; # NOTE: "test"

  list [expr {!![isEncryptedScript $script false]}] \
      [expr {!![isEncryptedScript $script true]}]
} -cleanup {
  unset -nocomplain script
} -constraints {eagle} -result {False False}}

###############################################################################

runTest {test zeus-4.2 {isEncryptedScript true results} -setup {
  package require Zeus.Enterprise
  package require Zeus.Cryptography
} -body {
  set script [string map [list \n $zzzz_new_line] {# <<ENCRYPTED-1.0>>
appendArgs {
/uGe0YPKNv0WQ+VthR8+jw==
}
}]

  list [expr {!![isEncryptedScript $script false]}] \
      [expr {!![isEncryptedScript $script true]}]
} -cleanup {
  unset -nocomplain script
} -constraints {eagle} -result {True True}}

