<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
  ******************************************************************************
  **                          Load Per-User Settings                          **
  ******************************************************************************
  -->

  <!--
      NOTE: If the per-user settings file exists, import it now.  The contained
            settings, if any, will override the default ones provided below.
  -->
  <Import Condition="'\$(MSBuildProjectDirectory)' != '' And
                     !HasTrailingSlash('\$(MSBuildProjectDirectory)') And
                     Exists('\$(MSBuildProjectDirectory)\\Targets\\${projectName}.StrongName.Settings.targets.user')"
          Project="\$(MSBuildProjectDirectory)\\Targets\\${projectName}.StrongName.Settings.targets.user" />

  <!--
  ******************************************************************************
  [getTargetsBanner "${projectName} Strong Name Signing Properties"]
  ******************************************************************************
  -->

  <Import Condition="'\$(HarpyDir)' != '' And
                     !HasTrailingSlash('\$(HarpyDir)') And
                     Exists('\$(HarpyDir)\\Targets\\Harpy.StrongName.Settings.targets')"
          Project="\$(HarpyDir)\\Targets\\Harpy.StrongName.Settings.targets" />
</Project>
