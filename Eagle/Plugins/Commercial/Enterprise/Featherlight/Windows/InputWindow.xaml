<src:BaseWindow x:Class="Featherlight.Windows.InputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:Featherlight.Windows"
    Title="Input Window" Width="400" Height="200"
    ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBox TabIndex="0" Name="txtInput" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Visible"
                 HorizontalScrollBarVisibility="Visible" FontFamily="Courier New"
                 AcceptsReturn="True" Background="#232D3C" BorderBrush="White"
                 Foreground="White" FontSize="16" />
    </Grid>
</src:BaseWindow>
