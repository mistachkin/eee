<src:BaseWindow x:Class="Featherlight.Windows.InteractiveWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:Featherlight.Windows"
    Title="Interactive Window" MinWidth="500" MinHeight="400" Width="500"
    Height="400" WindowStartupLocation="CenterScreen">
    <Grid Background="#485D7C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="5" />
            <RowDefinition />
            <RowDefinition Height="43" />
        </Grid.RowDefinitions>

        <TextBox TabIndex="0" Name="txtOutput" TextWrapping="Wrap" Grid.Row="0"
                 Grid.ColumnSpan="2" VerticalScrollBarVisibility="Visible"
                 HorizontalScrollBarVisibility="Visible" FontFamily="Courier New"
                 IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False"
                 Background="#485D7C" Foreground="White" BorderBrush="White"
                 FontSize="14" />

        <GridSplitter Name="splitInputOutput" Cursor="SizeNS"
                      ResizeDirection="Rows" Grid.ColumnSpan="2"
                      HorizontalAlignment="Stretch" Grid.Row="1" />

        <TextBox TabIndex="1" Name="txtInput" Grid.Row="2" Grid.ColumnSpan="2"
                 HorizontalScrollBarVisibility="Visible" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Visible" TextWrapping="Wrap"
                 FontFamily="Courier New" Foreground="White" Background="#232D3C"
                 BorderBrush="White" FontSize="16" />

        <Label Name="lblStatus" Content="" Grid.Row="3"
               Width="220" Height="30" HorizontalAlignment="Left"
               VerticalAlignment="Top" Margin="12,6,0,6" Foreground="White"
               FontSize="16" />

        <Button TabIndex="2" Name="btnEnter" Width="106" Click="btnEnter_Click"
                Grid.Row="3" Grid.Column="1" HorizontalContentAlignment="Center"
                HorizontalAlignment="Right" Focusable="False" IsTabStop="False"
                Background="#76869D" Foreground="White" BorderBrush="White"
                Margin="0,6,124,8">_Enter</Button>

        <Button TabIndex="3" Name="btnCancel" Width="106" Click="btnCancel_Click"
                Grid.Row="3" Grid.Column="1" HorizontalContentAlignment="Center"
                HorizontalAlignment="Right" Focusable="False" IsTabStop="False"
                Background="#76869D" Foreground="White" BorderBrush="White"
                Margin="0,6,12,8">_Cancel</Button>
    </Grid>
</src:BaseWindow>
