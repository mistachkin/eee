<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
  ******************************************************************************
  **                          Load Per-User Settings                          **
  ******************************************************************************
  -->

  <!--
      NOTE: If the per-user settings file exists, import it now.  The contained
            settings, if any, will override the default ones provided below.
  -->
  <Import Condition="'$(MSBuildProjectDirectory)' != '' And
                     !HasTrailingSlash('$(MSBuildProjectDirectory)') And
                     Exists('$(MSBuildProjectDirectory)\Targets\Featherlight.Settings.targets.user')"
          Project="$(MSBuildProjectDirectory)\Targets\Featherlight.Settings.targets.user" />

  <!--
  ******************************************************************************
  **                         Featherlight Properties                          **
  ******************************************************************************
  -->

  <PropertyGroup>
    <!--
        NOTE: Do we want to enforce the license certificate checking via the
              Featherlight plugin (i.e. not when run via the command line)?  By
              default, this is enabled.  If this is disabled, then no license
              certificate checking will be performed by the Featherlight plugin.
              This feature is largely just a proof-of-concept for the Harpy
              "License Manager" SDK; however, it is fully functional and is
              likely to ship [enabled] in the RTM version of Featherlight.
    -->
    <Licensing Condition="'$(Licensing)' == ''">true</Licensing>
  </PropertyGroup>
</Project>
