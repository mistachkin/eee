list \
  [writeWithoutFail "RequireVersion: " \
      [requireVersion 0.0.0.0]] \
  [writeWithoutFail "InteractiveLoop: " \
      [debug icommand #done; interactiveLoop]] \
  [writeWithoutFail "SettingsWereLoaded: " \
      [info exists settings_xml_was_loaded]] \
  [writeWithoutFail "LicensePolicy: " \
      [changeLicensePolicy]] \
  [writeWithoutFail "ScriptPolicy: " \
      [changePolicyProperty Script CurrentPolicy]] \
  [writeWithoutFail "LocalPolicy: " \
      [enableLocalPolicy ""]] \
  [writeWithoutFail "DisableInterpreterCreation: " \
      [disableInterpreterCreation ""]] \
  [writeWithoutFail "EnableInterpreterCreation: " \
      [enableInterpreterCreation ""]] \
  [writeWithoutFail "IsRestrictedInterpreter: " \
      [isRestrictedInterpreter]] \
  [writeWithoutFail "JoinSubPaths: " \
      [joinSubPaths a b c]] \
  [writeWithoutFail "StorageType: " \
      [storageType]] \
  [writeWithoutFail "TestMode: " \
      [testMode ""]] \
  [writeWithoutFail "SkipLicense: " \
      [skipLicense]] \
  [writeWithoutFail "HaveComponent: " \
      [haveComponent testMode]] \
  [writeWithoutFail "ListComponents: " \
      [listComponents]] \
  [writeWithoutFail "ListContextVariables: " \
      [listContextVariables]] \
  [writeWithoutFail "Features: " \
      [changeFeatures]]
