# <<swapCommands>>
requireVersion 0.0.0.0; # NOTE: Set allowed versions.
skipLicense true LicenseKeyRingOnly; # NOTE: Skip for license key rings.

writeWithoutFail \
    "Skipping Harpy plugin licensing for license key rings via " \
    $::scriptType " configuration " $::scriptSubType " \"" \
    $::scriptFileName "\" (" $::scriptFileId ") with a change count of " \
    $::pluginChangeCount .
