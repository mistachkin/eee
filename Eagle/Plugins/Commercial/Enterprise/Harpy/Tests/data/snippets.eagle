list [snippet clear] \
    [addCertificates ""] \
    [addCertificates $dataPath] \
    [addCertificates ""] \
    [snippet clear] \
    [snippet add [readFile $goodFile]] \
    [snippet clear] \
    [snippet add [readFile $badFile]] \
    [queryStatus Snippet]
