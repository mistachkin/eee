list \
  [info exists settings_xml_was_loaded] \
  [requireVersion 0.0.0.0] \
  [debug icommand #done; interactiveLoop] \
  [storageType] \
  [testMode ""] \
  [skipLicense] \
  [haveComponent ""] \
  [listComponents] \
  [listContextVariables] \
  [changeFeatures] \
  [changeLicensePolicy] \
  [changePolicyProperty Script CurrentPolicy] \
  [enableLocalPolicy ""] \
  [isRestrictedInterpreter] \
  [joinSubPaths a b c] \
  [set id [evaluateInSandbox $dumpSandboxFile sandboxResults]] \
  [waitForSandbox $id]
