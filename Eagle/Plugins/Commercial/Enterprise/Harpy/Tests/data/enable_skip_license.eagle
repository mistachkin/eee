# <<swapCommands>>
requireVersion 0.0.0.0; # NOTE: Set allowed versions.
skipLicense true Any; # NOTE: Skip license checks for Harpy plugin.

writeWithoutFail \
    "Skipping Harpy plugin licensing via " $::scriptType \
    " configuration " $::scriptSubType " \"" $::scriptFileName \
    "\" (" $::scriptFileId ") with a change count of " \
    $::pluginChangeCount .
