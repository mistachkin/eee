# <<swapCommands>>
requireVersion 0.0.0.0; # NOTE: Set allowed versions.
changeFeatures -S; # NOTE: Disable all support features.

writeWithoutFail \
    "Plugin \"" $::pluginType \
    "\" features now changed to \"" [changeFeatures] \
    "\" via " $::scriptType " configuration " $::scriptSubType \
    " \"" $::scriptFileName "\" (" $::scriptFileId \
    ") with a change count of " $::pluginChangeCount .
