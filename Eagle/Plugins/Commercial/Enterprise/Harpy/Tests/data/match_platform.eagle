#
# NOTE: This is now required prior to any commands that may mutate state;
#       however, in this case, the minimum version simply allows anything
#       to be used.
#
failOnError true
requireVersion 0.0.0.2

#
# NOTE: If "match_platform" variable exists, use it with the [matchPlatform]
#       command.
#
maybeEvaluate {[info exists match_platform]} {
  matchPlatform $match_platform
} else {
  writeStatus
}
