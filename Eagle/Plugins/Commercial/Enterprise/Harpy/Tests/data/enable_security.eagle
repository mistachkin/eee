# <<swapCommands>>
failOnError true; # Upon error, plugin will fail to load.
requireVersion 0.0.0.0; # NOTE: Set allowed versions.

maybeEvaluate {[haveVariable ::security_flags]} {
  enableSecurity $::security_flags; # NOTE: Toggle signed-only script policies?
} else {
  maybeEvaluate {[haveVariable ::pluginConfigurationPhase] && \
      $::pluginConfigurationPhase eq "Initialize"} {
    enableSecurity {
      :ToggleLocally MaybeKeyRings WithKeyRingsOnly
    }; # NOTE: Toggle signed-only script policies?
  } else {
    enableSecurity {
      :ToggleLocally AlwaysKeyRings
    }; # NOTE: Toggle signed-only script policies?
  }
}
