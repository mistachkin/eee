#
# NOTE: This is now required prior to any commands that may mutate state;
#       however, in this case, the minimum version simply allows anything
#       to be used.
#
failOnError true
requireVersion 0.0.0.0

#
# NOTE: This command should follow the HTTPS redirects, download the ZIP
#       file being pointed to, extract it, and install it into the Harpy
#       plugin directory.
#
downloadAndInstall https://urn.to/r/harpy_test_package
