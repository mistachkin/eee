requireVersion 0.0.0.0

set name [appendArgs ukse_ [pid]]; set value ""; set result [list]

lappend result [haveConfiguration $name]
lappend result [haveEnvironment $name]
lappend result [info exists ::env($name)]
lappend result [catch {setConfiguration $name} value] $value
lappend result [haveConfiguration $name]
lappend result [haveEnvironment $name]
lappend result [info exists ::env($name)]
