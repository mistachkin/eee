lappend result [info exists ::env($name)]
lappend result [catch {setEnvironment $name two} value] $value
lappend result [haveConfiguration $name]
lappend result [haveEnvironment $name]
lappend result [info exists ::env($name)]
lappend result [catch {setEnvironment $name} value] $value
lappend result [haveConfiguration $name]
lappend result [haveEnvironment $name]
lappend result [info exists ::env($name)]
lappend result [catch {setEnvironment $name ""} value] $value
lappend result [haveConfiguration $name]
lappend result [haveEnvironment $name]
lappend result [info exists ::env($name)]
lappend result [catch {setEnvironment $name} value] $value
lappend result [haveConfiguration $name]
lappend result [haveEnvironment $name]
lappend result [info exists ::env($name)]

set result
