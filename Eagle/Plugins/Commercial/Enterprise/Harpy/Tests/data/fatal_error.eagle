#
# NOTE: This is now required prior to any commands that may mutate state;
#       however, in this case, the minimum version simply allows anything
#       to be used.
#
failOnError true
requireVersion 0.0.0.1

#
# NOTE: If "fatal_error" variable exists, use it with the [fatalError]
#       command.
#
maybeEvaluate {[info exists ::fatal_error]} {
  fatalError $::fatal_error 123
} else {
  maybeEvaluate {![isRestrictedInterpreter]} {
    requireIdentifier getKnownBuildTypes Eagle.Test.Constraints
  }
}
