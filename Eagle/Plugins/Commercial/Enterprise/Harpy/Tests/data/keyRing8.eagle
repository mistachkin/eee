###############################################################################

#
# NOTE: This is the metadata for "TestPublic7.snk".
#
set keyMetadata(TestPublic7.snk) {
  Kind         KeyPair
  Id           936f5620-5b36-40ac-a205-7f6719c51d9a
  Name         TestPublic7.snk
  Group        "Core Library & Enterprise Demo"
  Description  "Used to sign certificates for demonstration purposes."
}

###############################################################################

#
# NOTE: This is the key usage for "TestPublic7.snk".
#
set keyUsage(TestPublic7.snk) {
  SZGE
}

###############################################################################

#
# NOTE: These are the key domains for "TestPublic7.snk".
#
# WARNING: These are locked to the local machine during testing and signed,
#          via an identifier that includes the volume serial number for the
#          location of the Harpy assembly itself.  Details of the algorithm
#          in use are officially unspecified.
#
set keyDomains(TestPublic7.snk) {
  00000000-0000-0000-0000-000000000000
}

###############################################################################

#
# NOTE: These are the key groups for "TestPublic7.snk".  This key ring is
#       special because it can be used to load the Harpy assembly itself when
#       it was compiled with the "Demo Edition" feature enabled.  Normally, a
#       license key ring cannot be loaded until the Harpy assembly itself has
#       already been loaded, which means that a license certificate for Harpy
#       itself is always required and must be signed with its public key;
#       however, this restriction is relaxed for demonstration purposes when
#       Harpy was compiled with the "Demo Edition" feature enabled.  If the
#       "Demo Edition" feature is not enabled, this key ring cannot be loaded
#       during Harpy assembly license certificate verification and any attempt
#       to verify such a license certificate signed with it will fail.
#
set keyGroups(TestPublic7.snk) {
  0x8bf43b4749e46a0b
}
