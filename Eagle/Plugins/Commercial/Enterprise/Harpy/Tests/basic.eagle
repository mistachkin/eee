#
# HACK: This test has proved to be rather flaky when running on Mono;
#       so, disable it there, via a negative test constraint.
#
runTest {test harpy-1.0 {check for working TLS connections} -setup {
  set uris [list]

  if {![info exists no(tlsHostsFile)]} then {
    eval lappend uris [split [readFile $tlsHostsFile] \n]
  }

  if {![info exists no(tls12HostsFile)]} then {
    eval lappend uris [split [readFile $tls12HostsFile] \n]
  }

  if {![info exists no(tls13HostsFile)]} then {
    eval lappend uris [split [readFile $tls13HostsFile] \n]
  }
} -body {
  set failures [list]

  foreach uri $uris {
    if {[string index $uri 0] eq "#"} then {; # HACK: Commented out?
      tputs $test_channel [appendArgs \
          "---- skipped: " [string trim [string range $uri 1 end]] \n]
    } else {
      if {[maybeDownloadFromUri $test_channel $uri $test_timeout]} then {
        tputs $test_channel [appendArgs "---- success: " $uri \n]
      } else {
        lappend failures $uri
        tputs $test_channel [appendArgs "---- failure: " $uri \n]
      }
    }
  }

  tputs $test_channel "---- checking for TLS to user-defined hosts... "

  if {[llength $failures] == 0} then {
    addConstraint tlsHostsOk

    tputs $test_channel yes\n
  } else {
    removeConstraint tlsHostsOk

    tputs $test_channel no\n
  }

  set failures
} -cleanup {
  unset -nocomplain uris uri failures
} -constraints {eagle tlsOk file_tls_hosts monoBug612} -result {}}

