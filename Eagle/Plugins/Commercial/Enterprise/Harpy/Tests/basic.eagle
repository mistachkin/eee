runTest {test harpy-60.1 {command collision skips apply} -setup [subst {
  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  proc matchPlatform { platform } {; # cfg cmd name collision (!)
    return true
  }

  saveEnvironmentVariables \[list NoLicensingPackageUnknown\]
}] -body {
  set env(NoLicensingPackageUnknown) 1

  set pattern {, applyCount = \d+, }
  set error null

  set code [object invoke Eagle._Tests.Default \
      TestSetTraceFilterCallback "" RegExp $pattern 4 \
      true error]; # 4 == TestTraceFilterMessageSpyCallback

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  object invoke \
      Eagle._Tests.Default TestTraceFilterResetOutput

  package require Licensing.Enterprise

  noContextVariables

  set output [object invoke \
      Eagle._Tests.Default TestTraceFilterGetOutput]

  list [expr {[string length $output] > 0}] \
      [regexp -- $pattern $output]
} -cleanup {
  restoreEnvironmentVariables [list NoLicensingPackageUnknown]

  catch {
    set error null

    object invoke Eagle._Tests.Default \
        TestSetTraceFilterCallback "" \
        None null -1 false error
  }

  unset -nocomplain code error output pattern

  catch {rename matchPlatform ""}; # should always fail
} -constraints {eagle compile.ISOLATED_INTERPRETERS compile.ISOLATED_PLUGINS\
Eagle._Tests.Default.TestSetTraceFilterCallback\
Eagle._Tests.Default.TestTraceFilterGetOutput\
Eagle._Tests.Default.TestTraceFilterResetOutput} -isolationLevel Maximum \
-noSecurity true -result {False 0}}

###############################################################################

runTest {test harpy-60.2 {force configuration commands} -setup [subst {
  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  proc matchPlatform { platform } {; # cfg cmd name collision (!)
    return true
  }

  saveEnvironmentVariables \[list \
      NoTraceLimits ConfigurationForceCommands \
      NoLicensingPackageUnknown\]
}] -body {
  set env(NoTraceLimits) 1
  set env(ConfigurationForceCommands) 1
  set env(NoLicensingPackageUnknown) 1

  set pattern {, applyCount = \d+, }
  set error null

  set code [object invoke Eagle._Tests.Default \
      TestSetTraceFilterCallback "" RegExp $pattern 4 \
      true error]; # 4 == TestTraceFilterMessageSpyCallback

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  object invoke \
      Eagle._Tests.Default TestTraceFilterResetOutput

  package require Licensing.Enterprise

  noContextVariables

  set output [object invoke \
      Eagle._Tests.Default TestTraceFilterGetOutput]

  list [expr {[string length $output] > 0}] \
      [regexp -- $pattern $output]
} -cleanup {
  restoreEnvironmentVariables [list \
      NoTraceLimits ConfigurationForceCommands \
      NoLicensingPackageUnknown]

  catch {
    set error null

    object invoke Eagle._Tests.Default \
        TestSetTraceFilterCallback "" \
        None null -1 false error
  }

  unset -nocomplain code error output pattern

  catch {rename matchPlatform ""}; # should always fail
} -constraints [fixConstraints {eagle !harpy.plugin.isolated\
compile.ISOLATED_INTERPRETERS compile.ISOLATED_PLUGINS\
Eagle._Tests.Default.TestSetTraceFilterCallback\
Eagle._Tests.Default.TestTraceFilterGetOutput\
Eagle._Tests.Default.TestTraceFilterResetOutput}] -isolationLevel Maximum \
-noSecurity true -result {True 1}}

