runTest {test harpy-45.18 {cryptography signfile / forEachFile} -setup [subst {
  package require Eagle.Test
  package require Licensing.Enterprise
  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  set dataPath {$dataPath}

  setupTestModeFiles \$dataPath
  setupSkipLicenseFiles \$dataPath

  set settingsFile(1) {$settingsFile(1)}
  set testKeyFile(1) {$testKeyFile(1)}
  set testKeyFile(2) {$testKeyFile(2)}
  set forPublicKeyFile {$forPublicKeyFile}
  set forPublicKeyImportFile {$forPublicKeyImportFile}

  saveEnvironmentVariables \[list \
      NoAnnounceInteractiveLoop \
      ScriptInterpreterSettings_Licensing.Enterprise\]

  enableTestMode true
}] -body {
  set env(NoAnnounceInteractiveLoop) 1

  set token [string trimleft [expr {random()}] -]

  set directory [file join \
      [getTemporaryPath] [appendArgs harpy-45_18_ [pid]]]

  file mkdir $directory

  set fileName(1) [file join $directory one.eagle]
  set fileName(2) [file join $directory two.eagle]
  set fileName(3) [file join $directory red.eagle]

  writeFile $fileName(1) {set x 1}
  writeFile $fileName(2) {set y 2}
  writeFile $fileName(3) {set z 3}

  set fileName(4) [file join $directory [file tail $forPublicKeyFile]]
  set fileName(5) [file join $directory [file tail $forPublicKeyImportFile]]

  file copy $forPublicKeyFile $fileName(4)
  file copy $forPublicKeyImportFile $fileName(5)

  set privateKey [keypair open -public -private $testKeyFile(1)]
  set publicKey [keypair open -public -private $testKeyFile(2)]

  cryptography signfile $fileName(1) $privateKey
  cryptography verifyfile $fileName(1) $publicKey
  cryptography signfile $fileName(2) $privateKey
  cryptography verifyfile $fileName(2) $publicKey

  set code [catch {
    ksource -sandboxtoken $token -withcommands -useshared \
        -useplugin -usecontext -local -- $fileName(4)
  } result]

  if {$code != 0} then {
    error [getStringFromObjectHandle $result]
  }

  noContextVariables

  set result
} -cleanup {
  enableTestMode false

  restoreEnvironmentVariables [list \
      NoAnnounceInteractiveLoop \
      ScriptInterpreterSettings_Licensing.Enterprise]

  catch {certificate cleanup $token}

  catch {file delete $fileName(1)}
  catch {file delete $fileName(2)}
  catch {file delete $fileName(3)}

  catch {file delete [appendArgs $fileName(1) .b64sig]}
  catch {file delete [appendArgs $fileName(2) .b64sig]}
  catch {file delete [appendArgs $fileName(3) .b64sig]}

  catch {file delete $fileName(4)}
  catch {file delete $fileName(5)}

  if {[string length $directory] > 0} then {
    catch {
      if {[llength [glob -nocomplain \
          [file join $directory *]]] == 0} then {
        file rmdir $directory
      }
    }
  }

  cleanupSkipLicenseFiles
  cleanupTestModeFiles

  unset -nocomplain token directory fileName privateKey publicKey x y
  unset -nocomplain code result
} -constraints {eagle command.ksource command.certificate command.keypair\
command.cryptography file_TestPrivate1.snk file_TestPublic1.snk\
file_for_public_key.eagle compile.ISOLATED_INTERPRETERS file_settings.xml\
harpy.strongName.official2 harpy.strongName.resource2} -isolationLevel \
Maximum -noSecurity true -result {x y}}

