"897c556e-a90c-465b-93c4-5e8a0a128a53"}}

###############################################################################

runTest {test harpy-65.3 {specific missing process restricted} -setup {
  set sourceFileNames(shell) [info nameofexecutable]
  set sourceFileNames(library) [lindex [info assembly] end]
  set sourceFileNames(plugin) $plugin_path

  set targetDirectory [file join $bin_path harpy-65.3]

  set targetFileNames(shell) [file join $targetDirectory EagleShell.exe]
  set targetFileNames(library) [file join $targetDirectory Eagle.dll]
  set targetFileNames(plugin) [file join $targetDirectory Harpy.dll]

  file mkdir $targetDirectory
  file copy -force -- $sourceFileNames(shell) $targetFileNames(shell)
  file copy -force -- $sourceFileNames(library) $targetFileNames(library)
  file copy -force -- $sourceFileNames(plugin) $targetFileNames(plugin)

  rename getShellExecutableName __getShellExecutableName
  rename customGetShellExecutableName getShellExecutableName

  saveLicenseEnvironment true
  resetLicenseEnvironment true

  saveExecEnvironment
} -body {
  set env(Override_Certificate) $testFile(11)
  set env(getShellExecutableName) $targetFileNames(shell)

  set result [execTestShell [list \
      -nocarriagereturns -eventflags Wait] \
      -preInitialize [appendArgs \" \
          [list set env(NoPopulateOsExtra) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoAutoRecord) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoWorkerThread) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoLicensing) true] \"] \
      -preInitialize [appendArgs \" \
          [getChangeToExecutableDirectoryScript] \"] \
      -evaluate [appendArgs \" [getProofOfLoadScript] \"]]

  waitForProcesses [list [info previouspid]] 10000

  string trim $result
} -cleanup {
  restoreExecEnvironment

  restoreLicenseEnvironment true

  if {[llength [info commands getShellExecutableName]] > 0 && \
      [llength [info commands __getShellExecutableName]] > 0} then {
    rename getShellExecutableName customGetShellExecutableName
    rename __getShellExecutableName getShellExecutableName
  }

  catch {file delete $targetFileNames(plugin)}
  catch {file delete $targetFileNames(library)}
  catch {file delete $targetFileNames(shell)}
  catch {file rmdir $targetDirectory}

  unset -nocomplain targetDirectory targetFileNames
  unset -nocomplain sourceFileNames result
} -constraints {eagle testExec dotNet file_clrV2Shell file_clrV4Shell\
file_test11.xml} -result {Error, line 1: missing embedded process identifier}}

