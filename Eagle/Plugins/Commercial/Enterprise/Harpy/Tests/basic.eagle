runTest {test harpy-26.7 {keypair save private (DSA SNK)} -setup {
  package require Licensing.Enterprise

  set fileName [file join \
      [getTemporaryPath] [appendArgs harpy-26.7- [pid] .dsasnk]]

  catch {file delete -force $fileName}
} -body {
  #
  # HACK: In isolated mode, we cannot use the KeyPairType enumeration
  #       directly.
  #
  if {[haveConstraint harpy.isolated]} then {
    set DSA 0x200
  } else {
    set DSA DSA
  }

  set testKey [keypair open \
      -alias -public -private -keypairtype $DSA $testKeyFile(17)]

  keypair save -private -keypairtype $DSA $fileName $testKey

  expr {[hash normal -filename sha1 $fileName] eq \
      [hash normal -filename sha1 $testKeyFile(17)]}
} -cleanup {
  catch {file delete -force $fileName}

  unset -nocomplain testKey fileName DSA
} -constraints {eagle command.keypair file_TestPrivate1.dsasnk} -result {True}}

