###############################################################################

#
# HACK: Due to (possible) implicit use of HTTPS, this test requires the
#       "tlsOk" constraint.
#
# NOTE: As of this writing (March 2024), this test seems to provoke web
#       timeout exceptions when running on .NET Core 3.x or later.  It
#       does not appear to have the same issues when running on Mono or
#       .NET Core 2.x on the same machine.  The root cause of this issue
#       is not known and may be related to "security changes" to the TLS
#       behaviors within the BCL.  Alternatively, it could be bad luck?
#
runTest {test harpy-34.3 {encrypt/decrypt w/remote password} -setup {
  package require Licensing.Enterprise

  set bytes(0) [object create Byte\[\] 4]

  set provider [object create -alias Licensing.Providers.Remote]

  $provider Interpreter ""
} -body {
  set triplet(1) [cryptography encrypt \
      -alias -encodingname OneByte $bytes(0) $provider]

  set status(1) [$triplet(1) X]
  set bytes(1) [$triplet(1) -create Y]

  set triplet(2) [cryptography decrypt \
      -alias -encodingname OneByte $bytes(1) $provider]

  set status(2) [$triplet(2) X]
  set bytes(2) [$triplet(2) -create Y]

  list $status(1) $status(2) [expr {
    [object invoke Convert ToBase64String $bytes(0)] eq \
    [object invoke Convert ToBase64String $bytes(2)]
  }]
} -cleanup {
  unset -nocomplain status triplet bytes provider
} -constraints [fixConstraints {eagle compile.NETWORK compile.WEB\
command.cryptography !harpy.plugin.isolated tlsOk}] -result {None None True}}

###############################################################################

#
# HACK: Due to (possible) implicit use of HTTPS, this test requires the
#       "tlsOk" constraint.
#
runTest {test harpy-34.4 {encrypt/decrypt w/remote secret} -setup {
  package require Licensing.Enterprise

  set bytes(0) [object create Byte\[\] 4]

  set provider [object create -alias Licensing.Providers.Remote]

  $provider Interpreter ""
  $provider CultureInfo null
  $provider ClientId 00000000-0000-0000-0000-000000000000
  $provider ClientHashAlgorithmName null
  $provider SignatureHashAlgorithmName null
  $provider KeyRingName null
  $provider PolicyType Script
  $provider MatchKeyRingName false
  $provider Uri https://urn.to/r/secret

  set apiKey null; set error null

  set code [object invoke -argumentflags {+ArrayAsValue Create} \
      Utility GetBytesFromString 40c92a8b6515452da8cb6855a2208c69 \
      null apiKey error]; # TODO: Hard-coded.

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  $provider ApiKey $apiKey

  set apiId null; set error null

  set code [object invoke -argumentflags {+ArrayAsValue Create} \
      Utility GetBytesFromString d771aaf5-165b-5e04-a78b-b0c92a26fecc \
      null apiId error]; # TODO: Hard-coded.

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  $provider ApiId $apiId
  $provider UseSecretData true

  savePolicy savedPolicy; resetPolicy
  certificate policy -enabled true

  saveKeyRing savedKeyRing; resetKeyRing

  enableSecretMode true
} -body {
  keyring merge $keyRingFile(21)

  set triplet(1) [cryptography encrypt \
      -alias -encodingname OneByte $bytes(0) $provider]

  set status(1) [$triplet(1) X]
  set bytes(1) [$triplet(1) -create Y]

  set triplet(2) [cryptography decrypt \
      -alias -encodingname OneByte $bytes(1) $provider]

  set status(2) [$triplet(2) X]
  set bytes(2) [$triplet(2) -create Y]

  list $status(1) $status(2) [expr {
    [object invoke Convert ToBase64String $bytes(0)] eq \
    [object invoke Convert ToBase64String $bytes(2)]
  }]
} -cleanup {
  enableSecretMode false

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  unset -nocomplain code error apiKey apiId
  unset -nocomplain status triplet bytes provider
} -constraints [fixSnkConstraints {eagle compile.NETWORK compile.WEB\
command.cryptography !harpy.plugin.isolated command.certificate command.keypair\
command.keyring command.secret command.ksource network_urn.to tlsOk\
file_keyRing.zero.eagle file_enable_secret_mode.eagle\
file_disable_secret_mode.eagle $privateKeyFile(5)}] -result {None None True}}

