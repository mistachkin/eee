runTest {test harpy-10.2 {flags change sub-command} -setup {
  package require Licensing.Enterprise

  proc verifyFlags { code result options } {
    if {[info exists ::flagsRegExpPattern]} then {
      if {$code == 0} then {
        if {[lsearch -exact -- $options -space] != -1} then {
          set result [string map [list " " ""] $result]
        }

        if {![regexp -- $::flagsRegExpPattern $result]} then {
          error [appendArgs \
              "change MISMATCH flags: " $result]
        }
      }
    }
  }
} -body {
  #
  # NOTE: Construct some valid flags for the test cases.
  #
  set flags(1) {}
  set flags(2) {abc}
  set flags(3) {{1:abc}{2:def}{FF:GHI}{0123456789ABCDEFzyx}}
  set flags(4) {a{1:abc}b{2:def}c{FF:GHI}{0123456789ABCDEF:zyx}e}

  #
  # NOTE: Construct some invalid flags for the test cases.
  #
  set flags(5) {ab+cd}; # invalid value character '+'
  set flags(6) [appendArgs \{abcd:]; # missing close brace
  set flags(7) [appendArgs \{abcd:\}\}]; # unexpected close brace
  set flags(8) {{}}; # incomplete name
  set flags(9) {{:abcd}}; # missing name
  set flags(10) {{o:abcd}}; # invalid name character
  set flags(11) {{1:abc%}}; # invalid value character '%'

  #
  # NOTE: Setup the option sets we want to test.
  #
  set options [list \
      -complex \
      -space \
      -sort \
      -legacy \
      -compact \
      {-key 1} \
      {-complex -space} \
      {-complex -sort} \
      {-complex -legacy} \
      {-complex -compact} \
      {-complex -key 1} \
      {-space -sort} \
      {-space -legacy} \
      {-space -compact} \
      {-space -key 1} \
      {-sort -legacy} \
      {-sort -compact} \
      {-sort -key 1} \
      {-legacy -compact} \
      {-legacy -key 1} \
      {-compact -key 1} \
      {-complex -space -sort} \
      {-complex -space -legacy} \
      {-complex -space -compact} \
      {-complex -space -key 1} \
      {-complex -sort -legacy} \
      {-complex -sort -compact} \
      {-complex -sort -key 1} \
      {-complex -legacy -compact} \
      {-complex -legacy -key 1} \
      {-complex -compact -key 1} \
      {-space -sort -legacy} \
      {-space -sort -compact} \
      {-space -sort -key 1} \
      {-space -legacy -compact} \
      {-space -legacy -key 1} \
      {-space -compact -key 1} \
      {-sort -legacy -compact} \
      {-sort -legacy -key 1} \
      {-sort -compact -key 1} \
      {-legacy -compact -key 1} \
      {-complex -space -sort -legacy} \
      {-complex -space -sort -compact} \
      {-complex -space -sort -key 1} \
      {-complex -space -legacy -compact} \
      {-complex -space -legacy -key 1} \
      {-complex -space -compact -key 1} \
      {-complex -sort -legacy -compact} \
      {-complex -sort -legacy -key 1} \
      {-complex -sort -compact -key 1} \
      {-complex -legacy -compact -key 1} \
      {-space -sort -legacy -compact} \
      {-space -sort -legacy -key 1} \
      {-space -sort -compact -key 1} \
      {-space -legacy -compact -key 1} \
      {-sort -legacy -compact -key 1} \
      {-complex -space -sort -legacy -compact} \
      {-complex -space -sort -legacy -key 1} \
      {-complex -space -sort -compact -key 1} \
      {-complex -space -legacy -compact -key 1} \
      {-complex -sort -legacy -compact -key 1} \
      {-space -sort -legacy -compact -key 1} \
      {-complex -space -sort -legacy -compact -key 1}]

  #
  # NOTE: Setup the result list.
  #
  set result [list]

  #
  # NOTE: For each set of flags, run various test cases.
  #
  foreach name [array names flags] {
    foreach chgFlags [list {} abcd +ab-cd +* -*+ABCD +%] {
      foreach chgOptions $options {
        set cmd [list flags change]

        eval lappend cmd $chgOptions \
            [list $flags($name)] [list $chgFlags]

        set code [catch $cmd error]
        verifyFlags $code $error $chgOptions

        lappend result $cmd $error
      }
    }
  }

  #
  # NOTE: This command is used to capture the current results to a text file
  #       for later comparison when this test case changes (i.e. new options,
  #       etc).
  #
  # writeFile $changeResultFile [join $result \n]

  set result
} -cleanup {
  rename verifyFlags ""

  unset -nocomplain code result error
  unset -nocomplain cmd chgOptions chgFlags name options flags
} -constraints {eagle command.flags timeIntensive file_change.txt} -time true \
-result $chgResult}

