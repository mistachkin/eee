set test_log_if [expr {[info exists test_log] ? $test_log : ""}]

###############################################################################

runTest {test harpy-69.2 {enableSecurity via configuration} -setup [subst {
  if {!\[info exists test_channel\]} then {
    set test_channel {$test_channel}
  }

  if {\[catch {package present Eagle.Test}\]} then {
    package require Eagle.Test
  }

  if {!\[info exists test_log\]} then {
    set test_log {$test_log_if}
  }

  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  proc configurationReport {[info args configurationReport]} {
    [info body configurationReport]
  }

  set enableSecurityFile {$enableSecurityFile}
  set badFile {$badFile}
  set goodFile {$goodFile}

  saveEnvironmentVariables \[list \
      ConfigurationFileNames NoLicensingPackageUnknown\]
}] -body {
  set env(NoLicensingPackageUnknown) 1

  unset -nocomplain env(ConfigurationFileNames)
  lappend env(ConfigurationFileNames) $enableSecurityFile

  package require Security.Core

  set code(1) [catch {
    source $badFile
  } result(1)]

  set code(2) [catch {
    source $goodFile
  } result(2)]

  noContextVariables

  configurationReport [harpy configurations \
      {+Global WithOkResults WithErrorResults}]

  list [expr {[lsearch -exact -- [getDictionaryValue [harpy \
      configurations] Ok] $enableSecurityFile] != -1}] \
      $code(1) [string map [list $badFile <badFile>] $result(1)] \
      $code(2) [string map [list $goodFile <goodFile>] $result(2)]
} -cleanup {
  restoreEnvironmentVariables [list \
      ConfigurationFileNames NoLicensingPackageUnknown]
} -constraints {eagle command.harpy file_enable_security.eagle file_bad.eagle\
file_good.eagle} -isolationLevel Maximum -noSecurity true -result {True 1\
{couldn't read or get file "<badFile>": no such file or directory} 0 {This\
script should be evaluated.}}}

