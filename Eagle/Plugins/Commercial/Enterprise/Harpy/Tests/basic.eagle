runTest {test harpy-27.1 {using a revoked key pair with a certificate} -setup {
  package require Licensing.Enterprise

  enableTestMode true
} -body {
  set privateKey [keypair open -alias -public -private $testKeyFile(7)]
  set publicKey [keypair open -alias -public $testKeyFile(8)]
  set certificate [certificate import -alias -validate $importFile]

  list [certificate sign -setid -settimestamp -setkey $certificate \
      $privateKey] [catch {certificate verify $certificate $publicKey} \
      error] $error
} -cleanup {
  enableTestMode false

  unset -nocomplain error certificate privateKey publicKey
} -constraints {eagle command.certificate command.keypair command.ksource\
compile.XML file_template.xml file_TestPrivate3.snk file_enable_test_mode.eagle\
file_disable_test_mode.eagle} -result {SignedOk 1 {public key token\
"0x4e9d9d95d68290be" is revoked as of "<always>"}}}

