runTest {test harpy-26.1 {keypair save private (RSA SNK)} -setup {
  package require Licensing.Enterprise

  set fileName [file join \
      [getTemporaryPath] [appendArgs harpy-26.1- [pid] .snk]]

  catch {file delete -force $fileName}
} -body {
  set testKey [keypair open -alias -public -private $testKeyFile(1)]

  keypair save -private $fileName $testKey

  expr {[hash normal -filename sha1 $fileName] eq \
      [hash normal -filename sha1 $testKeyFile(1)]}
} -cleanup {
  catch {file delete -force $fileName}

  unset -nocomplain testKey fileName
} -constraints {eagle command.keypair file_TestPrivate1.snk} -result {True}}

