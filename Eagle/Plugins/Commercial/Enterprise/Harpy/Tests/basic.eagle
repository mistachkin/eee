runTest {test harpy-2.10 {import/sign/verify/export key fail} -setup {
  package require Licensing.Enterprise
  catch {file delete -force $exportFile}
} -body {
  set testKey [keypair open -alias -public -private $testKeyFile(1)]
  set certificate [certificate import -alias -validate $importFile]

  certificate metadata $certificate EntityName "Joe Eagle <joe@eagle.to>"
  certificate metadata $certificate EntityType Team
  certificate metadata $certificate Restrictions F; # FullyTrustedKey

  list [certificate sign -setid -settimestamp -setkey $certificate \
      $testKey] [certificate export -validate $certificate $exportFile] \
      [certificate warning -type License $exportFile] [set certificate \
      [certificate import -alias -validate $exportFile]] [certificate \
      loadandverify -force true -policytype License -policy \
      -EnforceKeyGroup -filename $exportFile $testKey] \
      [certificate verify $certificate $testKey] [certificate metadata \
      $certificate Key]
} -cleanup {
  catch {file delete -force $exportFile}

  unset -nocomplain testKey certificate
} -constraints {eagle command.certificate command.keypair command.keyring\
compile.XML file_template.xml file_keyRing10.eagle file_TestPrivate1.snk} \
-returnCodes 1 -result {found some of the Restriction flags "F" with key 0}}

