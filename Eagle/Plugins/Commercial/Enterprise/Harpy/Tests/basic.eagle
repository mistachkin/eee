catch {split [readFile $haveResultFile] \n} haveResult

###############################################################################

runTest {test harpy-10.1 {flags have sub-command} -setup {
  package require Licensing.Enterprise

  proc verifyFlags { code result options } {
    if {[info exists ::flagsRegExpPattern]} then {
      if {$code == 0} then {
        if {[lsearch -exact -- $options -space] != -1} then {
          set result [string map [list " " ""] $result]
        }

        if {![regexp -- $::flagsRegExpPattern $result]} then {
          error [appendArgs \
              "have MISMATCH flags: " $result]
        }
      }
    }
  }
} -body {
  #
  # NOTE: Construct some valid flags for the test cases.
  #
  set flags(1) {}
  set flags(2) {abc}
  set flags(3) {{1:abc}{2:def}{FF:GHI}{0123456789ABCDEFzyx}}
  set flags(4) {a{1:abc}b{2:def}c{FF:GHI}{0123456789ABCDEF:zyx}e}

  #
  # NOTE: Construct some invalid flags for the test cases.
  #
  set flags(5) {ab+cd}; # invalid value character '+'
  set flags(6) [appendArgs \{abcd:]; # missing close brace
  set flags(7) [appendArgs \{abcd:\}\}]; # unexpected close brace
  set flags(8) {{}}; # incomplete name
  set flags(9) {{:abcd}}; # missing name
  set flags(10) {{o:abcd}}; # invalid name character
  set flags(11) {{1:abc%}}; # invalid value character '%'

  #
  # NOTE: Setup the option sets we want to test.
  #
  set options [list \
      -complex \
      -space \
      -sort \
      -all \
      -strict \
      {-key 1} \
      {-complex -space} \
      {-complex -sort} \
      {-complex -all} \
      {-complex -strict} \
      {-complex -key 1} \
      {-space -sort} \
      {-space -all} \
      {-space -strict} \
      {-space -key 1} \
      {-sort -all} \
      {-sort -strict} \
      {-sort -key 1} \
      {-all -strict} \
      {-all -key 1} \
      {-strict -key 1} \
      {-complex -space -sort} \
      {-complex -space -all} \
      {-complex -space -strict} \
      {-complex -space -key 1} \
      {-complex -sort -all} \
      {-complex -sort -strict} \
      {-complex -sort -key 1} \
      {-complex -all -strict} \
      {-complex -all -key 1} \
      {-complex -strict -key 1} \
      {-space -sort -all} \
      {-space -sort -strict} \
      {-space -sort -key 1} \
      {-space -all -strict} \
      {-space -all -key 1} \
      {-space -strict -key 1} \
      {-sort -all -strict} \
      {-sort -all -key 1} \
      {-sort -strict -key 1} \
      {-all -strict -key 1} \
      {-complex -space -sort -all} \
      {-complex -space -sort -strict} \
      {-complex -space -sort -key 1} \
      {-complex -space -all -strict} \
      {-complex -space -all -key 1} \
      {-complex -space -strict -key 1} \
      {-complex -sort -all -strict} \
      {-complex -sort -all -key 1} \
      {-complex -sort -strict -key 1} \
      {-complex -all -strict -key 1} \
      {-space -sort -all -strict} \
      {-space -sort -all -key 1} \
      {-space -sort -strict -key 1} \
      {-space -all -strict -key 1} \
      {-sort -all -strict -key 1} \
      {-complex -space -sort -all -strict} \
      {-complex -space -sort -all -key 1} \
      {-complex -space -sort -strict -key 1} \
      {-complex -space -all -strict -key 1} \
      {-complex -sort -all -strict -key 1} \
      {-space -sort -all -strict -key 1} \
      {-complex -space -sort -all -strict -key 1}]

  #
  # NOTE: Setup the result list.
  #
  set result [list]

  #
  # NOTE: For each set of flags, run various test cases.
  #
  foreach name [array names flags] {
    foreach haveFlags [list {} abcd {{1:abc}}] {
      foreach haveOptions $options {
        set cmd [list flags have]

        eval lappend cmd $haveOptions \
            [list $flags($name)] [list $haveFlags]

        set code [catch $cmd error]
        verifyFlags $code $flags($name) $haveOptions

        lappend result $cmd $error
      }
    }
  }

  #
  # NOTE: This command is used to capture the current results to a text file
  #       for later comparison when this test case changes (i.e. new options,
  #       etc).
  #
  # writeFile $haveResultFile [join $result \n]

  set result
} -cleanup {
  rename verifyFlags ""

  unset -nocomplain code result error
  unset -nocomplain cmd haveOptions haveFlags name options flags
} -constraints {eagle command.flags timeIntensive file_have.txt} -time true \
-result $haveResult}

