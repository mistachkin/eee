  catch {rename helloWorld ""}

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy
} -constraints {eagle command.certificate file_keyRing19.eagle\
file_secureTest21.eagle} -result [subst {1 {couldn't read or get file\
"$testScriptFile(21)": no such file or directory}}]}

