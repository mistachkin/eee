#
# HACK: The [certificate shell] sub-command requires isolated interpreter
#       and shell support from the Eagle core library.
#
runTest {test harpy-22.2 {certificate shell sub-command (script)} -setup {
  package require Licensing.Enterprise

  saveKeyName savedKeyName; resetKeyName
  setKeyName $testKeyName(5)

  saveKeyRingName savedKeyRingName; resetKeyRingName

  savePolicy savedPolicy; resetPolicy
  certificate policy -file $testPolicy(8) -script $testPolicy(8)

  saveKeyRing savedKeyRing; resetKeyRing

  set interp [interp create -safe -nosecurity]

  if {![haveConstraint harpy.isolated]} then {
    keyring share $interp
  }

  interp set $interp plugin_path $plugin_path
  interp set $interp unsafeScript(2) [readFile $unsafeFile(2)]
  interp set $interp unsafeScript(3) [readFile $unsafeFile(3)]

  if {[haveConstraint harpy.isolated]} then {
    interp set $interp testKeyName(2) $testKeyName(2)
    interp set $interp testKeyName(5) $testKeyName(5)
    interp set $interp testPolicy(7) $testPolicy(7)
    interp set $interp testPolicy(8) $testPolicy(8)

    package require Eagle.Test

    interp eval $interp [makeProcedureCommand enableFlags]
    interp eval $interp [makeProcedureCommand enablePluginFlags]

    debug secureeval -trusted true -- $interp {
      set savedPluginFlags [enablePluginFlags]
      enablePluginFlags Isolated true
    }
  }

  debug secureeval -trusted true -- $interp {
    object invoke Interpreter.GetActive Quiet true
  }

  debug secureeval -trusted true -- $interp {
    load $plugin_path Licensing.Enterprise
  }

  interp expose $interp debug; # allow [debug *]

  set subCommands [getAllowedSubCommands $interp certificate]

  $subCommands Add shell null; # allow [certificate shell]

  if {[haveConstraint harpy.isolated]} then {
    setAllowedSubCommands $interp certificate $subCommands

    debug secureeval -trusted true -- $interp {
      certificate keyname -file $testKeyName(2) -script $testKeyName(2) \
          -stream $testKeyName(2)

      certificate policy -file $testPolicy(7) -script $testPolicy(7)

      keyring bootstrap

      certificate keyname -file $testKeyName(5) -script $testKeyName(5) \
          -stream $testKeyName(5)

      certificate policy -file $testPolicy(8) -script $testPolicy(8)
    }
  }

  debug secureeval -trusted true -- $interp {
    object invoke Interpreter.GetActive ExitCode Success
  }
} -body {
  list [interp eval $interp {certificate shell}] \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(3)
      }} result(1)] $result(1) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(3)
      }} result(2)] $result(2) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(2)
      }} result(3)] $result(3) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(2)
      }} result(4)] $result(4) \
      [interp eval $interp {certificate shell InstallCallbacks}] \
      [interp eval $interp {certificate shell}] \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(3)
      }} result(5)] $result(5) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(3)
      }} result(6)] $result(6) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(2)
      }} result(7)] $result(7) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(2)
      }} result(8)] $result(8) \
      [interp eval $interp {certificate shell UninstallCallbacks}] \
      [interp eval $interp {certificate shell}] \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(3)
      }} result(9)] $result(9) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(3)
      }} result(10)] $result(10) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(2)
      }} result(11)] $result(11) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            $unsafeScript(2)
      }} result(12)] $result(12)
} -cleanup {
  if {[haveConstraint harpy.isolated]} then {
    catch {
      debug secureeval -trusted true -- $interp {
        enablePluginFlags $savedPluginFlags
        unset -nocomplain savedPluginFlags
      }
    }
  }

  catch {object dispose $subCommands}
  catch {interp delete $interp}

  unset -nocomplain result subCommands interp

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  restoreKeyRingName savedKeyRingName

  restoreKeyName savedKeyName
} -constraints [fixConstraints {eagle command.certificate command.keyring\
file_unsafe2.eagle file_unsafe3.eagle compile.SHELL !harpy.obfuscated}] \
-match regexp -result \
[fixSnkTokenResult [appendArgs {^\{\{\} \{\} \{\} \{Flags Default\}\} 1\
\{permission denied: safe interpreter cannot use command "version"\} 1\
\{permission denied: safe interpreter cannot use command "version"\} 1\
\{permission denied: safe interpreter cannot use command "version"\} 1\
\{permission denied: safe interpreter cannot use command "version"\}\
\{\{\{(?:Eagle|Harpy), Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
(?:Eagle\._Components\.Public\.ShellCallbackBridge|}\
{Licensing\.Components\.Private\.CertificateShellOps) EvaluateScriptCallback\}\
\{\{(?:Eagle|Harpy), Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
(?:Eagle\._Components\.Public\.ShellCallbackBridge|}\
{Licensing\.Components\.Private\.CertificateShellOps) EvaluateFileCallback\}\
\{\{(?:Eagle|Harpy), Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
