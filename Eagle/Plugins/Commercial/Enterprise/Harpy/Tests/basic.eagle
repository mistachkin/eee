  catch {file delete -force $testScriptExportFile(1)}

  unset -nocomplain publicKey privateKey asmKey certificate
} -constraints [fixSnkConstraints {eagle command.certificate command.keypair\
compile.XML !harpy.plugin.isolated $publicKeyFile(1) $privateKeyFile(1)}] \
-match regexp -result [fixSnkTokenResult {^\{$publicKeyTokenBytes(1)\} SignedOk\
VerifiedOk ExportedOk Licensing#Components#Public#Certificate#\d+ VerifiedOk$}]}

