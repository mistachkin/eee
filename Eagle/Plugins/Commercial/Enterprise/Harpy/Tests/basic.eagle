unset -nocomplain test_log_if

###############################################################################

set errorMessage(1) {{invalid file name} {invalid file name} {could not read\
"NoFileName.harpy": no such file} {invalid file name} {invalid file name}\
{data "NoFileName.harpy" not found} {no files were checked} {skipped extension\
resource manager} {skipped application resource manager} {skipped kit resource\
manager} {start of signature block not found}}

set errorMessage(2) {{invalid file name} {invalid file name} {could not read\
"NoFileName.harpy": no such file} {invalid file name} {invalid file name}\
{data "NoFileName.harpy" not found} {skipped extension resource manager}\
{skipped application resource manager} {skipped kit resource manager} {start\
of signature block not found}}

set errorMessage(3) {couldn't read or get file "NoFileName": no such file or\
directory}

###############################################################################

if {[haveConstraint file_keval.txt]} then {
  set kevalResults [readFile $kevalResultFile]
} else {
  set kevalResults ""
}

###############################################################################

runTest {test harpy-57.1 {keval command} -setup {
  set interp [interp create -safe -security]

  package require Eagle.Test

  interp eval $interp [makeProcedureCommand appendArgs]

  interp alias $interp isSafe {} interp invokehidden $interp interp issafe
  interp set $interp x 0

  set fileName [file join \
      [getTemporaryPath] [appendArgs is_safe.harpy-57_1_ [pid] \
      .eagle]]

  saveEnvironmentVariables [list NoLicensingPackageUnknown]
} -body {
  set env(NoLicensingPackageUnknown) 1

  #
  # NOTE: Create unsigned variant of the "is_safe.eagle" script file.
  #
  writeFile $fileName \
      [certificate discard $isSafeFile [readFile $isSafeFile]]

  #
  # HACK: In isolated mode, we cannot use the ShellFlags enumeration
  #       directly.
  #
  if {[haveConstraint harpy.isolated]} then {
    set NoPoliciesOnFallback 0x1000
    set FallbackOnUnsafe 0x10000
    set FallbackOnNoPolicy 0x20000
    set FallbackOnNeutral 0x40000
    set FallbackOnDenied 0x80000
    set FallbackOnFailure 0x100000
  } else {
    set NoPoliciesOnFallback NoPoliciesOnFallback
    set FallbackOnUnsafe FallbackOnUnsafe
    set FallbackOnNoPolicy FallbackOnNoPolicy
    set FallbackOnNeutral FallbackOnNeutral
    set FallbackOnDenied FallbackOnDenied
    set FallbackOnFailure FallbackOnFailure
  }

  set script(good) [readFile $isSafeFile]
  set script(bad) {appendArgs "safe = " [isSafe]}

  set results [list]

  set allFlags [permuteFlags -flags + \
      $NoPoliciesOnFallback $FallbackOnUnsafe $FallbackOnNoPolicy \
      $FallbackOnNeutral $FallbackOnDenied $FallbackOnFailure]

  set index 0

  for {set pass 0} {$pass < 3} {incr pass} {
    foreach {fidx flags} $allFlags {
      if {$pass == 0 || $pass == 2} then {
        interp invokehidden $interp certificate policy \
            -local true -file -TrustSignedOnly
      } elseif {$pass == 1} then {
        interp invokehidden $interp certificate policy \
            -local true -file +TrustSignedOnly
      }

      #########################################################################

      set code($index) [catch {
        set command [list keval]
        maybeAddDangerOption $flags command

        if {[llength $flags] > 0} then {
          eval lappend command $flags
        }

        lappend command $script(good)
        interp eval $interp $command
      } result($index)]

      set result($index) [string map \
          [list $fileName NoFileName [appendArgs $fileName \
          .harpy] NoFileName.harpy] $result($index)]

      set result($index) [string map \
          [list $errorMessage(1) <error(1)> $errorMessage(2) <error(2)> \
          $errorMessage(3) <error(3)>] $result($index)]

      lappend results [list \
          $pass $index $fidx goodScript $code($index) $result($index)]

      incr index

      #########################################################################

      set code($index) [catch {
        set command [list keval]
        maybeAddDangerOption $flags command

        if {[llength $flags] > 0} then {
          eval lappend command $flags
        }

        lappend command -file $isSafeFile
        interp eval $interp $command
      } result($index)]

      set result($index) [string map \
          [list $fileName NoFileName [appendArgs $fileName \
          .harpy] NoFileName.harpy] $result($index)]

      set result($index) [string map \
          [list $errorMessage(1) <error(1)> $errorMessage(2) <error(2)> \
          $errorMessage(3) <error(3)>] $result($index)]

      lappend results [list \
          $pass $index $fidx goodFile $code($index) $result($index)]

      incr index

      #########################################################################

      set code($index) [catch {
        set command [list keval]
        maybeAddDangerOption $flags command

        if {[llength $flags] > 0} then {
          eval lappend command $flags
        }

        lappend command $script(bad)
        interp eval $interp $command
      } result($index)]

      set result($index) [string map \
          [list $fileName NoFileName [appendArgs $fileName \
          .harpy] NoFileName.harpy] $result($index)]

      set result($index) [string map \
          [list $errorMessage(1) <error(1)> $errorMessage(2) <error(2)> \
          $errorMessage(3) <error(3)>] $result($index)]

      lappend results [list \
          $pass $index $fidx badScript $code($index) $result($index)]

      incr index

      #########################################################################

      set code($index) [catch {
        set command [list keval]
        maybeAddDangerOption $flags command

        if {[llength $flags] > 0} then {
          eval lappend command $flags
        }

        lappend command -file $fileName
        interp eval $interp $command
      } result($index)]

      set result($index) [string map \
          [list $fileName NoFileName [appendArgs $fileName \
          .harpy] NoFileName.harpy] $result($index)]

      set result($index) [string map \
          [list $errorMessage(1) <error(1)> $errorMessage(2) <error(2)> \
          $errorMessage(3) <error(3)>] $result($index)]

      lappend results [list \
          $pass $index $fidx badFile $code($index) $result($index)]

      incr index
    }
  }

  if {[haveConstraint harpy.isolated]} then {
    foreach flags [list \
        NoPoliciesOnFallback FallbackOnUnsafe FallbackOnNoPolicy \
        FallbackOnNeutral FallbackOnDenied FallbackOnFailure] {
      set value [set $flags]

      regsub -all -- [appendArgs \
          {(^| |\+)} $value {( |\}|$)}] $allFlags [appendArgs {\1} \
          $flags {\2}] allFlags
    }
  }

  appendArgs [join $allFlags \n] \n [join $results \n]
} -cleanup {
  restoreEnvironmentVariables [list NoLicensingPackageUnknown]

  catch {file delete -force $fileName}
  catch {interp delete $interp}

  unset -nocomplain NoPoliciesOnFallback FallbackOnUnsafe
  unset -nocomplain FallbackOnNoPolicy FallbackOnNeutral
  unset -nocomplain FallbackOnDenied FallbackOnFailure
  unset -nocomplain fidx allFlags flags value
  unset -nocomplain index pass command code result results
  unset -nocomplain script interp fileName
} -constraints {eagle command.certificate command.keval file_is_safe.eagle\
file_keval.txt} -result $kevalResults}

###############################################################################

runTest {test harpy-57.2 {certificate evaluate sub-command} -setup {
  set interp [interp create -safe -security]

  package require Eagle.Test

  interp eval $interp [makeProcedureCommand appendArgs]

