  set privateKey [keypair open -alias -public -private $privateKeyFile(1)]
  set asmKey [keypair assembly -alias -public null]
  set certificate [certificate import -alias -validate $testScriptImportFile(1)]
  $certificate Key [publicKeyTokenToBytes $publicKeyToken(1)]

  list [$certificate Key] [certificate signstring -setid -settimestamp -setkey \
      $certificate $privateKey "hello there"] [certificate verifystring \
      $certificate $publicKey "hello there"] [certificate export -validate \
      $certificate $testScriptExportFile(1)] [set certificate [certificate \
      import -alias -validate $testScriptExportFile(1)]] [certificate \
      verifystring $certificate $asmKey "hello there"]
