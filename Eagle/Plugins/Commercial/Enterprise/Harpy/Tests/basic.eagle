unset -nocomplain test_log_if
set test_log_if [expr {[info exists test_log] ? $test_log : ""}]

###############################################################################

runTest {test harpy-47.1 {keyring merge w/enableSecurity} -setup [subst \
    -nocommands -nobackslashes {
  if {![info exists test_channel]} then {
    set test_channel {$test_channel}
  }

  if {[catch {package present Eagle.Test}]} then {
    package require Eagle.Test
  }

  if {![info exists test_log]} then {
    set test_log {$test_log_if}
  }

  set keyRingFile(1) {$keyRingFile(1)}
}] -body {
  package require Security.Core

  tputs $test_channel [appendArgs \
      "---- initially configured certificate policy: " \
      [certificate policy -local true] \n]

  source enableSecurity

  tputs $test_channel [appendArgs \
      "---- certificate policy after \[enableSecurity\]: " \
      [certificate policy -local true] \n]

  set code [catch {keyring merge $keyRingFile(1)} result]

  source disableSecurity

  tputs $test_channel [appendArgs \
      "---- certificate policy after \[disableSecurity\]: " \
      [certificate policy -local true] \n]

  list $code $result
} -cleanup {
  unset -nocomplain result code
  unset -nocomplain keyRingFile
} -constraints {eagle command.certificate command.keyring file_keyRing.eagle} \
-isolationLevel Maximum -result {0 {}}}

