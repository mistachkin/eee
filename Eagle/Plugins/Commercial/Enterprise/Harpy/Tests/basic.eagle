###############################################################################

runTest {test harpy-15.1 {loading all plugins} -body {
  set p(1) [package require Licensing.Enterprise]
  set p(2) [package require Licensing.Standard]
  set p(3) [package require Licensing.Core]
  set p(4) [package require Security.Core]

  list $p(1) [expr {$p(1) eq $p(2)}] \
      [expr {$p(2) eq $p(3)}] [expr {$p(3) eq $p(4)}]
} -cleanup {
  unset -nocomplain p
} -constraints {eagle} -match regexp -result \
{^\d+\.\d+\.\d+.\d+ True True True$}}

###############################################################################

runTest {test harpy-16.1 {keyring command without policy} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  setApprovedDataPolicy false

  saveKeyRing savedKeyRing
} -body {
  list [keyring clear] [keyring script] \
      [keyring merge $keyRingFile(1)] [keyring script] \
      [keyring clear] [keyring script]
} -cleanup {
  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy
} -constraints {eagle command.certificate command.keyring file_keyRing.eagle} \
-result {{} {} {} {EagleEnterprisePluginRootPublic.snk 8bf43b4749e46a0b\
TestPrivate1.snk 9c6c559394030af1 TestPrivate2.snk 724942ae9a27c4e2\
TestPrivate3.snk 4e9d9d95d68290be TestPrivate4.snk f37a907a6fe24095\
TestPrivate5.snk 107cdfbbd26112c9} {} {}}}

###############################################################################

runTest {test harpy-16.2 {keyring command with policy} -setup {
  package require Licensing.Enterprise

  saveKeyName savedKeyName; resetKeyName
  setKeyName $testKeyName(2)

  saveKeyRingName savedKeyRingName; resetKeyRingName

  savePolicy savedPolicy; resetPolicy
  certificate policy -local true -file $testPolicy(1) -script $testPolicy(1)

  saveKeyRing savedKeyRing
} -body {
  list [keyring clear] [keyring script] \
      [keyring merge $keyRingFile(1)] [keyring script] \
      [keyring clear] [keyring script]
} -cleanup {
  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  restoreKeyRingName savedKeyRingName

  restoreKeyName savedKeyName
} -constraints {eagle command.keyring file_keyRing.eagle} -result {{} {} {}\
{EagleEnterprisePluginRootPublic.snk 8bf43b4749e46a0b TestPrivate1.snk\
9c6c559394030af1 TestPrivate2.snk 724942ae9a27c4e2 TestPrivate3.snk\
4e9d9d95d68290be TestPrivate4.snk f37a907a6fe24095 TestPrivate5.snk\
107cdfbbd26112c9} {} {}}}

###############################################################################

runTest {test harpy-16.3 {keyring remove sub-command} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  setApprovedDataPolicy false

  saveKeyRing savedKeyRing
} -body {
  list [keyring clear] [keyring script] \
      [keyring merge $keyRingFile(1)] [keyring script] \
      [keyring remove default] [keyring script]
} -cleanup {
  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy
} -constraints {eagle command.certificate command.keyring file_keyRing.eagle} \
-result {{} {} {} {EagleEnterprisePluginRootPublic.snk 8bf43b4749e46a0b\
TestPrivate1.snk 9c6c559394030af1 TestPrivate2.snk 724942ae9a27c4e2\
TestPrivate3.snk 4e9d9d95d68290be TestPrivate4.snk f37a907a6fe24095\
TestPrivate5.snk 107cdfbbd26112c9} {} {}}}

###############################################################################

#
# WARNING: This must be done outside the context of an active test to work
#          properly because the test suite redefines the [puts] command
#          while tests are active.
#
if {[isEagle]} then {debug vout stdout true}

###############################################################################

runTest {test harpy-17.1 {policy use of trusted keyring} -setup {
  package require Licensing.Enterprise

  saveKeyName savedKeyName; resetKeyName
  setKeyName $testKeyName(2)

  saveKeyRingName savedKeyRingName; resetKeyRingName

  savePolicy savedPolicy; resetPolicy
  certificate policy -local true -file $testPolicy(1) -script $testPolicy(1)

  saveKeyRing savedKeyRing
} -body {
  list [keyring clear] [keyring script] \
      [keyring merge $keyRingFile(1)] \
      [catch {certificate policy \
          -local true -file $testPolicy(3) -script $testPolicy(3)}] \
      [source $testScriptFile(3)]
} -cleanup {
  catch {rename helloWorld ""}

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  restoreKeyRingName savedKeyRingName

  restoreKeyName savedKeyName
} -constraints {eagle command.keyring file_secureTest3.eagle\
file_keyRing.eagle} -output \
[subst {Hello World - [file nativename $testScriptFile(3)]
}] -result {{} {} {} 0 {}}}

###############################################################################

if {[isEagle]} then {debug vout stdout false}

###############################################################################

runTest {test harpy-18.1 {keyring metadata sub-command (assembly)} -setup {
  package require Licensing.Enterprise
} -body {
  keyring metadata ""
} -constraints {eagle command.keyring} -result [subst {{{Kind KeyPair} {Id\
91368c4d-b585-4bae-8d38-1322fcffb649} {Name\
EagleEnterprisePluginRootPublic.snk} {Group {Licensing Root}} {Description\
{Used to sign the assembly.}} {PublicKeyToken $publicKeyToken(1)} {KeyUsage\
LCQE} {FileName [getResultFromPath [file nativename $plugin_path]]}}}]}

###############################################################################

runTest {test harpy-18.2 {keyring metadata sub-command (embedded)} -setup {
  package require Licensing.Enterprise
} -body {
  keyring metadata [lindex [keyring embedded] 0]
} -constraints {eagle command.keyring} -result [subst {{{Kind KeyPair} {Id\
8ff3af77-97f0-4813-9b46-32308693d690} {Name EagleEnterpriseTrustRootPublic.snk}\
{Group {Primary Trust Root}} {Description {Used to sign key rings.}}\
{PublicKeyToken $publicKeyToken(primaryRoot)} {KeyUsage RSZGVQE} {FileName\
[getResultFromPath [file nativename $plugin_path]]}}}]}

###############################################################################

runTest {test harpy-18.3 {keyring metadata sub-command (zero)} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  setApprovedDataPolicy false

  saveKeyRing savedKeyRing
} -body {
  list [keyring clear] [keyring merge $keyRingFile(1)] \
      [catch {keyring metadata Z*} error] $error
} -cleanup {
  unset -nocomplain error

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy
} -constraints {eagle command.certificate command.keyring file_keyRing.eagle} \
-match regexp -result {^\{\} \{\} 1 \{key pair not found\}$}}

