  enableSharedEngineFlags NoDefaultError true
} -body {
  list [querySoftwareUpdatesTrusted true] \
      [querySoftwareUpdatesTrusted false] \
      [catch {source $testScriptUri(3)} error] $error
} -cleanup {
  unset -nocomplain error
  catch {rename helloWorld ""}

  enableSharedEngineFlags $savedSharedEngineFlags
  unset -nocomplain savedSharedEngineFlags

  restorePolicy savedPolicy
} -constraints {eagle command.certificate compile.NETWORK internet_eagle.to\
harpy.strongName.official1} -once true -match regexp -result {^\{0 \{software\
update certificate is untrusted\}\} \{0 \{software update certificate is\
untrusted\}\} (?:0 \{\}|1 \{(?:caught exception getting script stream:\
)?System\.Net\.WebException: .*\})$}}

