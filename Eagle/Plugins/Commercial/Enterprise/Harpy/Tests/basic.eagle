if {[isEagle]} then {debug vout stdout false}

###############################################################################

runTest {test harpy-49.1 {verify encrypted license} -setup [subst {
  package require Licensing.Enterprise

  set testKeyFile(2) {$testKeyFile(2)}
  set testFile(6) {$testFile(6)}
  set testPolicy(19) {$testPolicy(19)}
  set testPolicy(30) {$testPolicy(30)}
}] -body {
  set pluginData [object invoke -flags +NonPublic \
      Interpreter.GetActive GetPluginData [lindex [lindex [info \
      loaded "" "* \{Licensing.Enterprise, *\}"] 0] end]]

  object invoke $pluginData AppDomain.SetData \
      [appendArgs 7494a596-f0d8-49db-9d55-55276c591f11_ [pid]] \
      "Eagle Development Team"

  set publicKey [keypair open -alias -public $testKeyFile(2)]

  set certificate [certificate \
      loadandverify -filename $testFile(6) -useplugin 0 -useassembly 0 \
      -policy [appendArgs - $testPolicy(19) " +" $testPolicy(30)] -force \
      true $publicKey]
} -cleanup {
  unset -nocomplain certificate publicKey pluginData
} -constraints {eagle command.certificate command.keypair file_test6.exml\
file_TestPublic1.snk} -isolationLevel Maximum -match regexp -result \
{^Licensing#Components#Public#Certificate#\d+$}}

###############################################################################

runTest {test harpy-49.2 {isolated verify encrypted license} -setup [subst {
  package require Eagle.Test

  set savedPluginFlags \[enablePluginFlags\]
  enablePluginFlags Isolated true

  package require Licensing.Enterprise

  set testKeyFile(2) {$testKeyFile(2)}
  set testFile(6) {$testFile(6)}
  set testPolicy(19) {$testPolicy(19)}
  set testPolicy(30) {$testPolicy(30)}
}] -body {
  set pluginData [object invoke -flags +NonPublic \
      Interpreter.GetActive GetPluginData [lindex [lindex [info \
      loaded "" "* \{Licensing.Enterprise, *\}"] 0] end]]

  object invoke $pluginData AppDomain.SetData \
      [appendArgs 7494a596-f0d8-49db-9d55-55276c591f11_ [pid]] \
      "Eagle Development Team"

  set publicKey [keypair open -alias -public $testKeyFile(2)]

  set certificate [certificate \
      loadandverify -filename $testFile(6) -useplugin 0 -useassembly 0 \
      -policy [appendArgs - $testPolicy(19) " +" $testPolicy(30)] -force \
      true $publicKey]
} -cleanup {
  catch {
    enablePluginFlags $savedPluginFlags
    unset -nocomplain savedPluginFlags
  }

  unset -nocomplain certificate publicKey pluginData
} -constraints {eagle compile.ISOLATED_PLUGINS command.certificate\
command.keypair file_test6.exml file_TestPublic1.snk} -isolationLevel Maximum \
-match regexp -result {^Licensing#Components#Public#Certificate#\d+$}}

###############################################################################

runTest {test harpy-49.3 {encrypt/verify license} -setup [subst {
  package require Eagle.Test
  package require Licensing.Enterprise
  package require Harpy.Test

  set testKeyFile(1) {$testKeyFile(1)}
  set testFile(5) {$testFile(5)}
  set testPolicy(19) {$testPolicy(19)}
  set testPolicy(30) {$testPolicy(30)}
}] -body {
  set pluginData [object invoke -flags +NonPublic \
      Interpreter.GetActive GetPluginData [lindex [lindex [info \
      loaded "" "* \{Licensing.Enterprise, *\}"] 0] end]]

  set fileName(1) [file join \
      [getTemporaryPath] [appendArgs harpy-49_3_ [pid] .xml]]

  set fileName(2) [file join \
      [getTemporaryPath] [appendArgs harpy-49_3_ [pid] .exml]]

  set privateKey [keypair open -alias -public -private $testKeyFile(1)]
  set certificate(1) [certificate import -alias $testFile(5)]

  $certificate(1) SerialNumber [appendArgs ENC- [$certificate(1) SerialNumber]]
  $certificate(1) Number [appendArgs 0x [format %016lX [expr {random()}]]]

  certificate sign -setid -settimestamp -setkey $certificate(1) $privateKey
  certificate verify $certificate(1) $privateKey
  certificate export $certificate(1) $fileName(1)
  certificate warning -type License $fileName(1)
  reformatCertificateSpacing $fileName(1)

  set data(1) [object invoke \
      -create System.IO.File ReadAllBytes $fileName(1)]

  set password(0) [$certificate(1) EntityName]
  set salt(0) [$certificate(1) -create Id.ToByteArray]

  #
  # HACK: The hash algorithm must be manually set to SHA1 for this test,
  #       because the license certificate verification subsystem always
  #       uses the default hash algorithm name (null), mapped to "SHA1",
  #       unless the (encrypted) license certificate itself expliciltly
  #       has a hash algorithm name specified.  Meanwhile, the following
  #       sub-command has a default hash algorithm name of "SHA512" due
  #       to its use of the SharedOps.GetHashAlgorithm() method with the
  #       HashAlgorithmType.CommandUse enumeration value.
  #
  set triplet(1) [cryptography \
      encrypt3 -alias -hashalgorithm SHA1 $data(1) $password(0) $salt(0)]

  set data(2) [$triplet(1) -create Y]
  set salt(1) [object invoke Convert ToBase64String $salt(0)]

  set data(3) [string map [list \r\n \n] [object invoke \
      Convert ToBase64String $data(2) InsertLineBreaks]]

  writeFile $fileName(2) [string trim \
      [string map [list \n \r\n] [subst -nocommands -nobackslashes {
! EncryptedData: v1.0
! symmetricAlgorithmName: Rijndael
! salt: $salt(1)

$data(3)
  }]]]

  object invoke $pluginData AppDomain.SetData [appendArgs \
      [$certificate(1) Id] _ [pid]] [$certificate(1) EntityName]

  set certificate(2) [certificate \
      loadandverify -filename $fileName(2) -useplugin 0 -useassembly 0 \
      -policy [appendArgs - $testPolicy(19) " +" $testPolicy(30)] -force \
      true $privateKey]
} -cleanup {
  catch {file delete -force $fileName(2)}
  catch {file delete -force $fileName(1)}

  unset -nocomplain triplet data password salt
  unset -nocomplain certificate privateKey fileName pluginData
} -constraints [fixConstraints {eagle command.certificate command.cryptography\
command.keypair file_test5.xml file_TestPrivate1.snk !harpy.plugin.isolated}] \
-isolationLevel Maximum -match regexp -result \
{^Licensing#Components#Public#Certificate#\d+$}}

###############################################################################

runTest {test harpy-50.1 {ILicenseManager.EvaluateFile method} -setup {
  package require Licensing.Enterprise
} -body {
  set plugin null; set error null

  set code [object invoke -flags +NonPublic Interpreter.GetActive \
      GetPlugin [getPluginName {Licensing\.Enterprise, }] {Default \
      -Wrapper} plugin error]

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  set licenseManager [object create -alias \
      Licensing.Components.Public.LicenseManager]

  set anyClientData [object create -alias AnyClientData]

  $anyClientData TrySetAny fileName $infoScriptFile

  set result null

  set code [$licenseManager \
      EvaluateFile "" $plugin null $anyClientData result]

  list $code [getStringFromObjectHandle $result]
} -cleanup {
  unset -nocomplain plugin licenseManager anyClientData
  unset -nocomplain error code result
} -constraints \
[fixConstraints {eagle file_info_script.eagle !harpy.plugin.isolated}] -match \
regexp -result {^Ok \{0 \{?.+[/\\]info_script\.eagle\}?\}$}}

###############################################################################

runTest {test harpy-50.2 {EvaluateFile plugin request} -setup {
  package require Licensing.Enterprise
} -body {
  set interpreter null; set error null

  set code [object invoke -alias \
      Value GetInterpreter "" "" Default interpreter error]

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  set plugin null; set error null

  set code [object invoke -flags +NonPublic Interpreter.GetActive \
      GetPlugin [getPluginName {Licensing\.Enterprise, }] {Default \
      -Wrapper} plugin error]

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  object alias $plugin

  set clientData [object create ClientData EvaluateFile]
  set anyClientData [object create -alias AnyClientData]

  $anyClientData TrySetAny fileName $infoScriptFile

  set request [object create -alias System.Object\[\] 4]

  $request SetValue $interpreter 0
  $request SetValue $plugin 1
  $request SetValue null 2; # variantName
  $request SetValue $anyClientData 3

  set response null; set error null

  if {[haveConstraint harpy.plugin.isolated]} then {
    set code [$plugin \
        -objectvalueflags {+NullForProxyType ManualProxyGetType} \
        -proxytype Eagle._Interfaces.Public.IExecuteRequest \
        Execute "" $clientData $request response error]
  } else {
    set code [$plugin \
        Execute "" $clientData $request response error]
  }

  list $code [expr {
    $code eq "Ok" ? \
        [getStringFromObjectHandle $response] : \
        [getStringFromObjectHandle $error]
  }]
} -cleanup {
  unset -nocomplain interpreter plugin clientData anyClientData
  unset -nocomplain error code request response
} -constraints {eagle compile.ISOLATED_PLUGINS file_info_script.eagle} -match \
regexp -result {^Ok \{0 \{?.+[/\\]info_script\.eagle\}?\}$}}

###############################################################################

runTest {test harpy-50.3 {EvaluateClientData.CreateFrom method} -setup {
  package require Licensing.Enterprise
} -body {
  set plugin null; set error null

  set code [object invoke -flags +NonPublic Interpreter.GetActive \
      GetPlugin [getPluginName {Licensing\.Enterprise, }] {Default \
      -Wrapper} plugin error]

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  set error null

  set ruleSet [object invoke RuleSet Create \
      {{id 1 type Include kind Command mode Glob regExOptions\
      None patterns o*} {id 2 type Exclude kind Command mode\
      Exact regExOptions None patterns open}} null error]

  if {![isNonNullObjectHandle $ruleSet]} then {
    error [getStringFromObjectHandle $error]
  }

  set refreshEvent [object create -flags +NonPublic \
      Licensing.Components.Private.SharedEventWaitHandle \
      false ManualReset]

  set object [object create Object]

  set longList [object create -alias LongList]

  $longList Add 1; $longList Add 2; $longList Add 3

  set stream [object create System.IO.MemoryStream]

  set publicKey [keypair open -public $testKeyFile(2)]

  set keyPairs [object invoke -alias Array CreateInstance \
      Licensing.Interfaces.Private.IKeyPair 1]

  $keyPairs SetValue $publicKey 0

  set anyClientData [object create -alias AnyClientData]

  $anyClientData -marshalflags +NoHandle TrySetAny data $object
  $anyClientData TrySetAny name "some name"
  $anyClientData TrySetAny id 10000000-0000-0000-0000-000000000001
  $anyClientData TrySetAny group "some group"
  $anyClientData TrySetAny description "some description"
  $anyClientData TrySetAny contextName harpy-50.3

  $anyClientData -marshalflags +NoHandle TrySetAny \
      refreshEvent $refreshEvent

  $anyClientData TrySetAny sandboxToken \
      [appendArgs 0x [format %016lX [expr {random()}]]]

  $anyClientData -marshalflags +NoHandle TrySetAny commandTokens $longList
  $anyClientData TrySetAny useSettingsCallback true
  $anyClientData TrySetAny ruleSet $ruleSet
  $anyClientData TrySetAny interpreter ""
  $anyClientData TrySetAny plugin $plugin
  $anyClientData TrySetAny minimumVersion 0.0.0.0
  $anyClientData TrySetAny maximumVersion 1.1.1.1
  $anyClientData TrySetAny variantName something2
  $anyClientData TrySetAny hashAlgorithmName SHA1
  $anyClientData TrySetAny hashKey [base64 encode hashKey]; # WRONG
  $anyClientData TrySetAny encoding UTF-8
  $anyClientData TrySetAny type test
  $anyClientData TrySetAny subType fake
  $anyClientData TrySetAny directory some/path/to/dir
  $anyClientData TrySetAny fileName somefile.eagle
  $anyClientData -marshalflags +NoHandle TrySetAny stream $stream
  $anyClientData -marshalflags +NoHandle TrySetAny keyPairs $keyPairs
  $anyClientData -marshalflags +NoHandle TrySetAny keyPair $publicKey
  $anyClientData TrySetAny keyName someKeyName
  $anyClientData TrySetAny keyRingName someKeyRingName
  $anyClientData TrySetAny hashValue hZizm+0DEDerP73qytKjzXW8Maw=; # WRONG
  $anyClientData TrySetAny signature [base64 encode signature]; # WRONG
  $anyClientData TrySetAny keyUsage NA
  $anyClientData TrySetAny configurationPhase Demand
  $anyClientData TrySetAny trustFlags SecurityPackage
  $anyClientData TrySetAny policyType License
  $anyClientData TrySetAny policy AllowSignedOnly
  $anyClientData TrySetAny timeout 1000
  $anyClientData TrySetAny referenceCount 1
  $anyClientData TrySetAny untrusted true
  $anyClientData TrySetAny allowRemoteUri true
  $anyClientData TrySetAny useContext true
  $anyClientData TrySetAny withCommands true
  $anyClientData TrySetAny removeCommands true
  $anyClientData TrySetAny swapCommands true
  $anyClientData TrySetAny noGlobalOnly true
  $anyClientData TrySetAny allowLocalPolicy true
  $anyClientData TrySetAny extractAndApply true
  $anyClientData TrySetAny failOnError true
  $anyClientData TrySetAny fatalError true

  set error null

  set evaluateClientData [object invoke -flags +NonPublic \
      Licensing.Components.Private.EvaluateClientData CreateFrom \
      "" $plugin something0 $anyClientData error]

  if {![isNonNullObjectHandle $evaluateClientData]} then {
    error [getStringFromObjectHandle $error]
  }

  getStringFromObjectHandle $evaluateClientData
} -cleanup {
  unset -nocomplain plugin refreshEvent object
  unset -nocomplain longList stream publicKey keyPairs
  unset -nocomplain ruleSet anyClientData evaluateClientData
  unset -nocomplain error code result
} -constraints [fixConstraints {eagle file_TestPublic1.snk !harpy.obfuscated\
!harpy.plugin.isolated}] -match regexp -result {^\{data System\.Object\} \{name\
\{some name\}\} \{kind ContextData\} \{id\
10000000-0000-0000-0000-000000000001\} \{group \{some group\}\} \{description\
\{some description\}\} \{contextName harpy-50\.3\} \{refreshEvent\
\{Licensing\.Components\.Private\.SharedEventWaitHandle \{0x[0-9A-F]+\
0x[0-9A-F]+ 0x[0-9A-F]+ 0x[0-9A-F]+\
Licensing\.Components\.Private\.SharedEventWaitHandle 0x[0-9A-F]+\} -?\d+\}\}\
\{sandboxToken \d+\} \{commandTokens \{1 2 3\}\} \{settingsCallback\
Licensing\.Components\.Private\.GetFileNameCallback\} \{ruleSet \{\{id 1 type\
Include kind Command mode Glob patterns o\*\} \{id 2 type Exclude kind Command\
mode Exact patterns open\}\}\} \{interpreter \d+\} \{plugin\
Licensing\.Enterprise\} \{pluginType Licensing\.Enterprise\} \{minimumVersion\
0\.0\.0\.0\} \{maximumVersion 1\.1\.1\.1\} \{variantName something2\}\
\{hashAlgorithmName SHA1\} \{hashKey 0x686173684b6579\} \{encoding utf-8\}\
\{type test\} \{subType fake\} \{directory some/path/to/dir\} \{fileName\
somefile\.eagle\} \{stream System\.IO\.MemoryStream\} \{keyPairs\
\{Licensing\.Interfaces\.Private\.IKeyPair\[\]\}\} \{keyPair 9c6c559394030af1\}\
\{keyName someKeyName\} \{keyRingName someKeyRingName\} \{hashValue\
0x8598b39bed031037ab3fbdeacad2a3cd75bc31ac\} \{signature 0x7369676e6174757265\}\
\{keyUsage NA\} \{configurationPhase Demand\} \{trustFlags \{?(?:None,\
)?(?:Default, )?SecurityPackage\}?\} \{policyType License\} \{policy\
AllowSignedOnly\} \{timeout 1000\} \{referenceCount 1\} \{untrusted True\}\
\{allowRemoteUri True\} \{useContext True\} \{withCommands True\}\
\{removeCommands True\} \{swapCommands True\} \{noGlobalOnly True\}\
\{allowLocalPolicy True\} \{extractAndApply True\} \{failOnError True\}\
\{fatalError True\}$}}

###############################################################################

runTest {test harpy-51.1 {KeyRingOnly usage flag, direct success} -setup {
  if {[haveConstraint compile.ISOLATED_INTERPRETERS]} then {
    set interp [interp create -isolated -nosecurity]
  } else {
    set interp [interp create -nosecurity]
  }

  interp set $interp dataPath $dataPath
  interp set $interp keyRingFile(11) $keyRingFile(11)
  interp set $interp keyRingFile(12) $keyRingFile(12)

  if {[haveConstraint harpy.isolated]} then {
    interp eval $interp {
      package require Eagle.Test

      set savedPluginFlags [enablePluginFlags]
      enablePluginFlags Isolated true
    }
  }

  interp eval $interp {
    package require Harpy.Test

    setupTestModeFiles $dataPath
    setupSkipLicenseFiles $dataPath
  }
} -body {
  set code(1) [catch {interp eval $interp {
    list [source enableSecurity] [enableTestMode true]
  }} result(1)]

  set code(2) [catch {interp eval $interp {
    keyring merge $keyRingFile(11)
  }} result(2)]

  set code(3) [catch {interp eval $interp {
    keyring merge $keyRingFile(12)
  }} result(3)]

  interp eval $interp {enableTestMode false}

  list $code(1) $result(1) $code(2) $result(2) \
      $code(3) $result(3)
} -cleanup {
  if {[haveConstraint harpy.isolated]} then {
    catch {
      interp eval $interp {
        enablePluginFlags $savedPluginFlags
        unset -nocomplain savedPluginFlags
      }
    }
  }

  catch {interp delete $interp}

  unset -nocomplain result code interp
} -constraints {eagle command.keyring file_keyRing11.eagle file_keyRing12.eagle\
command.ksource file_enable_test_mode.eagle file_disable_test_mode.eagle} \
-match regexp -result [appendArgs \
{^0 \{1\.0\.\d+\.\d+ \{Enabled test-mode via TRUSTED configuration file } \" \
[pathToRegexp $enableTestModeFile] \" \
{ \([0-9a-f]{128}\) with a change count of } \
[expr {[haveConstraint compile.ISOLATED_INTERPRETERS] ? "0" : "\\d+"}] \
{\.\}\} 0 \{\} 0 \{\}$}]}

