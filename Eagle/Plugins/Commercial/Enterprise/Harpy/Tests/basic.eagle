###############################################################################

package require Eagle.Library
package require Eagle.Test

runTestPrologue

###############################################################################

unset -nocomplain result

if {[catch {cleanState} result] == 0} then {
  tputs $test_channel [appendArgs \
      "---- state cleanup success: " [formatList $result <none>] \n]
} else {
  tputs $test_channel [appendArgs \
      "---- state cleanup failure: " [formatList $result <none>] \n]
}

unset -nocomplain result

###############################################################################

package require Harpy.Test

###############################################################################

if {![info exists test_timeout_multiplier]} then {
  if {[isMono]} then {
    set test_timeout_multiplier 10; # HACK: Mono even slower?  Why?
  } else {
    set test_timeout_multiplier 4; # HACK: Isolation is slow.
  }

  set setTimeoutMultiplier true
}

###############################################################################

if {![info exists useLocalHost]} then {
  set useLocalHost [haveConstraint configuration.Debug]
  set setUseLocalHost true
}

###############################################################################

if {![info exists package_path]} then {
  set package_path [file dirname [file normalize $path]]
}

if {![info exists package_lib_path]} then {
  set package_lib_path [file join $package_path lib]
}

if {![info exists package_storage_lib_path]} then {
  set package_storage_lib_path [file join $package_lib_path Storage]
}

if {![info exists package_base_path]} then {
  set package_base_path [file dirname \
      [file dirname [file dirname [file dirname $package_path]]]]
}

if {![info exists package_plugins_path]} then {
  set package_plugins_path [file join \
      $package_base_path Plugins Commercial Enterprise]
}

if {![info exists package_key_path]} then {
  set package_key_path $key_path; # TODO: Support multiple?
}

if {![info exists package_tools_path]} then {
  set package_tools_path [file join $package_path Tools]
}

###############################################################################

set trialFile(1) [file join \
    $package_plugins_path Demo NuGet lib trial-certificate.xml]

set trialFile(2) [file join \
    $package_plugins_path Featherlight NuGet lib trial-certificate.xml]

set trialFile(3) [file join \
    $package_plugins_path Harpy NuGet lib trial-certificate.xml]

set trialFile(4) [file join \
    $package_plugins_path HotKey NuGet lib trial-certificate.xml]

set trialFile(5) [file join \
    $package_plugins_path Zeus NuGet lib trial-certificate.xml]

###############################################################################

set signFile(1) [file join $package_tools_path sign.eagle]

###############################################################################

if {![info exists dataPath]} then {
  set dataPath [file join $path data]; # NOTE: Path to Harpy test data.
}

if {![info exists startupPath]} then {
  if {[info exists ::env(XDG_STARTUP_HOME)]} then {
    set startupPath $::env(XDG_STARTUP_HOME); # NOTE: Path to user startup.
  } else {
    set startupPath $dataPath
  }
}

if {![info exists shellsPath]} then {
  if {[info exists ::env(XDG_SHELLS_DIR)]} then {
    set shellsPath $::env(XDG_SHELLS_DIR); # NOTE: Path to user shells.
  } else {
    set shellsPath $dataPath
  }
}

