-result {^Licensing#Components#Public#Certificate#\d+$}}

###############################################################################

runTest {test harpy-44.1 {certificate signhash / verifyhash} -setup {
  package require Licensing.Enterprise
} -body {
  set results [list]

  set publicKey [keypair open -alias -public $testKeyFile(2)]
  set privateKey [keypair open -alias -public -private $testKeyFile(1)]

  set fileName(1) [file join \
      [getTemporaryPath] [appendArgs keyRing.harpy-44_1_ [pid] \
      .eagle]]

  set fileName(2) [appendArgs $fileName(1) .b64sig]; # COMPAT: Eagle.
  set data(0) ""

  if {[haveConstraint memoryIntensive]} then {
    #
    # NOTE: Normally, fallback to legacy default number of iterations
    #       for this test.
    #
    set count [expr {int($test_stress_count / 10)}]; # e.g. 1000
  } else {
    #
    # HACK: When running this test on a (relatively) low-memory system,
    #       cut back on the number of iterations in order to limit the
    #       memory usage of [append].
    #
    set count [expr {int($test_stress_count / 100)}]; # e.g. 100
  }

  for {set i 0} {$i < $count} {incr i} {
    append data(0) \n
    append data(0) {
      if {![info exists x]} then {set x [expr {random()}]}
      if {![info exists y]} then {set y [expr {random()}]}
      if {![info exists z]} then {set z [expr {wide(0)}]}
      switch -exact -- [expr {abs(random() % 8)}] {
        0 {incr z [expr {$x + $y}]}
        1 {incr z [expr {$x - $y}]}
        2 {incr z [expr {$x * $y}]}
        3 {if {$y == 0} then continue; incr z [expr {$x / $y}]}
        4 {if {$y == 0} then continue; incr z [expr {$x % $y}]}
        5 {incr z [expr {$x & $y}]}
        6 {incr z [expr {$x | $y}]}
        7 {incr z [expr {$x ^ $y}]}
        default {error "you cannot do that"}
      }
    }
  }

  append data(0) \n {return $z}
  writeFile $fileName(1) $data(0)

  set data(1) [object invoke \
      -create System.IO.File ReadAllBytes $fileName(1)]

  set error(1) null

  set hashValue(1) [object invoke \
      -create Utility HashBytes null $data(1) error(1)]

  if {![isNonNullObjectHandle $hashValue(1)]} then {
    error [getStringFromObjectHandle $error(1)]
  }

  set signature(1) [certificate signhash -create $privateKey $data(1)]

  if {[isDotNetCore]} then {
    writeFile $fileName(2) \
        [appendArgs [object invoke Convert ToBase64String \
        $signature(1) InsertLineBreaks] \r\n]
  } else {
    object invoke System.IO.File WriteAllText $fileName(2) \
        [appendArgs [object invoke Convert ToBase64String \
        $signature(1) InsertLineBreaks] \r\n]
  }

  set data(2) [object invoke \
      -create System.IO.File ReadAllBytes $fileName(1)]

  if {[isDotNetCore]} then {
    set signature(2) [object invoke -create Convert FromBase64String \
        [readFile $fileName(2)]]
  } else {
    set signature(2) [object invoke -create Convert FromBase64String \
        [object invoke -create System.IO.File ReadAllText $fileName(2)]]
  }

  lappend results [certificate verifyhash $publicKey $data(2) $signature(2)]

  if {[haveConstraint harpy.isolated] || \
      [haveConstraint harpy.obfuscated]} then {
    if {[catch {
      certificate source -keyusage "" $publicKey $fileName(1)
    } result] in [list 0 2]} then {
      lappend results Ok [format %016lX $result]
    } else {
      lappend results Error $result
    }
  } else {
    set array [object invoke -alias Array CreateInstance \
        Licensing.Interfaces.Private.IKeyPair 1]

    $array SetValue $publicKey 0

    set encoding [object invoke Interpreter DefaultEncoding]

    set clientData [object create \
        Licensing.Components.Private.EvaluateClientData \
        null null null [guid null] null null null null null \
        null null null "" null null null null null SHA512 \
        null $encoding null null null $fileName(1) null \
        $array null null null $hashValue(1) $signature(2) \
        null Demand {MaybeMarkTrusted PushScriptLocation} \
        null null null 0 false false false false false \
        false false false false false false]

    set result null

    set code [object invoke -flags +NonPublic \
        Licensing.Components.Private.CertificateScriptOps \
        EvaluateFile $clientData result]

    if {$code in [list Ok Return]} then {
      lappend results Ok [format %016lX \
          [getStringFromObjectHandle $result]]
    } else {
      lappend results Error \
          [getStringFromObjectHandle $result]
    }
  }

  set results
} -cleanup {
  catch {file delete -force $fileName(2)}
  catch {file delete -force $fileName(1)}

  unset -nocomplain i x y z count
  unset -nocomplain array result encoding clientData code results error
  unset -nocomplain publicKey privateKey fileName data hashValue signature
} -constraints [fixMemoryConstraints {eagle command.certificate command.keypair\
file_TestPublic1.snk file_TestPrivate1.snk}] -match regexp -result {^VerifiedOk\
Ok [0-9A-F]{16}$}}

