  rawPutsAndLog [appendArgs \
      "---- queried machine information: " $machine \n]

  set interp [interp create -nosecurity -nopluginpolicies]
} -body {
  set fileName(1) [file join \
      [getTemporaryPath] [appendArgs keyRing.harpy-5_19_ [pid] \
      .eagle]]

  set fileName(2) [appendArgs $fileName(1) .harpy]

  writeFile $fileName(1) [string map [list \
      00000000-0000-0000-0000-000000000000 [getDictionaryValue \
      $machine id]] [readFile $keyRingFile(8)]]

  interp set $interp argv [list \
      $fileName(1) "Mistachkin Systems" 0 -1 KeyRing null \
      $publicKeyFile(2) $privateKeyFile(2)]

  interp source $interp $signFile(1)

  keyring merge $fileName(1)

  list [catch {source $testScriptFile(11)} error] $error
} -cleanup {
  unset -nocomplain error
  catch {rename helloWorld ""}

  catch {file delete -force $fileName(2)}
  catch {file delete -force $fileName(1)}
  catch {interp delete $interp}

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  restoreKeyRingName savedKeyRingName

  restoreKeyName savedKeyName

  unset -nocomplain machine fileName interp
} -constraints [fixSnkConstraints {eagle command.certificate command.harpy\
command.keyring file_sign.eagle file_keyRing8.eagle file_secureTest11.eagle\
$publicKeyFile(2) $privateKeyFile(2)}] -output \
