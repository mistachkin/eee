runTest {test harpy-5.17 {direct IScript evaluation w/o file success} -setup {
  package require Licensing.Enterprise

  saveKeyName savedKeyName; resetKeyName
  setKeyName $testKeyName(5)

  saveKeyRingName savedKeyRingName; resetKeyRingName

  savePolicy savedPolicy; resetPolicy
  certificate policy -file $testPolicy(4) -script $testPolicy(4)

  saveKeyRing savedKeyRing; resetKeyRing
} -body {
  set xml [readFile $testScriptFile(22)]

  set clientData null; set scripts null; set text null; set error null

  set code [object invoke Eagle._Tests.Default TestReadScriptXml \
      "" null $xml clientData scripts text error]

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  if {![isNonNullObjectHandle $scripts]} then {
    error [appendArgs \
        "missing scripts from XML file \"" $testScriptFile(22) \"]
  }

  object foreach -alias script $scripts {
    set result null
    set code [object invoke Engine EvaluateScript "" $script result]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $result]
    }
  }
} -cleanup {
  catch {rename helloWorld ""}

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  restoreKeyRingName savedKeyRingName

  restoreKeyName savedKeyName

  unset -nocomplain xml text clientData error code scripts script result
} -constraints {eagle command.certificate command.keyring compile.TEST\
compile.XML Eagle._Tests.Default.TestReadScriptXml file_secureTest.xml} \
-output \
[subst {Hello World - Secure XML Script Test
}] -result {}}

