  set certificate [certificate import -alias -validate $importFile]

  $certificate Id f2de70a4-78bb-4a8b-a42b-31b285502c5e
  $certificate Authority null
  $certificate Origin null
  $certificate Restrictions R

  list [harpy failsafetrip] [catch {
    certificate revoked -forcenetwork -nocache -failsafe -whatif $certificate
  } error] $error [harpy failsafetrip]
} -cleanup {
