    [info body configurationReport]
  }

  set infoScriptFile {$infoScriptFile}
  set infoScriptImportFile {$infoScriptImportFile}

  saveEnvironmentVariables \[list \
      ConfigurationFileName0 ConfigurationScriptText0 \
      ConfigurationSignatureText0 ConfigurationEnvironmentOnly \
      NoLicensingPackageUnknown\]
}] -body {
  set env(ConfigurationFileName0) [file tail $infoScriptFile]
  set env(ConfigurationScriptText0) [readFile $infoScriptFile]
  set env(ConfigurationSignatureText0) [readFile $infoScriptImportFile]
  set env(ConfigurationEnvironmentOnly) 1
  set env(NoLicensingPackageUnknown) 1

  set code(1) [catch {
    package require Licensing.Enterprise
  } result(1)]

  set code(2) [catch {
    harpy configurations {+Global WithOkResults WithErrorResults}
  } result(2)]

  set code(3) [catch {
    harpy configurations
  } result(3)]

  list $code(1) $result(1) [configurationReport [expr \
      {$code(2) == 0 ? $result(2) : [list]}]] [noContextVariables] \
      $code(3) $result(3)
} -cleanup {
  restoreEnvironmentVariables [list \
      ConfigurationFileName0 ConfigurationScriptText0 \
      ConfigurationSignatureText0 ConfigurationEnvironmentOnly \
      NoLicensingPackageUnknown]

  unset -nocomplain code result
