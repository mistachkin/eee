compile.NETWORK internet_eagle.to tlsOk compile.XML !harpy.plugin.isolated\
command.harpy !harpy.obfuscated file_template.xml file_enable_test_mode.eagle\
file_disable_test_mode.eagle}] -result {False 1 {unique identifier\
"f2de70a4-78bb-4a8b-a42b-31b285502c5e" is revoked as of "<always>"} True}}

