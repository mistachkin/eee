runTest {test harpy-23.1 {certificate extract sub-command} -setup {
  package require Licensing.Enterprise
} -body {
  set certificate [certificate extract \
      -alias -validate -textvar text $testScriptFile(4)]

  list [$certificate Protocol] [$certificate Vendor] \
      [$certificate EntityType] [$certificate HashAlgorithm] \
      [getStringFromObjectHandle \
          [set a [$certificate -create -alias Duration]]] \
      [getStringFromObjectHandle \
          [set b [$certificate -create -alias Id]]] \
      [certificate formattimestamp \
          [set c [$certificate -create -alias TimeStamp]] true] \
      [string tolower [hash normal sha1 $text]]
} -cleanup {
  unset -nocomplain certificate a b c text
} -constraints [fixConstraints {eagle command.certificate compile.XML\
!harpy.plugin.isolated file_secureTest4.eagle}] -result {None {Mistachkin\
Systems} Script SHA512 -1.00:00:00 b5ba823b-266f-4d11-aedd-f985ffdb28c6\
2016-05-26T06:59:05.3496093Z c7b58d06ee56a4c8ca29917741513c3494d8b1c7}}

