  package require Licensing.Enterprise

  set fileName [file join \
      [getTemporaryPath] [appendArgs harpy-12_9_ [pid] .dsasnk]]

  catch {file delete -force $fileName}
} -body {
  #
  # HACK: In isolated mode, we cannot use the KeyPairType enumeration
  #       directly.
  #
  if {[haveConstraint harpy.isolated]} then {
    set DSA 0x200
    set DsaStrongName 0x210
  } else {
    set DSA DSA
    set DsaStrongName DsaStrongName
  }

  set testKey(1) [keypair open \
      -public -private -keypairtype $DSA $testKeyFile(18)]

  keypair save -public -keypairtype $DSA -keyfileformat \
      $DsaStrongName $fileName $testKey(1)

  set testKey(2) [keypair open \
      -public -private -keypairtype $DSA $fileName]

  list [keypair metadata $testKey(2) SignatureAlgorithmId] \
      [keypair metadata $testKey(2) HashAlgorithmId] \
      [keypair metadata $testKey(2) ByteCount] \
      [keypair metadata $testKey(2) Type] \
      [keypair metadata $testKey(2) Version] \
      [keypair metadata $testKey(2) Reserved] \
      [keypair metadata $testKey(2) Algorithm] \
      [keypair metadata $testKey(2) Magic] \
      [keypair metadata $testKey(2) BitLength] \
      [keypair metadata $testKey(2) P] \
      [keypair metadata $testKey(2) Q] \
      [keypair metadata $testKey(2) G] \
      [keypair metadata $testKey(2) Y] \
      [keypair metadata $testKey(2) X] \
      [keypair metadata $testKey(2) Counter] \
      [keypair metadata $testKey(2) Seed] \
      [keypair metadata $testKey(2) Salt] \
      [keypair metadata $testKey(2) KeyPairType] \
      [keypair metadata $testKey(2) KeyFileFormat] \
      [keypair metadata $testKey(2) PublicKeyToken] \
      [keypair metadata $testKey(2) HavePublicKey] \
      [keypair metadata $testKey(2) HavePrivateKey] \
      [keypair metadata $testKey(2) KeyUsage] \
      [keypair metadata $testKey(2) KeyExpiration] \
      [keypair metadata $testKey(2) KeyDomains] \
      [keypair metadata $testKey(2) KeyGroups] \
      [list [file normalize [keypair metadata \
          $testKey(2) FileName]]] \
      [keypair metadata $testKey(2) Parent]
} -cleanup {
  catch {file delete -force $fileName}

  unset -nocomplain fileName testKey DsaStrongName DSA
} -constraints {eagle command.keypair file_TestPublic1.dsasnk} -match regexp \
 -result {^8704 32772 144 6 2 0 8704 827544388 1024 \{208 53 63 56 167 23 144\
243 100 213 43 14 146 13 130 47 20 66 0 234 207 159 241 200 252 152 233 74 145\
89 246 214 119 172 213 179 35 252 95 34 0 34 63 173 50 94 210 70 140 243 150 24\
172 37 175 128 45 38 34 169 193 90 92 26 37 131 191 198 83 99 83 196 170 20 173\
77 40 79 98 110 63 104 120 233 159 69 199 138 51 247 147 3 223 176 250 81 234\
43 198 186 37 91 222 121 51 60 180 151 54 125 183 119 130 137 228 25 160 88 32\
64 235 174 117 22 205 134 234 67\} \{140 15 138 108 214 60 131 98 10 78 117 193\
134 87 222 189 126 58 21 229\} \{30 1 143 226 16 38 188 0 14 9 214 37 164 78 7\
140 215 147 175 79 25 125 252 87 33 62 63 60 31 247 191 242 145 67 192 153 234\
166 101 222 83 220 27 193 134 104 127 170 150 176 34 87 225 133 19 33 0 112 118\
201 209 69 163 0 195 111 202 193 104 111 243 181 184 55 205 53 26 161 149 252\
78 213 24 58 66 89 108 22 131 18 74 145 147 130 130 74 159 42 102 190 12 245\
132 200 205 53 147 136 140 107 53 129 136 225 222 84 15 134 158 247 197 232 16\
158 104 225 244 55\} \{26 241 244 131 129 144 84 155 10 228 141 197 59 35 235\
166 73 23 6 110 242 186 143 9 174 36 254 110 120 42 183 220 89 214 176 245 180\
63 39 189 196 66 248 188 23 176 159 5 223 156 199 111 209 205 224 146 213 0 216\
79 169 163 211 107 224 155 76 107 226 239 114 233 69 222 156 124 233 78 60 115\
49 134 97 90 229 61 68 207 130 117 148 63 37 210 128 209 56 59 21 223 66 73 32\
223 92 175 86 232 104 60 9 172 209 63 5 48 75 135 224 194 249 34 211 213 51 167\
212 250\} \{\} 38 \{51 108 246 203 126 169 241 226 135 212 211 185 34 239 207\
46 202 119 188 102\} \{\} DSA DsaStrongName \{157 113 143 185 63 203 35 42\}\
True False \{\} \{\} \{\} \{\} (?:\{)?.+?[/\\]harpy-12_9_\d+\.dsasnk(?:\})?\
\{\}$}}

###############################################################################

runTest {test harpy-12.10 {keypair metadata list sub-command (DSA)} -setup {
  package require Licensing.Enterprise
} -body {
  #
  # HACK: In isolated mode, we cannot use the KeyPairType enumeration
  #       directly.
  #
  if {[haveConstraint harpy.isolated]} then {
    set DSA 0x200
  } else {
    set DSA DSA
  }

  lsort [keypair metadata -keypairtype $DSA]
} -cleanup {
  unset -nocomplain DSA
} -constraints {eagle command.keypair} -result {Algorithm BitLength ByteCount\
Counter FileName G HashAlgorithmId HavePrivateKey HavePublicKey KeyDomains\
KeyExpiration KeyFileFormat KeyGroups KeyPairType KeyUsage Magic P Parent\
PublicKeyToken Q Reserved Salt Seed SignatureAlgorithmId Type Version X Y}}

###############################################################################

runTest {test harpy-13.1 {NTP time server success} -setup {
  package require Licensing.Enterprise

  saveEnvironmentVariables [list PrimaryNetworkTime]
} -body {
  set env(PrimaryNetworkTime) 1

  set code [catch {certificate time -refresh} result]

  showLocalTimeDifference NTP $code $result

  list $code $result
} -cleanup {
  restoreEnvironmentVariables [list PrimaryNetworkTime]

  unset -nocomplain result code
} -constraints [fixConstraints {eagle command.certificate compile.NETWORK\
!offlineMode network_time.mistachkin.net}] -match regexp -result \
{^0 \{Utc -?\d+\}$}}

###############################################################################

runTest {test harpy-13.2 {NTP time server failure} -setup {
  package require Licensing.Enterprise
} -body {
  set code [catch {certificate time} result]

  showLocalTimeDifference NTP $code $result

  list $code $result
} -cleanup {
  unset -nocomplain result code
} -constraints [fixConstraints {eagle command.certificate compile.NETWORK\
!offlineMode network_time.mistachkin.net}] -result {1 {time query is too fast}}}

###############################################################################

runTest {test harpy-13.3 {HTTP time server success} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  certificate policy -enabled true

  saveKeyRing savedKeyRing; resetKeyRing

  saveEnvironmentVariables [list PrimaryNetworkTime]
} -body {
  set env(PrimaryNetworkTime) 1

  keyring merge $keyRingFile(7)

  set code [catch {
    certificate time -refresh -viahttp true -signed -- EagleDemoPublic.snk
  } result]

  showLocalTimeDifference HTTP $code $result

  list $code $result
} -cleanup {
  restoreEnvironmentVariables [list PrimaryNetworkTime]

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  unset -nocomplain result code
} -constraints {eagle command.certificate command.keyring compile.NETWORK\
file_keyRing7.eagle harpy.timeServer network_urn.to tlsOk} -match regexp \
-result {^0 \{Utc -?\d+\}$}}

###############################################################################

runTest {test harpy-13.4 {HTTP time server failure} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  certificate policy -enabled true

  saveKeyRing savedKeyRing; resetKeyRing

  saveEnvironmentVariables [list PrimaryNetworkTime]
} -body {
  set env(PrimaryNetworkTime) 1

  keyring merge $keyRingFile(7)

  set code [catch {
    certificate time -viahttp true -signed -- EagleDemoPublic.snk
    certificate time -viahttp true -signed -- EagleDemoPublic.snk
  } result]

  showLocalTimeDifference HTTP $code $result

  list $code $result
} -cleanup {
  restoreEnvironmentVariables [list PrimaryNetworkTime]

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  unset -nocomplain result code
} -constraints {eagle command.certificate command.keyring compile.NETWORK\
file_keyRing7.eagle harpy.timeServer network_urn.to tlsOk} -result \
{1 {time query is too fast}}}

###############################################################################

runTest {test harpy-14.1 {certificate environment variable names} -setup {
  package require Licensing.Enterprise
} -body {
  set assembly [object invoke -alias -flags +NonPublic \
      Licensing.Components.Private.CertificateAssemblyOps \
      object]

  set assemblyName [$assembly GetName]

  set pluginData [object invoke -flags +NonPublic \
      Interpreter.GetActive GetPluginData [lindex [lindex [info \
      loaded "" "* \{Licensing.Enterprise, *\}"] 0] end]]

  set overrideEnvVarNames null
  set envVarNames null

  object invoke -flags +NonPublic \
      Licensing.Components.Private.CertificatePathOps \
      GetEnvVarNames $assemblyName $pluginData overrideEnvVarNames \
      envVarNames

  list $overrideEnvVarNames $envVarNames
} -cleanup {
  unset -nocomplain envVarNames overrideEnvVarNames pluginData assemblyName \
      assembly
} -constraints [fixConstraints {eagle !harpy.plugin.isolated\
!harpy.obfuscated}] -result \
{{Override_Harpy_Licensing.Enterprise_Certificate\
Override_Licensing.Enterprise_Certificate\
Override_Harpy_Enterprise_Certificate\
Override_Enterprise_Certificate\
Override_Harpy_Certificate\
Override_Eagle_Certificate\
Override_Certificate}\
{Harpy_Licensing.Enterprise_Certificate\
Licensing.Enterprise_Certificate\
Harpy_Enterprise_Certificate\
Enterprise_Certificate\
Harpy_Certificate\
Eagle_Certificate\
Certificate}}}

###############################################################################

runTest {test harpy-14.2 {certificate file names} -setup {
  package require Licensing.Enterprise
} -body {
  set assembly [object invoke -alias -flags +NonPublic \
      Licensing.Components.Private.CertificateAssemblyOps \
      object]

  set pluginData [object invoke -alias -flags +NonPublic \
      Interpreter.GetActive GetPluginData [lindex [lindex [info \
      loaded "" "* \{Licensing.Enterprise, *\}"] 0] end]]

  set assemblyName null

  if {[isNonNullObjectHandle $pluginData]} then {
    if {[object invoke -flags +NonPublic \
        Licensing.Components.Private.CertificateSharedOps \
        IsCrossAppDomain "" $pluginData]} then {
      set assemblyName [$pluginData AssemblyName]
    }
  }

  if {![isNonNullObjectHandle $assemblyName] && \
      [isNonNullObjectHandle $assembly]} then {
    set assemblyName [$assembly GetName]
  }

  saveCertificateEnvironment
  saveLicenseEnvironment true

  resetCertificateEnvironment
  resetLicenseEnvironment true

  set directories [object invoke -flags +NonPublic \
      Licensing.Components.Private.CertificatePathOps \
      GetDirectories [file dirname [info script]] \
      $assemblyName $assembly false]

  set code Error
  set fileNames null
  set error null

  set code [object invoke -flags +NonPublic \
      Licensing.Components.Private.CertificatePathOps \
      GetFileNames "" $assembly $pluginData null None \
      License false false false false fileNames error]

  if {$code eq "Ok"} then {
    # writeFile harpy-14.2-[clock seconds]-dirs.txt [join $directories \r\n]
    # writeFile harpy-14.2-[clock seconds]-files.txt [join $fileNames \r\n]

    set fileNames [string map [list \
        [file nativename $path] TEST_PATH \
        [file nativename $base_path] BASE_PATH \
        \\ /] $fileNames]

    set configuration [appendArgs \
        $eagle_platform(configuration) [getConfigurationSuffix]]

    set fileNames [string map [list \
        [file join bin $configuration bin] BIN \
        [file join bin $configuration lib] LIB] \
        $fileNames]

    set save_path [file normalize [object invoke -flags +NonPublic \
        Licensing.Components.Private.CertificatePathOps \
        GetSaveDirectory]]

    if {[string length $save_path] > 0} then {
      set fileNames [string map [list [appendArgs \
          $save_path /] SAVE_PATH/] $fileNames]
    }

    set core_dnc_name [getDotNetCoreDirectoryNameOnly \
        [file dirname [lindex [info assembly] end]]]

    if {[string length $core_dnc_name] > 0} then {
      set fileNames [string map [list [appendArgs \
          $core_dnc_name /] ""] $fileNames]
    }

    set fileNames [string map [list \{ "" \} ""] $fileNames]
  }

  list $code $fileNames [getStringFromObjectHandle $error]
} -cleanup {
  restoreCertificateEnvironment
  restoreLicenseEnvironment true

  unset -nocomplain configuration code error core_dnc_name fileNames \
      directories pluginData assemblyName assembly save_path
} -constraints [fixConstraints {eagle !harpy.plugin.isolated\
!harpy.obfuscated harpy_base_path}] -result [list Ok [appendArgs \
SAVE_PATH/Certificates/License/Licensing.Enterprise.certificate.xml " " \
SAVE_PATH/Certificates/Licensing.Enterprise.certificate.xml " " \
SAVE_PATH/License/Licensing.Enterprise.certificate.xml " " \
