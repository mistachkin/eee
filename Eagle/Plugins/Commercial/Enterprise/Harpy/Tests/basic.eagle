###############################################################################

if {[isEagle] && [haveConstraint command.harpy]} then {
  set savedFeatures [harpy features]
  resetFeatures -*; # NOTE: Remove all features.
} else {
  set savedFeatures ""
}

###############################################################################

#
# WARNING: This test requires AppDomain isolation because it modifies static
#          global state related to policy settings.  Without isolation, this
#          will cause subsequent tests to fail.
#
# HACK: Due to (possible) implicit use of HTTPS, this test requires the
#       "tlsOk" constraint.
#
runTest {test harpy-52.1 {configuration state handling} -setup [subst {
  package require Eagle.Test
  package require Licensing.Enterprise
  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  set enableSupportFile {$enableSupportFile}
  set disableSupportFile {$disableSupportFile}

  saveKeyRing savedKeyRing License

  saveEnvironmentVariables \[list \
      NoLoadLicenseKeyRings NoLicensingPackageUnknown\]

  certificate reset =GlobalConfiguration
}] -body {
  set env(NoLoadLicenseKeyRings) 1
  set env(NoLicensingPackageUnknown) 1

  set code(1) [catch {
    keyring clear License

    set fileName test7.xml

    ksource -withcommands -useshared -useplugin -usecontext -- \
        $enableSupportFile

    harpy features
  } result(1)]

  set code(2) [catch {
    ksource -withcommands -useshared -useplugin -usecontext -- \
        $disableSupportFile

    harpy features
  } result(2)]

  set code(3) [catch {
    list [harpy changed true] \
        [harpy changed true false] [harpy changed true true]
  } result(3)]

  noContextVariables

  list $code(1) $result(1) $code(2) $result(2) \
      $code(3) $result(3)
} -cleanup {
  catch {certificate reset =GlobalConfiguration}

  restoreEnvironmentVariables [list \
      NoLoadLicenseKeyRings NoLicensingPackageUnknown]

  restoreKeyRing savedKeyRing License

  unset -nocomplain code result fileName
} -constraints {eagle command.certificate command.harpy command.keyring\
command.ksource file_enable_support.eagle file_disable_support.eagle\
file_test7.xml tlsOk harpy.timeServer harpy.certificateRequestServer\
kapok.server} -isolationLevel Maximum -noSecurity true -result \
{0 S 0 {} 0 {pluginTestMode pluginTestMode pluginTestMode}}}

###############################################################################

#
# HACK: Due to (possible) implicit use of HTTPS, this test requires the
#       "tlsOk" constraint.
#
runTest {test harpy-52.2 {configuration state handling} -setup {
  package require Eagle.Test
  package require Licensing.Enterprise
  package require Harpy.Test

  saveKeyRing savedKeyRing License

  saveEnvironmentVariables [list \
      NoLoadLicenseKeyRings NoLicensingPackageUnknown]

  certificate reset =GlobalConfiguration
} -body {
  set env(NoLoadLicenseKeyRings) 1
  set env(NoLicensingPackageUnknown) 1

  set code(1) [catch {
    keyring clear License

    set fileName test7.xml

    ksource -withcommands -useshared -useplugin -usecontext -local -- \
        $enableSupportFile

    harpy features
  } result(1)]

  set code(2) [catch {
    ksource -withcommands -useshared -useplugin -usecontext -local -- \
        $disableSupportFile

    harpy features
  } result(2)]

  set code(3) [catch {
    list [harpy changed true] \
        [harpy changed true false] [harpy changed true true]
  } result(3)]

  noContextVariables

  list $code(1) $result(1) $code(2) $result(2) \
      $code(3) $result(3)
} -cleanup {
  catch {certificate reset =GlobalConfiguration}

  restoreEnvironmentVariables [list \
      NoLoadLicenseKeyRings NoLicensingPackageUnknown]

  restoreKeyRing savedKeyRing License

  unset -nocomplain code result fileName
} -constraints {eagle command.certificate command.harpy command.keyring\
command.ksource tlsOk harpy.timeServer harpy.certificateRequestServer\
kapok.server file_enable_support.eagle file_disable_support.eagle\
file_test7.xml} -result \
{0 S 0 {} 0 {pluginTestMode pluginTestMode pluginTestMode}}}

###############################################################################

if {[info exists savedFeatures]} then {
  resetFeatures [appendArgs = $savedFeatures]
  unset -nocomplain savedFeatures
}

###############################################################################

restoreConfiguration $test_channel
enableConfiguration $test_channel true

###############################################################################

configurationReset

###############################################################################

#
# HACK: Due to (possible) implicit use of HTTPS, this test requires the
#       "tlsOk" constraint.
#
runTest {test harpy-53.1 {configuration script queue} -setup [subst {
  if {!\[info exists test_channel\]} then {
    set test_channel {$test_channel}
  }

  if {\[catch {package present Eagle.Test}\]} then {
    package require Eagle.Test
  }

  if {!\[info exists test_log\]} then {
    set test_log {$test_log_if}
  }

  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  proc configurationReport {[info args configurationReport]} {
    [info body configurationReport]
  }

  set enableSupportFile {$enableSupportFile}

  saveEnvironmentVariables \[list \
      ConfigurationFileNames NoLicensingPackageUnknown\]
}] -body {
  set env(NoLicensingPackageUnknown) 1

  unset -nocomplain env(ConfigurationFileNames)
  lappend env(ConfigurationFileNames) $enableSupportFile

  set fileName test7.xml

  package require Licensing.Enterprise

  noContextVariables

  configurationReport [harpy configurations \
      {+Global WithOkResults WithErrorResults}]

  expr {[lsearch -exact -- \
      [getDictionaryValue [harpy configurations] Ok] \
      harpy_config_01.eagle] != -1}
} -cleanup {
  unset -nocomplain fileName

  restoreEnvironmentVariables [list \
      ConfigurationFileNames NoLicensingPackageUnknown]
} -constraints {eagle command.harpy tlsOk harpy.timeServer\
harpy.certificateRequestServer kapok.server file_enable_support.eagle\
file_test7.xml} -isolationLevel Maximum -noSecurity true -result {True}}

###############################################################################

configurationReset

###############################################################################

runTest {test harpy-53.2 {requireVersion reset per file} -setup [subst {
  if {!\[info exists test_channel\]} then {
    set test_channel {$test_channel}
  }

  if {\[catch {package present Eagle.Test}\]} then {
    package require Eagle.Test
  }

  if {!\[info exists test_log\]} then {
    set test_log {$test_log_if}
  }

  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  proc configurationReport {[info args configurationReport]} {
    [info body configurationReport]
  }

  set fatalErrorFile {$fatalErrorFile}
  set matchPlatformFile {$matchPlatformFile}

  saveEnvironmentVariables \[list \
      ConfigurationFileNames ConfigurationOverrideOnly \
      NoLicensingPackageUnknown\]
}] -body {
  set env(ConfigurationOverrideOnly) 1
  set env(NoLicensingPackageUnknown) 1

  unset -nocomplain env(ConfigurationFileNames)
  lappend env(ConfigurationFileNames) $fatalErrorFile
  lappend env(ConfigurationFileNames) $matchPlatformFile

  package require Licensing.Enterprise

  noContextVariables

  configurationReport [harpy configurations \
      {+Global WithOkResults WithErrorResults}]

  set configurations [getDictionaryValue [harpy configurations] Ok]

  list [expr {
    [lsearch -exact -- $configurations $fatalErrorFile] != -1
  }] [expr {
    [lsearch -exact -- $configurations $matchPlatformFile] != -1
  }]
} -cleanup {
  unset -nocomplain configurations

  restoreEnvironmentVariables [list \
      ConfigurationFileNames ConfigurationOverrideOnly \
      NoLicensingPackageUnknown]
} -constraints \
{eagle command.harpy file_fatal_error.eagle file_match_platform.eagle} \
-isolationLevel Maximum -noSecurity true -result {True True}}

###############################################################################

configurationReset

###############################################################################

runTest {test harpy-53.3 {configuration file(s) load stress} -setup [subst {
  if {!\[info exists test_channel\]} then {
    set test_channel {$test_channel}
  }

  if {\[catch {package present Eagle.Test}\]} then {
    package require Eagle.Test
  }

  if {!\[info exists test_log\]} then {
    set test_log {$test_log_if}
  }

  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  proc configurationReport {[info args configurationReport]} {
    [info body configurationReport]
  }

  set plugin_path {$plugin_path}

  saveEnvironmentVariables \[list \
      ConfigurationFileNames ConfigurationFailOnError \
      ConfigurationSkipEmbedded NoLicensingPackageUnknown\]
}] -body {
  set env(ConfigurationFailOnError) 1
  set env(ConfigurationSkipEmbedded) 1
  set env(NoLicensingPackageUnknown) 1

  set configuration_path [file join \
      [file dirname $plugin_path] Configurations]

  set fileNames [list]

  eval lappend fileNames [glob -nocomplain \
      [file join $configuration_path *.eagle]]

  eval lappend fileNames [glob -nocomplain \
      [file join $configuration_path *.eeagle]]

  unset -nocomplain env(ConfigurationFileNames)
  eval lappend env(ConfigurationFileNames) $fileNames

  package require Licensing.Enterprise

  noContextVariables

  configurationReport [harpy configurations \
      {+Global WithOkResults WithErrorResults}]
} -cleanup {
  unset -nocomplain fileNames configuration_path

  restoreEnvironmentVariables [list \
      ConfigurationFileNames ConfigurationFailOnError \
      ConfigurationSkipEmbedded NoLicensingPackageUnknown]
} -constraints {eagle command.harpy} -isolationLevel Maximum -noSecurity true \
-result {}}

###############################################################################

configurationReset

###############################################################################

runTest {test harpy-53.4 {reconfigure sub-command} -setup [subst {
  if {!\[info exists test_channel\]} then {
    set test_channel {$test_channel}
  }

  if {\[catch {package present Eagle.Test}\]} then {
    package require Eagle.Test
  }

  if {!\[info exists test_log\]} then {
    set test_log {$test_log_if}
  }

  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  proc configurationReport {[info args configurationReport]} {
    [info body configurationReport]
  }

  saveEnvironmentVariables \[list NoLicensingPackageUnknown\]
}] -body {
  set env(NoLicensingPackageUnknown) 1

  package require Licensing.Enterprise

  noContextVariables

  configurationReport [harpy configurations \
      {+Global WithOkResults WithErrorResults}]

  harpy reconfigure

  noContextVariables

  configurationReport [harpy configurations \
      {+Global WithOkResults WithErrorResults}]
} -cleanup {
  restoreEnvironmentVariables [list NoLicensingPackageUnknown]
} -constraints {eagle command.harpy} -isolationLevel Maximum -noSecurity true \
-result {}}

###############################################################################

configurationReset

###############################################################################

unset -nocomplain test_log_if

###############################################################################

runTest {test harpy-54.1 {special configuration commands} -setup {
  package require Licensing.Enterprise
} -body {
  set code(1) [catch {
    unset -nocomplain fatal_error

    ksource -withcommands -useshared -useplugin -usecontext -- \
        $fatalErrorFile
  } result(1)]

  set code(2) [catch {
    set fatal_error "this error will stop things."

    ksource -withcommands -useshared -useplugin -usecontext -- \
        $fatalErrorFile
  } result(2)]

  noContextVariables

  list $code(1) $result(1) $code(2) $result(2)
} -cleanup {
  unset -nocomplain fatal_error code result
} -constraints {eagle command.ksource file_fatal_error.eagle} -result \
{0 getKnownBuildTypes 1 {this error will stop things.}}}

###############################################################################

runTest {test harpy-54.2 {fatal configuration error} -setup [subst {
  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  set fatalErrorFile {$fatalErrorFile}
  set enableSupportFile {$enableSupportFile}

  saveEnvironmentVariables \[list \
      ConfigurationFileNames NoLicensingPackageUnknown\]
}] -body {
  set env(NoLicensingPackageUnknown) 1

  unset -nocomplain env(ConfigurationFileNames)
  lappend env(ConfigurationFileNames) $fatalErrorFile
  lappend env(ConfigurationFileNames) $enableSupportFile

  set code [catch {
    set fatal_error "this error will stop things."
    package require Licensing.Enterprise
  } result]

  noContextVariables

  list $code \
      [expr {[string first $fatalErrorFile $result] != -1}] \
      [expr {[string first $fatal_error $result] != -1}] \
      [expr {[string first $enableSupportFile $result] != -1}]
} -cleanup {
  restoreEnvironmentVariables [list \
      ConfigurationFileNames NoLicensingPackageUnknown]

  unset -nocomplain fatal_error code result fileName
} -constraints {eagle command.ksource file_enable_support.eagle\
file_fatal_error.eagle} -isolationLevel Maximum -noSecurity true -result \
{1 True True False}}

###############################################################################

#
# HACK: *SPECIAL* This test can only pass when the DEMO_KEY_PAIRS -OR-
#       DEMO_EDITION compile-time options are enabled; otherwise, the
#       key ring used to validate the (new machine provisioned) demo
#       license certificate cannot be loaded during package license
#       certificate verification.
#
runTest {test harpy-55.1 {machine license provisioning} -setup [subst {
  package require Harpy.Test

  set testFile(8) {$testFile(8)}

  saveLicenseEnvironment true
  resetLicenseEnvironment true
}] -body {
  set fileName(1) [appendArgs $testFile(8) .bak]

  set fileName(2) [appendArgs \
      $testFile(8) -provision-1a796654-9efd-4764-b301-c644702786ca.bak]

  catch {file delete $fileName(1)}
  file copy $testFile(8) $fileName(1)

  set env(Override_Certificate) $testFile(8)

  package require Licensing.Enterprise
} -cleanup {
  restoreLicenseEnvironment true

  catch {file delete $fileName(2)}

  if {[info exists fileName(1)] && [file exists $fileName(1)]} then {
    catch {file delete $testFile(8)}; # NOTE: MatchMachineId overwrites.
    catch {file rename $fileName(1) $testFile(8)}; # NOTE: Restore backup.
  }

  unset -nocomplain fileName
} -constraints {eagle compile.ISOLATED_INTERPRETERS compile.ISOLATED_PLUGINS\
file_test8.xml tlsOk} -constraintExpression {[haveConstraint \
harpyCompile.DEMO_KEY_PAIRS] || [haveConstraint harpyCompile.DEMO_EDITION]} \
-isolationLevel Maximum -noSecurity true -match regexp -result \
{^\d+\.\d+\.\d+.\d+$}}

###############################################################################

#
# HACK: This test requires the official strong name key due to (indirect)
#       use of the (test) Kapok server within the "request_license.eagle"
#       configuration script.
#
runTest {test harpy-56.1 {license configuration requirement} -setup [subst {
  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  set testFile(9) {$testFile(9)}
  set requestLicenseFile {$requestLicenseFile}

  saveLicenseEnvironment true
  resetLicenseEnvironment true

  saveEnvironmentVariables \[list ConfigurationFileNames\]
}] -body {
  set env(Override_Certificate) $testFile(9)

  unset -nocomplain env(ConfigurationFileNames)
  lappend env(ConfigurationFileNames) $requestLicenseFile

  list [package require Licensing.Enterprise] [noContextVariables]
} -cleanup {
  restoreEnvironmentVariables [list ConfigurationFileNames]

  restoreLicenseEnvironment true
} -constraints {eagle compile.ISOLATED_INTERPRETERS compile.ISOLATED_PLUGINS\
file_test9.xml file_request_license.eagle tlsOk harpy.strongName.official1} \
-isolationLevel Maximum -noSecurity true -match regexp -result \
{^\d+\.\d+\.\d+.\d+ \{\}$}}

###############################################################################

unset -nocomplain test_log_if
set test_log_if [expr {[info exists test_log] ? $test_log : ""}]

###############################################################################

#
# HACK: This test assumes that at least one "encrypted" configuration file
#       will actually be loaded by the plugin.
#
runTest {test harpy-56.2 {encrypted configuration files only} -setup [subst {
  if {!\[info exists test_channel\]} then {
    set test_channel {$test_channel}
  }

  if {\[catch {package present Eagle.Test}\]} then {
    package require Eagle.Test
  }

  if {!\[info exists test_log\]} then {
    set test_log {$test_log_if}
  }

  package require Harpy.Test

  saveEnvironmentVariables \[list \
      HarpyEncryptedConfigurationsOnly NoLicensingPackageUnknown\]
}] -body {
  set env(HarpyEncryptedConfigurationsOnly) 1
  set env(NoLicensingPackageUnknown) 1

  package require Licensing.Enterprise

  set configurations [getDictionaryValue [harpy configurations] Ok]

  tputs $test_channel [appendArgs \
      "---- plugin \"Licensing.Enterprise\" loaded configurations: " \
      [formatList $configurations <none>] \n]

  foreach fileName $configurations {
    set name [string tolower \
        [string trimleft [file extension $fileName] .]]

    if {[info exists counts($name)]} then {
      incr counts($name)
    } else {
      set counts($name) 1
    }
  }

  tputs $test_channel [appendArgs \
      "---- plugin \"Licensing.Enterprise\" configuration counts: " \
      [formatListAsDict [testArrayGet counts] <none>] \n]

  list [expr {
    int([info exists counts(eagle)] ? $counts(eagle) == 0 : true)
  }] [expr {
    int([info exists counts(eeagle)] ? $counts(eeagle) > 0 : false)
  }]
} -cleanup {
  restoreEnvironmentVariables [list \
      HarpyEncryptedConfigurationsOnly NoLicensingPackageUnknown]

  unset -nocomplain counts name fileName configurations
} -constraints {eagle command.harpy compile.OFFICIAL compile.XML} \
-isolationLevel Maximum -noSecurity true -result {1 1}}

