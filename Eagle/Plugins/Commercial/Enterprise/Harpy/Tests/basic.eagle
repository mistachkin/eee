runTest {test harpy-24.1 {certificate expired sub-command} -setup {
  package require Licensing.Enterprise
} -body {
  set certificate(1) [certificate import -validate $testFile(1)]
  set certificate(2) [certificate import -validate $testFile(2)]
  set certificate(3) [certificate import -validate $testFile(3)]

  list [catch {certificate expired $certificate(1)} error(1)] $error(1) \
      [catch {certificate expired $certificate(2)} error(2)] $error(2) \
      [catch {certificate expired $certificate(3)} error(3)] $error(3)
} -cleanup {
  unset -nocomplain error certificate
} -constraints [fixConstraints {eagle command.certificate compile.XML\
file_test1.xml file_test2.xml file_test3.xml}] -match regexp -result {^0\
NeverExpires 1 (?:\{\{assembly version: (?:assembly location "[^\"]+?" not\
verified|not trusted|newer disallowed)\} )?\{certificate expired\
"2015-05-20T23:16:32\.6875000Z"\}(?:\})? 0 NotExpired$}}

