runTest {test harpy-6.1 {ILicenseManager w/-clientData} -setup [subst {
  set auto_path {$auto_path}

  proc getHarpyDll \
      {[info args getHarpyDll]} \
      {[info body getHarpyDll]}

  proc isUnderHarpyDirectory \
      {[info args isUnderHarpyDirectory]} \
      {[info body isUnderHarpyDirectory]}

  set fileName \[getHarpyDll\]

  if {\[string length \$fileName\] == 0} then {
    error "cannot find package assembly file name"
  }

  object load -loadtype file \$fileName

  set licenseManager \[object create \
      Licensing.Components.Public.LicenseManager\]

  set clientData \[object create ClientData \$licenseManager true\]
}] -body {
  set plugin [load -clientdata $clientData $fileName]
  set manager [certificate manager]
  unload -clientdata $clientData $fileName
  list $plugin $manager
} -cleanup {
  rename isUnderHarpyDirectory ""
  rename getHarpyDll ""

  unset -nocomplain manager plugin clientData licenseManager fileName
} -constraints {eagle command.certificate} -isolationLevel Maximum -noSecurity \
true -match regexp -result [fixSnkTokenResult {^\{\{Licensing\.Enterprise,\
Harpy, Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=$publicKeyToken(1)\} \d+\.\d+\.\d+.\d+\} custom$}]}

