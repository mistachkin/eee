###############################################################################

runTest {test harpy-69.3 {enableSecurity / evaluateFile} -setup [subst {
  package require Security.Core
  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  set enableSecurityFile {$enableSecurityFile}
  set useEvaluateFile {$useEvaluateFile}
  set queryStatusFile {$queryStatusFile}

  saveEnvironmentVariables \[list NoLicensingPackageUnknown\]
}] -body {
  set env(NoLicensingPackageUnknown) 1

  set code(1) [catch {
    ksource -withcommands -useshared -useplugin \
        -usecontext -- $enableSecurityFile
  } result(1)]

  set code(2) [catch {
    set fileName $queryStatusFile
    set evaluate_flags ""

    ksource -withcommands -useshared -useplugin \
        -usecontext -- $useEvaluateFile
  } result(2)]

  set code(3) [catch {
    set fileName $queryStatusFile
    set evaluate_flags WithTrust

    ksource -withcommands -useshared -useplugin \
        -usecontext -- $useEvaluateFile
  } result(3)]

  set code(4) [catch {
    set fileName $queryStatusFile
    set evaluate_flags ViaShell

    ksource -withcommands -useshared -useplugin \
        -usecontext -- $useEvaluateFile
  } result(4)]

  noContextVariables

  list $code(1) $result(1) \
      $code(2) [string trim [string map \
          [list $queryStatusFile <queryStatusFile>] $result(2)]] \
      $code(3) [string trim [string map \
          [list $queryStatusFile <queryStatusFile>] $result(3)]] \
      $code(4) [string trim [string map \
          [list $queryStatusFile <queryStatusFile>] $result(4)]]
} -cleanup {
  restoreEnvironmentVariables [list NoLicensingPackageUnknown]

  unset -nocomplain fileName evaluate_flags
  unset -nocomplain code result
} -constraints {eagle command.ksource file_queryStatus.eagle\
file_use_evaluateFile.eagle} -isolationLevel Maximum -noSecurity true -match \
regexp -result {^0 \{security was disabled set enabled is enabled interpreter\
synchronized loaded \d+ certificates unavailable\} 0 \{QueryStatus Levels \d+\
TrustedLevels 1 ShellTrustedLevels 0 ShellFallbackLevels 0\} 0\
\{QueryStatus Levels \d+ TrustedLevels 2 ShellTrustedLevels 0\
ShellFallbackLevels 0\} 0 \{QueryStatus Levels \d+ TrustedLevels 1\
ShellTrustedLevels 0 ShellFallbackLevels 1\}$}}

###############################################################################

runTest {test harpy-69.4 {"safe" enableSecurity / evaluateFile} -setup {
  saveEnvironmentVariables [list NoLicensingPackageUnknown]

  set interp [interp create -safe -nosecurity]

  package require Eagle.Test

  interp eval $interp [makeProcedureCommand getContextVariables]
  interp eval $interp [makeProcedureCommand noContextVariables]

  interp set $interp plugin_path $plugin_path
  interp set $interp enableSecurityFile $enableSecurityFile
  interp set $interp useEvaluateFile $useEvaluateFile
  interp set $interp queryStatusFile $queryStatusFile

  interp eval $interp [makeProcedureCommand enableFlags]
  interp eval $interp [makeProcedureCommand enableInterpreterFlags]

  if {[haveConstraint harpy.isolated]} then {
    interp eval $interp [makeProcedureCommand enablePluginFlags]

    debug secureeval -trusted true -- $interp {
      set savedPluginFlags [enablePluginFlags]
      enablePluginFlags Isolated true
    }
  }

  debug secureeval -trusted true -- $interp {
    #
    # WARNING: Use the extremely "dangerous" AllowUnsafeOptions
    #          interpreter flag here in order to test [ksource]
    #          (with non-default options) from within a "safe"
    #          evaluation context.  Really, we are testing the
    #          [evaluateFile] (configuration) command and only
    #          using the [ksource] command as an entry point
    #          into the configuration subsystem.
    #
    # NOTE: In a non-testing context, we would not need to use
    #       the AllowUnsafeOptions interpreter flag because it
    #       would not matter if the initial evaluation context
    #       were "unsafe".
    #
    set savedInterpreterFlags [enableInterpreterFlags]
    enableInterpreterFlags AllowUnsafeOptions true
  }

  debug secureeval -trusted true -- $interp {
    object invoke Interpreter.GetActive Quiet true
  }

  debug secureeval -trusted true -- $interp {
    load $plugin_path Security.Core
  }
} -body {
  set env(NoLicensingPackageUnknown) 1

  set code(1) [catch {
    interp eval $interp {
      ksource -withcommands -useplugin -- $enableSecurityFile
    }
  } result(1)]

  set code(2) [catch {
    interp eval $interp {
      set fileName $queryStatusFile
      set evaluate_flags ""

      ksource -withcommands -useplugin -- $useEvaluateFile
    }
  } result(2)]

  set code(3) [catch {
    interp eval $interp {
      #
      # BUGBUG: This is actually misleading.  Since the initial
      #         evaluation context here is "unsafe", i.e. due to
      #         [ksource] defaults, use of the "WithTrust" flag
      #         here does not change anything substantive, i.e.
      #         because the EvaluateTrustedScript method simply
      #         skips changing (any) already trusted evaluation
      #         context.
      #
      set fileName $queryStatusFile
      set evaluate_flags WithTrust

      ksource -withcommands -useplugin -- $useEvaluateFile
    }
  } result(3)]

  set code(4) [catch {
    interp eval $interp {
      #
      # HACK: Use the "-untrusted" option here to make sure that
      #       the initial evaluation context for the target file
      #       is "safe".  Subsequently, when the "evaluateFile"
      #       configuration command is used, that should end up
      #       changing the evaluation context to "unsafe" due to
      #       the signed script handling in the ShellOps class.
      #
      set fileName $queryStatusFile
      set evaluate_flags ViaShell

      ksource -withcommands -useplugin -untrusted -- $useEvaluateFile
    }
  } result(4)]

  interp eval $interp {
    noContextVariables
  }

  list $code(1) $result(1) \
      $code(2) [string trim [string map \
          [list $queryStatusFile <queryStatusFile>] $result(2)]] \
      $code(3) [string trim [string map \
          [list $queryStatusFile <queryStatusFile>] $result(3)]] \
      $code(4) [string trim [string map \
          [list $queryStatusFile <queryStatusFile>] $result(4)]]
} -cleanup {
  catch {
    enableInterpreterFlags $savedInterpreterFlags
    unset -nocomplain savedInterpreterFlags
  }

  if {[haveConstraint harpy.isolated]} then {
    catch {
      debug secureeval -trusted true -- $interp {
        enablePluginFlags $savedPluginFlags
        unset -nocomplain savedPluginFlags
      }
    }
  }

  catch {interp delete $interp}

  unset -nocomplain fileName evaluate_flags
  unset -nocomplain code result
  unset -nocomplain interp

  restoreEnvironmentVariables [list NoLicensingPackageUnknown]
} -constraints {eagle command.ksource file_queryStatus.eagle\
file_use_evaluateFile.eagle} -match regexp -result {^0 \{security was disabled\
set enabled is enabled interpreter synchronized loaded \d+ certificates\
unavailable\} 0 \{QueryStatus Levels \d+ TrustedLevels 1 ShellTrustedLevels 0\
ShellFallbackLevels 0\} 0 \{QueryStatus Levels \d+ TrustedLevels 2\
ShellTrustedLevels 0 ShellFallbackLevels 0\} 0 \{QueryStatus Levels \d+\
TrustedLevels 1 ShellTrustedLevels 1 ShellFallbackLevels 0\}$}}

###############################################################################

runTest {test harpy-70.1 {security sub-commands (unsigned)} -setup {
  package require Licensing.Enterprise
} -body {
  set secretApiKey d1c607405fee42bf86efa7ef97e10e58; # TODO: Hard-coded.

  set id [secret generate \
      -iterations 99999 -hashalgorithms [list SHA512] \
      -encrypted true -apikey $secretApiKey]

  set response [secret request \
      -hashalgorithm SHA512 -apikey $secretApiKey -- $id]

  secret delete -apikey $secretApiKey -- $id

  set password [getDictionaryValue $response password]

  if {[string is not base64 -strict $password]} then {
    error "password is empty or not base64"
  }

  set salt [getDictionaryValue $response salt]

  if {[string is not base64 -strict $salt]} then {
    error "salt is empty or not base64"
  }

  set iterationCount [getDictionaryValue $response iterationCount]

  if {[string is not integer -strict $iterationCount]} then {
    error "iteration count is empty or not integer"
  }

  set hashAlgorithmName [getDictionaryValue $response hashAlgorithmName]
  set saltBytes [object invoke -create Convert FromBase64String $salt]

  if {[string length $hashAlgorithmName] > 0} then {
    set deriveBytes [object create -alias \
        System.Security.Cryptography.Rfc2898DeriveBytes $password \
        $saltBytes $iterationCount $hashAlgorithmName]
  } else {
    set deriveBytes [object create -alias \
        System.Security.Cryptography.Rfc2898DeriveBytes $password \
        $saltBytes $iterationCount]
  }

  list [set entropyBytes [$deriveBytes -create -alias GetBytes 256]] \
      [$entropyBytes Length]
} -cleanup {
  catch {secret delete -apikey $secretApiKey -- $id}

  unset -nocomplain password salt iterationCount hashAlgorithmName
  unset -nocomplain saltBytes deriveBytes entropyBytes
  unset -nocomplain secretApiKey id response
} -constraints {eagle command.secret network_urn.to tlsOk} -match regexp \
-result {^\{System#Byte\[\]#\d+\} 256$}}

###############################################################################

runTest {test harpy-70.2 {security sub-commands (signed)} -setup {
  package require Licensing.Enterprise

  savePolicy savedPolicy; resetPolicy
  certificate policy -enabled true

  saveKeyRing savedKeyRing; resetKeyRing

  enableSecretMode true
} -body {
  set secretApiKey d1c607405fee42bf86efa7ef97e10e58; # TODO: Hard-coded.

  set privateKey [keypair open -alias -public -private $privateKeyFile(5)]

  set id [secret generate \
      -iterations 99999 -hashalgorithms [list SHA512] \
      -encrypted true -apikey $secretApiKey -keypair $privateKey]

  keyring merge $keyRingFile(21)

  set response [secret request \
      -hashalgorithm SHA512 -apikey $secretApiKey -- $id]

  secret delete -apikey $secretApiKey -- $id

  set password [getDictionaryValue $response password]

  if {[string is not base64 -strict $password]} then {
    error "password is empty or not base64"
  }

  set salt [getDictionaryValue $response salt]

  if {[string is not base64 -strict $salt]} then {
    error "salt is empty or not base64"
  }

  set iterationCount [getDictionaryValue $response iterationCount]

  if {[string is not integer -strict $iterationCount]} then {
    error "iteration count is empty or not integer"
  }

  set hashAlgorithmName [getDictionaryValue $response hashAlgorithmName]
  set saltBytes [object invoke -create Convert FromBase64String $salt]

  if {[string length $hashAlgorithmName] > 0} then {
    set deriveBytes [object create -alias \
        System.Security.Cryptography.Rfc2898DeriveBytes $password \
        $saltBytes $iterationCount $hashAlgorithmName]
  } else {
    set deriveBytes [object create -alias \
        System.Security.Cryptography.Rfc2898DeriveBytes $password \
        $saltBytes $iterationCount]
  }

  list [set entropyBytes [$deriveBytes -create -alias GetBytes 256]] \
      [$entropyBytes Length]
} -cleanup {
  catch {secret delete -apikey $secretApiKey -- $id}

  enableSecretMode false

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  unset -nocomplain password salt iterationCount hashAlgorithmName
  unset -nocomplain saltBytes deriveBytes entropyBytes
  unset -nocomplain privateKey secretApiKey id response
} -constraints [fixSnkConstraints {eagle command.certificate command.keypair
command.keyring command.secret network_urn.to tlsOk file_keyRing.zero.eagle\
command.ksource file_enable_secret_mode.eagle file_disable_secret_mode.eagle\
$privateKeyFile(5)}] -match regexp -result {^\{System#Byte\[\]#\d+\} 256$}}

###############################################################################

runTest {test harpy-71.1 {convert to limited duration license} -setup [subst {
  package require Licensing.Enterprise
  package require Harpy.Test

  set limitedTimeFile {$limitedTimeFile}
  set testFile(14) {$testFile(14)}
  set testPolicy(30) {$testPolicy(30)}
  set testPolicy(31) {$testPolicy(31)}

  saveKeyRing savedKeyRing License; resetKeyRing License

  saveEnvironmentVariables \[list NoLicensingPackageUnknown\]
}] -body {
  set env(NoLicensingPackageUnknown) 1

  set pluginData [object invoke -flags +NonPublic \
      Interpreter.GetActive GetPluginData [lindex [lindex [info \
      loaded "" "* \{Licensing.Enterprise, *\}"] 0] end]]

  object invoke $pluginData AppDomain.SetData \
      [appendArgs 00000000-0000-0000-0000-000000000002_ [pid]] \
      "Contents Does Not Matter"

  ksource -withcommands -useshared -useplugin -usecontext -- \
      $limitedTimeFile

  set certificate [certificate \
      loadandverify -filename $testFile(14) -useplugin 0 -policytype \
      License -policy [appendArgs - $testPolicy(31) " +" $testPolicy(30)] \
      -force true]
} -cleanup {
  restoreEnvironmentVariables [list NoLicensingPackageUnknown]

  catch {certificate reset =GlobalDurationData}

  restoreKeyRing savedKeyRing License

  unset -nocomplain pluginData certificate
} -constraints {eagle command.certificate command.keypair file_TestPublic8.snk\
file_test14.xml file_limited_time.eagle !harpy.plugin.isolated} \
-constraintExpression {[haveConstraint configuration.Debug] || \
[haveConstraint harpyCompile.EXTRA_DIAGNOSTICS]} -isolationLevel Maximum \
-noSecurity true -match regexp -result \
{^Licensing#Components#Public#Certificate#\d+$}}

###############################################################################

runTest {test harpy-72.1 {using the ISnippetManager interface} -setup {
  saveEnvironmentVariables [list NoLicensingPackageUnknown]

  if {[haveConstraint compile.ISOLATED_INTERPRETERS]} then {
    set interp [interp create -isolated -nosecurity]
  } else {
    set interp [interp create -nosecurity]
  }

  interp set $interp dataPath $dataPath
  interp set $interp goodFile $goodFile
  interp set $interp badFile $badFile

  set good [interp set $interp good [appendArgs \
      0x [string tolower [hash normal -filename \
      sha1 $goodFile]]]]

  set bad [interp set $interp bad [appendArgs \
      0x [string tolower [hash normal -filename \
      sha1 $badFile]]]]

  #
  # HACK: Undo both of the [file rename] commands
  #       that we perform below, just in case they
  #       were not undone last time this test was
  #       ran.
  #
  moveFiles $test_channel $dataPath false
} -body {
  set env(NoLicensingPackageUnknown) 1

  interp eval $interp {
    set names null; set errors null

    set code [object invoke Interpreter.GetActive \
        AddSnippetsForCertificates $dataPath None \
        None names errors]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $errors]
    }
  }

  set result(good) [interp eval $interp {
    set snippet null; set error null

    set code [object invoke Interpreter.GetActive \
        GetSnippet $good None None snippet error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    object invoke $snippet Name
  }]

  interp eval $interp {unset -nocomplain snippet error}

  set result(bad) [interp eval $interp {
    set snippet null; set error null

    set code [object invoke Interpreter.GetActive \
        GetSnippet $bad None None snippet error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    object invoke $snippet Name
  }]

  interp eval $interp {unset -nocomplain snippet error}

  #
  # HACK: There is no direct way to tell the Harpy
  #       script policy checking code to avoid using
  #       script certificates that it finds on the
  #       file system; however, we can temporarily
  #       move them out of the way.
  #
  moveFiles $test_channel $dataPath true

  list $result(good) $result(bad) \
       [file exists $goodFile] \
       [file exists [appendArgs $goodFile .harpy]] \
       [file exists $badFile] \
       [file exists [appendArgs $badFile .harpy]] \
  [interp eval $interp {
    list [catch {
      source enableSecurity
    } error(0)] $error(0) [catch {
      source $goodFile
    } error(1)] $error(1) [catch {
      source $badFile
    } error(2)] $error(2) [catch {
      source disableSecurity
    } error(3)] $error(3)
  }]
} -cleanup {
  moveFiles $test_channel $dataPath false

  catch {interp eval $interp {
    if {![isMono]} then {
      #
      # HACK: *MONO* The method call to RemoveSnippets
      #       has been confirmed to crash Mono version
      #       v6.12.0.200 on Ubuntu.  The more precise
      #       crash location is inside of the method
      #       call to GetEnumerator in order to handle
      #       the (only) foreach statement located in
      #       RemoveSnippets method.  The exact cause
      #       of this crash is unclear.
      #
      set names [object invoke \
          -create StringList FromString $names]

      set errors null

      object invoke Interpreter.GetActive \
          RemoveSnippets None None names errors
    }

    unset -nocomplain names errors code
  }}

  catch {interp delete $interp}

  unset -nocomplain interp good bad result

  restoreEnvironmentVariables [list NoLicensingPackageUnknown]
} -constraints {eagle file_bad.eagle file_good.eagle} -match regexp -result \
{^0x41772f4539b11e828dfe956443459eb243d64cf6\
0x0bdb3777ed1b973d27687907900708a774608c6d True False True False \{0\
\d+\.\d+\.\d+.\d+ 0 \{This script should be evaluated\.\} 1 \{couldn't read or\
get file "[^\"]+[/\\]bad.eagle": no such file or directory\} 0 True\}$}}

###############################################################################

if {[isEagle] && [haveConstraint file_snippets.txt]} then {
  set badgeDll [getBadgeDll]

  if {[string length $badgeDll] > 0} then {
    set snippetsResults [string map [list \
        %patchLevel% [file version $badgeDll] %dataPath% $dataPath] \
        [readFile $snippetsResultFile]]
  } else {
    set snippetsResults ""
  }

  unset -nocomplain badgeDll
} else {
  set snippetsResults ""
}

###############################################################################

runTest {test harpy-72.2 {using the ISnippetManager interface} -setup {
  proc fixScriptResult { value } {
    return [string map [list " " \xA0] $value]
  }

  if {[haveConstraint compile.ISOLATED_INTERPRETERS]} then {
    set interp [interp create -isolated -nosecurity]
  } else {
    set interp [interp create -nosecurity]
  }

  interp set $interp dataPath $dataPath
  interp set $interp goodFile $goodFile
  interp set $interp badFile $badFile
  interp set $interp snippetsFile $snippetsFile

  #
  # HACK: Undo both of the [file rename] commands
  #       that we perform below, just in case they
  #       were not undone last time this test was
  #       ran.
  #
  moveFiles $test_channel $dataPath false

  saveEnvironmentVariables [list \
      ForceModernAlgorithms NoLicensingPackageUnknown]
} -body {
  set env(NoLicensingPackageUnknown) 1

  #############################################################################

  interp eval $interp {
    set good_sha1 [appendArgs \
        0x [string tolower [hash normal -filename \
        sha1 $goodFile]]]

    set good_sha512 [appendArgs \
        0x [string tolower [hash normal -filename \
        sha512 $goodFile]]]

    set bad_sha1 [appendArgs \
        0x [string tolower [hash normal -filename \
        sha1 $badFile]]]

    set bad_sha512 [appendArgs \
        0x [string tolower [hash normal -filename \
        sha512 $badFile]]]
  }

  #############################################################################

  lappend results [interp eval $interp {
    unset -nocomplain env(ForceModernAlgorithms)
    set names null; set errors null

    set code [object invoke Interpreter.GetActive \
        AddSnippetsForCertificates $dataPath None \
        None names errors]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $errors]
    }

    set env(ForceModernAlgorithms) 1
    set names null; set errors null

    set code [object invoke Interpreter.GetActive \
        AddSnippetsForCertificates $dataPath None \
        None names errors]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $errors]
    }

    unset -nocomplain env(ForceModernAlgorithms)
    set names null; set errors null

    set code [object invoke Interpreter.GetActive \
        ListSnippets null false None None names errors]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $errors]
    }

    set names
  }]

  #############################################################################

  lappend results [interp eval $interp {
    set error null

    set code [object invoke Interpreter.GetActive \
        RemoveSnippet $good_sha1 None None error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    set error null

    set code [object invoke Interpreter.GetActive \
        RemoveSnippet $good_sha512 None None error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    unset -nocomplain env(ForceModernAlgorithms)
    set names null; set errors null

    set code [object invoke Interpreter.GetActive \
        AddSnippets $dataPath good.eagle.harpy \
        None None names errors]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $errors]
    }

    set names
  }]

  #############################################################################

  lappend results [interp eval $interp {
    set count 0; set error null

    set code [object invoke Interpreter.GetActive \
        ClearSnippets None None count error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    set count
  }]

  #############################################################################

  interp eval $interp {
    unset -nocomplain env(ForceModernAlgorithms)
    set names null; set errors null

    set code [object invoke Interpreter.GetActive \
        AddSnippets $dataPath good.eagle.harpy \
        None None names errors]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $errors]
    }
  }

  #############################################################################

  set code [catch {interp eval $interp {
    source $goodFile
  }} result]

  lappend results $code [fixScriptResult $result]

  set code [catch {interp eval $interp {
    source $badFile
  }} result]

  lappend results $code [fixScriptResult $result]

  set code [catch {interp eval $interp {
    source enableSecurity
  }} result]; lappend results $code $result

  set code [catch {interp eval $interp {
    source $goodFile
  }} result]

  lappend results $code [fixScriptResult $result]

  set code [catch {interp eval $interp {
    source $badFile
  }} result]

  lappend results $code [fixScriptResult $result]

  set code [catch {interp eval $interp {
    source disableSecurity
  }} result]; lappend results $code $result

  set code [catch {interp eval $interp {
    source $goodFile
  }} result]

  lappend results $code [fixScriptResult $result]

  set code [catch {interp eval $interp {
    source $badFile
  }} result]

  lappend results $code [fixScriptResult $result]

  #############################################################################

  set code [catch {
    interp eval $interp {
      ksource -withcommands -useshared -useplugin -usecontext -- \
          $snippetsFile
    }
  } result]; lappend results $code $result

  #############################################################################

  interp eval $interp {; # SUPERFLUOUS
    unset -nocomplain good_sha1 good_sha512 bad_sha1 bad_sha512
    unset -nocomplain code names count error errors
    unset -nocomplain dataPath goodFile badFile snippetsFile
  }

  #############################################################################

  set results [string map [list " " \n] $results]

  if {0} then {
    writeFile [file join $dataPath snippets.txt] [string map [list \
        [file version [getBadgeDll]] %patchLevel% $dataPath %dataPath%] \
        $results]
  }

  #############################################################################

  set results
} -cleanup {
  catch {interp delete $interp}

  restoreEnvironmentVariables [list \
      ForceModernAlgorithms NoLicensingPackageUnknown]

  rename fixScriptResult ""

  unset -nocomplain interp code result results
} -constraints {eagle file_bad.eagle file_good.eagle file_snippets.eagle\
file_snippets.txt} -result $snippetsResults}

###############################################################################

unset -nocomplain snippetsResults

###############################################################################

runTest {test harpy-73.1 {harpy uri sub-command} -setup {
  package require Licensing.Enterprise
} -body {
  lsort [harpy uri]
} -constraints {eagle command.harpy} -result {AuthorityBase AuthorityRelative\
HttpTimeBase HttpTimeRelative LibraryBase LibraryRelative LicenseBase\
LicenseRelative NtpBase NtpRelative PingBase PingRelative ProvisionBase\
ProvisionRelative RenewalBase RenewalRelative RequestBase RequestRelative\
RevocationBase RevocationRelative ScriptBase ScriptRelative SecretBase\
SecretRelative StorageBase StorageRelative SupportBase SupportRelative\
TestBase TestRelative}}

###############################################################################

runTest {test harpy-73.2 {harpy uri sub-command} -setup {
  package require Licensing.Enterprise

  proc addUriResult { uriType code result varName } {
    upvar 1 $varName results

    if {$code == 0} then {
      if {[lindex $uriType 0] eq "NtpBase"} then {
        #
        # HACK: Since the NTP server selection is random and
        #       the hosts do not follow any specific pattern,
        #       change result to something easier to check,
        #       as long as the selected NTP server is present
        #       in the global (test) list of "valid" servers.
        #
        if {$result in [getNtpServers]} then {
          set result ntpOk
        }
      } elseif {[string match *Relative [lindex $uriType 0]]} then {
        if {[isValidRelativeUri $result]} then {
          set result relativeOk
        }
      } elseif {[string is uri -strict $result]} then {
        set result uriOk
      } elseif {[isValidHostName $result]} then {
        set result hostOk
      }
    }

    lappend results [list $uriType $code $result]
  }

  saveEnvironmentVariables [list \
      pingBaseUri pingRelativeUri supportBaseUri \
      supportRelativeUri scriptBaseUri scriptRelativeUri \
      storageBaseUri storageRelativeUri testBaseUri \
      testRelativeUri]
} -body {
  set env(pingBaseUri) https://fake.urn.to/r/pingBase
  set env(pingRelativeUri) pingRelative
  set env(supportBaseUri) https://fake.urn.to/r/supportBase
  set env(supportRelativeUri) supportRelative
  set env(scriptBaseUri) https://fake.urn.to/r/scriptBase
  set env(scriptRelativeUri) scriptRelative
  set env(storageBaseUri) https://fake.urn.to/r/storageBase
  set env(storageRelativeUri) storageRelative
  set env(testBaseUri) https://fake.urn.to/r/testBase
  set env(testRelativeUri) testRelative

  set results [list]

  foreach uriType [lsort [harpy uri]] {
    set code [catch {harpy uri $uriType} result]
    addUriResult $uriType $code $result results

    if {$code == 1 && $result eq "not implemented"} then {
      continue
    }

    if {$uriType eq "AuthorityBase"} then {
      set uriType [appendArgs : $uriType " UseCertificate"]
      set code [catch {harpy uri $uriType} result]
      addUriResult $uriType $code $result results
    } elseif {$uriType eq "LibraryBase"} then {
      set uriType [appendArgs : $uriType " UseLibrary"]
      set code [catch {harpy uri $uriType} result]
      addUriResult $uriType $code $result results
    } else {
      set uriType [appendArgs : $uriType " FlagMask"]
      set code [catch {harpy uri $uriType} result]
      addUriResult $uriType $code $result results
    }
  }

  set results
} -cleanup {
  restoreEnvironmentVariables [list \
      pingBaseUri pingRelativeUri supportBaseUri \
      supportRelativeUri scriptBaseUri scriptRelativeUri \
      storageBaseUri storageRelativeUri testBaseUri \
      testRelativeUri]

  rename addUriResult ""

  unset -nocomplain ntpServers uriType results result code
} -constraints {eagle command.harpy} -result {{AuthorityBase 0 uriOk}\
{{:AuthorityBase UseCertificate} 0 uriOk} {AuthorityRelative 1 {not\
implemented}} {HttpTimeBase 0 uriOk} {{:HttpTimeBase FlagMask} 0 uriOk}\
{HttpTimeRelative 1 {not implemented}} {LibraryBase 1 {cannot use script\
library}} {{:LibraryBase UseLibrary} 0 uriOk} {LibraryRelative 1 {not\
implemented}} {LicenseBase 0 uriOk} {{:LicenseBase FlagMask} 0 uriOk}\
{LicenseRelative 0 relativeOk} {{:LicenseRelative FlagMask} 0 relativeOk}\
{NtpBase 0 ntpOk} {{:NtpBase FlagMask} 0 hostOk} {NtpRelative 1 {not\
implemented}} {PingBase 1 {cannot use script variable}} {{:PingBase FlagMask} 0\
uriOk} {PingRelative 1 {cannot use script variable}} {{:PingRelative FlagMask}\
0 relativeOk} {ProvisionBase 0 uriOk} {{:ProvisionBase FlagMask} 0 uriOk}\
{ProvisionRelative 0 relativeOk} {{:ProvisionRelative FlagMask} 0 relativeOk}\
{RenewalBase 0 uriOk} {{:RenewalBase FlagMask} 0 uriOk} {RenewalRelative 0\
relativeOk} {{:RenewalRelative FlagMask} 0 relativeOk} {RequestBase 0 uriOk}\
{{:RequestBase FlagMask} 0 uriOk} {RequestRelative 0 relativeOk}\
{{:RequestRelative FlagMask} 0 relativeOk} {RevocationBase 0 uriOk}\
{{:RevocationBase FlagMask} 0 uriOk} {RevocationRelative 0 relativeOk}\
{{:RevocationRelative FlagMask} 0 relativeOk} {ScriptBase 1 {cannot use script\
variable}} {{:ScriptBase FlagMask} 0 uriOk} {ScriptRelative 1 {cannot use\
script variable}} {{:ScriptRelative FlagMask} 0 relativeOk} {SecretBase 0\
uriOk} {{:SecretBase FlagMask} 0 uriOk} {SecretRelative 1 {not implemented}}\
{StorageBase 1 {cannot use script variable}} {{:StorageBase FlagMask} 0 uriOk}\
{StorageRelative 1 {cannot use script variable}} {{:StorageRelative FlagMask} 0\
relativeOk} {SupportBase 1 {cannot use script variable}} {{:SupportBase\
FlagMask} 0 uriOk} {SupportRelative 1 {cannot use script variable}}\
{{:SupportRelative FlagMask} 0 relativeOk} {TestBase 0 uriOk} {{:TestBase\
FlagMask} 0 uriOk} {TestRelative 0 relativeOk} {{:TestRelative FlagMask} 0\
relativeOk}}}

###############################################################################

runTest {test harpy-74.1 {harpy timeout sub-command} -setup {
  package require Licensing.Enterprise
  package require Harpy.Test

  #
  # HACK: Forcibly remove any network timeout configured by any of
  #       the interpreter creation / startup scripts.  This is not
  #       a problem because this test uses interpreter isolation.
  #
  set error null; set code [object invoke \
      Interpreter.GetActive SetOrUnsetTimeout Network null error]

  saveEnvironmentVariables [list NetworkTimeout HarpyTimeout]
} -body {
  set varNames [list NetworkTimeout HarpyTimeout]

  foreach varName $varNames {
    unset -nocomplain env($varName)
  }

  foreach varName $varNames {
    lappend results $varName
    lappend results [harpy timeout]

    set env($varName) 33333
    lappend results [harpy timeout]

    unset env($varName)
    lappend results [harpy timeout]
  }

  set results
} -cleanup {
  restoreEnvironmentVariables [list NetworkTimeout HarpyTimeout]

  unset -nocomplain varNames varName results error code
} -constraints {eagle command.harpy} -isolationLevel Maximum -result \
{NetworkTimeout {} 33333 {} HarpyTimeout {} 33333 {}}}

###############################################################################

runTest {test harpy-75.1 {signed bundles (automatic)} -setup [subst {
  set bundle1File {$bundle1File}
}] -body {
  source -bundle true $bundle1File
} -cleanup {
  catch {debug unmount $bundle1File}
  catch {source disableSecurity}

  set id [object invoke Interpreter.GetActive Id]

  foreach interp [interp children] {
    if {$interp eq $id} then {continue}
    catch {interp delete $interp}
  }; unset -nocomplain interp id
} -constraints {eagle compile.DATA command.sql command.harpy monoBug28\
monoHang612 file_sqlite3.dll file_System.Data.SQLite.dll file_bundle1.db} \
-isolationLevel Interpreter -result {This script should be evaluated.}}

