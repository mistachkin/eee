###############################################################################

#
# HACK: *SPECIAL* This test can only pass when the DEMO_KEY_PAIRS -OR-
#       DEMO_EDITION compile-time options are enabled; otherwise, the
#       key ring used to validate the demo license certificate cannot
#       be loaded during package license certificate verification.
#
runTest {test harpy-36.1 {demo license request success} -setup [subst {
  package require Harpy.Test

  if {!\[info exists test_timeout\]} then {
    set test_timeout {$test_timeout}
  }

  unset -nocomplain directory fileName

  saveLicenseEnvironment true
  resetLicenseEnvironment true

  saveEnvironmentVariables \[list \
      NetworkTimeout NoLoadLicenseKeyRings\]
}] -body {
  set env(NetworkTimeout) $test_timeout

  unset -nocomplain env(NoLoadLicenseKeyRings)

  set env(Override_Certificate) \
      [set fileName [requestLicenseCertificate]]

  package require Security.Core
} -cleanup {
  catch {file delete $fileName}

  catch {
    set directory [file dirname $fileName]

    if {[llength [glob -nocomplain \
        [file join $directory *]]] == 0} then {
      file rmdir $directory
    }
  }

  restoreEnvironmentVariables [list \
      NetworkTimeout NoLoadLicenseKeyRings]

  restoreLicenseEnvironment true

  unset -nocomplain directory fileName
} -constraints {eagle harpy.libraryServer network_urn.to tlsOk} \
-constraintExpression {[haveConstraint harpyCompile.DEMO_KEY_PAIRS] || \
[haveConstraint harpyCompile.DEMO_EDITION]} -isolationLevel Maximum \
-noSecurity true -match regexp -result {^\d+\.\d+\.\d+.\d+$}}

###############################################################################

restoreConfiguration $test_channel
enableConfiguration $test_channel true

###############################################################################

configurationReset

###############################################################################

unset -nocomplain test_log_if
set test_log_if [expr {[info exists test_log] ? $test_log : ""}]

###############################################################################

tputs $test_channel "---- result of plugin data reset... "

if {[isEagle] && [haveConstraint command.certificate] && \
    ([haveInterpreterTestFlags NoAppDomain] || \
     ![haveConstraint compile.ISOLATED_INTERPRETERS])} then {
  if {[catch {
    #
    # NOTE: Reset primary cached license certificate and file name, any
    #       other cached license certificates, and cached (trusted) key
    #       pairs for all interpreters.
    #
    certificate reset "+KeyPairsMask GlobalFileCache GlobalLicenseCache"
  }] == 0} then {
    tputs $test_channel success\n
  } else {
    tputs $test_channel failure\n
  }
} else {
  tputs $test_channel skipped\n
}

###############################################################################

runTest {test harpy-36.2 {demo license request w/o key ring} -setup [subst {
  if {!\[info exists test_timeout\]} then {
    set test_timeout {$test_timeout}
  }

  if {!\[info exists test_channel\]} then {
    set test_channel {$test_channel}
  }

  if {\[catch {package present Eagle.Test}\]} then {
    package require Eagle.Test
  }

  if {!\[info exists test_log\]} then {
    set test_log {$test_log_if}
  }

  package require Harpy.Test

  if {[haveConstraint harpyCompile.DEMO_KEY_PAIRS]} then {
    addConstraint harpyCompile.DEMO_KEY_PAIRS
  }

  if {[haveConstraint harpyCompile.DEMO_EDITION]} then {
    addConstraint harpyCompile.DEMO_EDITION
  }

  unset -nocomplain directory fileName; # REDUNDANT

  saveLicenseEnvironment true
  resetLicenseEnvironment true

  if {\[haveConstraint harpyCompile.DEMO_KEY_PAIRS\] || \
      \[haveConstraint harpyCompile.DEMO_EDITION\]} then {
    saveEnvironmentVariables \[list \
        ConfigurationFileNames NetworkTimeout NoLoadLicenseKeyRings\]

    set dataPath {$dataPath}

    setupDemoModeFiles \$dataPath
    enableDemoMode false false
  } else {
    saveEnvironmentVariables \[list \
        NetworkTimeout NoLoadLicenseKeyRings\]
  }
}] -body {
  set env(NetworkTimeout) $test_timeout

  unset -nocomplain env(NoLoadLicenseKeyRings)

  set env(Override_Certificate) \
      [set fileName [requestLicenseCertificate]]

  package require Security.Core
} -cleanup {
  if {[haveConstraint harpyCompile.DEMO_KEY_PAIRS] || \
      [haveConstraint harpyCompile.DEMO_EDITION]} then {
    enableDemoMode true false
    cleanupDemoModeFiles
  }

  catch {file delete $fileName}

  catch {
    set directory [file dirname $fileName]

    if {[llength [glob -nocomplain \
        [file join $directory *]]] == 0} then {
      file rmdir $directory
    }
  }

  if {[haveConstraint harpyCompile.DEMO_KEY_PAIRS] || \
      [haveConstraint harpyCompile.DEMO_EDITION]} then {
    restoreEnvironmentVariables [list \
        ConfigurationFileNames NetworkTimeout NoLoadLicenseKeyRings]
  } else {
    restoreEnvironmentVariables [list \
        NetworkTimeout NoLoadLicenseKeyRings]
  }

  restoreLicenseEnvironment true

  unset -nocomplain certificate directory fileName
} -constraints {eagle command.certificate harpy.libraryServer network_urn.to\
tlsOk} -isolationLevel Maximum -noSecurity true -returnCodes 1 -match regexp \
-result [PKTM]}

###############################################################################

tputs $test_channel "---- result of plugin key ring restore... "

if {[isEagle] && [haveConstraint command.certificate] && \
    ([haveInterpreterTestFlags NoAppDomain] || \
     ![haveConstraint compile.ISOLATED_INTERPRETERS])} then {
  if {[catch {
    resetKeyRing "" false
  }] == 0} then {
    tputs $test_channel success\n
  } else {
    tputs $test_channel failure\n
  }
} else {
  tputs $test_channel skipped\n
}

###############################################################################

restoreConfiguration $test_channel
enableConfiguration $test_channel false

###############################################################################

configurationReset

###############################################################################

unset -nocomplain test_log_if

###############################################################################

#
# HACK: *SPECIAL* This test can only pass when the DEMO_KEY_PAIRS -OR-
#       DEMO_EDITION compile-time options are enabled; otherwise, the
#       key ring used to validate the demo license certificate cannot
#       be loaded during package license certificate verification.
#
runTest {test harpy-36.3 {demo license renewal success} -setup [subst {
  package require Harpy.Test

  set test_timeout {$test_timeout}

  unset -nocomplain directory backupFileName fileName

  saveLicenseEnvironment true
  resetLicenseEnvironment true

  saveEnvironmentVariables \[list \
      AlwaysExpires NetworkTimeout NoLoadLicenseKeyRings\]

  saveServerEnvironmentVariables
  resetServerEnvironmentVariables
}] -body {
  set env(AlwaysExpires) 1
  set env(NetworkTimeout) $test_timeout

  unset -nocomplain env(NoLoadLicenseKeyRings)

  set env(Override_Certificate) \
      [set fileName [requestLicenseCertificate]]

  package require Security.Core
} -cleanup {
  catch {file delete $fileName}

  catch {
    set backupFileName [lindex [glob -nocomplain \
        [appendArgs [file rootname $fileName] *.bak]] 0]

    if {[string length $backupFileName] > 0} then {
      file delete $backupFileName
    }
  }

  catch {
    set directory [file dirname $fileName]

    if {[llength [glob -nocomplain \
        [file join $directory *]]] == 0} then {
      file rmdir $directory
    }
  }

  restoreServerEnvironmentVariables

  restoreEnvironmentVariables [list \
      AlwaysExpires NetworkTimeout NoLoadLicenseKeyRings]

  restoreLicenseEnvironment true

  unset -nocomplain directory backupFileName fileName
} -constraints {eagle kapok.server harpy.libraryServer network_urn.to tlsOk} \
-constraintExpression {[haveConstraint harpyCompile.DEMO_KEY_PAIRS] || \
[haveConstraint harpyCompile.DEMO_EDITION]} -isolationLevel Maximum \
-noSecurity true -match regexp -result {^\d+\.\d+\.\d+.\d+$}}

###############################################################################

#
# HACK: *SPECIAL* This test can only pass when the DEMO_KEY_PAIRS -OR-
#       DEMO_EDITION compile-time options are enabled; otherwise, the
#       key ring used to validate the demo license certificate cannot
#       be loaded during package license certificate verification.
#
runTest {test harpy-36.4 {interp isolated demo license renewal} -setup [subst {
  package require Harpy.Test

  set interp \[interp create -isolated -nosecurity\]
  interp set \$interp test_timeout {$test_timeout}

  saveLicenseEnvironment true
  resetLicenseEnvironment true

  saveEnvironmentVariables \[list \
      AlwaysExpires NetworkTimeout NoLoadLicenseKeyRings\]

  saveServerEnvironmentVariables
  resetServerEnvironmentVariables
}] -body {
  interp eval $interp {
    try {
      set env(AlwaysExpires) 1
      set env(NetworkTimeout) $test_timeout

      unset -nocomplain env(NoLoadLicenseKeyRings)

      set env(Override_Certificate) \
          [set fileName [requestLicenseCertificate]]

      package require Security.Core
    } finally {
      catch {file delete $fileName}

      catch {
        set backupFileName [lindex [glob -nocomplain \
            [appendArgs [file rootname $fileName] *.bak]] 0]

        if {[string length $backupFileName] > 0} then {
          file delete $backupFileName
        }
      }

      catch {
        set directory [file dirname $fileName]

        if {[llength [glob -nocomplain \
            [file join $directory *]]] == 0} then {
          file rmdir $directory
        }
      }
    }
  }
} -cleanup {
  catch {interp delete $interp}

  restoreServerEnvironmentVariables

  restoreEnvironmentVariables [list \
      AlwaysExpires NetworkTimeout NoLoadLicenseKeyRings]

  restoreLicenseEnvironment true

  unset -nocomplain interp
} -constraints {eagle kapok.server compile.ISOLATED_INTERPRETERS\
harpy.libraryServer network_urn.to tlsOk} -constraintExpression \
{[haveConstraint harpyCompile.DEMO_KEY_PAIRS] || [haveConstraint \
harpyCompile.DEMO_EDITION]} -match regexp -result {^\d+\.\d+\.\d+.\d+$}}

