runTest {test harpy-2.8 {import/sign/verify/export cert (DSA)} -setup {
  package require Licensing.Enterprise
  catch {file delete -force $exportFile}
} -body {
  #
  # HACK: In isolated mode, we cannot use the KeyPairType enumeration
  #       directly.
  #
  if {[haveConstraint harpy.isolated]} then {
    set DSA 0x200
  } else {
    set DSA DSA
  }

  set publicKey [keypair open \
      -alias -public -keypairtype $DSA $testKeyFile(17)]

  set privateKey [keypair open \
      -alias -public -private -keypairtype $DSA $testKeyFile(17)]

  set certificate [certificate import -alias -validate $importFile]

  #
  # HACK: Since DSA cannot handle SHA512, forcibly reset the hash
  #       algorithm to SHA1.
  #
  if {[haveConstraint harpy.isolated]} then {
    certificate metadata $certificate HashAlgorithm SHA1
  } else {
    $certificate HashAlgorithm SHA1
  }

  list [certificate sign -setid -settimestamp -setkey $certificate \
      $privateKey] [certificate verify $certificate $publicKey] \
      [certificate export -validate $certificate $exportFile] \
      [certificate warning -type License $exportFile] [set certificate \
      [certificate import -alias -validate $exportFile]] \
      [certificate metadata $certificate Key]
} -cleanup {
  catch {file delete -force $exportFile}

  unset -nocomplain publicKey privateKey asmKey certificate DSA
} -constraints {eagle command.certificate command.keypair compile.XML\
file_template.xml file_TestPrivate1.dsasnk} -match regexp -result {^SignedOk\
VerifiedOk ExportedOk WarningOk Licensing#Components#Public#Certificate#\d+\
\{157 113 143 185 63 203 35 42\}$}}

