runTest {test harpy-64.3 {failed license with fail-safe mode} -setup {
  package require Licensing.Enterprise

  object invoke -flags +NonPublic \
      Licensing.Components.Private.CertificateFailSafeMode \
      Untrip

  savePolicy savedPolicy; resetPolicy
  certificate policy -enabled true

  saveKeyRing savedKeyRing License; resetKeyRing License

  try {
    set savedPolicyType [keyring policytype]
    keyring policytype License

    keyring clear; keyring merge $keyRingFile(14)
  } finally {
    if {[info exists savedPolicyType]} then {
      keyring policytype $savedPolicyType
      unset savedPolicyType
    }
  }

  saveServerEnvironmentVariables
  resetServerEnvironmentVariables

  enableFailSafeMode true
  enableTestMode true
} -body {
  list [harpy failsafetrip] [set certificate [certificate \
      loadandverify -force true -policytype License -policy \
      -EnforceKeyGroup -filename $testFile(10) 9c6c559394030af1]] \
      [harpy failsafetrip]
} -cleanup {
  enableTestMode false
  enableFailSafeMode false

  restoreServerEnvironmentVariables

  restoreKeyRing savedKeyRing License

  restorePolicy savedPolicy

  catch {
    object invoke -flags +NonPublic \
        Licensing.Components.Private.CertificateFailSafeMode \
        Untrip
  }

  unset -nocomplain certificate savedPolicyType
} -constraints [fixConstraints {eagle !harpy.plugin.isolated !harpy.obfuscated\
kapok.server command.certificate command.keyring command.harpy\
file_keyRing14.eagle file_enable_fail_safe_mode.eagle file_test10.xml\
file_disable_fail_safe_mode.eagle file_enable_test_mode.eagle\
file_disable_test_mode.eagle tlsOk}] -match regexp -result {^False\
Licensing#Components#Public#Certificate#\d+ True$}}

