  set interp [interp create -isolated -nosecurity]
} -body {
  interp set $interp keyRingFile(21) $keyRingFile(21)
  interp eval $interp {package require Security.Core}

  set code(1) [catch {
    interp eval $interp {
      keyring merge $keyRingFile(21)
    }
  } result(1)]

  set code(2) [catch {
    interp eval $interp {
      security true
      keyring merge $keyRingFile(21)
    }
  } result(2)]

  list $code(1) $result(1) $code(2) $result(2)
} -cleanup {
