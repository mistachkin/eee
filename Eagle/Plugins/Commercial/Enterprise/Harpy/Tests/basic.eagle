runTest {test harpy-75.2 {signed bundles (on-demand) ok} -setup [subst {
  set bundle1File {$bundle1File}

  source enableSecurity
  debug mount \$bundle1File
}] -body {
  source [appendArgs $bundle1File :/pkg_one.eagle]
  package provide Bundle.Test1
} -cleanup {
  catch {package forget Bundle.Test1}
  catch {debug unmount $bundle1File}
  catch {source disableSecurity}
} -constraints {eagle compile.DATA command.sql command.harpy monoBug28\
monoHang612 file_sqlite3.dll file_System.Data.SQLite.dll file_bundle1.db} \
-isolationLevel Interpreter -result {1.0}}

###############################################################################

runTest {test harpy-75.3 {signed bundles (on-demand) xml} -setup [subst {
  set bundle1File {$bundle1File}

  source enableSecurity
  debug mount \$bundle1File

  debug vout stdout true
}] -body {
  list [catch {
    source [appendArgs $bundle1File :/secureTest.xml]
  } error] $error [debug vout stdout]
} -cleanup {
  debug vout stdout false

  catch {debug unmount $bundle1File}
  catch {source disableSecurity}

  unset -nocomplain error
} -constraints {eagle compile.DATA compile.XML command.sql command.harpy\
monoBug28 monoHang612 file_sqlite3.dll file_System.Data.SQLite.dll\
file_bundle1.db} -isolationLevel Interpreter -result [list 0 {} \
[subst {Hello World - [appendArgs $bundle1File :/secureTest.xml]
}]]}

###############################################################################

runTest {test harpy-75.4 {signed bundles (on-demand) error} -setup [subst {
  set bundle1File {$bundle1File}

  source enableSecurity
  debug mount \$bundle1File
}] -body {
  source [appendArgs $bundle1File :/Harpy/Tests/data/good.eagle]
} -cleanup {
