###############################################################################

runTest {test harpy-21.1 {keypair generate sub-command (RSA)} -setup {
  package require Licensing.Enterprise

  set fileName [file join \
      [getTemporaryPath] [appendArgs harpy-21.1- [pid] .snk]]

  catch {file delete -force $fileName}
} -body {
  list [keypair generate -keysize 2048 $fileName] [keypair token $fileName]
} -cleanup {
  catch {file delete -force $fileName}

  unset -nocomplain fileName
} -constraints [fixConstraints {eagle command.keypair\
!compile.NET_STANDARD_20}] -match regexp -result {^\{\} [0-9A-Fa-f]{16}$}}

###############################################################################

runTest {test harpy-21.2 {keypair generate sub-command (DSA)} -setup {
  package require Licensing.Enterprise

  set fileName [file join \
      [getTemporaryPath] [appendArgs harpy-21.2- [pid] .dsasnk]]

  catch {file delete -force $fileName}
} -body {
  #
  # HACK: In isolated mode, we cannot use the KeyPairType enumeration
  #       directly.
  #
  if {[haveConstraint harpy.isolated]} then {
    set DSA 0x200
  } else {
    set DSA DSA
  }

  list [keypair generate -keypairtype $DSA $fileName] \
      [keypair token -keypairtype $DSA $fileName]
} -cleanup {
  catch {file delete -force $fileName}

  unset -nocomplain fileName DSA
} -constraints [fixConstraints {eagle command.keypair\
!compile.NET_STANDARD_20}] -match regexp -result {^\{\} [0-9A-Fa-f]{16}$}}

###############################################################################

#
# HACK: The [certificate shell] sub-command requires isolated interpreter
#       and shell support from the Eagle core library.
#
runTest {test harpy-22.1 {certificate shell sub-command (file)} -setup {
  package require Licensing.Enterprise

  saveKeyName savedKeyName; resetKeyName
  setKeyName $testKeyName(5)

  saveKeyRingName savedKeyRingName; resetKeyRingName

  savePolicy savedPolicy; resetPolicy
  certificate policy -file $testPolicy(6) -script $testPolicy(6)

  saveKeyRing savedKeyRing; resetKeyRing

  set interp [interp create -safe -nosecurity]

  if {![haveConstraint harpy.isolated]} then {
    keyring share $interp
  }

  interp set $interp plugin_path $plugin_path
  interp set $interp unsafeFile(1) $unsafeFile(1)
  interp set $interp unsafeFile(2) $unsafeFile(2)

  if {[haveConstraint harpy.isolated]} then {
    interp set $interp testKeyName(2) $testKeyName(2)
    interp set $interp testKeyName(5) $testKeyName(5)
    interp set $interp testPolicy(5) $testPolicy(5)
    interp set $interp testPolicy(6) $testPolicy(6)

    package require Eagle.Test

    interp eval $interp [makeProcedureCommand enableFlags]
    interp eval $interp [makeProcedureCommand enablePluginFlags]

    debug secureeval -trusted true -- $interp {
      set savedPluginFlags [enablePluginFlags]
      enablePluginFlags Isolated true
    }
  }

  debug secureeval -trusted true -- $interp {
    object invoke Interpreter.GetActive Quiet true
  }

  debug secureeval -trusted true -- $interp {
    load $plugin_path Licensing.Enterprise
  }

  interp expose $interp debug; # allow [debug *]

  set subCommands [getAllowedSubCommands $interp certificate]

  $subCommands Add shell null; # allow [certificate shell]

  if {[haveConstraint harpy.isolated]} then {
    setAllowedSubCommands $interp certificate $subCommands

    debug secureeval -trusted true -- $interp {
      certificate keyname -file $testKeyName(2) -script $testKeyName(2) \
          -stream $testKeyName(2)

      certificate policy -file $testPolicy(5) -script $testPolicy(5)

      keyring bootstrap

      certificate keyname -file $testKeyName(5) -script $testKeyName(5) \
          -stream $testKeyName(5)

      certificate policy -file $testPolicy(6) -script $testPolicy(6)
    }
  }

  debug secureeval -trusted true -- $interp {
    object invoke Interpreter.GetActive ExitCode Success
  }
} -body {
  list [interp eval $interp {certificate shell}] \
      [interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            "set harpy-22.1 1"
      }] \
      [interp eval $interp {set harpy-22.1}] \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -anyFile $unsafeFile(1)
      }} result(1)] $result(1) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -file $unsafeFile(1)
      }} result(2)] $result(2) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -anyFile $unsafeFile(2)
      }} result(3)] $result(3) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -file $unsafeFile(2)
      }} result(4)] $result(4) \
      [interp eval $interp {certificate shell InstallCallbacks}] \
      [interp eval $interp {certificate shell}] \
      [interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            "set harpy-22.1 2"
      }] \
      [interp eval $interp {set harpy-22.1}] \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -anyFile $unsafeFile(1)
      }} result(5)] $result(5) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -file $unsafeFile(1)
      }} result(6)] $result(6) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -anyFile $unsafeFile(2)
      }} result(7)] $result(7) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -file $unsafeFile(2)
      }} result(8)] $result(8) \
      [interp eval $interp {certificate shell UninstallCallbacks}] \
      [interp eval $interp {certificate shell}] \
      [interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -evaluate \
            "set harpy-22.1 3"
      }] \
      [interp eval $interp {set harpy-22.1}] \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -anyFile $unsafeFile(1)
      }} result(9)] $result(9) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -file $unsafeFile(1)
      }} result(10)] $result(10) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -anyFile $unsafeFile(2)
      }} result(11)] $result(11) \
      [catch {interp eval $interp {
        debug shell -noArgumentsFileName -noAppSettings -file $unsafeFile(2)
      }} result(12)] $result(12)
} -cleanup {
  if {[haveConstraint harpy.isolated]} then {
    catch {
      debug secureeval -trusted true -- $interp {
        enablePluginFlags $savedPluginFlags
        unset -nocomplain savedPluginFlags
      }
    }
  }

  catch {object dispose $subCommands}
  catch {interp delete $interp}

  unset -nocomplain result harpy-22.1 subCommands interp

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  restoreKeyRingName savedKeyRingName

  restoreKeyName savedKeyName
} -constraints [fixConstraints {eagle command.certificate command.keyring\
file_unsafe1.eagle file_unsafe2.eagle compile.SHELL !harpy.obfuscated}] \
-match regexp -result \
[string map [list \$unsafeFile(2) [string map [list . \\.] $unsafeFile(2)]] \
[fixSnkTokenResult [appendArgs {^\{\{\} \{\} \{\} \{Flags Default\}\} 1 1 1\
\{permission denied: safe interpreter cannot use command "version"\} 1\
\{permission denied: safe interpreter cannot use command "version"\} 1\
\{couldn't read or get file "$unsafeFile(2)": no such file or directory\} 1\
\{couldn't read or get file "$unsafeFile(2)": no such file or directory\}\
\{\{\{(?:Eagle|Harpy), Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
(?:Eagle\._Components\.Public\.ShellCallbackBridge|}\
{Licensing\.Components\.Private\.CertificateShellOps) EvaluateScriptCallback\}\
\{\{(?:Eagle|Harpy), Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
(?:Eagle\._Components\.Public\.ShellCallbackBridge|}\
{Licensing\.Components\.Private\.CertificateShellOps) EvaluateFileCallback\}\
\{\{(?:Eagle|Harpy), Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
(?:Eagle\._Components\.Public\.ShellCallbackBridge|}\
{Licensing\.Components\.Private\.CertificateShellOps)\
EvaluateEncodedFileCallback\} \{Flags Default\}\} \{\{\{(?:Eagle|Harpy),\
Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
(?:Eagle\._Components\.Public\.ShellCallbackBridge|}\
{Licensing\.Components\.Private\.CertificateShellOps) EvaluateScriptCallback\}\
\{\{(?:Eagle|Harpy), Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
(?:Eagle\._Components\.Public\.ShellCallbackBridge|}\
{Licensing\.Components\.Private\.CertificateShellOps) EvaluateFileCallback\}\
\{\{(?:Eagle|Harpy), Version=\d+\.\d+\.\d+.\d+, Culture=neutral,\
PublicKeyToken=(?:$publicKeyToken(0)|$publicKeyToken(1))\}\
(?:Eagle\._Components\.Public\.ShellCallbackBridge|}\
{Licensing\.Components\.Private\.CertificateShellOps)\
EvaluateEncodedFileCallback\} \{Flags Default\}\} 2 2 0 1 0 1 1 \{certificate\
file "unsafe2\.eagle\.harpy" does not exist\} 1 \{certificate file\
"unsafe2\.eagle\.harpy" does not exist\} \{\{\} \{\} \{\} \{Flags Default\}\}\
\{\{\} \{\} \{\} \{Flags Default\}\} 3 3 1 \{permission denied: safe\
interpreter cannot use command "version"\} 1 \{permission denied: safe\
interpreter cannot use command "version"\} 1 \{couldn't read or get file\
"$unsafeFile(2)": no such file or directory\} 1 \{couldn't read or get file\
"$unsafeFile(2)": no such file or directory\}$}]]]}

