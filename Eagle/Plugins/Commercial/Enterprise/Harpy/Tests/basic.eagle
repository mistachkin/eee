runTest {test harpy-66.1 {process license ticket} -setup {
  package require Licensing.Enterprise
} -body {
  set changeCount(before) [harpy changecount]

  set code [catch {
    ksource -withcommands -useshared -useplugin -usecontext -- \
        $licenseTicketFile
  } result]

  set changeCount(after) [harpy changecount]

  noContextVariables

  list $code [string trim $result] \
      [expr {$changeCount(after) - $changeCount(before)}]
} -cleanup {
  unset -nocomplain changeCount code result
} -constraints {eagle command.ksource command.harpy\
file_license_ticket.eagle} -match regexp -result {^0 \{Redeemed test process\
license ticket: Harpy SDK v1\.15 License Ticket for Process \d+\
4b97b7f9-4dd5-4be4-9fef-00ddb64b9839\} 2$}}

###############################################################################

runTest {test harpy-67.1 {cryptography rc4 sub-command} -setup {
  package require Licensing.Enterprise

  set haveCryptoApi [isWindows]

  set kr \xAA\x82\x02\x13\x99\xAF\xBB\x88
  set pr [expr {randstr(200)}]

  set ke [base64 encode $kr]
  set pe [base64 encode $pr]
} -body {
  set c0 [cryptography rc4 \
      -cryptoapi false -encrypt true -obfuscate true $ke $pe]

  set d0 [cryptography rc4 \
      -cryptoapi false -encrypt false -obfuscate true $ke $c0]

  #############################################################################

  set c1 [cryptography rc4 \
      -cryptoapi false -encrypt true -obfuscate false $ke $pe]

  set d1 [cryptography rc4 \
      -cryptoapi false -encrypt false -obfuscate false $ke $c1]

  #############################################################################

  if {$haveCryptoApi} then {
    set c2 [cryptography rc4 \
        -cryptoapi true -encrypt true -obfuscate true $ke $pe]

    set d2 [cryptography rc4 \
        -cryptoapi true -encrypt false -obfuscate true $ke $c2]

    ###########################################################################

    set c3 [cryptography rc4 \
        -cryptoapi true -encrypt true -obfuscate false $ke $pe]

    set d3 [cryptography rc4 \
        -cryptoapi true -encrypt false -obfuscate false $ke $c3]
  }

  #############################################################################

  set c4 [cryptography rc4 \
      -encoding OneByte -cryptoapi false -encrypt true \
      -obfuscate true $kr $pr]

  set d4 [cryptography rc4 \
      -encoding OneByte -cryptoapi false -encrypt false \
      -obfuscate true $kr $c4]

  #############################################################################

  set c5 [cryptography rc4 \
      -encoding OneByte -cryptoapi false -encrypt true \
      -obfuscate false $kr $pr]

  set d5 [cryptography rc4 \
      -encoding OneByte -cryptoapi false -encrypt false \
      -obfuscate false $kr $c5]

  #############################################################################

  if {$haveCryptoApi} then {
    set c6 [cryptography rc4 \
        -encoding OneByte -cryptoapi true -encrypt true \
        -obfuscate true $kr $pr]

    set d6 [cryptography rc4 \
        -encoding OneByte -cryptoapi true -encrypt false \
        -obfuscate true $kr $c6]

    ###########################################################################

    set c7 [cryptography rc4 \
        -encoding OneByte -cryptoapi true -encrypt true \
        -obfuscate false $kr $pr]

    set d7 [cryptography rc4 \
        -encoding OneByte -cryptoapi true -encrypt false \
        -obfuscate false $kr $c7]
  }

  #############################################################################

  if {$haveCryptoApi} then {
    list [string equal $c0 $c1] [string equal $c0 $c2] \
        [string equal $c0 $c3] [string equal $c0 $c4] \
        [string equal $c0 $c5] [string equal $c0 $c6] \
        [string equal $c0 $c7] [string equal $d0 $pe] \
        [string equal $d1 $pe] [string equal $d2 $pe] \
        [string equal $d3 $pe] [string equal $d4 $pr] \
        [string equal $d5 $pr] [string equal $d6 $pr] \
        [string equal $d7 $pr]
  } else {
    list [string equal $c0 $c1] [string equal $c0 $c4] \
        [string equal $c0 $c5] [string equal $d0 $pe] \
        [string equal $d1 $pe] [string equal $d4 $pr] \
        [string equal $d5 $pr]
  }
} -cleanup {
  unset -nocomplain haveCryptoApi kr pr ke pe
  unset -nocomplain c0 d0 c1 d1 c2 d2 c3 d3 c4 d4 c5 d5 c6 d6 c7 d7
} -constraints {eagle command.cryptography} -match regexp -result {^False False\
False False False False False True True True True True True True True|False\
False False True True True True$}}

###############################################################################

runTest {test harpy-69.1 {enableSecurity via ksource} -setup [subst {
  package require Security.Core
  package require Harpy.Test

  proc noContextVariables {[info args noContextVariables]} {
    [string map [list \
        %varNames% [getContextVariables true]] \
        [info body noContextVariables]]
  }

  set enableSecurityFile {$enableSecurityFile}
  set badFile {$badFile}
  set goodFile {$goodFile}

  saveKeyRing savedKeyRing Script

  saveEnvironmentVariables \[list NoLicensingPackageUnknown\]
}] -body {
  set env(NoLicensingPackageUnknown) 1

  set code(1) [catch {
    ksource -withcommands -useshared -useplugin -usecontext -- \
        $enableSecurityFile
  } result(1)]

  set code(2) [catch {
    source $badFile
  } result(2)]

  set code(3) [catch {
    source $goodFile
  } result(3)]

  noContextVariables

  list $code(1) $result(1) \
      $code(2) [string map [list $badFile <badFile>] $result(2)] \
      $code(3) [string map [list $goodFile <goodFile>] $result(3)]
} -cleanup {
  restoreEnvironmentVariables [list NoLicensingPackageUnknown]

  restoreKeyRing savedKeyRing Script

  unset -nocomplain code result
} -constraints {eagle command.certificate command.harpy command.keyring\
command.ksource file_enable_security.eagle file_bad.eagle file_good.eagle} \
-isolationLevel Maximum -noSecurity true -match regexp -result {^0 \{security\
was disabled set enabled is enabled interpreter synchronized loaded \d+\
certificates unavailable\} 1 \{couldn't read or get file "<badFile>": no such\
file or directory\} 0 \{This script should be evaluated\.\}$}}

