###############################################################################

runTest {test harpy-10.3 {flags verify sub-command and corner-cases} -setup {
  package require Licensing.Enterprise
} -body {
  #
  # NOTE: These test cases are specifically designed to stress all the
  #       reachable code paths through the AttributeFlags.Parse method
  #       from the Eagle core library.
  #
  list [catch {flags verify -fromobject -- null} error] $error \
      [catch {flags verify -- ""} error] $error \
      [catch {flags verify -- "abb"} error] $error \
      [catch {flags verify -- "abc"} error] $error \
      [catch {flags verify -- "09az"} error] $error \
      [catch {flags verify -- "az09"} error] $error \
      [catch {flags verify -- "{}00"} error] $error \
      [catch {flags verify -- "00{}"} error] $error \
      [catch {flags verify -complex -- "{0}00"} error] $error \
      [catch {flags verify -complex -- "00{0}"} error] $error \
      [catch {flags verify -complex -- "{z}00"} error] $error \
      [catch {flags verify -complex -- "00{z}"} error] $error \
      [catch {flags verify -complex -- "{0:}00"} error] $error \
      [catch {flags verify -complex -- "00{0:}"} error] $error \
      [catch {flags verify -complex -- "\{\{0:\}"} error] $error \
      [catch {flags verify -complex -- "0{0:a}0{1:b}"} error] $error \
      [catch {flags verify -- "0 0"} error] $error \
      [catch {flags verify -space -- "0 0"} error] $error \
      [catch {flags verify -complex -- "{0000000000000000abc}"} error] $error \
      [catch {flags verify -complex -- "\{0000000000000000abc"} error] $error \
      [catch {flags verify -- "\}"} error] $error \
      [catch {flags verify -- "0\}"} error] $error \
      [catch {flags verify -complex -- "\}"} error] $error \
      [catch {flags verify -complex -- "0\}"} error] $error \
      [catch {flags verify -complex -- "{:}"} error] $error \
      [catch {flags verify -complex -space -- "{ :}"} error] $error \
      [catch {flags verify -complex -space -- "{ 1:a}"} error] $error \
      [catch {flags verify -complex -space -- "{ 1:a}z"} error] $error \
      [catch {flags verify A:2} error] $error \
      [catch {flags verify -complex A::2} error] $error \
      [catch {flags verify -complex "{A::2}"} error] $error \
      [catch {flags verify -complex "{0123456789ABCDEF0:2}"} error] $error \
      [catch {flags verify -complex "{E9FD7667C9DCA139:H7Du}"} error] $error
} -cleanup {
  unset -nocomplain error
} -constraints {eagle command.flags} -time true -result {1 {invalid flags} 0 {}\
0 {} 0 {} 0 {} 0 {} 1 {unexpected open brace at index 0, simple-only mode} 1\
{unexpected open brace at index 2, simple-only mode} 1 {unexpected close brace\
at index 2, name incomplete} 1 {unexpected close brace at index 4, name\
incomplete} 1 {invalid name character 'z' at index 1} 1 {invalid name character\
'z' at index 3} 0 {} 0 {} 1 {unexpected open brace at index 1, already open} 0\
{} 1 {invalid value character ' ' at index 1} 0 {} 0 {} 1 {close brace\
expected} 1 {unexpected close brace at index 0, simple-only mode} 1 {unexpected\
close brace at index 1, simple-only mode} 1 {unexpected close brace at index 0,\
already closed} 1 {unexpected close brace at index 1, already closed} 1\
{unexpected name separator at index 1, name missing} 1 {unexpected name\
separator at index 2, name missing} 0 {} 0 {} 1 {unexpected name separator at\
index 1, simple-only mode} 1 {unexpected name separator at index 1, name\
missing} 1 {unexpected name separator at index 3, already seen?} 1 {unexpected\
name separator at index 18, already complete} 0 {}}}

###############################################################################

runTest {test harpy-10.4 {flags check sub-command} -setup {
  package require Licensing.Enterprise
} -body {
  #
  # HACK: In isolated mode, we cannot use the FlagRuleType enumeration
  #       directly.
  #
  if {[haveConstraint harpy.isolated]} then {
    set MatchAllKey 0x100000; set MatchAllRule 0x1000000
  } else {
    set MatchAllKey MatchAllKey; set MatchAllRule MatchAllRule
  }

  list [catch {
        flags check -allow [list a] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllKey] \
            -allow [list a] abc
      } error] $error \
      [catch {
        flags check -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllKey] \
            -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllRule] \
            -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllRule " " $MatchAllKey] \
            -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -deny [list b] -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllKey] \
            -deny [list b] -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllRule] \
            -deny [list b] -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllRule " " $MatchAllKey] \
            -deny [list b] -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -deny [list z] -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllKey] \
            -deny [list z] -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllRule] \
            -deny [list z] -allow [list a z] abc
      } error] $error \
      [catch {
        flags check -ruletype [appendArgs + $MatchAllRule " " $MatchAllKey] \
            -deny [list z] -allow [list a z] abc
      } error] $error
} -cleanup {
  unset -nocomplain MatchAllRule MatchAllKey error
} -constraints {eagle command.flags} -time true -result {0 True 0 True 0 True 0\
True 0 False 0 False 0 False 0 False 0 False 0 False 0 True 0 True 0 False 0\
False}}

