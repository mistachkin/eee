    [file tail $snippetsResultFile]]]} then {
  checkForFile $test_channel $snippetsResultFile
}

###############################################################################

if {![info exists no(harpy)] && ![info exists no(compileOptions)]} then {
  checkForKnownHarpyCompileOptions $test_channel
}

###############################################################################

if {![info exists no(core)] && ![info exists no(network)]} then {
  checkForNetworkHosts $test_channel $test_timeout
}

###############################################################################

#
# NOTE: We need to make sure the plugin is actually loaded prior to
#       querying the compile options.
#
if {[catch {package require Licensing.Enterprise} error] == 0} then {
  #
  # HACK: Pre-check for the [harpy] command now so that we can show
  #       the plugin compile options.
  #
  if {![haveConstraint command.harpy]} then {
    checkForCommand $test_channel harpy
  }

  #
  # NOTE: Now, check if the [harpy] command is actually available.
  #       If so, report the plugin compile options; otherwise, report
  #       that we cannot.
  #
  if {[haveConstraint command.harpy]} then {
    tputs $test_channel [appendArgs \
        "---- plugin \"Licensing.Enterprise\" compile options: " \
        [formatList [harpy options] <none>] \n]
  } else {
    tputs $test_channel [appendArgs \
        "---- harpy command not available\n"]
  }
} else {
  tputs $test_channel [appendArgs \
      "---- failed to load plugin: " $error \n]
}

unset -nocomplain error
tputs $test_channel "---- checking for plugin isolation... "

if {[isEagle] && ![haveConstraint harpy.plugin.isolated]} then {
  #
  # NOTE: We need to make sure the plugin is actually loaded prior to
  #       querying the plugin flags.
  #
  if {[catch {package present Licensing.Enterprise}] == 0} then {
    #
    # NOTE: Query the plugin flags for the plugin and search them for the
    #       "Isolated" flag.  If this flag is present then the plugin has
    #       been loaded into an isolated AppDomain and some functionality
    #       will be unavailable.
    #
    if {[lsearch -exact -- \
        [getPluginFlags {^Licensing\.Enterprise, }] Isolated] != -1} then {
      addConstraint harpy.plugin.isolated

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel error\n
  }
} else {
  tputs $test_channel skipped\n
}

###############################################################################

unset -nocomplain error; # cleanup for above.

###############################################################################

if {[isEagle] && [haveConstraint command.harpy]} then {
  if {![info exists no(timeServer)]} then {
    checkForTimeServer $test_channel \
        [harpy uri HttpTimeBase] $test_timeout
  }

  #############################################################################

  if {![info exists no(libraryServer)]} then {
    checkForLibraryServer $test_channel \
        [harpy uri {:LibraryBase UseLibrary}] $test_timeout
  }

  #############################################################################

  if {![info exists no(requestServer)]} then {
    #
    # TODO: This constraint check uses a hard-coded test API key.
    #
    checkForCertificateRequestServer $test_channel \
        [harpy uri RequestBase] [harpy uri RequestRelative] \
        1935f24a-18ee-49d9-9458-555bf2f39ba5 $test_timeout
  }

  #############################################################################

  if {![info exists no(provisionServer)]} then {
    #
    # TODO: This constraint check uses a hard-coded test API key.
    #
    checkForCertificateProvisionServer $test_channel \
        [harpy uri ProvisionBase] [harpy uri ProvisionRelative] \
        1a796654-9efd-4764-b301-c644702786ca $test_timeout
  }
}

###############################################################################

#
# NOTE: Attempt to disable use of automatic network time checks for the
#       duration of the test suite, if necessary.
#
if {![haveConstraint harpy.timeServer]} then {
  #
  # HACK: Pre-check for the [certificate] command now so we can check
  #       for the network time feature.
  #
  if {![haveConstraint command.certificate]} then {
    checkForCommand $test_channel certificate
  }

  unset -nocomplain result
  tputs $test_channel "---- attempting to disable network time... "

  if {[isEagle] && [haveConstraint command.certificate] && [catch {
    list [certificate networktime false] [certificate networktime]
  } result] == 0} then {
    addConstraint harpy.noNetworkTime

    tputs $test_channel [appendArgs "yes (" $result )\n]
  } else {
    tputs $test_channel error\n
  }
}

###############################################################################

unset -nocomplain result; # cleanup for above.

###############################################################################

#
# NOTE: Check test constraints specific to tests in this file that require
#       the plugin to be loaded.
#
if {![haveConstraint command.certificate]} then {
  checkForCommand $test_channel certificate
}

if {![haveConstraint command.cryptography]} then {
  checkForCommand $test_channel cryptography
}

if {![haveConstraint command.flags]} then {
  checkForCommand $test_channel flags
}

if {![haveConstraint command.harpy]} then {
  checkForCommand $test_channel harpy
}

if {![haveConstraint command.keval]} then {
  checkForCommand $test_channel keval
}

if {![haveConstraint command.keypair]} then {
  checkForCommand $test_channel keypair
}

if {![haveConstraint command.ksource]} then {
  checkForCommand $test_channel ksource
}

if {![haveConstraint command.keyring]} then {
  checkForCommand $test_channel keyring
}

if {![haveConstraint command.secret]} then {
  checkForCommand $test_channel secret
}

if {![haveConstraint command.security]} then {
  checkForCommand $test_channel security
}

if {![haveConstraint command.storage]} then {
  checkForCommand $test_channel storage
}

if {![haveConstraint command.support]} then {
  checkForCommand $test_channel support
}

###############################################################################

tputs $test_channel "---- checking for plugin licensing... "

if {[haveConstraint command.harpy]} then {
  #
  # NOTE: Query the plugin compile-time options for the plugin and search
  #       them for the "LICENSING" option.  If this option is present then
  #       the plugin has been loaded with licensing enabled.
  #
  if {[lsearch -exact -- [harpy options] LICENSING] != -1} then {
    #
    # NOTE: This plugin is running with licensing enabled.
    #
    addConstraint harpy.licensing; # NOTE: Yep.

    tputs $test_channel enabled\n
  } else {
    tputs $test_channel disabled\n
  }
} else {
  tputs $test_channel unknown\n
}

tputs $test_channel "---- checking for plugin command isolation... "

if {![haveConstraint harpy.command.isolated]} then {
  if {[haveConstraint command.harpy]} then {
    #
    # NOTE: Check if the plugin commands were added via an isolated AppDomain;
    #       if so, special care must be taken in some tests, e.g. "harpy-8.1",
    #       "harpy-22.1", and "harpy-22.2".
    #
    if {[catch {harpy isolated} result] == 0 && $result} then {
      addConstraint harpy.command.isolated

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel unknown\n
  }
} else {
  tputs $test_channel skipped\n
}

unset -nocomplain result
tputs $test_channel "---- checking for plugin assembly obfuscation... "

if {[isEagle] && ![haveConstraint harpy.plugin.isolated]} then {
  #
  # NOTE: We need to make sure the plugin is actually loaded prior to
  #       invoking a method within it.
  #
  if {[catch {package present Licensing.Enterprise}] == 0} then {
    #
    # NOTE: Attempt to invoke a simply method within the plugin assembly.
    #       If this fails, the plugin assembly is probably obfuscated and
    #       some [internal] functionality will be unavailable.
    #
    if {[catch {
      object invoke -flags +NonPublic \
          Licensing.Components.Private.Constants IsTimeStampUtc
    }]} then {
      #
      # NOTE: This plugin assembly appears to be obfuscated.
      #
      addConstraint harpy.obfuscated

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel error\n
  }
} else {
  tputs $test_channel skipped\n
}

###############################################################################

tputs $test_channel "---- checking for core assembly strong name key... "

set publicKeyToken(0) [info engine PublicKeyToken]

if {[string length $publicKeyToken(0)] > 0} then {
  addConstraint [appendArgs core.strongName. $publicKeyToken(0)]

  if {[isCorePublicKeyToken $publicKeyToken(0)]} then {
    addConstraint core.strongName.official1

    tputs $test_channel [appendArgs "official (" $publicKeyToken(0) )\n]
  } else {
    addConstraint core.strongName.unofficial1

    tputs $test_channel [appendArgs "unofficial (" $publicKeyToken(0) )\n]
  }
} else {
  addConstraint core.strongName.none

  tputs $test_channel no\n
}

###############################################################################

if {[haveConstraint command.keypair]} then {
  tputs $test_channel "---- checking for assembly strong name key... "

  set publicKeyToken(token) [keypair token]
  set publicKeyToken(1) $publicKeyToken(token)

  if {[string length $publicKeyToken(1)] == 0} then {
    addConstraint harpy.strongName.none

    tputs $test_channel none\n
  } else {
    addConstraint [appendArgs harpy.strongName. $publicKeyToken(1)]

    #
    # BUGBUG: Tcl 8.4 does not seem to like this expression because it
    #         contains the "ni" operator added in Tcl 8.5 (and Tcl 8.4
    #         tries to compile it even though it will only be evaluated
    #         in Eagle).
    #
    set expr {$publicKeyToken(1) ni "8bf43b4749e46a0b"}

    if {[expr $expr]} then {
      addConstraint harpy.strongName.unofficial1

      tputs $test_channel [appendArgs "unofficial (" $publicKeyToken(1) )\n]
    } else {
      addConstraint harpy.strongName.official1

      tputs $test_channel [appendArgs "official (" $publicKeyToken(1) )\n]
    }

    unset expr

    #
    # NOTE: Next, check if the public key token used to sign the Harpy
    #       assembly matches the one in the specified public key file.
    #       This is an important bit of information for several of the
    #       tests.
    #
    tputs $test_channel "---- checking for matching assembly public key... "

    if {$publicKeyToken(1) eq [keypair token $publicKeyFile(1)]} then {
      addConstraint harpy.strongName.tokenMatch1

      tputs $test_channel yes\n
    } else {
      addConstraint harpy.strongName.tokenMismatch1

      tputs $test_channel no\n
    }
  }

  #############################################################################

  tputs $test_channel "---- checking for trust root strong name key... "

  set publicKeyToken(root) [keypair root]
  set publicKeyToken(primaryRoot) [lindex $publicKeyToken(root) 0]
  set publicKeyToken(2) $publicKeyToken(primaryRoot)

  if {[string length $publicKeyToken(2)] == 0} then {
    tputs $test_channel no\n
  } else {
    #
    # BUGBUG: Tcl 8.4 does not seem to like this expression because it
    #         contains the "ni" operator added in Tcl 8.5 (and Tcl 8.4
    #         tries to compile it even though it will only be evaluated
    #         in Eagle).
    #
    set expr {$publicKeyToken(2) ni "26f17c3a1a544324"}

    if {[expr $expr]} then {
      addConstraint harpy.strongName.unofficial2

      tputs $test_channel [appendArgs "unofficial (" $publicKeyToken(2) )\n]
    } else {
      addConstraint harpy.strongName.official2

      tputs $test_channel [appendArgs "official (" $publicKeyToken(2) )\n]
    }

    unset expr

    tputs $test_channel "---- checking for matching trust root public key... "

    if {$publicKeyToken(2) eq [keypair token $publicKeyFile(2)]} then {
      addConstraint harpy.strongName.tokenMatch2

      tputs $test_channel yes\n
    } else {
      addConstraint harpy.strongName.tokenMismatch2

      tputs $test_channel no\n
    }
  }

  #############################################################################

  tputs $test_channel "---- checking for backup root strong name key... "

  set publicKeyToken(backupRoot) [lindex $publicKeyToken(root) 1]
  set publicKeyToken(3) $publicKeyToken(backupRoot)

  if {[string length $publicKeyToken(3)] == 0} then {
    tputs $test_channel no\n
  } else {
    #
    # BUGBUG: Tcl 8.4 does not seem to like this expression because it
    #         contains the "ni" operator added in Tcl 8.5 (and Tcl 8.4
    #         tries to compile it even though it will only be evaluated
    #         in Eagle).
    #
    set expr {$publicKeyToken(3) ni ""}; # TODO: Add public key token.

    if {[expr $expr]} then {
      addConstraint harpy.strongName.unofficial3

      tputs $test_channel [appendArgs "unofficial (" $publicKeyToken(3) )\n]
    } else {
      addConstraint harpy.strongName.official3

      tputs $test_channel [appendArgs "official (" $publicKeyToken(3) )\n]
    }

    unset expr

    tputs $test_channel "---- checking for matching backup root public key... "

    if {$publicKeyToken(3) eq [keypair token $publicKeyFile(3)]} then {
      addConstraint harpy.strongName.tokenMatch3

      tputs $test_channel yes\n
    } else {
      addConstraint harpy.strongName.tokenMismatch3

      tputs $test_channel no\n
    }
  }

  #############################################################################

  tputs $test_channel "---- checking for redundant root strong name key... "

  set publicKeyToken(redundantRoot) [lindex $publicKeyToken(root) 1]
  set publicKeyToken(4) $publicKeyToken(redundantRoot)

  if {[string length $publicKeyToken(4)] == 0} then {
    tputs $test_channel no\n
  } else {
    #
    # BUGBUG: Tcl 8.4 does not seem to like this expression because it
    #         contains the "ni" operator added in Tcl 8.5 (and Tcl 8.4
    #         tries to compile it even though it will only be evaluated
    #         in Eagle).
    #
    set expr {$publicKeyToken(4) ni "298cfe3b5670142f 45688a99cec07850"}

    if {[expr $expr]} then {
      addConstraint harpy.strongName.unofficial4

      tputs $test_channel [appendArgs "unofficial (" $publicKeyToken(4) )\n]
    } else {
      addConstraint harpy.strongName.official4

      tputs $test_channel [appendArgs "official (" $publicKeyToken(4) )\n]
    }

    unset expr

    tputs $test_channel "---- checking for matching redundant root public key... "

    if {$publicKeyToken(4) eq [keypair token $publicKeyFile(4)]} then {
      addConstraint harpy.strongName.tokenMatch4

      tputs $test_channel yes\n
    } else {
      addConstraint harpy.strongName.tokenMismatch4

      tputs $test_channel no\n
    }
  }

  #############################################################################

  tputs $test_channel "---- checking for script strong name key... "

  set publicKeyToken(script) [keypair script]
  set publicKeyToken(5) $publicKeyToken(script)

  if {[string length $publicKeyToken(5)] == 0} then {
    tputs $test_channel no\n
  } else {
    #
    # BUGBUG: Tcl 8.4 does not seem to like this expression because it
    #         contains the "ni" operator added in Tcl 8.5 (and Tcl 8.4
    #         tries to compile it even though it will only be evaluated
    #         in Eagle).
    #
    set expr {$publicKeyToken(5) ni "9559f6017247e3e2"}

    if {[expr $expr]} then {
      addConstraint harpy.strongName.unofficial5

      tputs $test_channel [appendArgs "unofficial (" $publicKeyToken(5) )\n]
    } else {
      addConstraint harpy.strongName.official5

      tputs $test_channel [appendArgs "official (" $publicKeyToken(5) )\n]
    }

    unset expr

    tputs $test_channel "---- checking for matching script public key... "

    if {$publicKeyToken(5) eq [keypair token $publicKeyFile(5)]} then {
      addConstraint harpy.strongName.tokenMatch5

      tputs $test_channel yes\n
    } else {
      addConstraint harpy.strongName.tokenMismatch5

      tputs $test_channel no\n
    }
  }

  #############################################################################

  tputs $test_channel "---- checking for demo strong name key... "

  set publicKeyToken(demo) 5f8230f3e7b9b317; # TODO: Hard-coded.
  set publicKeyToken(6) $publicKeyToken(demo)

  if {[string length $publicKeyToken(6)] == 0} then {
    tputs $test_channel no\n
  } else {
    tputs $test_channel yes\n

    tputs $test_channel "---- checking for matching demo public key... "

    if {$publicKeyToken(6) eq [keypair token $publicKeyFile(6)]} then {
      addConstraint harpy.strongName.tokenMatch6

      tputs $test_channel yes\n
    } else {
      addConstraint harpy.strongName.tokenMismatch6

      tputs $test_channel no\n
    }
  }

  #############################################################################

  #
  # NOTE: Some of the tests require the strong name public keys to be
  #       present as embedded resources.
  #
  tputs $test_channel "---- checking for first public test key name... "

  if {![haveConstraint harpy.strongName.resource1]} then {
    if {[string length $testKeyName(1)] == 0 || \
        $testKeyName(1) in [keypair resources *.snk]} then {
      addConstraint harpy.strongName.resource1

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel skipped\n
  }

  #############################################################################

  tputs $test_channel "---- checking for second public test key name... "

  if {![haveConstraint harpy.strongName.resource2]} then {
    if {[string length $testKeyName(2)] == 0 || \
        $testKeyName(2) in [keypair resources *.snk]} then {
      addConstraint harpy.strongName.resource2

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel skipped\n
  }

  #############################################################################

  tputs $test_channel "---- checking for third public test key name... "

  if {![haveConstraint harpy.strongName.resource3]} then {
    if {[string length $testKeyName(3)] == 0 || \
        $testKeyName(3) in [keypair resources *.snk]} then {
      addConstraint harpy.strongName.resource3

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel skipped\n
  }

  #############################################################################

  tputs $test_channel "---- checking for fourth public test key name... "

  if {![haveConstraint harpy.strongName.resource4]} then {
    if {[string length $testKeyName(4)] == 0 || \
        $testKeyName(4) in [keypair resources *.snk]} then {
      addConstraint harpy.strongName.resource4

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel skipped\n
  }

  #############################################################################

  tputs $test_channel "---- verifying matching assembly key pair... "

  if {[keypair token $publicKeyFile(1)] eq \
      [keypair token $privateKeyFile(1)]} then {
    addConstraint harpy.strongName.pairMatch1

    tputs $test_channel yes\n
  } else {
    addConstraint harpy.strongName.pairMismatch1

    tputs $test_channel no\n
  }

  #############################################################################

  tputs $test_channel "---- verifying matching trust root key pair... "

  if {[keypair token $publicKeyFile(2)] eq \
      [keypair token $privateKeyFile(2)]} then {
    addConstraint harpy.strongName.pairMatch2

    tputs $test_channel yes\n
  } else {
    addConstraint harpy.strongName.pairMismatch2

    tputs $test_channel no\n
  }

  #############################################################################

  tputs $test_channel "---- verifying matching backup root key pair... "

  if {[keypair token $publicKeyFile(3)] eq \
      [keypair token $privateKeyFile(3)]} then {
    addConstraint harpy.strongName.pairMatch3

    tputs $test_channel yes\n
  } else {
    addConstraint harpy.strongName.pairMismatch3

    tputs $test_channel no\n
  }

  #############################################################################

  tputs $test_channel "---- verifying matching redundant root key pair... "

  if {[keypair token $publicKeyFile(4)] eq \
      [keypair token $privateKeyFile(4)]} then {
    addConstraint harpy.strongName.pairMatch4

    tputs $test_channel yes\n
  } else {
    addConstraint harpy.strongName.pairMismatch4

    tputs $test_channel no\n
  }

  #############################################################################

  tputs $test_channel "---- verifying matching script key pair... "

  if {[keypair token $publicKeyFile(5)] eq \
      [keypair token $privateKeyFile(5)]} then {
    addConstraint harpy.strongName.pairMatch5

    tputs $test_channel yes\n
  } else {
    addConstraint harpy.strongName.pairMismatch5

    tputs $test_channel no\n
  }

  #############################################################################

  tputs $test_channel "---- verifying matching demo key pair... "

  if {[keypair token $publicKeyFile(6)] eq \
      [keypair token $privateKeyFile(6)]} then {
    addConstraint harpy.strongName.pairMatch6

    tputs $test_channel yes\n
  } else {
    addConstraint harpy.strongName.pairMismatch6

    tputs $test_channel no\n
  }
}

###############################################################################

if {[isEagle]} then {
  tputs $test_channel "---- checking for isolation... "

  if {[haveConstraint harpy.plugin.isolated] || \
      [haveConstraint harpy.command.isolated]} then {
    addConstraint harpy.isolated

    tputs $test_channel yes\n
  } else {
    tputs $test_channel no\n
  }
}

###############################################################################

if {[isEagle]} then {
  if {[haveConstraint harpy.strongName.pairMismatch1]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: assembly public key file \"" \
        $publicKeyFile(1) \
        "\" does not match up with assembly private key file \"" \
        $privateKeyFile(1) \"\n]
  }

  if {[haveConstraint harpy.strongName.pairMismatch2]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: trust root public key file \"" \
        $publicKeyFile(2) \
        "\" does not match up with trust root private key file \"" \
        $privateKeyFile(2) \"\n]
  }

  if {[haveConstraint harpy.strongName.pairMismatch3]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: backup root public key file \"" \
        $publicKeyFile(3) \
        "\" does not match up with backup root private key file \"" \
        $privateKeyFile(3) \"\n]
  }

  if {[haveConstraint harpy.strongName.pairMismatch4]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: redundant root public key file \"" \
        $publicKeyFile(4) \
        "\" does not match up with redundant root private key file \"" \
        $privateKeyFile(4) \"\n]
  }

  if {[haveConstraint harpy.strongName.pairMismatch5]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: script public key file \"" \
        $publicKeyFile(5) \
        "\" does not match up with script private key file \"" \
        $privateKeyFile(5) \"\n]
  }

  if {[haveConstraint harpy.strongName.pairMismatch6]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: demo public key file \"" \
        $publicKeyFile(6) \
        "\" does not match up with demo private key file \"" \
        $privateKeyFile(6) \"\n]
  }
}

###############################################################################

#
# NOTE: Check to see if the remote certificate server is available and is
#       apparently responding to requests.
#
checkForRemoteCertificateServer $test_channel \
    [getDictionaryValue $argv -iis] [getDictionaryValue $argv -localhost]

###############################################################################

if {[isEagle]} then {
  set plugin_path [file normalize [getPluginPath {^Licensing\.Enterprise, }]]
  set dnc_name [getDotNetCoreDirectoryNameOnly [file dirname $plugin_path]]
} else {
  set plugin_path ""
  set dnc_name ""
}

###############################################################################

if {[isEagle]} then {
  if {[havePluginLicenseEnvironmentVariableNames ""] || \
      [havePluginLicenseEnvironmentVariableNames Eagle]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: one or more common plugin license " \
        "certificates may have been overridden\n"]

    addConstraint common.certificate.overridden
  } else {
    addConstraint common.certificate.default
  }

  if {[havePluginLicenseEnvironmentVariableNames Harpy]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: one or more Harpy plugin license " \
        "certificates may have been overridden\n"]

    addConstraint harpy.certificate.overridden
  } else {
    addConstraint harpy.certificate.default
  }

  if {[havePluginLicenseEnvironmentVariableNames Badge]} then {
    tputs $test_channel [appendArgs \
        "==== WARNING: one or more Badge plugin license " \
        "certificates may have been overridden\n"]

    addConstraint badge.certificate.overridden
  } else {
    addConstraint badge.certificate.default
  }
}

###############################################################################

if {![info exists no(harpyBasePath)] && \
    ![haveConstraint harpy_base_path]} then {
  tputs $test_channel "---- checking for plugin base path... "

  if {[info exists base_path] && \
      [info exists plugin_path] && \
      [string starts $base_path $plugin_path]} then {
    addConstraint harpy_base_path

    tputs $test_channel yes\n
  } else {
    tputs $test_channel no\n
  }
}

###############################################################################

proc enableTracingForPolicy { channel } {
  if {![info exists ::saved_trace_for_policy]} then {
    set ::saved_trace_for_policy [certificate policytrace]
  }

  if {[info exists ::env(VerbosePolicyTrace)]} then {
    certificate policytrace Verbose
  } else {
    certificate policytrace Default; # TODO: Good default?
  }

  tputs $channel [appendArgs \
      "---- enabled forced policy tracing, previously: " \
      $::saved_trace_for_policy \n]
}

###############################################################################

proc restoreTracingForPolicy { channel } {
  if {[info exists ::saved_trace_for_policy]} then {
    set was_trace_for_policy $::saved_trace_for_policy
    unset ::saved_trace_for_policy
  } else {
    set was_trace_for_policy None; # TODO: Good default?
  }

  certificate policytrace $was_trace_for_policy

  tputs $channel [appendArgs \
      "---- restored forced policy tracing to: " \
      $was_trace_for_policy \n]
}

###############################################################################

proc enableConfiguration { channel enable } {
  if {![info exists ::saved_no_configuration]} then {
    set ::saved_no_configuration \
        [info exists ::env(NoConfiguration)]
  }

  if {$enable} then {
    unset -nocomplain ::env(NoConfiguration)
  } else {
    set ::env(NoConfiguration) 1
  }

  tputs $channel [appendArgs \
      "---- " [expr {$enable ? "enabled" : "disabled"}] \
      " configuration, previously " \
      [expr {$::saved_no_configuration ? "disabled" : "enabled"}] \n]
}

###############################################################################

proc restoreConfiguration { channel } {
  if {[info exists ::saved_no_configuration]} then {
    set was_no_configuration $::saved_no_configuration
    unset ::saved_no_configuration
  } else {
    set was_no_configuration 0; # TODO: Good default?
  }

  if {$was_no_configuration} then {
    set ::env(NoConfiguration) 1
  } else {
    unset -nocomplain ::env(NoConfiguration)
  }

  tputs $channel [appendArgs \
      "---- restored configuration to " \
      [expr {$was_no_configuration ? "disabled" : "enabled"}] \n]
}

###############################################################################

proc showLocalTimeDifference { type code result } {
  if {$code == 0} then {
    set ticks [object invoke DateTime UtcNow.Ticks]
    set local [object create -alias DateTime $ticks Utc]

    set remote [object create -alias \
        DateTime [lindex $result 1] [lindex $result 0]]

    set difference [$local Subtract $remote]
    set format [getDateTimeFormat true]

    tputs $::test_channel [appendArgs \
        "==== TIME: local " [$local ToString $format] " (Utc " \
        $ticks ") versus remote " [$remote ToString $format] " (" \
        $result "), difference of " $difference " via " $type \n]
  }
}

###############################################################################

proc getResultFromPath { path } {
  if {[string length $path] == 0} then {
    return ""
  }

  return [list $path]
}

###############################################################################

proc populateDefaultPolicies {} {
  if {[isEagle]} then {
    global testPolicy

    if {[haveConstraint harpy.plugin.isolated] || \
        [haveConstraint harpy.obfuscated]} then {
      if {[catch {certificate defaultpolicy} result] == 0} then {
        set testPolicy(23) [split [getDictionaryValue $result -script] ,]
        set testPolicy(24) [split [getDictionaryValue $result -file] ,]
        set testPolicy(25) [split [getDictionaryValue $result -stream] ,]
        set testPolicy(26) [split [getDictionaryValue $result -license] ,]
        set testPolicy(27) [split [getDictionaryValue $result -keypair] ,]
        set testPolicy(28) [split [getDictionaryValue $result -trace] ,]
        set testPolicy(29) [split [getDictionaryValue $result -other] ,]
      }
    } else {
      set testPolicy(23) [split [object invoke \
          Licensing.Components.Private.Constants \
          DefaultScriptExecutionPolicy] ,]

      set testPolicy(24) [split [object invoke \
          Licensing.Components.Private.Constants \
          DefaultFileExecutionPolicy] ,]

      set testPolicy(25) [split [object invoke \
          Licensing.Components.Private.Constants \
          DefaultStreamExecutionPolicy] ,]

      set testPolicy(26) [split [object invoke \
          Licensing.Components.Private.Constants \
          DefaultLicenseExecutionPolicy] ,]

      set testPolicy(27) [split [object invoke \
          Licensing.Components.Private.Constants \
          DefaultKeyPairExecutionPolicy] ,]

      set testPolicy(28) [split [object invoke \
          Licensing.Components.Private.Constants \
          DefaultTraceExecutionPolicy] ,]

      set testPolicy(29) [split [object invoke \
          Licensing.Components.Private.Constants \
          DefaultOtherExecutionPolicy] ,]
    }
  }
}

###############################################################################

proc populateSimplePolicies {} {
  if {[isEagle]} then {
    global testPolicy

    if {[haveConstraint harpy.plugin.isolated] || \
        [haveConstraint harpy.obfuscated]} then {
      if {[catch {certificate simplepolicy} result] == 0} then {
        set testPolicy(9) [split [getDictionaryValue $result -script] ,]
        set testPolicy(10) [split [getDictionaryValue $result -file] ,]
        set testPolicy(11) [split [getDictionaryValue $result -stream] ,]
        set testPolicy(12) [split [getDictionaryValue $result -license] ,]
        set testPolicy(13) [split [getDictionaryValue $result -keypair] ,]
        set testPolicy(14) [split [getDictionaryValue $result -trace] ,]
        set testPolicy(15) [split [getDictionaryValue $result -other] ,]
      }
    } else {
      set testPolicy(9) [split [object invoke \
          Licensing.Components.Private.Constants \
          SimpleScriptExecutionPolicy] ,]

      set testPolicy(10) [split [object invoke \
          Licensing.Components.Private.Constants \
          SimpleFileExecutionPolicy] ,]

      set testPolicy(11) [split [object invoke \
          Licensing.Components.Private.Constants \
          SimpleStreamExecutionPolicy] ,]

      set testPolicy(12) [split [object invoke \
          Licensing.Components.Private.Constants \
          SimpleLicenseExecutionPolicy] ,]

      set testPolicy(13) [split [object invoke \
          Licensing.Components.Private.Constants \
          SimpleKeyPairExecutionPolicy] ,]

      set testPolicy(14) [split [object invoke \
          Licensing.Components.Private.Constants \
          SimpleTraceExecutionPolicy] ,]

      set testPolicy(15) [split [object invoke \
          Licensing.Components.Private.Constants \
          SimpleOtherExecutionPolicy] ,]
    }
  }
}

###############################################################################

proc resetFeatures { features } {
  if {[isEagle] && [haveConstraint command.ksource] && \
      [info exists ::setFeaturesFile]} then {
    try {
      uplevel 1 [list set features $features]; # global

      return [uplevel 1 [list ksource \
          -withcommands -useshared -useplugin -usecontext -- \
          $::setFeaturesFile]]
    } finally {
      uplevel 1 [list unset -nocomplain features]; # cleanup
    }
  }
}

###############################################################################

proc getContextCommands { {all false} } {
  set result [list]

  lappend result applyContextVariables
  lappend result breakOutNow
  lappend result changeDuration
  lappend result changeTimeServers
  lappend result changeVersionRange
  lappend result configureRuleSet
  lappend result continueWithNow
  lappend result enableExtractAndApply
  lappend result evaluateWithCleanup
  lappend result evaluateWithoutError
  lappend result evaluateWithScope
  lappend result failOnError
  lappend result failSafeMode
  lappend result fatalError
  lappend result forEachFile
  lappend result haveComponent
  lappend result haveConfiguration
  lappend result haveEnvironment
  lappend result haveIdentifier
  lappend result haveVariable
  lappend result isDebuggerPresentOrAttached
  lappend result isRestrictedInterpreter
  lappend result issueTicket
  lappend result joinSubPaths
  lappend result keyUsage
  lappend result listComponents
  lappend result listContextVariables
  lappend result matchPlatform
  lappend result maybeEvaluate
  lappend result maybeIterateUsingExpression
  lappend result maybeRecordResult
  lappend result notAfter
  lappend result notBefore
  lappend result peekOnFlags
  lappend result queryStatus
  lappend result queueScript
  lappend result readScript
  lappend result redeemTicket
  lappend result refreshContextVariables
  lappend result requireAdministrator
  lappend result requireComponent
  lappend result requireData
  lappend result requireEnvironment
  lappend result requireIdentifier
  lappend result requireLicense
  lappend result requireNetwork
  lappend result requireProcess
  lappend result requireTracing
  lappend result requireTrusted
  lappend result requireVariable
  lappend result requireVerified
  lappend result requireVersion
  lappend result restoreContextVariables
  lappend result returnBackNow
  lappend result saveContextVariables
  lappend result setConfiguration
  lappend result setData
  lappend result setEnvironment
  lappend result setVariable
  lappend result skipLicense
  lappend result snippet
  lappend result storageType
  lappend result swapCommands
  lappend result testMode
  lappend result unsetVariable
  lappend result writeStatus
  lappend result writeWithoutFail

  if {$all || [haveConstraint harpyCompile.NETWORK]} then {
    lappend result offlineMode
  }

  if {$all || [haveConstraint harpyCompile.DEMO_KEY_PAIRS] || \
              [haveConstraint harpyCompile.DEMO_EDITION]} then {
    lappend result demoMode
  }

  if {$all || [haveConstraint harpyCompile.SHELL]} then {
    lappend result interactiveLoop

    if {$all || ([haveConstraint harpyCompile.CERTIFICATE_PLUGIN] && \
                 [haveConstraint harpyCompile.CERTIFICATE_POLICY] && \
                 [haveConstraint harpyCompile.PLUGIN_COMMANDS])} then {
      lappend result requireShell
    }
  }

  if {$all || [haveConstraint harpyCompile.CERTIFICATE_PLUGIN]} then {
    if {$all || ![haveConstraint harpyCompile.LIMITED_EDITION]} then {
      lappend result changeFeatures
      lappend result haveFeatures
      lappend result requireFeatures
    }

    if {$all || [haveConstraint harpyCompile.CERTIFICATE_POLICY]} then {
      lappend result addCertificates
      lappend result addPublicKey
      lappend result addRingPublicKey
      lappend result changeLicensePolicy
      lappend result changeNetworkFlags
      lappend result changePathFlags
      lappend result changePolicyProperty
      lappend result configurePackages
      lappend result disableInterpreterCreation
      lappend result enableInterpreterCreation
      lappend result enableLocalPolicy
      lappend result enableSecurity
      lappend result evaluateFile
      lappend result evaluateStream
      lappend result forEachPolicyType
      lappend result havePublicKey
      lappend result haveRingPublicKey
      lappend result removePublicKey
      lappend result removeRingPublicKey
      lappend result requireMachine
      lappend result requirePublicKey
    }

    if {$all || [haveConstraint harpyCompile.PLUGIN_COMMANDS]} then {
      lappend result changeLicenseProperty
    }
  }

  if {$all || [haveConstraint harpyCompile.TEST]} then {
    lappend result cleanupForSandbox
    lappend result evaluateInSandbox
    lappend result waitForSandbox
  }

  if {$all || [haveConstraint harpyCompile.XML]} then {
    if {$all || ([haveConstraint harpyCompile.CERTIFICATE_PLUGIN] && \
                 [haveConstraint harpyCompile.PLUGIN_COMMANDS])} then {
      lappend result setPassword
    }

    if {$all || ([haveConstraint harpyCompile.NETWORK] && \
                 [haveConstraint harpyCompile.WEB])} then {
      lappend result downloadAndInstall
      lappend result extractZipFile
      lappend result makeUriRequest
      lappend result removeLicense
      lappend result requestLicense
    }
  }

  if {$all || [haveConstraint harpyCompile.WEB]} then {
    lappend result joinUriParts
  }

  return [lsort -nocase $result]
}

###############################################################################

proc getContextVariables { {all false} } {
  set result [list]

  lappend result pluginChangeCount
  lappend result pluginConfigurationPhase
  lappend result pluginContext
  lappend result pluginDuration
  lappend result pluginFailSafeMode
  lappend result pluginForceNetwork
  lappend result pluginIsolated
  lappend result pluginMustHaveSecurity
  lappend result pluginPublicKeyToken
  lappend result pluginSdkMode
  lappend result pluginSkipLicense
  lappend result pluginStorageType
  lappend result pluginTestMode
  lappend result pluginTimeServers
  lappend result pluginType
  lappend result pluginVariant
  lappend result pluginVersionRange
  lappend result scriptDirectory
  lappend result scriptFileId
  lappend result scriptFileName
  lappend result scriptSubType
  lappend result scriptType

  if {$all || [haveConstraint harpyCompile.NETWORK]} then {
    lappend result pluginOfflineMode
  }

  if {$all || [haveConstraint harpyCompile.DEMO_KEY_PAIRS] || \
              [haveConstraint harpyCompile.DEMO_EDITION]} then {
    lappend result pluginDemoMode
  }

  if {$all || [haveConstraint harpyCompile.CERTIFICATE_PLUGIN]} then {
    lappend result pluginCount

    if {$all || ![haveConstraint harpyCompile.LIMITED_EDITION]} then {
      lappend result pluginFeatures
    }

    if {$all || [haveConstraint harpyCompile.CERTIFICATE_POLICY]} then {
      lappend result interpreterCreation
      lappend result pluginLicensePolicy
      lappend result pluginMachine
      lappend result pluginNetworkFlags
      lappend result pluginPathFlags
      lappend result pluginPending
      lappend result pluginPolicyProperty
      lappend result scriptKeyPairs
      lappend result scriptPublicKeyToken

      if {$all || ([haveConstraint harpyCompile.SHELL] && \
                   [haveConstraint harpyCompile.PLUGIN_COMMANDS])} then {
        lappend result pluginShellFlags
      }
    }
  }

  return [lsort $result]
}

###############################################################################

proc noContextVariables {} {
  set result [list]

  if {[llength [info commands getContextVariables]] > 0} then {
    set varNames [getContextVariables true]
  } else {
    set varNames {%varNames%}
  }

  if {[llength $varNames] <= 1} then {
    error "list of possible context variables is unavailable"
  }

  foreach varName $varNames {
    if {[uplevel 1 [list info exists $varName]]} then {
      lappend result $varName
    }
  }

  set length [llength $result]

  if {$length > 0} then {
    error [appendArgs \
        "found " $length " context variables: " $result \n]
  }

  return ""
}

###############################################################################

proc configurationReset {} {
  configurationReport [harpy configurations \
      {+Global Reset WithOkResults WithErrorResults}]
}

###############################################################################

proc configurationReport { configurations } {
  if {[llength $configurations] > 0} then {
    set oks [getDictionaryValue $configurations Ok]

    if {[llength $oks] > 0} then {
      set okCount 0

      foreach {pluginName fileName result} $oks {
        set directory [file dirname $fileName]

        if {[string length $directory] > 0 && $directory ne "."} then {
          set type file
        } else {
          set type stream
        }

        tputs $::test_channel [appendArgs \
            "---- success loading configuration " $type " \"" \
            $fileName "\" for plugin \"" $pluginName \"\n]

        incr okCount
      }

      tputs $::test_channel [appendArgs \
          "---- success loading " $okCount " configurations\n"]
    }

    set errors [getDictionaryValue $configurations Error]

    if {[llength $errors] > 0} then {
      set errorCount 0

      foreach {pluginName fileName result} $errors {
        set directory [file dirname $fileName]

        if {[string length $directory] > 0 && $directory ne "."} then {
          set type file
        } else {
          set type stream
        }

        tputs $::test_channel [appendArgs \
            "---- failure loading configuration " $type " \"" \
            $fileName "\" for plugin \"" $pluginName "\": " \
            $result \n]

        incr errorCount
      }

      tputs $::test_channel [appendArgs \
          "---- failure loading " $errorCount " configurations\n"]
    }

    set resetCount [getDictionaryValue $configurations ResetCount]

    if {$resetCount >= 0} then {
      tputs $::test_channel [appendArgs \
          "---- reset " $resetCount " loaded configurations\n"]
    }
  }

  return ""
}

###############################################################################

proc getNtpServers {} {
  #
  # TODO: Update this hard-coded list of NTP servers if
  #       there are changes to it in "Private/NtpOps.cs".
  #
  set result [list]

  lappend result time.mistachkin.net; # primary

  lappend result 0.pool.ntp.org 1.pool.ntp.org \
      2.pool.ntp.org 3.pool.ntp.org; # community

  lappend result time.nist.gov; # fallback 1
  lappend result time.windows.com; # fallback 2

  return $result
}

###############################################################################

if {[isEagle]} then {
  #
  # HACK: Avoid virtual output mechanism.  First, by directly using the
  #       [host result] sub-command.  Then, using the [tlog] procedure.
  #
  proc rawPutsAndLog { string } {
    host result Ok $string; tlog $string
  }

  #
  # NOTE: Return an ISO 8601 format string, except that there is a space
  #       for the date/time separator instead of a literal "T" character.
  #
  proc getDateTimeFormat { {zeros false} } {
    if {$zeros} then {
      return "yyyy-MM-dd HH:mm:ss.fffffffK"
    } else {
      return "yyyy-MM-dd HH:mm:ss.FFFFFFFK"
    }
  }

  #
  # HACK: Return an ISO 8601 formatted date/time that corresponds to now,
  #       in UTC time.  This must use exactly the same format used by the
  #       certificate time stamp parsing algorithm.
  #
  proc getUtcNowFormatted {} {
    return [string map \
        [list " " T] [object invoke DateTime UtcNow.ToString \
        [string map [list F f] [getDateTimeFormat]]]]
  }

  #
  # TODO: This test will start failing approximately 396 days from the
  #       date specified here (i.e. the simulated creation date for this
  #       plugin assembly) being far enough away from the install date
  #       (i.e. current?) that it is considered to be "obsolete".  The
  #       number 396 is derived from the trial duration of 30 days plus
  #       the window of time (of 1 leap year) the plugin is considered
  #       not to be "obsolete", based on its creation date.
  #
  proc resetPluginDateTime {
          {pluginNames ""} {value "2025-10-31 08:00:00.0000000Z"} } {
    #
    # HACK: Hard-coded the primary enterprise plugin names for now.
    #       If a particular test needs a different plugin name, this
    #       will NOT work correctly for that test.
    #
    if {[llength $pluginNames] == 0} then {
      set pluginNames [list \
          Licensing.Enterprise Licensing.Standard Licensing.Core \
          Security.Core]
    }

    foreach pluginName $pluginNames {
      set pluginData [object invoke -alias -flags +NonPublic \
          Interpreter.GetActive GetPluginData [lindex [lindex [info \
          loaded "" [appendArgs "* \{" $pluginName ", *\}"]] 0] end]]

      if {[isNonNullObjectHandle $pluginData]} then {
        set dateTime(1) [object invoke -create -alias DateTime \
            ParseExact $value [getDateTimeFormat] null]

        set dateTime(2) [$dateTime(1) -create -alias ToUniversalTime]

        $pluginData DateTime $dateTime(2); # backdate before dir mtime

        tputs $::test_channel [appendArgs \
            "---- reset plugin \"" $pluginName "\" DateTime to \"" \
            [$dateTime(2) ToString [getDateTimeFormat]] \"\n]
      }
    }
  }

  proc fixSubst { string } {
    return [string map [list \
        "{None}" None] [uplevel 1 [list subst $string]]]
  }

  proc PKTM {} {
    return "public key (?:.* )?token mismatch"
  }

  proc fixSnkRootErrors { before {after ""} } {
    set subResult [lrepeat [llength \
        $::publicKeyToken(root)] [PKTM]]

    if {[llength $after] > 0} then {
      eval lappend subResult $after
    }

    set result $before
    lappend result $subResult

    return $result
  }

  proc fixSnkConstraints { constraints } {
    global publicKeyFile privateKeyFile

    return [fixConstraints [string map [list \
        \$publicKeyFile(0) [appendArgs file_ \
            [file tail $publicKeyFile(0)]] \
        \$privateKeyFile(0) [appendArgs file_ \
            [file tail $privateKeyFile(0)]] \
        \$publicKeyFile(1) [appendArgs file_ \
            [file tail $publicKeyFile(1)]] \
        \$privateKeyFile(1) [appendArgs file_ \
            [file tail $privateKeyFile(1)]] \
        \$publicKeyFile(2) [appendArgs file_ \
            [file tail $publicKeyFile(2)]] \
        \$privateKeyFile(2) [appendArgs file_ \
            [file tail $privateKeyFile(2)]] \
        \$publicKeyFile(3) [appendArgs file_ \
            [file tail $publicKeyFile(3)]] \
        \$privateKeyFile(3) [appendArgs file_ \
            [file tail $privateKeyFile(3)]] \
        \$publicKeyFile(4) [appendArgs file_ \
            [file tail $publicKeyFile(4)]] \
        \$privateKeyFile(4) [appendArgs file_ \
            [file tail $privateKeyFile(4)]] \
        \$publicKeyFile(5) [appendArgs file_ \
            [file tail $publicKeyFile(5)]] \
        \$privateKeyFile(5) [appendArgs file_ \
            [file tail $privateKeyFile(5)]] \
        \$publicKeyFile(6) [appendArgs file_ \
            [file tail $publicKeyFile(6)]] \
        \$privateKeyFile(6) [appendArgs file_ \
            [file tail $privateKeyFile(6)]] \
        \$publicKeyFile(7) [appendArgs file_ \
            [file tail $publicKeyFile(7)]] \
        \$privateKeyFile(7) [appendArgs file_ \
            [file tail $privateKeyFile(7)]] \
        \$publicKeyFile(8) [appendArgs file_ \
            [file tail $publicKeyFile(8)]] \
        \$privateKeyFile(8) [appendArgs file_ \
            [file tail $privateKeyFile(8)]] \
        \$publicKeyFile(9) [appendArgs file_ \
            [file tail $publicKeyFile(9)]] \
        \$privateKeyFile(9) [appendArgs file_ \
            [file tail $privateKeyFile(9)]] \
        \$publicKeyFile(10) [appendArgs file_ \
            [file tail $publicKeyFile(10)]] \
        \$privateKeyFile(10) [appendArgs file_ \
            [file tail $privateKeyFile(10)]] \
        \$publicKeyFile(11) [appendArgs file_ \
            [file tail $publicKeyFile(11)]] \
        \$privateKeyFile(11) [appendArgs file_ \
            [file tail $privateKeyFile(11)]]] \
        $constraints]]
  }

  proc fixSnkTokenResult { result } {
    global publicKeyToken

    set publicKeyTokenBytes(0) [publicKeyTokenToBytes $publicKeyToken(0)]
    set publicKeyTokenBytes(1) [publicKeyTokenToBytes $publicKeyToken(1)]
    set publicKeyTokenBytes(2) [publicKeyTokenToBytes $publicKeyToken(2)]
    set publicKeyTokenBytes(3) [publicKeyTokenToBytes $publicKeyToken(3)]
    set publicKeyTokenBytes(4) [publicKeyTokenToBytes $publicKeyToken(4)]
    set publicKeyTokenBytes(5) [publicKeyTokenToBytes $publicKeyToken(5)]
    set publicKeyTokenBytes(6) [publicKeyTokenToBytes $publicKeyToken(6)]

    return [string map [list \
        \$publicKeyTokenBytes(0) $publicKeyTokenBytes(0) \
        \$publicKeyTokenBytes(1) $publicKeyTokenBytes(1) \
        \$publicKeyTokenBytes(2) $publicKeyTokenBytes(2) \
        \$publicKeyTokenBytes(3) $publicKeyTokenBytes(3) \
        \$publicKeyTokenBytes(4) $publicKeyTokenBytes(4) \
        \$publicKeyTokenBytes(5) $publicKeyTokenBytes(5) \
        \$publicKeyTokenBytes(6) $publicKeyTokenBytes(6) \
        \$publicKeyToken(0) $publicKeyToken(0) \
        \$publicKeyToken(1) $publicKeyToken(1) \
        \$publicKeyToken(2) $publicKeyToken(2) \
        \$publicKeyToken(3) $publicKeyToken(3) \
        \$publicKeyToken(4) $publicKeyToken(4) \
        \$publicKeyToken(5) $publicKeyToken(5) \
        \$publicKeyToken(6) $publicKeyToken(6)] \
        $result]
  }

  proc fixScriptFlagsResult { result } {
    #
    # TODO: *HACK* The tests in this file do not currently care about the
    #       "*CoreAssemblyOnly" script flags (i.e. when they are enabled
    #       for the ENTERPRISE_LOCKDOWN compile-time option); however, if
    #       this changes in the future, then this procedure will need to
    #       be changed and/or removed.
    #
    return [string map [list \
        "MaybeCoreAssemblyOnly, " "" \
        ", MaybeCoreAssemblyOnly" "" \
        "CoreAssemblyOnly, " "" \
        ", CoreAssemblyOnly" ""] \
        $result]
  }

  proc isUnderHarpyDirectory { path } {
    #
    # TODO: *HACK* If additional SKUs are added that
    #       modify the assembly name, add them here
    #       as well.
    #
    # TODO: The path must be normalized for use with
    #       the [string match] sub-command.
    #
    set path [file normalize $path]

    if {[string match */Harpy1.0/* $path] || \
        [string match */Harpy.Basic1.0/* $path] || \
        [string match */Harpy.Limited1.0/* $path] || \
        [string match */Harpy.Sdk1.0/* $path]} then {
      return true
    } else {
      return false
    }
  }

  proc isUnderBadgeDirectory { path } {
    #
    # TODO: *HACK* If additional SKUs are added that
    #       modify the assembly name, add them here
    #       as well.
    #
    # TODO: The path must be normalized for use with
    #       the [string match] sub-command.
    #
    set path [file normalize $path]

    if {[string match */Badge1.0/* $path] || \
        [string match */Badge.Basic1.0/* $path]} then {
      return true
    } else {
      return false
    }
  }

  proc getHarpyDll {} {
    #
    # TODO: *HACK* If additional SKUs are added that
    #       modify the assembly name, add them here
    #       as well.
    #
    set fileNamesOnly [list \
        Harpy.dll Harpy.Basic.dll Harpy.Limited.dll \
        Harpy.Sdk.dll]

    foreach index [package indexes] {
      foreach fileNameOnly $fileNamesOnly {
        set fileName [file join [file dirname \
            [file normalize $index]] $fileNameOnly]

        if {[isUnderHarpyDirectory $index]} then {
          return $fileName
        } elseif {[file exists $fileName]} then {
          return $fileName
        }
      }
    }

    return ""
  }

  proc getBadgeDll {} {
    #
    # TODO: *HACK* If additional SKUs are added that
    #       modify the assembly name, add them here
    #       as well.
    #
    set fileNamesOnly [list \
        Badge.dll Badge.Basic.dll]

    foreach index [package indexes] {
      foreach fileNameOnly $fileNamesOnly {
        set fileName [file join [file dirname \
            [file normalize $index]] $fileNameOnly]

        if {[isUnderBadgeDirectory $index]} then {
          return $fileName
        } elseif {[file exists $fileName]} then {
          return $fileName
        }
      }
    }

    return ""
  }

  proc getAllowedSubCommands { interp name } {
    set interpreter null; set error null

    set code [object invoke -alias \
        Value GetInterpreter "" $interp Default interpreter error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    set command null; set error null

    set code [$interpreter -alias \
        GetIdentifier HiddenCommand \
        $name null Default command error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    object flags $command +NoDispose; # NOTE: Not owned.
    return [set subCommands [$command -alias AllowedSubCommands]]
  }

  proc setAllowedSubCommands { interp name subCommands } {
    set interpreter null; set error null

    set code [object invoke -alias \
        Value GetInterpreter "" $interp Default interpreter error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    set command null; set error null

    set code [$interpreter -alias \
        GetIdentifier HiddenCommand \
        $name null Default command error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    object flags $command +NoDispose; # NOTE: Not owned.
    $command AllowedSubCommands $subCommands

    return ""
  }

  proc getConfigurationSuffix {} {
    if {[info exists ::eagle_platform(suffix)] && \
        [string length $::eagle_platform(suffix)] > 0} then {
      return $::eagle_platform(suffix)
    }

    set binary [info binary]

    if {[string length $binary] == 0} then {
      return ""
    }

    set parts [file split $binary]

    if {[llength $parts] < 2} then {
      return ""
    }

    if {[string match net* [lindex $parts end]]} then {
      set parts [lrange $parts 0 end-1]
    }

    if {[lindex $parts end] ne "bin"} then {
      return ""
    }

    if {![info exists ::eagle_platform(configuration)]} then {
      return ""
    }

    set configuration $::eagle_platform(configuration)
    set configurationAndSuffix [lindex $parts end-1]

    if {![string match \
        [appendArgs $configuration *] $configurationAndSuffix]} then {
      return ""
    }

    return [string range \
        $configurationAndSuffix [string length $configuration] end]
  }

  proc enableTestPluginStrings { enable } {
    if {$enable} then {
      object invoke Eagle._Tests.Default TestInitializeStrings true
    } else {
      object invoke Eagle._Tests.Default TestResetStrings
    }

    set token 0; set plugin null; set error null

    set pluginName [appendArgs "Eagle._Plugins.Test, Eagle, Version=" \
        $::eagle_platform(patchLevel) ", Culture=neutral, PublicKeyToken=" \
        $::publicKeyToken(0)]

    set code [object invoke -alias Interpreter.GetActive GetPlugin \
        $pluginName NoWrapper token plugin error]

    if {$code ne "Ok"} then {
      error [getStringFromObjectHandle $error]
    }

    $plugin EnableGetString $enable
  }

  #
  # HACK: This procedure relies on global variables that are only set
  #       by the tests "harpy-57.*".
  #
  proc maybeAddDangerOption { flags varName } {
    #
    # HACK: This list was stolen from the ShellFlags enumeration value
    #       "DangerForbidMask" in the "Private\Enumerations.cs" source
    #       code file.
    #
    set dangerFlags [list \
        $::NoPoliciesOnFallback [appendArgs + $::NoPoliciesOnFallback] \
        $::FallbackOnUnsafe [appendArgs + $::FallbackOnUnsafe] \
        $::FallbackOnDenied [appendArgs + $::FallbackOnDenied] \
        $::FallbackOnFailure [appendArgs + $::FallbackOnFailure]]

    foreach flag [lindex $flags 1] {; # starts with -flags
      if {[lsearch -exact -- $dangerFlags $flag] != -1} then {
        upvar 1 $varName command
        lappend command -danger
        return
      }
    }
  }

  proc permuteFlags { option prefix args } {
    set index 0
    set result [list $index [list]]
    set haveLength [llength $args]

    for {set wantLength 1} {$wantLength <= $haveLength} {incr wantLength} {
      foreach combinations [lcombine $args $wantLength] {
        lappend result \
            [incr index] [list $option [appendArgs $prefix $combinations]]
      }
    }

    return $result
  }

  proc moveFiles { channel path setup } {
    global goodFile
    global badFile

    if {$setup} then {
      set oldFileNames [list \
          [appendArgs $goodFile .harpy] \
          [appendArgs $badFile .harpy]]

      set newFileNames [list \
          [appendArgs $goodFile .harpy.no] \
          [appendArgs $badFile .harpy.no]]

      set phase setup
    } else {
      set oldFileNames [list \
          [appendArgs $badFile .harpy.no] \
          [appendArgs $goodFile .harpy.no]]

      set newFileNames [list \
          [appendArgs $badFile .harpy] \
          [appendArgs $goodFile .harpy]]

      set phase cleanup
    }

    foreach oldFileName $oldFileNames newFileName $newFileNames {
      set command [list file rename $oldFileName $newFileName]

      if {[catch $command error] == 0} then {
        tputs $channel [appendArgs \
            "---- test data file renaming for " $phase " ok: " \
            $command \n]
      } else {
        tputs $channel [appendArgs \
            "---- test data file renaming for " $phase " error: " \
            $error \n]
      }
    }

    return ""
  }

  proc getPluginVersion { pattern } {
    set name [getPluginName $pattern]

    if {[string length $name] > 0} then {
      if {[regexp -skip 1 -- \
          {Version=(\d+\.\d+\.\d+\.\d+),} $name value] && \
          [string is version -strict $value]} then {
        return $value
      }
    }

    return ""
  }

  proc getChangeToExecutableDirectoryScript {} {
    return [string map [list \n " "] {
      cd [file dirname [info nameofexecutable]]
    }]
  }

  proc getProofOfLoadScript {} {
    return [string map [list \n " "] {
      puts stdout [list \
          [load Harpy.dll Licensing.Enterprise] \
          [file tail [certificate current]]]
    }]
  }
}

