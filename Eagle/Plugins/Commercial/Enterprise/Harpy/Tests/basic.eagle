###############################################################################

runTest {test harpy-48.1 {script w/limited quantity (local)} -setup {
  if {[haveConstraint compile.ISOLATED_INTERPRETERS]} then {
    set interp [interp create -isolated -nosecurity]
  } else {
    set interp [interp create -nosecurity]
  }

  interp alias $interp puts {} puts

  interp set $interp test_run_id [getTestRunId]
  interp set $interp package_storage_lib_path $package_storage_lib_path
  interp set $interp testScriptImportFile(13) $testScriptImportFile(13)

  if {[haveConstraint harpy.isolated]} then {
    interp eval $interp {
      package require Eagle.Test

      set savedPluginFlags [enablePluginFlags]
      enablePluginFlags Isolated true
    }
  }
} -body {
  interp eval $interp {
    package require Licensing.Enterprise

    set certificate [certificate \
        import -alias -validate $testScriptImportFile(13)]

    if {[certificate isolated]} then {
      set id [[set guid [object create -alias Guid [certificate \
          metadata $certificate Id]]] ToString D]

      set key [certificate metadata $certificate Key]
      set quantity [certificate metadata $certificate Quantity]
    } else {
      set id [$certificate Id.ToString D]
      set key [$certificate Key]
      set quantity [$certificate Quantity]
    }

    set valueName [certificate hashstring -hexadecimal $certificate \
        [appendArgs $id .Quantity]]

    if {[isDotNetCore]} then {
      set valueData [object invoke -create -parametertypes Int64 \
          BitConverter GetBytes $quantity]

      set error null

      set code [object invoke Licensing.Components.Private.ProtectOps \
          ProtectData $key false false false null valueData error]

      if {$code ne "Ok"} then {
        error [getStringFromObjectHandle $error]
      }
    } else {
      object load -import System.Security
      set dataProtectionScope CurrentUser

      set valueData [object invoke -create ProtectedData Protect [set bytes \
          [object invoke -create -parametertypes Int64 BitConverter GetBytes \
          $quantity]] $key $dataProtectionScope]
    }

    lappend auto_path $package_storage_lib_path
    package require Harpy.StorageManager.Local

    #
    # WARNING: When this test loads the "Licensing.Enterprise" plugin
    #          into an isolated AppDomain, the following evaluation of
    #          the [enableSecurity] script will result in yet another
    #          AppDomain being created for its "Security.Core" plugin;
    #          this is why [storage type] sub-command must be executed
    #          after evaluating the [enableSecurity] script.
    #
    source enableSecurity

    storage type Interpreter

    storage write $valueName [object invoke Convert ToBase64String \
        $valueData]
  }

  set code(1) [catch {interp source $interp $testScriptFile(13)} result(1)]
  set code(2) [catch {interp source $interp $testScriptFile(13)} result(2)]

  interp eval $interp {
    storage delete $valueName
  }

  list $code(1) $result(1) $code(2) $result(2)
} -cleanup {
  catch {
    interp eval $interp {
      storage delete $valueName
    }
  }

  if {[haveConstraint harpy.isolated]} then {
    catch {
      interp eval $interp {
        enablePluginFlags $savedPluginFlags
        unset -nocomplain savedPluginFlags
      }
    }
  }

  catch {file delete [file join $package_storage_lib_path storage.db]}
  catch {interp delete $interp}

  unset -nocomplain result code interp
} -constraints [fixConstraints {eagle monoBug28 !harpy.obfuscated\
compile.DATA command.certificate command.storage command.sql\
file_secureTest13.eagle file_secureTest13.eagle.harpy file_sqlite3.dll\
file_System.Data.SQLite.dll}] -output \
[subst {Hello World - [file nativename $testScriptFile(13)]
}] -result [subst {0 {} 1 {couldn't read or get file "$testScriptFile(13)": no\
such file or directory}}]}

###############################################################################

#
# NOTE: This virtual output must be reset between these tests.
#
if {[isEagle]} then {
  debug vout stdout false
  debug vout stdout true
}

