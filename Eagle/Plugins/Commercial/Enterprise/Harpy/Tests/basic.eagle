###############################################################################

runTest {test harpy-8.1 {certificate flags sub-command} -setup {
  package require Licensing.Enterprise
} -body {
  #
  # HACK: In isolated mode, we cannot use the FlagType enumeration
  #       directly.
  #
  if {[haveConstraint harpy.isolated]} then {
    set Feature 0x2; set Restriction 0x4; set All 0xE
  } else {
    set Feature Feature; set Restriction Restriction; set All All
  }

  set certificate [certificate import -alias -validate $importFile]

  list [catch {certificate flags $certificate} error] \
          $error \
      [catch {certificate flags -flagtype $All -hasflags A $certificate} \
          error] $error \
      [catch {certificate flags -hasflags %Q $certificate} error] \
          $error \
      [catch {certificate flags -strict -hasflags %Q $certificate} error] \
          $error \
      [catch {certificate flags -flagtype $Feature -hasflags QX $certificate} \
          error] $error \
      [catch {certificate flags -flagtype $Feature -hasflags QX -hasall \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Feature -nothasflags AX \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Feature -nothasflags AX -nothasall \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Feature -nothasflags QX \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Feature -nothasflags QX -nothasall \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Feature -hasflags QXE $certificate} \
          error] $error \
      [catch {certificate flags -flagtype $Feature -hasflags QXE -hasall \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Restriction -hasflags E \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Restriction -hasflags EA \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Restriction -nothasflags E \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Restriction -nothasflags E \
          -nothasall $certificate} error] $error \
      [catch {certificate flags -flagtype $Restriction -nothasflags EA \
          $certificate} error] $error \
      [catch {certificate flags -flagtype $Restriction -nothasflags EA \
          -nothasall $certificate} error] $error
} -cleanup {
  unset -nocomplain error certificate All Restriction Feature
} -constraints {eagle command.certificate compile.XML file_template.xml} \
-result {0 FlagOk 1 {invalid All flags: "unknown flag type All"} 0 FlagOk 1\
{missing all of the Feature flags "%Q" with key 0} 0 FlagOk 0 FlagOk 1 {found\
some of the Feature flags "AX" with key 0} 0 FlagOk 1 {found some of the\
Feature flags "QX" with key 0} 1 {found all of the Feature flags "QX" with key\
0} 0 FlagOk 1 {missing some of the Feature flags "QXE" with key 0} 0 FlagOk 0\
FlagOk 1 {found some of the Restriction flags "E" with key 0} 1 {found all of\
the Restriction flags "E" with key 0} 1 {found some of the Restriction flags\
"EA" with key 0} 0 FlagOk}}

###############################################################################

runTest {test harpy-9.1 {certificate FromDictionary/ToDictionary} -setup {
  package require Licensing.Enterprise
} -body {
  set certificate [certificate import -alias -validate $importFile]

  $certificate Id 01234567-8901-2345-6789-012345678901

  $certificate TimeStamp \
      [set a [object create DateTime 635031560960123456 Utc]]

  $certificate Duration 0.12:34:56
  $certificate Key [list 0x10 0x20 0x30 0x40 0x50 0x60 0x70 0x80]
  $certificate Number 0x0123456789012345
  $certificate HashAlgorithm SHA512

  $certificate Signature [list \
      116 101 115 116 32 115 105 103 110 97 116 117 114 101]

  $certificate EntityType Company
  $certificate Quantity 1

  set dictionary [$certificate -flags +NonPublic ToDictionary]

  set error null
  set certificate2 [object invoke -alias -flags +NonPublic \
      Licensing.Components.Public.Certificate CreateFromDictionary \
      $dictionary error]

  list [$certificate2 Protocol] [$certificate2 Vendor] \
      [$certificate2 Key] [$certificate2 Number] \
      [$certificate2 SerialNumber] [$certificate2 HashAlgorithm] \
      [$certificate2 Signature] [$certificate2 Type] \
      [$certificate2 EntityType] [$certificate2 EntityName] \
      [$certificate2 EntityValue] [$certificate2 ExtraData] \
      [$certificate2 Quantity] [$certificate2 Product] \
      [$certificate2 Features] [$certificate2 Restrictions] \
      [getStringFromObjectHandle \
          [set b [$certificate2 -create -alias ProtocolVersion]]] \
      [getStringFromObjectHandle \
          [set c [$certificate2 -create -alias Origin]]] \
      [getStringFromObjectHandle \
          [set d [$certificate2 -create -alias Authority]]] \
      [getStringFromObjectHandle \
          [set e [$certificate2 -create -alias Agreement]]] \
      [getStringFromObjectHandle \
          [set f [$certificate2 -create -alias Support]]] \
      [getStringFromObjectHandle \
          [set g [$certificate2 -create -alias Id]]] \
      [certificate formattimestamp \
          [set h [$certificate2 -create -alias TimeStamp]] true] \
      [getStringFromObjectHandle \
          [set i [$certificate2 -create -alias Duration]]] \
      [getStringFromObjectHandle \
          [set j [$certificate2 -create -alias Version]]]
} -cleanup {
  unset -nocomplain a b c d e f g h i j
  unset -nocomplain certificate2 error dictionary certificate
} -constraints [fixConstraints {eagle command.certificate\
compile.ISOLATED_PLUGINS compile.XML !harpy.plugin.isolated\
file_template.xml}] -result {Local {Your company name here} {16 32 48 64 80 96\
112 128} 81985529205302085 {Serial number here} SHA512 {116 101 115 116 32 115\
105 103 110 97 116 117 114 101} {Single User} Company {User or company name\
here} {Script data here (script certs only)} {Script block type here (script\
certs only)} 1 {Product name here} QX E 4.0 https://www.example.com/\
https://certs.example.com/ https://www.example.com/license.html\
https://www.example.com/support.html?id=0123456789\
01234567-8901-2345-6789-012345678901 2013-05-03T05:34:56.0123456Z 12:34:56 1.0}}

