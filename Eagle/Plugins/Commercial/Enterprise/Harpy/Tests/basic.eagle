  set code [catch {
    ksource -withcommands -useshared -useplugin -usecontext -local -- \
        $ksourceCommandsFile
  } result]

  if {$code != 0} then {
    error [getStringFromObjectHandle $result]
  }

  vwait -force -timeout [expr {
    [haveConstraint harpy.plugin.isolated] ?
        $test_timeout * $test_timeout_multiplier : $test_timeout
  }] sandboxResults

  noContextVariables

  string map [list {{<infoScriptDir>}} <infoScriptDir>] \
      [string map [list $infoScriptFile <infoScriptFile> \
      [file nativename [file join [file dirname $infoScriptFile] a b c]] \
      <infoScriptDir> MaybeCoreAssemblyOnly Invalid] \
      [list $code $result [testArrayGet sandboxResults]]]
} -cleanup {
  restoreEnvironmentVariables [list NoAnnounceInteractiveLoop]

  restoreScriptFlags savedScriptFlags
  restorePolicy savedPolicy
  restoreKeyRingName savedKeyRingName
  restoreKeyName savedKeyName

  catch {storage type ""}

  unset -nocomplain code result id sandboxResults savedFeatures
} -constraints {eagle command.ksource command.storage file_info_script.eagle\
file_ksource_commands.eagle harpy.strongName.official2\
harpy.strongName.resource2} -match regexp -result \
[subst -nocommands -nobackslashes {^0 \{0 \{0\.0\.0\.0 \{\}\} \{\} \{\}\
Interpreter Interpreter \{\} True True False \{\} \{\} \{False None\} \{True\
(?:Any|\{(?:None, )?Any(?:, None)?\})\} \{True (?:Any|\{(?:None, )?Any(?:,\
None)?\})\} \{False None\} \{False None\} \{\{\} \{\}\} \{\{\} \{\}\} False\
False True True \{\} \{\} \{${testContextCommands}(?:\s+[A-Z_][0-9A-Z_]*)*\}\
\{$testContextVariables\} (?:[0-9A-Za-z]+|\{\}) X X X \{X X\} X\
(?:[0-9A-Za-z]+|\{\}) Invalid Invalid one two Invalid Invalid one two Invalid\
Invalid False True True True \{Error \{this is an error\}\} False\
<infoScriptDir> \{\} \{\} \d+ True this \{that other\} \{Id\
[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\
NetworkInfo \{(?:https://urn\.to/r/authority|https://urn\.to/r/kapok_test_01)\
AbsoluteUri\}\} False True True False False\} \{\d+,code Ok \d+,result \{0\
<infoScriptFile>\} \d+,wait True\}$}]}

