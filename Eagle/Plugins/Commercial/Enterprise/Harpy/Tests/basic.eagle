#          while tests are active.
#
if {[isEagle]} then {debug vout stdout true}

###############################################################################

#
# WARNING: This test is *very* sensitive to the system clock, especially if
#          the system clock is *behind* than actual time.
#
runTest {test harpy-37.1 {local ".eagle" renewal success} -setup {
  package require Licensing.Enterprise

  #
  # HACK: This test verifies that a script certificate can be renewed
  #       successfully.  It should be noted that the script being used
  #       for this test was signed with the "script" strong name key,
  #       but is being renewed with the "demo" strong name key.  This
  #       will work if the key used to sign the renewed certificate is
  #       considered to be valid and trusted by the policy engine.
  #
  saveKeyName savedKeyName; resetKeyName
  # setKeyName $testKeyName(6)

  saveKeyRingName savedKeyRingName; resetKeyRingName

  savePolicy savedPolicy; resetPolicy
  certificate policy -file $testPolicy(16) -script $testPolicy(16)

  saveKeyRing savedKeyRing; resetKeyRing

  saveRenewCallbacks savedRenewCallbacks; resetRenewCallbacks

  saveServerEnvironmentVariables
  resetServerEnvironmentVariables "" "" "" false true

  saveXdgEnvironment

  set tempXdgDataHome [file join [getTemporaryPath] harpy-37.1]
  set env(XDG_DATA_HOME) $tempXdgDataHome
} -body {
  list [catch {source $testScriptFile(8)} error] $error
} -cleanup {
  unset -nocomplain error
  catch {rename helloWorld ""}

  restoreServerEnvironmentVariables

  restoreRenewCallbacks savedRenewCallbacks

  restoreKeyRing savedKeyRing

  restorePolicy savedPolicy

  restoreKeyRingName savedKeyRingName

  restoreKeyName savedKeyName

  if {[info exists tempXdgDataHome] && \
      [file tail $tempXdgDataHome] eq "harpy-37.1" && \
      [file exists $tempXdgDataHome] && \
      [file isdirectory $tempXdgDataHome]} then {
    catch {file delete -recursive -force $tempXdgDataHome}
  }

  unset -nocomplain tempXdgDataHome
  restoreXdgEnvironment
} -constraints [fixSnkConstraints {eagle kapok.server tlsOk command.certificate\
command.keyring file_secureTest8.eagle $publicKeyFile(6)}] -output \
[subst {Hello World - [file nativename $testScriptFile(8)]
}] -result {0 {}}}

