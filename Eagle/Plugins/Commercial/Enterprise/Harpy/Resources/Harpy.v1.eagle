# <<swapCommands>>
failOnError true; # Upon error, plugin will fail to load.
requireVersion 0.0.0.0; # Set allowed versions.

###############################################################################

#
# NOTE: Since "Debug" builds are never (?) signed, just skip checking
#       their X.509 certificates and "trusted file" status.
#
maybeEvaluate {[matchPlatform {Glob {* * Debug * * *}}]} {
  # Enable skipping X.509 certificate and "trusted file" checking.
  changeFeatures +LZ; # NoCertificate, NoTrusted
} else {
  #
  # NOTE: Apparently, X.509 support is still broken for .NET Core on
  #       any operating system other than Windows; therefore, disable
  #       these checks there.  For further details, please see:
  #
  #       https://github.com/dotnet/runtime/issues/15073
  #
  #       The [requireTrusted] configuration command will always fail
  #       on those platforms, so skip it.  Also, make sure the plugin
  #       can continue loading by setting the X.509 skipping feature,
  #       which will prevent the above issue from being hit and still
  #       maintain the built-in assembly trust checking using SHA512.
  #
  maybeEvaluate {![matchPlatform {Glob {* * * windows * *}}] && \
      ![matchPlatform {RegExp {^\w+ Mono\d+ \w+ \w+ \d+-bit \w+$}}]} {
    # Enable skipping X.509 certificate checking.
    changeFeatures +L; # NoCertificate
  }
}

###############################################################################

writeStatus {Context ExtraFeatures} EMBEDDED-1
