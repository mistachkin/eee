# <<swapCommands>>
failOnError true; # Upon error, plugin will fail to load.
requireVersion 0.0.0.0; # Set allowed versions.

###############################################################################

maybeEvaluate {[haveComponent requireShell]} {
  requireShell {
    +AllowDangerousFlags ResetCallbacks
    +FallbackOnUnsafe +FallbackOnNeutral
  }; # Use signed script callbacks for shell.
}

###############################################################################

writeStatus {Context MaybeShellFlags} EMBEDDED-2
writeStatus -MaybeExtraFeatures EMBEDDED-2
