if {![package vsatisfies [package provide Tcl] 8.4]} then {return}
if {![package vsatisfies [package provide Eagle] 1.0]} then {return}

package ifneeded Harpy.StorageManager.Shared 1.0 \
    [list source -library true -- [file join $dir shared-storage-manager.eagle]]

package ifneeded Harpy.StorageManager.Local 1.0 \
    [list source -library true -- [file join $dir local-storage-manager.eagle]]

package ifneeded Harpy.StorageManager.Remote 1.0 \
    [list source -library true -- [file join $dir remote-storage-manager.eagle]]
