          enableFailSafeModeFile enableFailSafeModeImportFile \
          disableFailSafeModeFile disableFailSafeModeImportFile] {
        unset -nocomplain [appendArgs :: $varName]
      }
    }
  }

  proc setupFailSafeModeFiles { path } {
    # <help>
    # This procedure locates and records the paths to the script files used
    # to enable or disable Harpy's fail-safe mode, populating the matching
    # ::enableFailSafeModeFile, ::enableFailSafeModeImportFile,
    # ::disableFailSafeModeFile and ::disableFailSafeModeImportFile globals
    # when they are not already set.  It is invoked by [enableFailSafeMode]
    # before the first toggle.
    #
    # How it works: it iterates a hard-coded list pairing each file name
    # (enable_fail_safe_mode.eagle, disable_fail_safe_mode.eagle, and the
    # corresponding .b64sig import variants) with a global variable name.
    # For each pair, if the global is missing it loads the Eagle.Test
    # package and calls [recursiveGetFiles] to search the supplied path
    # tree.  When at least one match is found, the first match is
    # normalized via [file normalize] and stored in the global.
    #
    # Arguments:
    #   path -- The root directory to search recursively for the script
    #           files; usually ::dataPath or the script base directory.
    #
    # Results:
    #   Returns the empty string; side effects populate the four ::
    #   globals when matching files are found.  Does nothing outside Eagle.
    # </help>

    if {[isEagle]} then {
      foreach {fileNameOnly fileVarName} [list \
          enable_fail_safe_mode.eagle \
              enableFailSafeModeFile \
          enable_fail_safe_mode.eagle.b64sig \
              enableFailSafeModeImportFile \
          disable_fail_safe_mode.eagle \
              disableFailSafeModeFile \
          disable_fail_safe_mode.eagle.b64sig \
              disableFailSafeModeImportFile] {
        set varName [appendArgs :: $fileVarName]

        if {![info exists $varName]} then {
          package require Eagle.Test

          set fileNames [recursiveGetFiles $path $fileNameOnly]

          if {[llength $fileNames] > 0} then {
            set $varName [file normalize [lindex $fileNames 0]]
          }
        }
      }
    }
  }

  proc enableFailSafeMode { enable {immediate true} } {
    # <help>
    # This procedure turns Harpy's fail-safe mode on or off for the test
    # interpreter by sourcing the prepared enable_fail_safe_mode.eagle or
    # disable_fail_safe_mode.eagle script.  Fail-safe mode constrains the
    # interpreter to a conservative, defensively configured state and is
    # toggled here so tests can exercise both regular and fail-safe paths.
    #
    # How it works: it first lazily calls [setupFailSafeModeFiles] to
    # locate the four script files (enable, disable, and their b64sig
    # import companions) when any of the corresponding global path
    # variables are missing.  When enable is non-empty, it picks the
    # enable file when enable is true and the disable file when enable is
    # false, then either sources the chosen file via [ksource
    # -withcommands -useplugin -usecontext] under uplevel 1 (when
    # immediate is true) or appends the file name to the env element
    # ConfigurationFileNames for a later configuration pass.
    #
    # Tricky details: immediate sourcing requires the [ksource] command;
    # an error is raised when it is missing.  The selected file must exist
    # on disk or the call errors out.  Outside Eagle the procedure errors
    # immediately, because fail-safe mode is an Eagle-only concept.
    #
    # Arguments:
    #   enable    -- True to enable fail-safe mode, false to disable it;
    #                an empty string is a no-op (only the lazy setup of
    #                file paths is performed).
    #   immediate -- When true (default), the chosen script is sourced
    #                via [ksource] right away; when false, the file is
    #                queued via ConfigurationFileNames.
    #
    # Results:
    #   When immediate is true, returns the result of [ksource]; otherwise
    #   returns the empty string after appending the file name to the
    #   configuration list.
    # </help>

    if {[isEagle]} then {
      if {![info exists ::enableFailSafeModeFile] || \
          ![info exists ::enableFailSafeModeImportFile] || \
          ![info exists ::disableFailSafeModeFile] || \
          ![info exists ::disableFailSafeModeImportFile]} then {
        if {[info exists ::dataPath]} then {
          set path $::dataPath
        } else {
          set path [info base]
        }

        setupFailSafeModeFiles $path
      }

      if {[string length $enable] > 0} then {
        if {$immediate && \
            [llength [info commands ksource]] == 0} then {
          error "cannot change fail-safe-mode, missing \[ksource\] command"
        }

        if {$enable} then {
          if {[info exists ::enableFailSafeModeFile]} then {
            set fileName $::enableFailSafeModeFile
          } else {
            error "cannot enable fail-safe-mode, file name missing"
          }
        } else {
          if {[info exists ::disableFailSafeModeFile]} then {
            set fileName $::disableFailSafeModeFile
          } else {
            error "cannot disable fail-safe-mode, file name missing"
          }
        }

        if {![file exists $fileName]} then {
          error [appendArgs \
              "cannot change fail-safe-mode, file \"" $fileName \
              "\" missing"]
        }

        if {$immediate} then {
          return [uplevel 1 [list ksource \
              -withcommands -useplugin -usecontext -- $fileName]]
        } else {
          lappend ::env(ConfigurationFileNames) $fileName
        }
      }
    } else {
      error "cannot change fail-safe-mode, unsupported in native Tcl"
    }
  }

  proc cleanupSkipLicenseFiles {} {
    # <help>
    # This procedure clears the cached global variables that hold the script
    # paths used to toggle Harpy's skip-license behavior, so that the next
    # call to [enableSkipLicense] will rediscover the files.  It is useful
    # when the surrounding test environment, especially ::dataPath, has
    # changed and the previously located paths are no longer valid.
    #
    # How it works: it iterates the fixed list of six skip-license-related
    # global names (enable, enable key-ring, disable, plus their import
    # b64sig companions) and issues [unset -nocomplain] on each, using
    # [appendArgs] to build the fully qualified :: name.  Outside Eagle the
    # body is skipped entirely.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; side effects are the removal of the
    #   listed global variables.
    # </help>

    if {[isEagle]} then {
      foreach varName [list \
          enableSkipLicenseFile enableSkipLicenseImportFile \
          enableKeyRingSkipLicenseFile enableKeyRingSkipLicenseImportFile \
          disableSkipLicenseFile disableSkipLicenseImportFile] {
        unset -nocomplain [appendArgs :: $varName]
      }
    }
  }

  proc setupSkipLicenseFiles { path } {
    # <help>
    # This procedure locates and records the paths to the script files used
    # to enable or disable Harpy's skip-license behavior, populating the
    # corresponding ::enable*SkipLicenseFile and ::disable*SkipLicenseFile
    # global variables (and the matching b64sig import companions) if they
    # are not already set.  It is invoked by [enableSkipLicense] before the
    # first toggle so that the test interpreter knows where the scripts live.
    #
    # How it works: it iterates a hard-coded list pairing each file name
    # (such as enable_skip_license.eagle, enable_keyRing_skip_license.eagle,
    # disable_skip_license.eagle and their .b64sig variants) with a global
    # variable name.  For each pair, if the global is missing, it loads the
    # Eagle.Test package (which provides [recursiveGetFiles]) and searches
    # the given path tree for the file.  When at least one match is found,
    # the first match is normalized and stored in the global.
    #
    # Arguments:
    #   path -- The root directory to search recursively for the script
    #           files; usually ::dataPath or the script base directory.
    #
    # Results:
    #   Returns the empty string; side effects populate the relevant ::
    #   globals when matching files are found.  Does nothing outside Eagle.
    # </help>

    if {[isEagle]} then {
      foreach {fileNameOnly fileVarName} [list \
          enable_skip_license.eagle \
              enableSkipLicenseFile \
          enable_skip_license.eagle.b64sig \
              enableSkipLicenseImportFile \
          enable_keyRing_skip_license.eagle \
              enableKeyRingSkipLicenseFile \
          enable_keyRing_skip_license.eagle.b64sig \
              enableKeyRingSkipLicenseImportFile \
          disable_skip_license.eagle \
              disableSkipLicenseFile \
          disable_skip_license.eagle.b64sig \
              disableSkipLicenseImportFile] {
        set varName [appendArgs :: $fileVarName]

        if {![info exists $varName]} then {
          package require Eagle.Test

          set fileNames [recursiveGetFiles $path $fileNameOnly]

          if {[llength $fileNames] > 0} then {
            set $varName [file normalize [lindex $fileNames 0]]
          }
        }
      }
    }
  }

  proc enableSkipLicense { enable {keyRingOnly false} {immediate true} } {
    # <help>
    # This procedure turns Harpy's skip-license behavior on or off for the
    # test interpreter by sourcing one of the prepared enable or disable
    # script files.  In skip-license mode, license certificate validation is
    # bypassed, which is useful when running tests that should not depend on
    # the presence of a real license.  An optional key-ring-only variant
    # restricts the skip to just the key-ring lookup path.
    #
    # How it works: it first lazily calls [setupSkipLicenseFiles] to locate
    # the enable, key-ring enable, and disable script files (and their
    # b64sig import companions) if any of the corresponding global path
    # variables are missing, using ::dataPath when available or [info base]
    # as a fallback search root.  When enable is a non-empty string, it
    # selects a script: true with keyRingOnly true picks the key-ring enable
    # file, true with keyRingOnly false picks the regular enable file, and
    # false picks the disable file.  The chosen file is then either sourced
    # right away via [ksource -withcommands -useplugin -usecontext] under
    # uplevel 1 (when immediate is true), or appended to the env element
    # ConfigurationFileNames for later processing (when immediate is false).
    #
    # Tricky details: immediate sourcing requires the [ksource] command to
    # be present; if it is not, an error is raised so that the caller does
    # not silently fail to change licensing state.  All file paths must
    # already exist on disk or the call errors out.  Outside Eagle (in
    # native Tcl) the procedure errors immediately, since skipping licensing
    # only makes sense for an Eagle test run.
    #
    # Arguments:
    #   enable      -- True to enable skip-license mode, false to disable
    #                  it.  An empty string is a no-op (only the setup of
    #                  file paths is performed).
    #   keyRingOnly -- When true and enable is true, restricts the skip to
    #                  the key-ring lookup path; defaults to false.
    #   immediate   -- When true (default), the chosen script file is
    #                  sourced via [ksource] right away; when false, the
    #                  file is queued via ConfigurationFileNames for a
    #                  later configuration pass.
    #
    # Results:
    #   When immediate is true, returns the result of [ksource]; otherwise
    #   returns the empty string after appending the file name to the
    #   configuration list.
    # </help>

    if {[isEagle]} then {
      if {![info exists ::enableSkipLicenseFile] || \
          ![info exists ::enableSkipLicenseImportFile] || \
          ![info exists ::enableKeyRingSkipLicenseFile] || \
          ![info exists ::enableKeyRingSkipLicenseImportFile] || \
          ![info exists ::disableSkipLicenseFile] || \
          ![info exists ::disableSkipLicenseImportFile]} then {
        if {[info exists ::dataPath]} then {
          set path $::dataPath
        } else {
          set path [info base]
        }

        setupSkipLicenseFiles $path
      }

      if {[string length $enable] > 0} then {
        if {$immediate && \
            [llength [info commands ksource]] == 0} then {
          error "cannot change licensing, missing \[ksource\] command"
        }

        if {$enable} then {
          if {$keyRingOnly} then {
            if {[info exists ::enableKeyRingSkipLicenseFile]} then {
              set fileName $::enableKeyRingSkipLicenseFile
            } else {
              error "cannot disable key ring licensing, file name missing"
            }
          } else {
            if {[info exists ::enableSkipLicenseFile]} then {
              set fileName $::enableSkipLicenseFile
            } else {
              error "cannot disable licensing, file name missing"
            }
          }
        } else {
          if {[info exists ::disableSkipLicenseFile]} then {
            set fileName $::disableSkipLicenseFile
          } else {
            error "cannot enable licensing, file name missing"
          }
        }

        if {![file exists $fileName]} then {
          error [appendArgs \
              "cannot change licensing, file \"" $fileName \
              "\" missing"]
        }

        if {$immediate} then {
          return [uplevel 1 [list ksource \
              -withcommands -useplugin -usecontext -- $fileName]]
        } else {
          lappend ::env(ConfigurationFileNames) $fileName
        }
      }
    } else {
      error "cannot change licensing, unsupported in native Tcl"
    }
  }

  #
  # NOTE: Provide the Harpy test package to the interpreter.
  #
  package provide Harpy.Test 1.0
}
