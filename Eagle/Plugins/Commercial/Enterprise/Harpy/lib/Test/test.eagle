#
# NOTE: Use our own namespace here because even though we do not directly
#       support namespaces ourselves, we do not want to pollute the global
#       namespace if this script actually ends up being evaluated in Tcl.
#
namespace eval ::Eagle {
  proc tryToLoadKapok {} {
    # <help>
    # This procedure attempts to locate the Kapok enterprise package on disk,
    # add its binary directory to the auto-path, and load it via [package
    # require].  It exists so the Harpy test suite can opt-in to Kapok-based
    # checks (for example, certificate provisioning helpers) when a Kapok
    # build is available in any of the conventional locations, without
    # demanding it as a hard prerequisite.
    #
    # How it works: it first loads Eagle.Test and invokes the optional
    # before-directory hook through [maybeInvokeForTester].  It then searches
    # a fixed precedence of environment variables -- KAPOK_TEST_PATH (Kapok
    # root, "bin" appended), KAPOK_BIN_PATH (Kapok binary directory used as
    # is), KAPOK (Kapok root, "bin" appended), and EAGLE (Eagle source tree,
    # under Plugins/Commercial/Enterprise/Kapok/bin) -- and falls back to a
    # default relative to [info base] when none are set.  The chosen path
    # must be absolute; if it names an existing directory the
    # after-good-directory hook fires, the directory is added to the auto
    # path via [maybeAddToAutoPath], and Kapok.Enterprise is required.  When
    # the directory is missing or the candidate path is unsuitable, the
    # corresponding after-bad or after-missing hook fires and a sentinel
    # result is returned instead.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns a two-element list.  On success, the first element is the
    #   value returned by [maybeAddToAutoPath] for the chosen directory and
    #   the second is the result of requiring the Kapok.Enterprise package.
    #   On any failure to find the directory, the list is false followed by
    #   an empty string.
    # </help>

    package require Eagle.Test
    maybeInvokeForTester ::beforeKapokDirectory; # HOOK

    if {[info exists ::env(KAPOK_TEST_PATH)]} then {
      #
      # NOTE: Environment variable points to Kapok root directory.
      #
      set directory [file join $::env(KAPOK_TEST_PATH) bin]
    } elseif {[info exists ::env(KAPOK_BIN_PATH)]} then {
      #
      # NOTE: Environment variable points to Kapok binary directory.
      #
      set directory $::env(KAPOK_BIN_PATH)
    } elseif {[info exists ::env(KAPOK)]} then {
      #
      # NOTE: Environment variable points to Kapok root directory.
      #
      set directory [file join $::env(KAPOK) bin]
    } elseif {[info exists ::env(EAGLE)]} then {
      #
      # NOTE: Environment variable points to Eagle root directory.
      #
      set directory [file join \
          $::env(EAGLE) Plugins Commercial Enterprise Kapok bin]
    } else {
      #
      # NOTE: No environment variables available, use default for
      #       the location (i.e. within the source tree).
      #
      set directory [file join \
          [info base] Plugins Commercial Enterprise Kapok bin]
    }

    if {[string length $directory] > 0 && \
        [file pathtype $directory] eq "absolute"} then {
      set directory [file normalize $directory]

      if {[file isdirectory $directory]} then {
        maybeInvokeForTester ::afterGoodKapokDirectory; # HOOK

        set result [list \
            [maybeAddToAutoPath $directory] \
            [package require Kapok.Enterprise]]
      } else {
        set result [list false ""]
        maybeInvokeForTester ::afterBadKapokDirectory; # HOOK
      }
    } else {
      set result [list false ""]
      maybeInvokeForTester ::afterMissingKapokDirectory; # HOOK
    }

    return $result
  }

  proc querySoftwareUpdatesTrusted { coreOnly } {
    # <help>
    # This procedure reports whether the current interpreter considers the
    # software-updates source to be trusted, using either the core URI
    # subsystem or the Harpy certificate subsystem depending on the test
    # context.  It exists so test setup can probe the active trust posture
    # without aborting when the queried subcommand happens to raise.
    #
    # How it works: when coreOnly is true, or when the test constraint
    # harpy.plugin.isolated is not present, the core [uri softwareupdates]
    # query is used; otherwise the Harpy-aware [certificate softwareupdates]
    # query is used.  Either query is invoked inside a [catch] so the
    # success or failure code, together with the resulting value, can be
    # returned to the caller for further classification.
    #
    # Arguments:
    #   coreOnly -- When true, always uses the core URI query even when the
    #               Harpy plugin appears isolated.
    #
    # Results:
    #   Returns a two-element list: the [catch] return code (0 on success)
    #   followed by the captured result or error message.
    # </help>

    if {$coreOnly || ![haveConstraint harpy.plugin.isolated]} then {
      return [list [catch {uri softwareupdates} error] $error]
    }

    return [list [catch {certificate softwareupdates} error] $error]
  }

  proc haveInterpreterTestFlags { hasFlags } {
    # <help>
    # This procedure checks whether the active interpreter currently has a
    # specific subset of the internal InterpreterTestFlags enumeration set.
    # It exists so test scripts can branch on internal test-control flags
    # (which configure expensive or destabilizing diagnostics) without
    # touching private fields directly.
    #
    # How it works: it reads the non-public interpreterTestFlags property
    # from the active Interpreter via [object invoke -create -flags
    # +NonPublic Interpreter.GetActive interpreterTestFlags].  When the
    # hasFlags argument is not already a non-null object handle, it is
    # treated as a textual flag specification and is parsed into an
    # InterpreterTestFlags enumeration value with [Utility TryParseFlagsEnum]
    # (errors are surfaced via the parsed error object).  The current flags
    # are then tested against the requested ones using the non-public
    # FlagOps.HasFlags helper.
    #
    # Arguments:
    #   hasFlags -- Either an existing InterpreterTestFlags object handle or
    #               a textual specification (for example "+Foo Bar") that is
    #               parsed into one.
    #
    # Results:
    #   Returns the boolean result of FlagOps.HasFlags for the current
    #   interpreter test flags and the requested flags.  Raises an error if
    #   a textual flag specification cannot be parsed.
    # </help>

    set flags [object invoke \
        -create -flags +NonPublic Interpreter.GetActive \
        interpreterTestFlags]

    if {![isNonNullObjectHandle $hasFlags]} then {
      set error null; set hasFlags [object invoke -create \
          Utility TryParseFlagsEnum "" InterpreterTestFlags \
          null $hasFlags null true true true error]

      if {![isNonNullObjectHandle $hasFlags]} then {
        error [getStringFromObjectHandle $error]
      }
    }

    return [object invoke \
        -flags +NonPublic Eagle._Components.Private.FlagOps \
        HasFlags $flags $hasFlags true]
  }

  proc isValidHostName { value } {
    # <help>
    # This procedure validates whether a string is a syntactically valid
    # Internet host name as defined by RFC 1123.  It is used by the Harpy
    # test setup helpers that derive hosts from base URIs to confirm the
    # configured value is meaningful before it is exercised.
    #
    # How it works: it builds a regular expression that requires each label
    # to begin and end with an alphanumeric character, allow internal
    # hyphens, and be separated by dots; the labels and the overall string
    # are anchored.  The expression is then applied case-insensitively to
    # the value via [regexp -nocase].
    #
    # Arguments:
    #   value -- The candidate host name string to validate.
    #
    # Results:
    #   Returns true (a non-zero match count) when the value matches the
    #   RFC 1123 pattern; otherwise returns false (zero).
    # </help>

    #
    # NOTE: The following regular expression checks to see if a string
    #       conforms to RFC 1123 -AND- it was stolen from the following
    #       StackOverflow question:
    #
    #       https://stackoverflow.com/questions/1046740
    #
    set subPattern(1) {[0-9A-Z]}
    set subPattern(2) {[0-9A-Z\-]}

    set pattern [appendArgs \
        {^(?:(?:} $subPattern(1) {|} $subPattern(1) $subPattern(2) {*} \
        $subPattern(1) {)\.)*(?:} $subPattern(1) {|} $subPattern(1) \
        $subPattern(2) {*} $subPattern(1) {)$}]

    return [regexp -nocase -- $pattern $value]
  }

  proc isValidRelativeUri { value } {
    # <help>
    # This procedure validates that a string is acceptable as a relative URI
    # fragment for use against the Harpy test servers.  It is intentionally
    # narrower than a full URI parser: it enforces a small character set, a
    # specific path shape, and explicitly forbids the parent-directory
    # sequence "..".
    #
    # How it works: it first short-circuits with false when the value
    # contains two consecutive periods anywhere, preventing path traversal
    # attempts.  It then runs a case-insensitive regular expression that
    # requires the string to start with one or more underscore or
    # alphanumeric characters, followed by zero or more slash-separated
    # segments (each segment matching the same character set with an
    # optional dotted extension), with an optional trailing question mark.
    #
    # Tricky details: the dotted segment allowance is for simple "name.ext"
    # tails -- back-to-back dots are blocked up front so the regex itself
    # need not exclude them.
    #
    # Arguments:
    #   value -- The candidate relative URI string to validate.
    #
    # Results:
    #   Returns true when the string is non-empty, has no doubled dots, and
    #   matches the allowed shape; otherwise returns false.
    # </help>

    #
    # HACK: This should serve to disallow more than one period in a row.
    #
    if {[string first .. $value] != -1} then {
      return false
    }

    return [regexp -nocase -- \
        {^(?:[0-9A-Z_]+)(?:\/[0-9A-Z_]+(?:\.[0-9A-Z_]+)?)*\??$} $value]
  }

  proc saltToGuid { salt } {
    # <help>
    # This procedure converts a base64-encoded salt value into the textual
    # form of a .NET Guid.  It is a convenience used by the test code that
    # exercises the salted-identifier paths of the licensing components so
    # that a salt blob can be displayed and compared like an ordinary GUID.
    #
    # How it works: it first verifies the input is well-formed base64 using
    # [string is not base64]; non-base64 input yields the empty string.  It
    # then decodes the salt to a byte array with Convert.FromBase64String
    # and constructs a System.Guid from those bytes, returning the GUID's
    # canonical string representation via ToString.
    #
    # Tricky details: the underlying Guid constructor requires the byte
    # array to be exactly sixteen bytes; if the decoded salt is the wrong
    # length, the Guid construction will raise rather than silently produce
    # a value.
    #
    # Arguments:
    #   salt -- A base64-encoded byte string.  Must decode to exactly the
    #           number of bytes expected by Guid (sixteen) to succeed.
    #
    # Results:
    #   Returns the canonical Guid string when conversion succeeds, or the
    #   empty string when the salt is not valid base64.
    # </help>

    if {[string is not base64 $salt]} then {
      return ""
    }

    set bytes [object invoke -create Convert FromBase64String $salt]
    set guid [object create -alias Guid $bytes]

    return [$guid ToString]
  }

  #
  # WARNING: Do not remove or change this procedure.  It is used in order
  #          to properly handle the [harpy uri {:LibraryBase UseLibrary}]
  #          sub-command.
  #
  proc getRequestLicenseCertificateUri {} {
    # <help>
    # This procedure resolves the URI that the test suite uses to request a
    # license certificate from the official license processing servers, with
    # support for an environment-driven override so the address can be
    # redirected (for example to a private test server or on platforms where
    # the default infrastructure is not reachable).  This procedure is used
    # by the [harpy uri {:LibraryBase UseLibrary}] sub-command and MUST NOT
    # be removed or renamed.
    #
    # How it works: if the global LicenseUri environment variable is set, it
    # is returned verbatim.  Otherwise it loads the Eagle.Package.Toolset
    # sub-package, calls [setupPackageToolsetVars] to initialize the
    # package-scoped baseUri, licenseUri, and licenseUrns variables, and
    # randomly picks one of the configured license URNs (which is then
    # interpolated into the licenseUri template via [subst]).  A try/finally
    # block ensures the package toolset variables are cleaned up afterwards
    # via [setupPackageToolsetVars false true] regardless of how the
    # procedure exits, so transient test state does not leak.
    #
    # Tricky details: the URN selection is randomized and intentionally
    # global-scoped because the package variables it relies on are stored
    # in the global namespace; the cleanup pass in the finally block is
    # critical -- without it, those globals could perturb subsequent tests.
    # The body deliberately mirrors the core [requestLicenseCertificate]
    # helper so behavior stays aligned.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the resolved license request URI string.  Raises if the
    #   Eagle.Package.Toolset package cannot be loaded or required variables
    #   are missing.
    # </help>

    #
    # HACK: Allow license request URI to be overridden via the global
    #       environment.  This is necessary to enable testing on Mono.
    #       This was stolen from the [requestLicenseCertificate] core
    #       script library helper procedure.
    #
    if {[info exists ::env(LicenseUri)]} then {
      return $::env(LicenseUri)
    }

    #
    # NOTE: This core library sub-package is required.  It may already
    #       be present; however, if not, we need it right now.
    #
    package require Eagle.Package.Toolset; # pkgt.eagle

    #
    # NOTE: Make sure all the package variables are initialized before
    #       we attempt to refer to them below.  These variables may be
    #       able to interfere with the test suite; therefore, cleanup
    #       of those variables will be performed before returning from
    #       this procedure.
    #
    setupPackageToolsetVars false; # pkgt.eagle

    try {
      #
      # NOTE: Refer to these "package variables", which are actually in
      #       the global namespace.
      #
      variable baseUri
      variable licenseUri
      variable licenseUrns

      #
      # NOTE: Normally, choose a random URN, which will resolve to one
      #       of the official license request processing servers.  The
      #       (randomly) selected URN will then be used in the [subst]
      #       just below.  Stolen from the [requestLicenseCertificate]
      #       core script library helper procedure.
      #
      set urn [subst [lindex \
          $licenseUrns [expr {int(rand() * [llength $licenseUrns])}]]]

      return [subst $licenseUri]
    } finally {
      #
      # NOTE: Attempt to make sure that all "package variables", which
      #       are really global variables, are cleaned up.
      #
      setupPackageToolsetVars false true; # pkgt.eagle
    }
  }

  #
  # WARNING: This returns a default timeout value, which should not be
  #          relied upon for anything important -AND- absolutely cannot
  #          be infinite.
  #
  proc getDefaultTimeout {} {
    # <help>
    # This procedure returns a non-negative, finite default timeout (in
    # milliseconds) for the network probes performed elsewhere in the test
    # suite.  It is a best-effort helper: the value returned MUST NOT be
    # relied upon for anything important and absolutely cannot be infinite,
    # because the callers use it as a guard against tests hanging.
    #
    # How it works: when running under Eagle, it tries [harpy timeout] to
    # ask the Harpy plugin for its configured timeout; if that succeeds and
    # the result is a strict non-negative integer, that value is returned.
    # Otherwise the procedure falls back to a hard-coded 2000 milliseconds.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the configured Harpy timeout in milliseconds when available,
    #   or 2000 as a safety net.
    # </help>

    if {[isEagle] && [catch {harpy timeout} timeout] == 0 && \
        [string is integer -strict $timeout] && $timeout >= 0} then {
      return $timeout
    }

    return 2000; # HACK: Cannot get via Harpy?  Ok, no idea then.
  }

  proc getDefaultDateTimeFormat {} {
    # <help>
    # This procedure returns the canonical round-trippable date-and-time
    # format string the test suite uses when parsing or formatting Harpy
    # certificate timestamps.  Using a single shared format keeps the test
    # code aligned with the licensing components and makes round-trip
    # equality checks meaningful.
    #
    # How it works: it returns a hard-coded format string that mirrors the
    # DefaultTimeStampFormat static field in the
    # Licensing.Components.Private.Constants class.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the .NET DateTime format string
    #   "yyyy-MM-ddTHH:mm:ss.fffffffK".
    # </help>

    #
    # NOTE: This constant was borrowed from the DefaultTimeStampFormat
    #       static field in the Licensing.Components.Private.Constants
    #       class.
    #
    return yyyy-MM-ddTHH:mm:ss.fffffffK
  }

  proc rollbackInstallation { result {quiet false} } {
    # <help>
    # This procedure performs a forced rollback of a partially completed (or
    # successful) installation step, deleting newly written files and
    # restoring previously backed-up files.  It exists to leave the test
    # environment in a known state when an installer-driven test would
    # otherwise leave residue behind, or when the test wants to retry the
    # same installation.
    #
    # How it works: it consults the installation-result dictionary for a
    # rollback flag.  Only when that flag is strictly false (meaning the
    # installer did NOT already roll itself back) does it perform the work.
    # It first walks the relativeFileNames list, deleting each file found
    # under targetDirectory and attempting to remove the empty parent
    # subdirectories.  It then walks the backupFileNames list, regenerating
    # the original file name by stripping the standard "backup-GUID-" prefix
    # via [regsub] (using the System.IO.File class via [object invoke], with
    # the mscorlib-qualified type name on .NET Core).  Progress is reported
    # to the global test_channel using [tputs] unless quiet is requested.
    #
    # Tricky details: the backup prefix pattern is the standard GUID-prefixed
    # form written by the installer; if a backup file name does not contain
    # this prefix, the procedure raises rather than risk overwriting an
    # unrelated file.  Directory removal is wrapped in [catch] because
    # directories holding other files must remain.
    #
    # Arguments:
    #   result -- The installation result dictionary, containing at least
    #             rollback, targetDirectory, relativeFileNames, and
    #             backupFileNames entries.
    #   quiet  -- When true, suppresses the per-file progress messages; the
    #             default is false.
    #
    # Results:
    #   Returns the empty string; its effect is the side effect of deleting
    #   newly written files and restoring backed-up ones.  Raises if a
    #   backup file name does not match the expected GUID-prefixed pattern.
    # </help>

    set rollback [getDictionaryValue $result rollback]

    if {[string is false -strict $rollback]} then {
      set targetDirectory [getDictionaryValue $result targetDirectory]

      if {[file isdirectory $targetDirectory]} then {
        set relativeFileNames [getDictionaryValue $result relativeFileNames]

        if {[llength $relativeFileNames] > 0} then {
          foreach relativeFileName $relativeFileNames {
            set targetFileName [file nativename \
                [file join $targetDirectory $relativeFileName]]

            if {[file isfile $targetFileName]} then {
              file delete $targetFileName

              if {!$quiet} then {
                tputs $::test_channel [appendArgs \
                    "---- forced rollback deleted file \"" \
                    $targetFileName \"\n]
              }
            }

            set targetSubDirectory [file nativename \
                [file dirname $targetFileName]]

            if {[file isdirectory $targetSubDirectory]} then {
              catch {
                file rmdir $targetSubDirectory; # not empty?

                if {!$quiet} then {
                  tputs $::test_channel [appendArgs \
                      "---- forced rollback deleted directory \"" \
                      $targetSubDirectory \"\n]
                }
              }
            }
          }
        }
      }

      set backupPattern [appendArgs \
          {backup-[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-} \
          {[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}-}]

      set backupFileNames [getDictionaryValue $result backupFileNames]

      if {[llength $backupFileNames] > 0} then {
        foreach backupFileName $backupFileNames {
          set backupFileName [file nativename $backupFileName]

          if {[regsub -- $backupPattern \
              $backupFileName "" originalFileName] == 1} then {
            set originalFileName [file nativename $originalFileName]

            if {[isDotNetCore]} then {
              object invoke "System.IO.File, mscorlib" Move \
                  $backupFileName $originalFileName
            } else {
              object invoke System.IO.File Move \
                  $backupFileName $originalFileName
            }

            if {!$quiet} then {
              tputs $::test_channel [appendArgs \
                  "---- forced rollback restored file \"" \
                  $originalFileName \"\n]
            }
          } else {
            error [appendArgs \
                "bad prefix for backup file \"" $backupFileName \"]
          }
        }
      }
    }

    return ""
  }

  proc makeTlsBad { bad } {
    # <help>
    # This procedure forces the .NET process-wide transport security
    # protocol either to an obsolete and insecure value (deliberately bad)
    # or back to the best available value (good).  It exists so the test
    # suite can verify that the Harpy networking code refuses or recovers
    # from a hostile TLS configuration, and so it can restore a sane
    # protocol after such a test.
    #
    # How it works: when bad is true, it invokes the Eagle._Tests.Default
    # helper TestOverrideSecurityProtocol with the SSLv3 enumeration value
    # to forcibly set ServicePointManager.SecurityProtocol to SSLv3.  When
    # bad is false, it invokes TestRestoreBestSecurityProtocol to put it
    # back.  A success ("Ok") emits a warning banner to the test channel
    # via [tputs]; any other result raises with the captured error message.
    #
    # Tricky and security details: this is a DELIBERATE downgrade for test
    # purposes -- the SSLv3 selection is obsolete and insecure, and exists
    # here only to provoke the failure paths of the networking code.  The
    # restore branch must be paired with every "bad" call to avoid leaking
    # the unsafe setting into other tests.
    #
    # Arguments:
    #   bad -- When true, forces SSLv3 (a deliberately insecure value);
    #          when false, restores the best supported protocol.
    #
    # Results:
    #   Returns the empty string on success; emits a warning banner to the
    #   test channel.  Raises with the error message when the underlying
    #   helper does not report success.
    # </help>

    set result null

    if {$bad} then {
      set code [object invoke \
          Eagle._Tests.Default TestOverrideSecurityProtocol "" \
          Ssl3 true false false result]; # results
    } else {
      set code [object invoke \
          Eagle._Tests.Default TestRestoreBestSecurityProtocol "" \
          false result]
    }

    if {$code eq "Ok"} then {
      package require Eagle.Test

      tputs [getTestChannelOrDefault] [appendArgs \
          "==== WARNING: " [getStringFromObjectHandle $result] \n]
    } else {
      error [getStringFromObjectHandle $result]
    }
  }

  proc createCertificate { varName index } {
    # <help>
    # This procedure constructs a Licensing.Components.Public.Certificate
    # object whose properties are populated from a row in a test-data table.
    # It exists so test cases can lift "rows of certificate fields" out of
    # a structured tabular fixture and turn them into real, well-formed
    # Certificate objects ready to drive the licensing and signing
    # subsystems.
    #
    # How it works: it dereferences the caller's table variable with
    # [upvar 1], creates a fresh Certificate (with an Eagle object alias),
    # and then walks a fixed list of well-known column names -- Id, Protocol,
    # ProtocolVersion, Vendor, Origin, Authority, Agreement, Support,
    # TimeStamp, Duration, Key, Number, SerialNumber, HashAlgorithm,
    # Signature, Type, EntityType, EntityName, EntityValue, ExtraData,
    # Quantity, Product, Version, Features, and Restrictions -- using
    # [haveRowColumnValue] to test for presence and [getColumnValue] to
    # fetch the value before assigning it to the corresponding property on
    # the Certificate.  Two columns receive special handling: TimeStamp is
    # parsed with DateTime.ParseExact using the format from
    # [getDefaultDateTimeFormat], normalized to UTC via DateTime.SpecifyKind,
    # and round-trip-checked against the original text (a mismatch raises);
    # Key is parsed with Licensing.Components.Public.Utility's
    # ParsePublicKeyToken; Signature is base64-decoded into a byte array via
    # Convert.FromBase64String.
    #
    # Tricky details: the TimeStamp round-trip equality check is what
    # ensures the table's date strings actually represent valid timestamps
    # the licensing components will accept verbatim, rather than something
    # accepted by the parser but reformatted.  Each column is OPTIONAL --
    # absent columns are skipped, which is how the same routine can build
    # certificates that exercise specific subsets of the fields.
    #
    # Arguments:
    #   varName -- The name of the table variable in the caller's scope; it
    #              is dereferenced with [upvar 1].
    #   index   -- The row index within that table from which to draw the
    #              column values.
    #
    # Results:
    #   Returns the object handle of the newly created Certificate.  Raises
    #   when the TimeStamp round-trip equality check fails.
    # </help>

    upvar 1 $varName certificates

    set certificate [object create \
        -alias Licensing.Components.Public.Certificate]

    if {[haveRowColumnValue certificates $index Id]} then {
      $certificate Id \
          [getColumnValue $certificates($index) Id]
    }

    if {[haveRowColumnValue certificates $index Protocol]} then {
      $certificate Protocol \
          [getColumnValue $certificates($index) Protocol]
    }

    if {[haveRowColumnValue certificates $index ProtocolVersion]} then {
      $certificate ProtocolVersion \
          [getColumnValue $certificates($index) ProtocolVersion]
    }

    if {[haveRowColumnValue certificates $index Vendor]} then {
      $certificate Vendor \
          [getColumnValue $certificates($index) Vendor]
    }

    if {[haveRowColumnValue certificates $index Origin]} then {
      $certificate Origin \
          [getColumnValue $certificates($index) Origin]
    }

    if {[haveRowColumnValue certificates $index Authority]} then {
      $certificate Authority \
          [getColumnValue $certificates($index) Authority]
    }

    if {[haveRowColumnValue certificates $index Agreement]} then {
      $certificate Agreement \
          [getColumnValue $certificates($index) Agreement]
    }

    if {[haveRowColumnValue certificates $index Support]} then {
      $certificate Support \
          [getColumnValue $certificates($index) Support]
    }

    if {[haveRowColumnValue certificates $index TimeStamp]} then {
      set timeStamp(0) [getColumnValue $certificates($index) TimeStamp]
      set dateTimeFormat [getDefaultDateTimeFormat]

      set timeStamp($index) [object invoke -create -alias \
          DateTime ParseExact $timeStamp(0) $dateTimeFormat \
          null AdjustToUniversal]

      set timeStamp(2) [object invoke -create \
          -alias DateTime SpecifyKind $timeStamp($index) Utc]

      set timeStamp(check) [$timeStamp(2) ToString $dateTimeFormat]

      if {$timeStamp(check) ne $timeStamp(0)} then {
        error [appendArgs \
            "mismatch of roundtrip DateTime value \"" \
            $timeStamp(check) \
            "\" versus original DateTime value \"" \
            $timeStamp(0) \"]
      }

      $certificate TimeStamp $timeStamp(2)
    }

    if {[haveRowColumnValue certificates $index Duration]} then {
      $certificate Duration \
          [getColumnValue $certificates($index) Duration]
    }

    if {[haveRowColumnValue certificates $index Key]} then {
      set key [object invoke -create \
          Licensing.Components.Public.Utility ParsePublicKeyToken \
          [getColumnValue $certificates($index) Key]]

      $certificate Key $key
    }

    if {[haveRowColumnValue certificates $index Number]} then {
      $certificate Number \
          [getColumnValue $certificates($index) Number]
    }

    if {[haveRowColumnValue certificates $index SerialNumber]} then {
      $certificate SerialNumber \
          [getColumnValue $certificates($index) SerialNumber]
    }

    if {[haveRowColumnValue certificates $index HashAlgorithm]} then {
      $certificate HashAlgorithm \
          [getColumnValue $certificates($index) HashAlgorithm]
    }

    if {[haveRowColumnValue certificates $index Signature]} then {
      set signature [object invoke -create Convert FromBase64String \
          [getColumnValue $certificates($index) Signature]]

      $certificate Signature $signature
    }

    if {[haveRowColumnValue certificates $index Type]} then {
      $certificate Type \
          [getColumnValue $certificates($index) Type]
    }

    if {[haveRowColumnValue certificates $index EntityType]} then {
      $certificate EntityType \
          [getColumnValue $certificates($index) EntityType]
    }

    if {[haveRowColumnValue certificates $index EntityName]} then {
      $certificate EntityName \
          [getColumnValue $certificates($index) EntityName]
    }

    if {[haveRowColumnValue certificates $index EntityValue]} then {
      $certificate EntityValue \
          [getColumnValue $certificates($index) EntityValue]
    }

    if {[haveRowColumnValue certificates $index ExtraData]} then {
      $certificate ExtraData \
          [getColumnValue $certificates($index) ExtraData]
    }

    if {[haveRowColumnValue certificates $index Quantity]} then {
      $certificate Quantity \
          [getColumnValue $certificates($index) Quantity]
    }

    if {[haveRowColumnValue certificates $index Product]} then {
      $certificate Product \
          [getColumnValue $certificates($index) Product]
    }

    if {[haveRowColumnValue certificates $index Version]} then {
      $certificate Version \
          [getColumnValue $certificates($index) Version]
    }

    if {[haveRowColumnValue certificates $index Features]} then {
      $certificate Features \
          [getColumnValue $certificates($index) Features]
    }

    if {[haveRowColumnValue certificates $index Restrictions]} then {
      $certificate Restrictions \
          [getColumnValue $certificates($index) Restrictions]
    }

    return $certificate
  }

  proc checkForHarpyCompileOption { channel name } {
    # <help>
    # This procedure probes whether a specific Harpy compile-time option is
    # present in the currently loaded Harpy build and, if so, registers a
    # corresponding test constraint so subsequent test cases can require it.
    # It exists because Harpy is built with different feature sets per
    # configuration; tests that depend on optional features must skip
    # gracefully on builds where those features were compiled out.
    #
    # How it works: it writes a diagnostic line announcing the probe through
    # [tputs] on the given channel.  When running under Eagle, it asks the
    # plugin for its compile options via [harpy options] (inside a [catch]),
    # and if the named option appears in the list (case-insensitive match
    # via [lsearch -exact -nocase]) it adds the test constraint
    # "harpyCompile.<name>" via [addConstraint], finishes the line with
    # "yes", and returns.  Otherwise the line finishes with "no".
    #
    # Arguments:
    #   channel -- The test output channel to which the probe diagnostic is
    #              written.
    #   name    -- The name of the Harpy compile option (for example
    #              CERTIFICATE_PLUGIN).
    #
    # Results:
    #   Returns the empty string; the effect is a diagnostic line and,
    #   on success, a registered test constraint.
    # </help>

    tputs $channel [appendArgs "---- checking for Harpy compile option \"" \
        $name "\"... "]

    if {[isEagle]} then {
      if {[catch {harpy options} options] == 0 && \
          [lsearch -exact -nocase $options $name] != -1} then {
        addConstraint [appendArgs harpyCompile. $name]
        tputs $channel yes\n
        return
      }
    }

    tputs $channel no\n
  }

  proc getKnownHarpyCompileOptions { {all true} } {
    # <help>
    # This procedure returns the list of compile-time option names the test
    # suite knows how to probe for.  It is the canonical "what features
    # could be present" list driving [checkForKnownHarpyCompileOptions], so
    # tests can establish test constraints for every interesting feature in
    # one pass.
    #
    # How it works: when the global array entry
    # test_well_known(harpyCompileOptions) is set, it is returned verbatim
    # (this allows external configuration to override or extend the list).
    # Otherwise a hard-coded list of Harpy-specific options is built --
    # CERTIFICATE_PLUGIN, CERTIFICATE_POLICY, CERTIFICATE_RENEWAL,
    # DEMO_EDITION, DEMO_KEY_PAIRS, EMBED_CERTIFICATES, EXTRA_DIAGNOSTICS,
    # FOR_TEST_USE_ONLY, FORCE_TRACE, LICENSING, LICENSING_NOP,
    # LICENSE_MANAGER, LIMITED_EDITION, OBFUSCATION, OPEN_SSL,
    # PLUGIN_COMMANDS, SECURITY, and STRICT_FEATURES.  When the all flag is
    # set (the default), a second list of core library options that Harpy
    # references directly is appended: CONSOLE, DEAD_CODE, DEBUG,
    # DEBUG_TRACE, ENTERPRISE_LOCKDOWN, ISOLATED_INTERPRETERS,
    # ISOLATED_PLUGINS, MAYBE_ENTERPRISE_LOCKDOWN, MONO_BUILD, NATIVE,
    # NETWORK, NET_40, NET_STANDARD_20, NET_STANDARD_21, OFFICIAL,
    # POLICY_TRACE, SERIALIZATION, SHELL, STABLE, TEST, THROW_ON_DISPOSED,
    # UNIX, WEB, WINDOWS, WINFORMS, and XML.
    #
    # Tricky details: the lists are deliberately hand-curated; the inline
    # TODO comments note that they must be kept up-to-date as the build
    # gains new options.
    #
    # Arguments:
    #   all -- When true (the default), includes the core library options
    #          referenced by Harpy in addition to the Harpy-only list.
    #
    # Results:
    #   Returns the list of known compile option names.
    # </help>

    if {[info exists ::test_well_known(harpyCompileOptions)]} then {
      return $::test_well_known(harpyCompileOptions)
    }

    #
    # TODO: Manually keep this list up-to-date.
    #
    set result [list \
        CERTIFICATE_PLUGIN CERTIFICATE_POLICY \
        CERTIFICATE_RENEWAL DEMO_EDITION \
        DEMO_KEY_PAIRS EMBED_CERTIFICATES \
        EXTRA_DIAGNOSTICS FOR_TEST_USE_ONLY \
        FORCE_TRACE LICENSING LICENSING_NOP \
        LICENSE_MANAGER LIMITED_EDITION \
        OBFUSCATION OPEN_SSL PLUGIN_COMMANDS \
        SECURITY STRICT_FEATURES]

    if {$all} then {
      #
      # HACK: Also include the core library compile options that
      #       are directly referenced by Harpy.
      #
      # TODO: Manually keep this list up-to-date.
      #
      lappend result CONSOLE DEAD_CODE DEBUG DEBUG_TRACE \
          ENTERPRISE_LOCKDOWN ISOLATED_INTERPRETERS \
          ISOLATED_PLUGINS MAYBE_ENTERPRISE_LOCKDOWN MONO_BUILD \
          NATIVE NETWORK NET_40 NET_STANDARD_20 NET_STANDARD_21 \
          OFFICIAL POLICY_TRACE SERIALIZATION SHELL STABLE TEST \
          THROW_ON_DISPOSED UNIX WEB WINDOWS WINFORMS XML
    }

    return $result
  }

  proc checkForKnownHarpyCompileOptions { channel } {
    # <help>
    # This procedure drives the compile-option discovery pass at test suite
    # startup, probing every well-known option name and (when present)
    # registering a corresponding test constraint.  It is the umbrella that
    # ensures the feature-dependent skip logic of individual tests is set
    # up correctly.
    #
    # How it works: it emits a starting diagnostic to the given channel via
    # [tputs] and then fetches the list of well-known options through
    # [getKnownHarpyCompileOptions].  When the list is non-empty, the count
    # is announced and each option is checked via [checkForHarpyCompileOption];
    # options that have been explicitly suppressed by setting a global
    # no(compile.<name>) variable are skipped.  When the list is empty,
    # only "no" is emitted.
    #
    # Arguments:
    #   channel -- The test output channel to which the progress messages
    #              are written.
    #
    # Results:
    #   Returns the empty string; the effect is the emitted diagnostics and
    #   the registered test constraints for each present option.
    # </help>

    tputs $channel "---- checking for known Harpy compile options... "

    set options [getKnownHarpyCompileOptions]

    if {[llength $options] > 0} then {
      tputs $channel [appendArgs "yes (" [llength $options] ")\n"]

      foreach option $options {
        if {![info exists [appendArgs ::no(compile. $option )]]} then {
          checkForHarpyCompileOption $channel $option
        }
      }
    } else {
      tputs $channel no\n
    }
  }

  proc reformatCertificateSpacing { fileName } {
    # <help>
    # This procedure normalizes the cosmetic layout of a Harpy certificate
    # XML file in place, reordering the standard namespace declarations
    # into a canonical sequence and rewrapping over-long hash comments.
    # It is invoked by the signing tool after exporting a certificate so
    # the resulting file is easier to read and diff.
    #
    # How it works: it loads the file with [readFile] and uses [string map]
    # twice to reorder the xmlns, xmlns:xsi, and xmlns:xsd attributes into
    # the canonical "xmlns -> xmlns:xsi -> xmlns:xsd" order regardless of
    # whether they originally appeared in xsd/xsi/ns or xsi/xsd/ns order.
    # A second pass injects a newline and 13-space indent before the bare
    # "xmlns" keyword, aligning the namespace block under its parent.
    # Finally, when the embedded HASH comment exceeds a 57-character cap,
    # it is broken across two lines (the second line indented by four
    # spaces) so [certificate warning]-style formatting stays tidy.  The
    # modified text is written back with [writeFile].
    #
    # Tricky details: the 57-character limit is the magic number used by
    # the [certificate warning] hash formatter and must stay in agreement
    # with it; the [regexp -skip 1] is used to extract the hash hex run from
    # the warning comment.  The pattern allows hash lengths from 32 to 128
    # hexadecimal characters to cover MD5 through SHA-512.
    #
    # Arguments:
    #   fileName -- The path of the Harpy certificate file to reformat.
    #
    # Results:
    #   Returns the empty string; its effect is rewriting the file with the
    #   cosmetically reformatted XML content.
    # </help>

    set data [readFile $fileName]

    set xmlNs xmlns=\"https://eagle.to/2011/harpy\"
    set xmlNsXsi xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"
    set xmlNsXsd xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\"

    set data [string map [list \
        [appendArgs $xmlNsXsd " " $xmlNsXsi " " $xmlNs] \
        [appendArgs $xmlNs " " $xmlNsXsi " " $xmlNsXsd]]  $data]

    set data [string map [list \
        [appendArgs $xmlNsXsi " " $xmlNsXsd " " $xmlNs] \
        [appendArgs $xmlNs " " $xmlNsXsi " " $xmlNsXsd]]  $data]

    set spaces "             "

    set data [string map [list \
        "\" xmlns" [appendArgs \" [info newline] $spaces xmlns]] $data]

    set limit 57; # HACK: Magic, see "certificate warning" formatting.

    if {$limit > 0 && [regexp -skip 1 -- \
        {HASH: ([0-9a-f]{32,128})\s+-->} $data hash] && \
        [string length $hash] > $limit} then {
      set formatted [appendArgs \
          [string range $hash 0 [expr {$limit - 1}]] \
          [info newline] "    " [string range $hash $limit end]]

      set data [string map [list $hash $formatted] $data]
    }

    writeFile $fileName $data
    return ""
  }

  proc isValidKeyRing { name } {
    # <help>
    # This procedure decides whether a value retrieved as a "saved key
    # ring" is meaningful enough to be restored.  It is the gate used by
    # [restoreKeyRing] before issuing a [keyring restore] so an empty
    # snapshot is not treated as a real restoration.
    #
    # How it works: it returns false when the string is empty, true
    # otherwise.
    #
    # Arguments:
    #   name -- The candidate key ring snapshot value.
    #
    # Results:
    #   Returns true when the value is non-empty; otherwise false.
    # </help>

    if {[string length $name] == 0} then {
      return false
    }

    return true
  }

  proc saveKeyRing { varName {policyType ""} } {
    # <help>
    # This procedure captures a snapshot of the current Harpy key ring
    # state (optionally restricted to a specific policy type) into a named
    # array variable in the caller's scope.  It is paired with
    # [restoreKeyRing] to make tests that perturb the key rings revertible.
    #
    # How it works: it dereferences the caller's array variable through
    # [upvar 1], pre-seeds the local element to the empty string (so a
    # failed save leaves a sentinel that [restoreKeyRing] will skip), and
    # then attempts to capture the snapshot using [keyring save] -- with
    # the policy type when supplied, or without when omitted.  The save is
    # wrapped in [catch] so a failure does not propagate out of the helper.
    #
    # Arguments:
    #   varName    -- The name of the destination array in the caller's
    #                 scope; its local member receives the snapshot.
    #   policyType -- Optional policy type (for example "script") to scope
    #                 the snapshot; an empty string means "all".
    #
    # Results:
    #   Returns the empty string; its effect is populating the named array.
    # </help>

    upvar 1 $varName savedKeyRing

    set savedKeyRing(local) ""

    if {[string length $policyType] > 0} then {
      catch {set savedKeyRing(local) [keyring save $policyType]}
    } else {
      catch {set savedKeyRing(local) [keyring save]}
    }

    return ""
  }

  proc resetKeyRing { {policyType ""} {useTestData true} } {
    # <help>
    # This procedure resets the Harpy key rings back to their bootstrapped
    # default state for the given policy type, configuring the policy and
    # key-name machinery as needed so that the [keyring bootstrap] step is
    # permitted to run.  It is the key-ring counterpart of a "test fixture
    # init" routine, used between tests that mutate the active key rings.
    #
    # How it works: it determines whether the operation targets the default
    # script policy (an empty policyType or "Script"), then saves the
    # current key name and arranges for the trust root key name to be in
    # effect for the duration: when useTestData is true and a script policy
    # is being reset and testKeyName(2) exists, that test key name is
    # applied; otherwise the key name is fully reset.  Inside nested
    # try/finally blocks it then saves and resets the key-ring name (so the
    # default ring is targeted), saves and resets the policy, optionally
    # applies the test policy file from testPolicy(5) -- or enables policy
    # with [certificate policy -enabled true] -- and finally calls
    # [keyring clear] followed by [keyring bootstrap] (scoped by policyType
    # when given).  Every nested save is restored in a finally clause so
    # the surrounding state is left exactly as it was.
    #
    # Tricky details: the policy and key name must be in a specific shape
    # before [keyring bootstrap] will succeed under the test policy (which
    # enforces key-name matching against the trust root); the staging done
    # here is what makes the reset possible.  The test fixture relies on
    # the globals testKeyName and testPolicy, which the surrounding suite
    # initializes.
    #
    # Arguments:
    #   policyType  -- Optional policy scope (empty string means "all").
    #   useTestData -- When true (the default), uses the testKeyName(2) and
    #                  testPolicy(5) values; otherwise uses raw resets.
    #
    # Results:
    #   Returns the empty string; its effect is the side effect of clearing
    #   and re-bootstrapping the key rings within the staged context.
    # </help>

    global testKeyName
    global testPolicy

    #
    # NOTE: Are we dealing with the default policy type (script)?
    #
    set isScript [expr {$policyType in [list "" Script]}]

    #
    # NOTE: In order for the [keyring bootstrap] sub-command to work when
    #       the test policy is active (which enforces key name matching),
    #       the key name must be set to the trust root key name.
    #
    saveKeyName savedKeyName

    if {$useTestData && $isScript && [info exists testKeyName(2)]} then {
      setKeyName $testKeyName(2)
    } else {
      resetKeyName
    }

    try {
      #
      # HACK: Force use of the default key rings as that is how Harpy is
      #       generally tested.  In the future, perhaps make testing not
      #       depend on this.
      #
      saveKeyRingName savedKeyRingName; resetKeyRingName

      try {
        #
        # NOTE: In order for the [keyring bootstrap] sub-command to work
        #       when the test policy is active, certain policy flags are
        #       required.
        #
        savePolicy savedPolicy; resetPolicy

        if {$useTestData && $isScript && [info exists testPolicy(5)]} then {
          certificate policy -file $testPolicy(5) -script $testPolicy(5)
        } else {
          certificate policy -enabled true
        }

        try {
          if {[string length $policyType] > 0} then {
            keyring clear $policyType
            keyring bootstrap $policyType
          } else {
            keyring clear
            keyring bootstrap
          }
        } finally {
          restorePolicy savedPolicy
        }
      } finally {
        restoreKeyRingName savedKeyRingName
      }
    } finally {
      restoreKeyName savedKeyName
    }

    return ""
  }

  proc restoreKeyRing { varName {policyType ""} } {
    # <help>
    # This procedure restores a key ring snapshot previously captured by
    # [saveKeyRing], optionally scoped to a particular policy type, and
    # then disposes of the snapshot array element.  It is the unwind side
    # of the save/restore pair used to keep tests isolated.
    #
    # How it works: it dereferences the snapshot array variable through
    # [upvar 1], and when the local element exists and passes
    # [isValidKeyRing], it calls [keyring restore] (with the policy type
    # when supplied, or without when omitted).  The local element is then
    # unset, and the array itself is unset when no elements remain.
    #
    # Arguments:
    #   varName    -- The name of the snapshot array in the caller's scope.
    #   policyType -- Optional policy scope; an empty string means "all".
    #
    # Results:
    #   Returns the empty string; its effect is restoring the key rings and
    #   cleaning up the snapshot variable.
    # </help>

    upvar 1 $varName savedKeyRing

    if {[info exists savedKeyRing(local)] && \
        [isValidKeyRing $savedKeyRing(local)]} then {
      if {[string length $policyType] > 0} then {
        keyring restore $savedKeyRing(local) $policyType
      } else {
        keyring restore $savedKeyRing(local)
      }
    }

    unset -nocomplain savedKeyRing(local)

    if {[array size savedKeyRing] == 0} then {
      unset -nocomplain savedKeyRing
    }

    return ""
  }

  proc isValidPolicy { policy } {
    # <help>
    # This procedure decides whether a captured certificate policy value is
    # meaningful enough to be reapplied.  It is the gate used by
    # [restorePolicy] before issuing a policy assignment so that empty or
    # placeholder values are translated to a proper -unset instead.
    #
    # How it works: it returns false when the string is empty, or when its
    # value is one of the sentinel enumeration values "None" or
    # "Undefined"; otherwise it returns true.
    #
    # Arguments:
    #   policy -- The candidate policy value to validate.
    #
    # Results:
    #   Returns true when the value is a real policy enumeration name,
    #   false when it is empty or a sentinel.
    # </help>

    if {[string length $policy] == 0} then {
      return false
    }

    if {$policy eq "None" || $policy eq "Undefined"} then {
      return false
    }

    return true
  }

  proc savePolicy { varName } {
    # <help>
    # This procedure captures the current Harpy certificate policy
    # settings -- both the process-global view and the interpreter-local
    # view -- into a named array in the caller's scope.  It is paired with
    # [restorePolicy] so a test can freely reconfigure policies and put
    # them back when finished.
    #
    # How it works: it dereferences the caller's array variable with
    # [upvar 1] and writes two elements: global (the result of [certificate
    # policy -local false]) and local (the result of [certificate policy
    # -local true]).  Each element is a list of policy-type and policy-name
    # pairs suitable for direct consumption by [restorePolicy].
    #
    # Arguments:
    #   varName -- The name of the destination array in the caller's scope.
    #
    # Results:
    #   Returns the empty string; its effect is populating the named array.
    # </help>

    upvar 1 $varName savedPolicy

    set savedPolicy(global) [certificate policy -local false]
    set savedPolicy(local) [certificate policy -local true]

    return ""
  }

  proc resetPolicy {} {
    # <help>
    # This procedure disables and clears every certificate policy setting
    # in both the global and interpreter-local scopes.  It is the
    # before-test "blank slate" call used to remove any custom policies
    # left by previous tests so the new test starts from a known-clean
    # baseline.
    #
    # How it works: it issues two [certificate policy] invocations -- one
    # for each scope -- each with -enabled false and -unset true, so the
    # subsystem is both disabled and has its per-policy-type entries
    # removed.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; its effect is clearing the certificate
    #   policy state.
    # </help>

    certificate policy -local false -enabled false -unset true
    certificate policy -local true -enabled false -unset true

    return ""
  }

  proc restorePolicy { varName {policyTypes ""} {unset true} } {
    # <help>
    # This procedure reapplies a certificate policy snapshot previously
    # captured by [savePolicy], optionally restricted to a subset of policy
    # types, and then disposes of the snapshot array.  It is the unwind
    # side of the save/restore pair used to keep tests isolated from each
    # other.
    #
    # How it works: it dereferences the snapshot array variable through
    # [upvar 1].  For each of the local and global scopes, when the
    # corresponding element is present, it walks the list of policy-type
    # and policy-name pairs.  When the policyTypes filter is non-empty, any
    # policy whose type is not in the filter is skipped.  Each retained
    # entry is reapplied with [certificate policy] -- using the original
    # policy when [isValidPolicy] accepts it, or using "None" with -unset
    # true to clear it when it does not.  After processing, the local
    # element is unset and the global element is unset (and the array
    # disposed when empty) when the unset flag is true.
    #
    # Arguments:
    #   varName     -- The name of the snapshot array in the caller's
    #                  scope.
    #   policyTypes -- Optional list of policy types to limit the restore
    #                  to (others are skipped); empty means "all".
    #   unset       -- When true (the default), also unsets the snapshot
    #                  array elements after restoring them.
    #
    # Results:
    #   Returns the empty string; its effect is restoring the policy state
    #   and optionally disposing of the snapshot.
    # </help>

    upvar 1 $varName savedPolicy

    if {[info exists savedPolicy(local)]} then {
      foreach {policyType policy} $savedPolicy(local) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        if {[isValidPolicy $policy]} then {
          certificate policy -local true $policyType $policy
        } else {
          certificate policy -local true $policyType None -unset true
        }
      }
    }

    if {$unset} then {
      unset -nocomplain savedPolicy(local)
    }

    if {[info exists savedPolicy(global)]} then {
      foreach {policyType policy} $savedPolicy(global) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        if {[isValidPolicy $policy]} then {
          certificate policy -local false $policyType $policy
        } else {
          certificate policy -local false $policyType None -unset true
        }
      }
    }

    if {$unset} then {
      unset -nocomplain savedPolicy(global)

      if {[array size savedPolicy] == 0} then {
        unset -nocomplain savedPolicy
      }
    }

    return ""
  }

  proc setApprovedDataPolicy { enabled } {
    # <help>
    # This procedure adds or removes the "approved data" certificate policy
    # file from both the global and interpreter-local scopes.  Tests use it
    # to switch the approved-data trust contribution on and off without
    # otherwise touching the policy stack.
    #
    # How it works: it consults the global testPolicy fixture array for
    # index 21, which holds the path of the approved-data policy file, and
    # prefixes that path with a plus or minus operator depending on the
    # enabled argument.  It then issues [certificate policy -file] for both
    # scopes, where the leading plus character causes the file to be added
    # and the leading minus character causes it to be removed.
    #
    # Arguments:
    #   enabled -- When true the approved-data policy file is added; when
    #              false it is removed.
    #
    # Results:
    #   Returns the empty string; its effect is mutating the certificate
    #   policy file list in both scopes.
    # </help>

    global testPolicy

    if {$enabled} then {
      set operator +
    } else {
      set operator -
    }

    certificate policy -local false -file \
        [appendArgs $operator $testPolicy(21)]

    certificate policy -local true -file \
        [appendArgs $operator $testPolicy(21)]

    return ""
  }

  proc restoreLicensePolicy { varName } {
    # <help>
    # This procedure is a convenience wrapper that restores only the
    # license-related slice of a policy snapshot.  It exists because some
    # tests need to put back the license policy alone while leaving any
    # other captured policies untouched.
    #
    # How it works: it dereferences the snapshot variable through
    # [upvar 1] and delegates to [restorePolicy] with the policyTypes
    # filter set to a single-element list "-license" and unset set to
    # false, so the snapshot itself remains available for further targeted
    # restores.
    #
    # Arguments:
    #   varName -- The name of the snapshot array in the caller's scope.
    #
    # Results:
    #   Returns the result of [restorePolicy] (the empty string); its
    #   effect is restoring just the license policy.
    # </help>

    upvar 1 $varName savedPolicy

    restorePolicy savedPolicy [list -license] false
  }

  proc saveRenewCallbacks { varName } {
    # <help>
    # This procedure captures the current configuration of the certificate
    # renewal callbacks (per policy type) into a named array in the
    # caller's scope.  It is paired with [restoreRenewCallbacks] so a test
    # can switch the renewal callbacks off (or rewire them) and restore the
    # original configuration when done.
    #
    # How it works: it dereferences the caller's array variable through
    # [upvar 1] and stores the global element by querying [certificate
    # renewcallback] without arguments, which returns the list of
    # policy-type and enabled flag pairs that drive the renewal machinery.
    #
    # Arguments:
    #   varName -- The name of the destination array in the caller's scope.
    #
    # Results:
    #   Returns the empty string; its effect is populating the named array.
    # </help>

    upvar 1 $varName savedRenewCallbacks

    set savedRenewCallbacks(global) [certificate renewcallback]

    return ""
  }

  proc resetRenewCallbacks {} {
    # <help>
    # This procedure enables the certificate renewal callback for every
    # supported policy type.  It is the before-test baseline that lets
    # tests assume renewal is active across the script, file, stream,
    # license, keypair, trace, and other policy paths.
    #
    # How it works: it issues a single [certificate renewcallback] call
    # that sets the -script, -file, -stream, -license, -keypair, -trace,
    # and -other flags to true.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; its effect is enabling the renewal
    #   callback for every policy type.
    # </help>

    certificate renewcallback \
        -script true -file true -stream true -license true -keypair true \
        -trace true -other true

    return ""
  }

  proc restoreRenewCallbacks { varName {policyTypes ""} {unset true} } {
    # <help>
    # This procedure reapplies a renewal-callback snapshot previously
    # captured by [saveRenewCallbacks], optionally restricted to a subset
    # of policy types, and then disposes of the snapshot.  It is the
    # unwind side of the save/restore pair used to keep tests isolated.
    #
    # How it works: it dereferences the snapshot array variable through
    # [upvar 1], and when the global element is present, it walks the list
    # of policy-type and enabled-flag pairs.  When the policyTypes filter
    # is non-empty, any entry whose type is not in the filter is skipped;
    # remaining entries are reapplied via [certificate renewcallback].
    # When unset is true (the default), the global element and the array
    # itself (if empty) are then disposed.
    #
    # Arguments:
    #   varName     -- The name of the snapshot array in the caller's
    #                  scope.
    #   policyTypes -- Optional list of policy types to limit the restore
    #                  to (others are skipped); empty means "all".
    #   unset       -- When true (the default), also unsets the snapshot
    #                  array after restoring.
    #
    # Results:
    #   Returns the empty string; its effect is restoring the renewal
    #   callback state and optionally disposing of the snapshot.
    # </help>

    upvar 1 $varName savedRenewCallbacks

    if {[info exists savedRenewCallbacks(global)]} then {
      foreach {policyType enabled} $savedRenewCallbacks(global) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        certificate renewcallback $policyType $enabled
      }
    }

    if {$unset} then {
      unset -nocomplain savedRenewCallbacks(global)

      if {[array size savedRenewCallbacks] == 0} then {
        unset -nocomplain savedRenewCallbacks
      }
    }

    return ""
  }

  proc hasSecurity {} {
    # <help>
    # This procedure reports whether the active interpreter currently has
    # the script security subsystem enabled, returning the empty string
    # when that cannot be determined.  It is used by the security
    # save/restore helpers to read and compare the live state.
    #
    # How it works: it invokes the non-public HasSecurity property on the
    # active Interpreter via [object invoke -flags +NonPublic
    # Interpreter.GetActive HasSecurity], inside a [catch].  On success the
    # boolean result is returned; on failure (for example when no
    # interpreter is available) the empty string is returned so the caller
    # can branch on a missing answer.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the boolean (true or false) value of HasSecurity, or the
    #   empty string when it cannot be queried.
    # </help>

    if {[catch {
      object invoke -flags +NonPublic Interpreter.GetActive HasSecurity
    } security] == 0} then {
      return $security
    }

    return ""
  }

  proc saveSecurity { varName } {
    # <help>
    # This procedure captures the current script security enabled state
    # into a named array in the caller's scope, but only when that state
    # can actually be read.  It is paired with [restoreSecurity] so a test
    # can toggle script security and restore the original state when
    # finished.
    #
    # How it works: it reads the live state via [hasSecurity] and, only if
    # the value is a strict boolean (true or false), dereferences the
    # caller's array variable through [upvar 1] and writes the captured
    # state to its global element.  When the state cannot be read, the
    # snapshot variable is left untouched so [restoreSecurity] becomes a
    # no-op.
    #
    # Arguments:
    #   varName -- The name of the destination array in the caller's scope.
    #
    # Results:
    #   Returns the empty string; its effect is populating the named array
    #   when the state can be read.
    # </help>

    set security [hasSecurity]

    if {[string is boolean -strict $security]} then {
      upvar 1 $varName savedSecurity

      set savedSecurity(global) $security
    }

    return ""
  }

  proc resetSecurity {} {
    # <help>
    # This procedure forces script security off on the active interpreter,
    # ignoring any error that might occur.  It is the before-test baseline
    # used to put the engine into a known non-secure state so the test can
    # set up its preferred policy and key ring configuration.
    #
    # How it works: it issues [security false] inside a [catch] so that
    # missing or already-disposed security state does not propagate as an
    # error.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; its effect is disabling script security
    #   when possible.
    # </help>

    catch {security false}

    return ""
  }

  proc restoreSecurity { varName {unset true} } {
    # <help>
    # This procedure restores the script security enabled state captured
    # by [saveSecurity], applying it only when the live state actually
    # differs from the snapshot.  It is the unwind side of the save/reset
    # pair, and avoids redundant transitions through the security
    # subsystem.
    #
    # How it works: it dereferences the snapshot array variable through
    # [upvar 1], and when the global element is present it reads the live
    # state via [hasSecurity].  If the live state is not a strict boolean
    # or does not match the snapshot, it calls [security] with the saved
    # value to switch it back.  When unset is true (the default), the
    # snapshot element and the snapshot array itself (when empty) are
    # disposed.
    #
    # Arguments:
    #   varName -- The name of the snapshot array in the caller's scope.
    #   unset   -- When true (the default), also unsets the snapshot array
    #              after restoring.
    #
    # Results:
    #   Returns the empty string; its effect is restoring the security
    #   state and optionally disposing of the snapshot.
    # </help>

    upvar 1 $varName savedSecurity

    if {[info exists savedSecurity(global)]} then {
      set security [hasSecurity]

      if {![string is boolean -strict $security] || \
          $security != $savedSecurity(global)} then {
        security $savedSecurity(global)
      }
    }

    if {$unset} then {
      unset -nocomplain savedSecurity(global)

      if {[array size savedSecurity] == 0} then {
        unset -nocomplain savedSecurity
      }
    }

    return ""
  }

  proc isValidKeyName { keyName } {
    # <help>
    # This procedure decides whether a captured key-name value is
    # meaningful enough to be reapplied.  It is the gate used by
    # [restoreKeyName] before issuing a key-name assignment, so empty
    # values are translated to a proper -unset instead.
    #
    # How it works: it returns false when the string is empty, true
    # otherwise.
    #
    # Arguments:
    #   keyName -- The candidate key-name string to validate.
    #
    # Results:
    #   Returns true when the value is non-empty; otherwise false.
    # </help>

    if {[string length $keyName] == 0} then {
      return false
    }

    return true
  }

  proc saveKeyName { varName } {
    # <help>
    # This procedure captures the current per-policy-type required key
    # names (in both the global and interpreter-local scopes) into a named
    # array in the caller's scope.  It is paired with [restoreKeyName] so
    # a test can change the required key name and put the original list
    # back.
    #
    # How it works: it dereferences the caller's array variable through
    # [upvar 1] and writes two elements: global (the result of [certificate
    # keyname -local false]) and local (the result of [certificate keyname
    # -local true]).  Each element is a list of policy-type and key-name
    # pairs suitable for [restoreKeyName].
    #
    # Arguments:
    #   varName -- The name of the destination array in the caller's scope.
    #
    # Results:
    #   Returns the empty string; its effect is populating the named array.
    # </help>

    upvar 1 $varName savedKeyName

    set savedKeyName(global) [certificate keyname -local false]
    set savedKeyName(local) [certificate keyname -local true]

    return ""
  }

  proc setKeyName { keyName } {
    # <help>
    # This procedure sets the same required key name for every supported
    # policy type, in both the global and interpreter-local scopes.  It is
    # used in test setup, for example to align the active key name with the
    # trust-root key name before bootstrapping the key rings.
    #
    # How it works: it issues two [certificate keyname] commands -- one
    # with -local false and one with -local true -- each setting -file,
    # -script, -stream, -license, -keypair, -trace, and -other to the
    # supplied keyName.
    #
    # Arguments:
    #   keyName -- The required key name to apply uniformly across every
    #              policy type and both scopes.
    #
    # Results:
    #   Returns the empty string; its effect is setting the per-policy-type
    #   required key name in both scopes.
    # </help>

    certificate keyname -local false \
        -file $keyName -script $keyName -stream $keyName -license $keyName \
        -keypair $keyName -trace $keyName -other $keyName

    certificate keyname -local true \
        -file $keyName -script $keyName -stream $keyName -license $keyName \
        -keypair $keyName -trace $keyName -other $keyName

    return ""
  }

  proc resetKeyName {} {
    # <help>
    # This procedure clears every per-policy-type required key name, in
    # both the global and interpreter-local scopes.  It is the before-test
    # baseline used to remove any custom key-name constraints so the next
    # test starts from a clean slate.
    #
    # How it works: it issues two [certificate keyname] commands -- one
    # for each scope -- each setting -script, -file, -stream, -license,
    # -keypair, -trace, and -other to the empty string with -unset true so
    # the entries are actually removed rather than recorded as empty
    # constraints.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; its effect is removing every required
    #   key name across all policy types in both scopes.
    # </help>

    certificate keyname -local false \
        -script "" -file "" -stream "" -license "" -keypair "" -trace "" \
        -other "" -unset true

    certificate keyname -local true \
        -script "" -file "" -stream "" -license "" -keypair "" -trace "" \
        -other "" -unset true

    return ""
  }

  proc restoreKeyName { varName {policyTypes ""} {unset true} } {
    # <help>
    # This procedure reapplies a required-key-name snapshot previously
    # captured by [saveKeyName], optionally restricted to a subset of
    # policy types, and then disposes of the snapshot.  It is the unwind
    # side of the save/restore pair used to keep tests isolated.
    #
    # How it works: it dereferences the snapshot array variable through
    # [upvar 1].  For each scope (local first, then global), when the
    # corresponding element is present it walks the list of policy-type
    # and key-name pairs.  When the policyTypes filter is non-empty, any
    # entry whose type is not in the filter is skipped; remaining entries
    # are reapplied via [certificate keyname], using the captured name
    # when it passes [isValidKeyName] or an empty string with -unset true
    # otherwise.  When unset is true (the default), the local element, the
    # global element, and the array itself (when empty) are then disposed.
    #
    # Arguments:
    #   varName     -- The name of the snapshot array in the caller's
    #                  scope.
    #   policyTypes -- Optional list of policy types to limit the restore
    #                  to (others are skipped); empty means "all".
    #   unset       -- When true (the default), also unsets the snapshot
    #                  array after restoring.
    #
    # Results:
    #   Returns the empty string; its effect is restoring the required
    #   key-name state and optionally disposing of the snapshot.
    # </help>

    upvar 1 $varName savedKeyName

    if {[info exists savedKeyName(local)]} then {
      foreach {policyType keyName} $savedKeyName(local) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        if {[isValidKeyName $keyName]} then {
          certificate keyname -local true $policyType $keyName
        } else {
          certificate keyname -local true $policyType "" -unset true
        }
      }
    }

    if {$unset} then {
      unset -nocomplain savedKeyName(local)
    }

    if {[info exists savedKeyName(global)]} then {
      foreach {policyType keyName} $savedKeyName(global) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        if {[isValidKeyName $keyName]} then {
          certificate keyname -local false $policyType $keyName
        } else {
          certificate keyname -local false $policyType "" -unset true
        }
      }
    }

    if {$unset} then {
      unset -nocomplain savedKeyName(global)

      if {[array size savedKeyName] == 0} then {
        unset -nocomplain savedKeyName
      }
    }

    return ""
  }

  proc isValidKeyRingName { keyRingName } {
    # <help>
    # This procedure decides whether a captured key-ring-name value is
    # meaningful enough to be reapplied.  It is the gate used by
    # [restoreKeyRingName] before issuing a key-ring-name assignment, so
    # empty values are translated to a proper -unset instead.
    #
    # How it works: it returns false when the string is empty, true
    # otherwise.
    #
    # Arguments:
    #   keyRingName -- The candidate key-ring-name string to validate.
    #
    # Results:
    #   Returns true when the value is non-empty; otherwise false.
    # </help>

    if {[string length $keyRingName] == 0} then {
      return false
    }

    return true
  }

  proc saveKeyRingName { varName } {
    # <help>
    # This procedure captures the current per-policy-type required
    # key-ring names (in both the global and interpreter-local scopes)
    # into a named array in the caller's scope.  It is paired with
    # [restoreKeyRingName] so a test can change the required key-ring name
    # and put the original list back when finished.
    #
    # How it works: it dereferences the caller's array variable through
    # [upvar 1] and writes two elements: global (the result of [certificate
    # keyringname -local false]) and local (the result of [certificate
    # keyringname -local true]).  Each element is a list of policy-type and
    # key-ring-name pairs suitable for [restoreKeyRingName].
    #
    # Arguments:
    #   varName -- The name of the destination array in the caller's scope.
    #
    # Results:
    #   Returns the empty string; its effect is populating the named array.
    # </help>

    upvar 1 $varName savedKeyRingName

    set savedKeyRingName(global) [certificate keyringname -local false]
    set savedKeyRingName(local) [certificate keyringname -local true]

    return ""
  }

  proc setKeyRingName { keyRingName } {
    # <help>
    # This procedure forces every policy type, both globally and locally, to
    # use the same caller-supplied key ring name.  It is intended for tests
    # that need a known, uniform key ring identifier in effect across all of
    # the certificate subsystems (script, file, stream, license, keypair,
    # trace, and other).
    #
    # How it works: it invokes the [certificate keyringname] subcommand
    # twice -- once with -local false (the global scope) and once with
    # -local true (the per-interpreter scope) -- passing the same name for
    # each of the seven supported policy type options.  After both calls
    # complete, the configured key ring name is identical everywhere.
    #
    # Arguments:
    #   keyRingName -- The desired key ring name to apply to every policy
    #                  type in both global and local scopes.
    #
    # Results:
    #   Returns the empty string.  The effect is the side effect on the
    #   certificate subsystem's key ring name configuration.
    # </help>

    certificate keyringname -local false \
        -file $keyRingName -script $keyRingName -stream $keyRingName \
        -license $keyRingName -keypair $keyRingName -trace $keyRingName \
        -other $keyRingName

    certificate keyringname -local true \
        -file $keyRingName -script $keyRingName -stream $keyRingName \
        -license $keyRingName -keypair $keyRingName -trace $keyRingName \
        -other $keyRingName

    return ""
  }

  proc resetKeyRingName {} {
    # <help>
    # This procedure clears the configured key ring name for every policy
    # type, both globally and locally, returning the key ring name
    # configuration to its initial, unset state.  It is the counterpart of
    # [setKeyRingName] and is typically used by tests during cleanup.
    #
    # How it works: it invokes [certificate keyringname] twice -- once with
    # -local false and once with -local true -- supplying an empty string
    # for each of the seven policy type options (script, file, stream,
    # license, keypair, trace, and other) and passing -unset true so the
    # subsystem treats the value as absent rather than as the literal empty
    # string.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string.  The effect is the side effect on the
    #   certificate subsystem's key ring name configuration.
    # </help>

    certificate keyringname -local false \
        -script "" -file "" -stream "" -license "" -keypair "" -trace "" \
        -other "" -unset true

    certificate keyringname -local true \
        -script "" -file "" -stream "" -license "" -keypair "" -trace "" \
        -other "" -unset true

    return ""
  }

  proc restoreKeyRingName { varName {policyTypes ""} {unset true} } {
    # <help>
    # This procedure restores per-policy-type key ring names that were
    # previously captured by [saveKeyRingName], reapplying both the local
    # and global scopes from the saved snapshot in the caller's variable.
    # It exists so tests can stash the current configuration, mutate it,
    # then put it back exactly as it was.
    #
    # How it works: it links the caller variable via [upvar] and iterates
    # the policyType/keyRingName pairs found in savedKeyRingName(local)
    # then savedKeyRingName(global).  An optional policyTypes filter, when
    # non-empty, skips entries whose policy type is not in the list.  For
    # each surviving entry, if the saved name passes [isValidKeyRingName]
    # it is reapplied via [certificate keyringname] with the matching
    # -local flag; otherwise the entry is cleared with -unset true.  When
    # the unset argument is true, the local and global sub-elements are
    # removed after restoration, and if the array becomes empty it is
    # unset entirely (self-cleaning behavior matching the rest of this
    # module).
    #
    # Arguments:
    #   varName     -- Name of an array variable in the caller's scope,
    #                  previously populated by [saveKeyRingName].
    #   policyTypes -- Optional list filter.  When non-empty, only the
    #                  listed policy types are restored; others are
    #                  skipped.
    #   unset       -- Optional boolean (default true).  When true, the
    #                  saved entries are removed after being restored.
    #
    # Results:
    #   Returns the empty string.  The effect is the side effect of
    #   reapplying the saved key ring names and pruning the saved array.
    # </help>

    upvar 1 $varName savedKeyRingName

    if {[info exists savedKeyRingName(local)]} then {
      foreach {policyType keyRingName} $savedKeyRingName(local) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        if {[isValidKeyRingName $keyRingName]} then {
          certificate keyringname -local true $policyType $keyRingName
        } else {
          certificate keyringname -local true $policyType "" -unset true
        }
      }
    }

    if {$unset} then {
      unset -nocomplain savedKeyRingName(local)
    }

    if {[info exists savedKeyRingName(global)]} then {
      foreach {policyType keyRingName} $savedKeyRingName(global) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        if {[isValidKeyRingName $keyRingName]} then {
          certificate keyringname -local false $policyType $keyRingName
        } else {
          certificate keyringname -local false $policyType "" -unset true
        }
      }
    }

    if {$unset} then {
      unset -nocomplain savedKeyRingName(global)

      if {[array size savedKeyRingName] == 0} then {
        unset -nocomplain savedKeyRingName
      }
    }

    return ""
  }

  proc isValidScriptFlags { scriptFlags } {
    # <help>
    # This procedure performs a lightweight sanity check on a script flags
    # value as returned or accepted by the [certificate scriptflags]
    # subcommand.  It is used by [restoreScriptFlags] to decide whether a
    # saved value is meaningful enough to apply, or should be cleared.
    #
    # How it works: it returns false when the value is an empty string or
    # the literal "None" (the explicit "no flags set" sentinel); otherwise
    # it returns true.  No deeper enum or syntax validation is performed.
    #
    # Arguments:
    #   scriptFlags -- The candidate script flags string to validate.
    #
    # Results:
    #   Returns a boolean: true when scriptFlags appears to be a real
    #   value worth applying, false when it is empty or "None".
    # </help>

    if {[string length $scriptFlags] == 0} then {
      return false
    }

    if {$scriptFlags eq "None"} then {
      return false
    }

    return true
  }

  proc saveScriptFlags { varName } {
    # <help>
    # This procedure captures the current global and local script flags
    # configuration from the certificate subsystem into a caller-supplied
    # array variable.  It is paired with [restoreScriptFlags] so a test
    # can record the script flags, modify them, then put them back.
    #
    # How it works: it links the caller variable via [upvar] and queries
    # [certificate scriptflags] twice -- once with -local false (the
    # global scope) and once with -local true (the per-interpreter scope)
    # -- storing each result list into the global and local sub-elements
    # of the named array.  Each result is a list of policy type and
    # script flags value pairs suitable for iteration by [restoreScriptFlags].
    #
    # Arguments:
    #   varName -- Name of an array variable in the caller's scope; on
    #              return it has global and local sub-elements populated
    #              with the captured configuration.
    #
    # Results:
    #   Returns the empty string.  The effect is the side effect of
    #   populating the named caller array.
    # </help>

    upvar 1 $varName savedScriptFlags

    set savedScriptFlags(global) [certificate scriptflags -local false]
    set savedScriptFlags(local) [certificate scriptflags -local true]

    return ""
  }

  proc resetScriptFlags {} {
    # <help>
    # This procedure clears the script flags for every policy type, both
    # globally and locally, returning the script flags configuration to
    # its initial, unset state.  It is the counterpart of [saveScriptFlags]
    # and is typically used by tests during cleanup.
    #
    # How it works: it invokes [certificate scriptflags] twice -- once
    # with -local false and once with -local true -- supplying the
    # sentinel value "None" for each of the seven policy type options
    # (script, file, stream, license, keypair, trace, and other) and
    # passing -unset true so the subsystem treats the value as absent
    # rather than as the literal "None" enumeration.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string.  The effect is the side effect on the
    #   certificate subsystem's script flags configuration.
    # </help>

    certificate scriptflags -local false \
        -script None -file None -stream None -license None -keypair None \
        -trace None -other None -unset true

    certificate scriptflags -local true \
        -script None -file None -stream None -license None -keypair None \
        -trace None -other None -unset true

    return ""
  }

  proc restoreScriptFlags { varName {policyTypes ""} {unset true} } {
    # <help>
    # This procedure restores per-policy-type script flags that were
    # previously captured by [saveScriptFlags], reapplying both the local
    # and global scopes from the saved snapshot in the caller's variable.
    # It exists so tests can stash the current configuration, mutate it,
    # then put it back exactly as it was.
    #
    # How it works: it links the caller variable via [upvar] and iterates
    # the policyType/scriptFlags pairs found in savedScriptFlags(local)
    # then savedScriptFlags(global).  An optional policyTypes filter, when
    # non-empty, skips entries whose policy type is not in the list.  For
    # each surviving entry, if the saved value passes [isValidScriptFlags]
    # it is reapplied via [certificate scriptflags] with the matching
    # -local flag; otherwise the entry is cleared by passing "None" with
    # -unset true.  When the unset argument is true, the local and global
    # sub-elements are removed after restoration, and the array itself is
    # removed when it becomes empty (self-cleaning behavior matching the
    # rest of this module).
    #
    # Arguments:
    #   varName     -- Name of an array variable in the caller's scope,
    #                  previously populated by [saveScriptFlags].
    #   policyTypes -- Optional list filter.  When non-empty, only the
    #                  listed policy types are restored; others are
    #                  skipped.
    #   unset       -- Optional boolean (default true).  When true, the
    #                  saved entries are removed after being restored.
    #
    # Results:
    #   Returns the empty string.  The effect is the side effect of
    #   reapplying the saved script flags and pruning the saved array.
    # </help>

    upvar 1 $varName savedScriptFlags

    if {[info exists savedScriptFlags(local)]} then {
      foreach {policyType scriptFlags} $savedScriptFlags(local) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        if {[isValidScriptFlags $scriptFlags]} then {
          certificate scriptflags -local true $policyType $scriptFlags
        } else {
          certificate scriptflags -local true $policyType None -unset true
        }
      }
    }

    if {$unset} then {
      unset -nocomplain savedScriptFlags(local)
    }

    if {[info exists savedScriptFlags(global)]} then {
      foreach {policyType scriptFlags} $savedScriptFlags(global) {
        if {[llength $policyTypes] > 0 && \
            [lsearch -exact -- $policyTypes $policyType] == -1} then {
          continue
        }

        if {[isValidScriptFlags $scriptFlags]} then {
          certificate scriptflags -local false $policyType $scriptFlags
        } else {
          certificate scriptflags -local false $policyType None -unset true
        }
      }
    }

    if {$unset} then {
      unset -nocomplain savedScriptFlags(global)

      if {[array size savedScriptFlags] == 0} then {
        unset -nocomplain savedScriptFlags
      }
    }

    return ""
  }

  proc dumpPolicySettings { channel } {
    # <help>
    # This procedure writes a human-readable snapshot of the certificate
    # policy configuration to a test channel.  It is intended for use as
    # a diagnostic aid when triaging failing tests, so the actual policy,
    # key name, key ring name, script flags, and renewal callback values
    # are all visible in the test log alongside the failure.
    #
    # How it works: it requires the Eagle.Test package so [tputs] is
    # available, then emits one labeled line per setting using
    # [appendArgs] to assemble the text.  For each of policy, keyname,
    # keyringname, and scriptflags it queries [certificate ...] with
    # -local false to capture the global value and with -local true to
    # capture the local value.  The global renewal callbacks are queried
    # via [certificate renewcallback] (renewal callbacks have no local
    # scope here).  Local security state is captured via [hasSecurity].
    #
    # Arguments:
    #   channel -- The test channel passed to [tputs].  Typically the
    #              value of [getTestChannelOrDefault], or an empty string
    #              to log only.
    #
    # Results:
    #   Returns the value of the final [tputs] call (an unspecified
    #   string).  The effect is the side effect of writing the snapshot
    #   to the channel.
    # </help>

    package require Eagle.Test

    tputs $channel [appendArgs \
        "---- local security is \"" [hasSecurity] \"\n]

    tputs $channel [appendArgs \
        "---- global policy is \"" \
        [certificate policy -local false] \"\n]

    tputs $channel [appendArgs \
        "---- local policy is \"" \
        [certificate policy -local true] \"\n]

    tputs $channel [appendArgs \
        "---- global key name is \"" \
        [certificate keyname -local false] \"\n]

    tputs $channel [appendArgs \
        "---- local key name is \"" \
        [certificate keyname -local true] \"\n]

    tputs $channel [appendArgs \
        "---- global key ring name is \"" \
        [certificate keyringname -local false] \"\n]

    tputs $channel [appendArgs \
        "---- local key ring name is \"" \
        [certificate keyringname -local true] \"\n]

    tputs $channel [appendArgs \
        "---- global script flags are \"" \
        [certificate scriptflags -local false] \"\n]

    tputs $channel [appendArgs \
        "---- local script flags are \"" \
        [certificate scriptflags -local true] \"\n]

    tputs $channel [appendArgs \
        "---- global renewal callbacks are \"" \
        [certificate renewcallback] \"\n]
  }

  proc dumpServerEnvironmentVariables {
          varName savedIis iis savedLocal local savedRootBaseUri
          rootBaseUri full channel } {
    # <help>
    # This procedure writes a human-readable snapshot of the server-related
    # environment variables to a test channel.  It is invoked by
    # [resetServerEnvironmentVariables] so the resulting configuration is
    # captured in the test log, making it easy to see what URIs and ports
    # were in effect for a given test run.
    #
    # How it works: it requires the Eagle.Test package so [tputs] is
    # available.  For each of the IIS flag, the local-host flag, and the
    # root base URI it emits one line showing the saved (raw caller-supplied)
    # value and one line showing the effective (after defaults are applied)
    # value, substituting the literal -none- when a value is empty.  It
    # then links the caller variable named by varName via [upvar] and
    # iterates the names returned by [getServerEnvironmentVariableNames],
    # emitting one line per name showing the value stored in the named
    # array (or -none- when missing or empty).
    #
    # Arguments:
    #   varName         -- Name of an array variable in the caller's
    #                      scope holding the candidate environment
    #                      variable values.
    #   savedIis        -- The caller-supplied IIS flag before defaulting.
    #   iis             -- The effective IIS flag after defaulting.
    #   savedLocal      -- The caller-supplied local-host flag before
    #                      defaulting.
    #   local           -- The effective local-host flag after defaulting.
    #   savedRootBaseUri-- The caller-supplied root base URI before
    #                      defaulting.
    #   rootBaseUri     -- The effective root base URI after defaulting.
    #   full            -- Boolean passed to
    #                      [getServerEnvironmentVariableNames] to choose
    #                      the full list versus the reduced subset.
    #   channel         -- The test channel passed to [tputs].
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   writing the labeled snapshot to the channel.
    # </help>

    package require Eagle.Test

    if {[string length $savedIis] > 0} then {
      set savedIis [appendArgs \" $savedIis \"]
    } else {
      set savedIis <none>
    }

    tputs $channel [appendArgs \
        "---- saved IIS flag is " $savedIis \n]

    tputs $channel [appendArgs \
        "---- effective IIS flag is \"" $iis \"\n]

    if {[string length $savedLocal] > 0} then {
      set savedLocal [appendArgs \" $savedLocal \"]
    } else {
      set savedLocal <none>
    }

    tputs $channel [appendArgs \
        "---- saved local flag is " $savedLocal \n]

    tputs $channel [appendArgs \
        "---- effective local flag is \"" $local \"\n]

    if {[string length $savedRootBaseUri] > 0} then {
      set savedRootBaseUri [appendArgs \" $savedRootBaseUri \"]
    } else {
      set savedRootBaseUri <none>
    }

    tputs $channel [appendArgs \
        "---- saved root base URI is " $savedRootBaseUri \n]

    if {[string length $rootBaseUri] > 0} then {
      set rootBaseUri [appendArgs \" $rootBaseUri \"]
    } else {
      set rootBaseUri <none>
    }

    tputs $channel [appendArgs \
        "---- effective root base URI is " $rootBaseUri \n]

    upvar 1 $varName array

    foreach name [getServerEnvironmentVariableNames $full] {
      if {[info exists array($name)] && \
          [string length $array($name)] > 0} then {
        set value [appendArgs \" $array($name) \"]
      } else {
        set value <none>
      }

      tputs $channel [appendArgs \
          "---- server environment variable \"" $name "\" is " \
          $value \n]
    }
  }

  proc publicKeyTokenToBytes { publicKeyToken } {
    # <help>
    # This procedure converts a textual public key token (as found on
    # signed assemblies) into a list of integer byte values, suitable for
    # comparison against a byte array returned from .NET APIs that report
    # public key tokens.  It is a helper used by test fixtures that need
    # to match a string token against a binary representation.
    #
    # How it works: it validates that the input has an even number of
    # characters (raising a script error otherwise) and then iterates
    # pairs of characters (nibble1 then nibble2), reassembling each pair
    # into the hexadecimal literal 0x<nibble1><nibble2> and adding zero
    # in an [expr] to force decimal numeric form before appending it to
    # the result list.
    #
    # Tricky details: the contract requires an even-length token, since
    # each byte is represented by exactly two hexadecimal digits.  Odd
    # input is rejected explicitly so that a malformed token surfaces as
    # an error rather than being silently truncated by [foreach]'s
    # pair-binding behavior.
    #
    # Arguments:
    #   publicKeyToken -- A hexadecimal string, typically 16 characters
    #                     long, representing the public key token.  Must
    #                     have an even length.
    #
    # Results:
    #   Returns a Tcl list of integer byte values (each 0..255)
    #   corresponding to the supplied token.  Raises a script error when
    #   the input has an odd length.
    # </help>

    if {[string length $publicKeyToken] % 2 != 0} then {
      error [appendArgs "public key token \"" $publicKeyToken \
          "\" has an odd length; expected an even number of hexadecimal" \
          " digits"]
    }

    set result [list]

    foreach {nibble1 nibble2} [split $publicKeyToken ""] {
      lappend result [expr {[appendArgs 0x $nibble1 $nibble2] + 0}]
    }

    return $result
  }

  proc saveEnvironmentVariables { names {varName ""} } {
    # <help>
    # This procedure captures a snapshot of the live process environment
    # variables for a given list of names into a caller-supplied array
    # variable.  It is the building block underlying every save/restore
    # pair in this module that touches the environment.
    #
    # How it works: when varName is empty, the default name savedEnv is
    # used.  The variable is linked via [upvar] into the caller's frame.
    # For each name in the names list, if the global env array has the
    # corresponding element its value is copied into savedEnv; otherwise
    # the matching savedEnv element is removed.  When the resulting
    # savedEnv array has no elements left, it is unset entirely, so an
    # all-absent snapshot leaves no array behind (self-cleaning).
    #
    # Tricky details: the live env array is intentionally NOT modified
    # by this procedure -- it only reads.  Mutation is the job of the
    # corresponding [restoreEnvironmentVariables] procedure.
    #
    # Arguments:
    #   names   -- A list of environment variable names to capture.
    #   varName -- Optional name of the destination array variable in
    #              the caller's scope.  When empty, the literal name
    #              savedEnv is used.
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   populating (or unsetting) the named caller array.
    # </help>

    #
    # NOTE: For each name, does the live environment variable exist?  If
    #       so, save the value for later; otherwise, make sure the saved
    #       value does not exist either.  The live environment variables
    #       ARE NOT changed by this procedure.
    #
    if {[string length $varName] == 0} then {
      set varName savedEnv
    }

    upvar 1 $varName savedEnv

    foreach name $names {
      if {[info exists ::env($name)]} then {
        set savedEnv($name) $::env($name)
      } else {
        unset -nocomplain savedEnv($name)
      }
    }

    #
    # NOTE: This is self-cleaning.  If no saved environment variables now
    #       exist, remove the array.
    #
    if {[array size savedEnv] == 0} then {
      unset -nocomplain savedEnv
    }
  }

  proc restoreEnvironmentVariables { names {varName ""} } {
    # <help>
    # This procedure restores live environment variables from a snapshot
    # previously taken by [saveEnvironmentVariables], putting the process
    # environment back to whatever state was captured for each name.  It
    # is the counterpart to [saveEnvironmentVariables].
    #
    # How it works: when varName is empty, the default name savedEnv is
    # used.  The variable is linked via [upvar] into the caller's frame.
    # For each name in the names list, if the saved snapshot has a value
    # for that name, the value is copied into the global env array and
    # then removed from the snapshot; otherwise the live env element is
    # removed (since it was absent at the time of the save).  When the
    # resulting snapshot array has no elements left, it is unset entirely
    # (self-cleaning).
    #
    # Tricky details: both the saved snapshot and the live env array are
    # mutated by this procedure.  Each restored entry is also removed
    # from the snapshot so subsequent restores are idempotent.
    #
    # Arguments:
    #   names   -- A list of environment variable names to restore.
    #   varName -- Optional name of the source snapshot array variable
    #              in the caller's scope.  When empty, the literal name
    #              savedEnv is used.
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   updating the live environment and pruning the snapshot.
    # </help>

    #
    # NOTE: For each name, does the saved environment variable exist?  If
    #       so, restore the saved value and unset it; otherwise, make sure
    #       the live environment variable does not exist either (i.e. it
    #       was not set to begin with).  Both saved and live environment
    #       variables ARE changed by this procedure.
    #
    if {[string length $varName] == 0} then {
      set varName savedEnv
    }

    upvar 1 $varName savedEnv

    foreach name $names {
      if {[info exists savedEnv($name)]} then {
        set ::env($name) $savedEnv($name)
        unset -nocomplain savedEnv($name)
      } else {
        unset -nocomplain ::env($name)
      }
    }

    #
    # NOTE: This is self-cleaning.  If no saved environment variables now
    #       exist, remove the array.
    #
    if {[array size savedEnv] == 0} then {
      unset -nocomplain savedEnv
    }
  }

  proc getServerEnvironmentVariableNames { {full true} } {
    # <help>
    # This procedure returns the list of environment variable names that
    # configure communication between Harpy and the Kapok licensing
    # server (and that are inspected by the Kapok test suite).  It is
    # the canonical source of truth used by save, restore, reset, and
    # dump procedures throughout this module to know which environment
    # variables to handle.
    #
    # How it works: when the full argument is true (the default) it
    # returns the complete list, which spans every base URI, relative
    # URI, port, and toggle Harpy understands -- authority, license,
    # local server port, NTP and HTTP time URIs, every "No*" relative
    # URI override, ping, provision, renewal, request, revocation,
    # root, sandbox eval, script, storage, support, test, server port,
    # and the UseLocalHost toggle.  When full is false it returns the
    # smaller subset that [resetServerEnvironmentVariables] is allowed
    # to mutate (the relative URIs plus LocalServerPort, ServerPort,
    # and UseLocalHost).
    #
    # Arguments:
    #   full -- Optional boolean (default true).  When true, the full
    #           list is returned; when false, only the reset-mutable
    #           subset is returned.
    #
    # Results:
    #   Returns a Tcl list of environment variable names (strings).
    # </help>

    #
    # NOTE: The list returned from this procedure is intended to be a
    #       complete list of the environment variable names that are
    #       used by Harpy (to connect with a Kapok server) and/or the
    #       Kapok test suite.
    #
    if {$full} then {
      return [list \
          AuthorityBaseUri \
          LicenseUri \
          LocalServerPort \
          NetworkTimeHttpUri \
          NetworkTimeNtpUri \
          NetworkTimeUri \
          NoProvisionRelativeUri \
          NoRenewalRelativeUri \
          NoRequestRelativeUri \
          NoRevocationRelativeUri \
          NoScriptRelativeUri \
          NoStorageRelativeUri \
          NoSupportRelativeUri \
          NoTestRelativeUri \
          PingBaseUri \
          PingRelativeUri \
          ProvisionBaseUri \
          ProvisionRelativeUri \
          RenewalBaseUri \
          RenewalRelativeUri \
          RequestBaseUri \
          RequestRelativeUri \
          RevocationBaseUri \
          RevocationRelativeUri \
          RootBaseUri \
          SandboxEvalUri \
          ScriptBaseUri \
          ScriptRelativeUri \
          ServerPort \
          StorageBaseUri \
          StorageRelativeUri \
          SupportBaseUri \
          SupportRelativeUri \
          TestBaseUri \
          TestRelativeUri \
          UseLocalHost]
    } else {
      #
      # HACK: Return the subset of environment variable names that may be
      #       changed by the [resetServerEnvironmentVariables] procedure.
      #
      return [list \
          ProvisionRelativeUri \
          RenewalRelativeUri \
          RequestRelativeUri \
          RevocationRelativeUri \
          SupportRelativeUri \
          ScriptRelativeUri \
          StorageRelativeUri \
          TestRelativeUri \
          LocalServerPort \
          ServerPort \
          UseLocalHost]
    }
  }

  proc saveServerEnvironmentVariables { {varName ""} {full false} } {
    # <help>
    # This procedure captures the current values of the Kapok-server
    # related environment variables into a caller-supplied snapshot
    # array.  It is a thin wrapper that combines
    # [getServerEnvironmentVariableNames] with
    # [saveEnvironmentVariables].
    #
    # How it works: when the global override flag ::no(saveServerEnvironmentVariables)
    # is set, the procedure does nothing -- this is the standard test
    # harness escape hatch.  Otherwise it defaults the varName to
    # savedEnv when empty, links the caller variable via [upvar], and
    # delegates to [saveEnvironmentVariables], passing the list of
    # server environment variable names selected by the full flag.
    #
    # Arguments:
    #   varName -- Optional name of the destination array variable in
    #              the caller's scope.  When empty, savedEnv is used.
    #   full    -- Optional boolean (default false).  When true, the
    #              full server variable list is captured; when false,
    #              only the reset-mutable subset is captured.
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   populating the named caller array.
    # </help>

    if {![info exists ::no(saveServerEnvironmentVariables)]} then {
      if {[string length $varName] == 0} then {
        set varName savedEnv
      }

      upvar 1 $varName savedEnv

      saveEnvironmentVariables \
          [getServerEnvironmentVariableNames $full] savedEnv
    }
  }

  proc restoreServerEnvironmentVariables { {varName ""} {full false} } {
    # <help>
    # This procedure restores the Kapok-server related environment
    # variables from a snapshot previously taken by
    # [saveServerEnvironmentVariables].  It is the counterpart of that
    # save procedure and a thin wrapper around
    # [restoreEnvironmentVariables].
    #
    # How it works: when the global override flag
    # ::no(restoreServerEnvironmentVariables) is set, the procedure does
    # nothing.  Otherwise it defaults varName to savedEnv when empty,
    # links the caller variable via [upvar], and delegates to
    # [restoreEnvironmentVariables], passing the list of server
    # environment variable names selected by the full flag.
    #
    # Arguments:
    #   varName -- Optional name of the source snapshot array variable
    #              in the caller's scope.  When empty, savedEnv is used.
    #   full    -- Optional boolean (default false).  Must match the
    #              value passed to the matching save call.
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   restoring the live environment and pruning the snapshot.
    # </help>

    if {![info exists ::no(restoreServerEnvironmentVariables)]} then {
      if {[string length $varName] == 0} then {
        set varName savedEnv
      }

      upvar 1 $varName savedEnv

      restoreEnvironmentVariables \
          [getServerEnvironmentVariableNames $full] savedEnv
    }
  }

  proc getLicenseCertificateEntityName {} {
    # <help>
    # This procedure returns the display name to embed as the entity
    # name when the test suite asks the Kapok server to issue a license
    # certificate.  It centralizes the resolution rules so every test
    # that creates a license uses the same chosen name.
    #
    # How it works: it first consults the LicenseDisplayName environment
    # variable -- if present and non-empty, that value is returned
    # unchanged.  Otherwise it requires Eagle.Test, fetches the test run
    # tag via [getTestRunTag], and returns the tag when it is non-empty.
    # As a last resort it returns the literal placeholder text used to
    # make missing display names obvious in logs.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns a string suitable for use as a certificate entity name.
    # </help>

    if {[info exists ::env(LicenseDisplayName)]} then {
      set displayName $::env(LicenseDisplayName)

      if {[string length $displayName] > 0} then {
        return $displayName
      }
    }

    package require Eagle.Test

    set tag [getTestRunTag]

    if {[string length $tag] > 0} then {
      return $tag
    }

    return "NO HARPY DISPLAY NAME"
  }

  proc checkForInternetInformationServices { channel } {
    # <help>
    # This procedure ensures that a configuration.Debug or
    # configuration.Release test constraint is established, so that
    # subsequent code can reason about whether the test run is going
    # through the locally hosted ASP.NET development server (debug) or
    # a deployed IIS server (release).
    #
    # How it works: it requires Eagle.Test, then checks whether either
    # of the configuration.Debug or configuration.Release constraints is
    # already in effect.  When neither is present, it lazily initializes
    # the ::test_configuration global from [getPlatformInfo configuration Release]
    # and asks [checkForTestConfiguration] (from Eagle.Test.Constraints)
    # to register the appropriate constraint.
    #
    # Arguments:
    #   channel -- The test channel forwarded to [checkForTestConfiguration]
    #              for any diagnostic output.
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   registering a test constraint when one is missing.
    # </help>

    package require Eagle.Test

    if {![haveConstraint configuration.Debug] && \
        ![haveConstraint configuration.Release]} then {
      if {![info exists ::test_configuration]} then {
        set ::test_configuration [getPlatformInfo configuration Release]
      }

      package require Eagle.Test.Constraints
      checkForTestConfiguration $channel
    }
  }

  proc checkForNetworkHosts { channel timeout } {
    # <help>
    # This procedure probes the network reachability of the three
    # canonical hosts the Harpy test suite depends on, registering a
    # network_<host> constraint for each that responds.  It is invoked
    # by [isUsingLocalHost] to decide whether the suite is in offline
    # or online mode.
    #
    # How it works: after requiring Eagle.Test, for each of
    # www.eagle-lang.org, urn.to, and time.mistachkin.net, if the
    # matching network_<host> constraint is not already set, it
    # requires Eagle.Test.Constraints and calls [checkForNetwork]
    # which registers the constraint when the host responds within
    # the supplied timeout.
    #
    # Arguments:
    #   channel -- The test channel forwarded to [checkForNetwork] for
    #              diagnostic output.
    #   timeout -- The per-host network timeout (passed to
    #              [checkForNetwork]).
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   registering up to three test constraints.
    # </help>

    package require Eagle.Test

    if {![haveConstraint network_www.eagle-lang.org]} then {
      package require Eagle.Test.Constraints
      checkForNetwork $channel www.eagle-lang.org $timeout
    }

    if {![haveConstraint network_urn.to]} then {
      package require Eagle.Test.Constraints
      checkForNetwork $channel urn.to $timeout
    }

    if {![haveConstraint network_time.mistachkin.net]} then {
      package require Eagle.Test.Constraints
      checkForNetwork $channel time.mistachkin.net $timeout
    }
  }

  proc checkForTimeServer { channel baseUri timeout {retries 3} } {
    # <help>
    # This procedure probes a network time server URI by issuing a
    # trusted HTTP GET and inspecting the response.  When the response
    # contains a "ticks" field it registers two constraints --
    # harpy.timeServer (the generic indicator) and a per-URI
    # timeServer_<base> constraint -- so subsequent tests can require
    # working time service.
    #
    # How it works: after announcing the check on channel, when baseUri
    # is empty it either auto-registers the constraint (if the override
    # ::no(missingTimeServerUri) is set) or reports "no (missing uri)"
    # and returns.  Otherwise the URI is validated: time servers are
    # uniquely permitted to be a bare host name in addition to a full
    # URI, so the check accepts either [isValidHostName] or a strict
    # URI test.  A nonce-augmented query string is built using a random
    # hexadecimal value, then [uri download] is invoked with -trusted
    # and the network timeout type, retrying up to retries times.  A
    # response containing a literal " ticks <digits> " substring marks
    # success; the constraints are added and the retry count is logged.
    #
    # Tricky details: malformed URIs short-circuit before any network
    # I/O.  Bare host names are intentionally accepted here so that
    # alternative NTP servers can be supplied without scheme prefixes.
    # The per-URI constraint name is derived by replacing both colon
    # and slash characters with underscores.
    #
    # Arguments:
    #   channel -- The test channel for diagnostic output.
    #   baseUri -- The candidate time server URI or bare host name.
    #   timeout -- The network timeout (milliseconds) per attempt.
    #   retries -- Optional retry count (default 3).
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   registering zero, one, or two test constraints and writing
    #   diagnostic lines to the channel.
    # </help>

    tputs $channel "---- checking for time server... "

    if {[string length $baseUri] == 0} then {
      if {[info exists ::no(missingTimeServerUri)]} then {
        addConstraint harpy.timeServer
        tputs $channel "yes (missing uri)\n"
      } else {
        tputs $channel "no (missing uri)\n"
      }

      return
    }

    #
    # HACK: For time servers only, allow a raw host name to
    #       enable the selected NTP server to be considered
    #       as "valid".
    #
    if {![isValidHostName $baseUri] && \
        [string is not uri -strict $baseUri]} then {
      tputs $channel "no (malformed uri)\n"
      return
    }

    set uri [appendArgs \
        $baseUri ?raw=1&nonce= \
        [format %lx [expr {random()}]]]

    set retry 0

    while {$retry < $retries} {
      if {[catch {
        uri download -trusted -timeouttype network \
            -timeout $timeout -inline $uri
      } result] == 0 && [regexp -- { ticks \d+ } $result]} then {
        addConstraint harpy.timeServer

        addConstraint [appendArgs \
            timeServer_ [string map [list : _ / _] $baseUri]]

        tputs $channel [appendArgs "yes (" $retry ")\n"]
        return
      }

      incr retry
    }

    tputs $channel no\n
  }

  proc checkForLibraryServer { channel baseUri timeout {retries 3} } {
    # <help>
    # This procedure probes a license library server URI by requesting a
    # temporary license and inspecting the response.  When the response
    # is well-formed it registers two constraints -- harpy.libraryServer
    # and a per-URI libraryServer_<base> constraint -- so subsequent
    # tests can require an available library server.
    #
    # How it works: it announces the check on channel, then validates
    # the URI (empty or non-URI inputs report "no" and return early).
    # The current tcl_platform(user) value is required to compose the
    # request.  A query string is built that supplies userName, a
    # displayName built from the current proc name and
    # [getLicenseCertificateEntityName], and raw=1.  The URI is
    # downloaded with -trusted and the network timeout type, retrying
    # up to retries times; a response that begins with
    # "returnCode Ok " marks success.  When the response names an
    # existing file (the temporary license), that file is best-effort
    # deleted so the test does not leak it.  Both constraints are
    # added on success.
    #
    # Tricky details: as in [checkForTimeServer] the per-URI constraint
    # name is built by mapping colon and slash characters to underscore.
    # Missing user information aborts the probe cleanly rather than
    # failing.
    #
    # Arguments:
    #   channel -- The test channel for diagnostic output.
    #   baseUri -- The candidate library server base URI.
    #   timeout -- The network timeout (milliseconds) per attempt.
    #   retries -- Optional retry count (default 3).
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   registering constraints and writing diagnostic lines.
    # </help>

    global tcl_platform

    tputs $channel "---- checking for library server... "

    if {[string length $baseUri] == 0} then {
      if {[info exists ::no(missingLibraryServerUri)]} then {
        addConstraint harpy.libraryServer
        tputs $channel "yes (missing uri)\n"
      } else {
        tputs $channel "no (missing uri)\n"
      }

      return
    }

    if {[string is not uri -strict $baseUri]} then {
      tputs $channel "no (malformed uri)\n"
      return
    }

    if {![info exists tcl_platform(user)]} then {
      tputs $channel "no (missing user name)\n"
      return
    }

    set uri [appendArgs \
        $baseUri ?raw=1&userName= \
        [uri escape data $tcl_platform(user)] \
        &displayName= [uri escape data [appendArgs \
        [lindex [info level [info level]] 0] " " \
        [getLicenseCertificateEntityName]]]]

    set retry 0

    while {$retry < $retries} {
      if {[catch {
        uri download -trusted -timeouttype network \
            -timeout $timeout -inline $uri
      } result] == 0 && [string first \
          "returnCode Ok " $result] == 0} then {
        if {[file exists $result]} then {
          #
          # HACK: Attempt to cleanup the temporary license
          #       to avoid leaking the associated temporary
          #       file.
          #
          catch {file delete $result}
        }

        addConstraint harpy.libraryServer

        addConstraint [appendArgs \
            libraryServer_ [string map [list : _ / _] $baseUri]]

        tputs $channel [appendArgs "yes (" $retry ")\n"]
        return
      }

      incr retry
    }

    tputs $channel no\n
  }

  proc checkForCertificateRequestServer {
          channel baseUri relativeUri id timeout {retries 3} } {
    # <help>
    # This procedure probes a certificate request server endpoint and,
    # when it responds with encrypted data, registers two test
    # constraints -- harpy.certificateRequestServer (generic) and a
    # per-URI certificateRequestServer_<base> constraint -- so
    # subsequent tests can require an available request server.
    #
    # How it works: the URI and a GUID identifier are validated before
    # any I/O.  Empty baseUri short-circuits, either auto-passing when
    # the override ::no(missingCertificateRequestServerUri) is set or
    # reporting "no (missing uri)".  Malformed URI or non-GUID id
    # produce matching diagnostics.  The full URI is built by joining
    # baseUri with relativeUri and appending id and encrypted=1 query
    # parameters.  The endpoint is downloaded with -trusted and the
    # network timeout type, retrying up to retries times; a response
    # whose first bytes match the literal EncryptedData header marks
    # success.
    #
    # Tricky details: the per-URI constraint name is built by mapping
    # colon and slash characters to underscore.
    #
    # Arguments:
    #   channel    -- The test channel for diagnostic output.
    #   baseUri    -- The certificate request server base URI.
    #   relativeUri-- The relative endpoint (joined onto baseUri).
    #   id         -- A GUID request identifier; must be a strict GUID.
    #   timeout    -- The network timeout (milliseconds) per attempt.
    #   retries    -- Optional retry count (default 3).
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   registering constraints and writing diagnostic lines.
    # </help>

    tputs $channel "---- checking for certificate requesting server... "

    if {[string length $baseUri] == 0} then {
      if {[info exists ::no(missingCertificateRequestServerUri)]} then {
        addConstraint harpy.certificateRequestServer
        tputs $channel "yes (missing uri)\n"
      } else {
        tputs $channel "no (missing uri)\n"
      }

      return
    }

    if {[string is not uri -strict $baseUri]} then {
      tputs $channel "no (malformed uri)\n"
      return
    }

    if {[string is not guid -strict $id]} then {
      tputs $channel "no (malformed identifier)\n"
      return
    }

    set uri [appendArgs \
        [file join $baseUri $relativeUri] id= $id &encrypted=1]

    set retry 0

    while {$retry < $retries} {
      if {[catch {
        uri download -trusted -timeouttype network \
            -timeout $timeout -inline $uri
      } result] == 0 && [string first \
          "! EncryptedData: v1.0" $result] == 0} then {
        addConstraint harpy.certificateRequestServer

        addConstraint [appendArgs \
            certificateRequestServer_ \
            [string map [list : _ / _] $baseUri]]

        tputs $channel [appendArgs "yes (" $retry ")\n"]
        return
      }

      incr retry
    }

    tputs $channel no\n
  }

  proc checkForCertificateProvisionServer {
          channel baseUri relativeUri apiKey timeout {retries 3} } {
    # <help>
    # This procedure probes a certificate provisioning server endpoint
    # and, when it responds with encrypted data, registers two test
    # constraints -- harpy.certificateProvisionServer (generic) and a
    # per-URI certificateProvisionServer_<base> constraint -- so
    # subsequent tests can require an available provisioning server.
    #
    # How it works: the URI and the apiKey GUID are validated before
    # any I/O.  An empty baseUri short-circuits, either auto-passing
    # when the override ::no(missingCertificateProvisionServerUri) is
    # set or reporting "no (missing uri)".  Then the local machine
    # identifier is obtained via [harpy machine]; failure here aborts
    # the probe.  The full URI is built by joining baseUri with
    # relativeUri and appending apiKey, provisionType=License,
    # entityName=<machine id>, duration=30, and encrypted=1.  The
    # endpoint is downloaded with -trusted and the network timeout
    # type, retrying up to retries times; a response that begins with
    # the literal EncryptedData header marks success.
    #
    # Tricky details: the entity name is derived from the machine
    # identifier returned by [harpy machine] (the underlying API
    # encoded by the Harpy plugin), so successful probes are
    # specific to the current host.  The per-URI constraint name is
    # built by mapping colon and slash characters to underscore.
    #
    # Arguments:
    #   channel    -- The test channel for diagnostic output.
    #   baseUri    -- The provisioning server base URI.
    #   relativeUri-- The relative endpoint (joined onto baseUri).
    #   apiKey     -- An API key GUID; must be a strict GUID.
    #   timeout    -- The network timeout (milliseconds) per attempt.
    #   retries    -- Optional retry count (default 3).
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   registering constraints and writing diagnostic lines.
    # </help>

    tputs $channel "---- checking for certificate provisioning server... "

    if {[string length $baseUri] == 0} then {
      if {[info exists ::no(missingCertificateProvisionServerUri)]} then {
        addConstraint harpy.certificateProvisionServer
        tputs $channel "yes (missing uri)\n"
      } else {
        tputs $channel "no (missing uri)\n"
      }

      return
    }

    if {[string is not uri -strict $baseUri]} then {
      tputs $channel "no (malformed uri)\n"
      return
    }

    if {[string is not guid -strict $apiKey]} then {
      tputs $channel "no (malformed API key)\n"
      return
    }

    if {[catch {harpy machine} machine]} then {
      tputs $channel "no (machine error)\n"
      return
    }

    set uri [appendArgs \
        [file join $baseUri $relativeUri] \
        apiKey= $apiKey &provisionType=License&entityName= \
        [getDictionaryValue $machine id] &duration=30&encrypted=1]

    set retry 0

    while {$retry < $retries} {
      if {[catch {
        uri download -trusted -timeouttype network \
            -timeout $timeout -inline $uri
      } result] == 0 && [string first \
          "! EncryptedData: v1.0" $result] == 0} then {
        addConstraint harpy.certificateProvisionServer

        addConstraint [appendArgs \
            certificateProvisionServer_ \
            [string map [list : _ / _] $baseUri]]

        tputs $channel [appendArgs "yes (" $retry ")\n"]
        return
      }

      incr retry
    }

    tputs $channel no\n
  }

  proc isUsingInternetInformationServices { {iis ""} } {
    # <help>
    # This procedure decides whether tests should assume an IIS-hosted
    # server, returning a boolean used to choose the corresponding URI
    # layout in [resetServerEnvironmentVariables].  It accepts an
    # explicit override for callers that already know the answer.
    #
    # How it works: when iis is an empty string and the global override
    # ::no(testConfiguration) is not set, the procedure invokes
    # [checkForInternetInformationServices] to ensure the
    # configuration.Debug or configuration.Release constraint is
    # registered.  It then loads Eagle.Test and inspects the
    # constraints: a Debug configuration is assumed to mean IDE-only
    # (no IIS), so the result is false; otherwise (Release) the result
    # is true.  When iis is non-empty its value is returned unchanged.
    #
    # Arguments:
    #   iis -- Optional explicit override boolean.  When non-empty its
    #          value is returned as-is, bypassing detection.
    #
    # Results:
    #   Returns a boolean: true when IIS is assumed, false otherwise.
    # </help>

    if {[string length $iis] == 0} then {
      if {![info exists ::no(testConfiguration)]} then {
        checkForInternetInformationServices ""
      }

      package require Eagle.Test

      if {[haveConstraint configuration.Debug]} then {
        return false; # NOTE: Assume IDE testing.
      } else {
        return true; # NOTE: Assume release testing.
      }
    } else {
      return $iis; # NOTE: Use caller provided override.
    }
  }

  proc isUsingLocalHost { {local ""} } {
    # <help>
    # This procedure decides whether tests should assume the locally
    # hosted Kapok server (as opposed to a real remote one), returning
    # a boolean that callers (notably [resetServerEnvironmentVariables])
    # use to pick port and host defaults.  It accepts an explicit
    # override for callers that already know the answer.
    #
    # How it works: when local is empty, the procedure consults a small
    # collection of globals.  If any of the per-host overrides
    # ::no(www.eagle-lang.org), ::no(urn.to), or ::no(time.mistachkin.net)
    # is set, it assumes IDE testing (returns true).  Otherwise, unless
    # ::no(core) or ::no(network) suppresses the probes, it runs
    # [checkForNetworkHosts] (using ::test_timeout when present or
    # [getDefaultTimeout] otherwise).  If all three network_<host>
    # constraints are then in effect, full external connectivity is
    # assumed and the result is false; otherwise it is true.  When
    # local is non-empty its value is returned unchanged.
    #
    # Arguments:
    #   local -- Optional explicit override boolean.  When non-empty
    #            its value is returned as-is, bypassing detection.
    #
    # Results:
    #   Returns a boolean: true when the local (in-process) server
    #   should be assumed, false otherwise.
    # </help>

    if {[string length $local] == 0} then {
      if {![info exists ::no(www.eagle-lang.org)] && \
          ![info exists ::no(urn.to)] && \
          ![info exists ::no(time.mistachkin.net)]} then {
        if {![info exists ::no(core)] && \
            ![info exists ::no(network)]} then {
          if {[info exists ::test_timeout]} then {
            set timeout $::test_timeout
          } else {
            set timeout [getDefaultTimeout]
          }

          checkForNetworkHosts "" $timeout
        }

        package require Eagle.Test

        if {[haveConstraint network_www.eagle-lang.org] && \
            [haveConstraint network_urn.to] && \
            [haveConstraint network_time.mistachkin.net]} then {
          return false; # NOTE: Assume release testing.
        } else {
          return true; # NOTE: Assume IDE testing.
        }
      } else {
        return true; # NOTE: Assume IDE testing.
      }
    } else {
      return $local; # NOTE: Use caller provided override.
    }
  }

  proc getHostFromBaseUri { baseUri {default true} } {
    # <help>
    # This procedure extracts the host portion of a URI string by
    # delegating to the .NET System.Uri class.  It is used by callers
    # such as [resetServerEnvironmentVariables] to detect whether a
    # supplied root base URI points at "localhost".
    #
    # How it works: it declares an output variable, then invokes
    # System.Uri.TryCreate via Eagle's [object invoke -create -alias]
    # binding, asking for an Absolute URI.  When the returned Boolean
    # is non-null and parses true (and the out parameter object handle
    # is also non-null), it returns the Host property of the parsed Uri;
    # otherwise it returns an empty string.
    #
    # Tricky details: the default argument is presently unused, but the
    # signature is preserved so callers (and the symmetric
    # [getPortFromBaseUri]) can be invoked uniformly.
    #
    # Arguments:
    #   baseUri -- The URI string to parse.
    #   default -- Optional and currently unused.
    #
    # Results:
    #   Returns the host portion as a string, or empty string when the
    #   URI cannot be parsed as absolute.
    # </help>

    set uri null

    set ok [object invoke \
        -create -alias Uri TryCreate $baseUri Absolute uri]

    if {[isNonNullObjectHandle $ok] && \
        [$ok ToString] && [isNonNullObjectHandle $uri]} then {
      return [$uri Host]
    }

    return ""
  }

  proc getPortFromBaseUri { baseUri {default true} } {
    # <help>
    # This procedure extracts the port portion of a URI string by
    # delegating to the .NET System.Uri class, optionally suppressing
    # the well-known default ports for http and https.  It is used by
    # [resetServerEnvironmentVariables] to choose a LocalServerPort
    # value.
    #
    # How it works: it declares an output variable, then invokes
    # System.Uri.TryCreate via Eagle's [object invoke -create -alias]
    # binding, asking for an Absolute URI.  When parsing succeeds, the
    # Port property of the parsed Uri is read.  When the default
    # argument is false, the scheme is inspected: an http URI on port
    # 80 or an https URI on port 443 returns an empty string so the
    # caller will know not to set an explicit port.  Otherwise the
    # numeric port is returned.  When parsing fails, an empty string
    # is returned.
    #
    # Arguments:
    #   baseUri -- The URI string to parse.
    #   default -- Optional boolean (default true).  When false, the
    #              scheme's well-known port is suppressed and reported
    #              as empty.
    #
    # Results:
    #   Returns the port as a string, or empty when no explicit port
    #   should be used.
    # </help>

    set uri null

    set ok [object invoke \
        -create -alias Uri TryCreate $baseUri Absolute uri]

    if {[isNonNullObjectHandle $ok] && \
        [$ok ToString] && [isNonNullObjectHandle $uri]} then {
      set port [$uri Port]

      if {!$default} then {
        #
        # NOTE: Before returning the port value, make sure it is
        #       NOT the default value for its associated scheme.
        #       This does not apply when the "default" argument
        #       is true.
        #
        switch -exact -nocase -- [$uri Scheme] {
          http {
            if {$port eq "80"} then {
              return ""
            }
          }
          https {
            if {$port eq "443"} then {
              return ""
            }
          }
        }
      }

      return $port
    }

    return ""
  }

  proc shouldUseLocalRelativeUris {} {
    # <help>
    # This procedure returns a boolean indicating whether
    # [resetServerEnvironmentVariables] should pick the locally-hosted
    # relative URI prefixes (containing the "kapok/" segment) instead
    # of the remote-server flavor.
    #
    # How it works: the rule is intentionally simple -- when the
    # AuthorityBaseUri environment variable is set, an absolute URI
    # to a real server is assumed in effect, so the non-local relative
    # URIs are used (the procedure returns false); when the variable
    # is absent, the local flavor is used (returns true).
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns a boolean: true when the local relative URI flavor
    #   should be used, false otherwise.
    # </help>

    #
    # HACK: For now, assume that when an absolute base URI is specified,
    #       the non-local relative URIs should be used by the procedure
    #       [resetServerEnvironmentVariables].
    #
    return [expr {![info exists ::env(AuthorityBaseUri)]}]
  }

  #
  # TODO: Make the specific servers, ports, and relative URIs in this test
  #       procedure more configurable.
  #
  proc resetServerEnvironmentVariables {
          {varName ""} {iis ""} {local ""} {quiet false} {logOnly false}
          {rootBaseUri ""} } {
    # <help>
    # This procedure populates either the live process environment or a
    # caller-supplied array with the standard set of Kapok-server URI
    # and port values appropriate for the current test mode (IIS vs.
    # ASP.NET dev server, local vs. remote).  It is the central
    # configuration entry point for nearly every Harpy/Kapok server
    # interaction in the test suite.
    #
    # How it works: when varName is non-empty its caller-scope array is
    # linked via [upvar]; otherwise the global env array is used.  The
    # override ::no(resetServerEnvironmentVariables) suppresses all
    # mutation while still passing the saved/effective values onward.
    # Otherwise it resolves the iis and local flags through
    # [isUsingInternetInformationServices] and [isUsingLocalHost], and
    # defaults rootBaseUri from the RootBaseUri environment variable
    # when absent.  Two URI flavors are then chosen: when iis and local
    # are both true, IIS 7.x relative URIs (containing the kapok/
    # prefix) are used along with port 11452 (or the port extracted
    # from rootBaseUri); otherwise the ASP.NET dev-server flavor of
    # relative URIs is used along with port 1195 (again overridable
    # from rootBaseUri).  ServerPort mirrors LocalServerPort only when
    # local is true.  When the host of rootBaseUri is "localhost" and
    # local is true, UseLocalHost is set to 1.  Finally, unless quiet
    # is set, the resulting configuration is dumped via
    # [dumpServerEnvironmentVariables]; the logOnly flag suppresses
    # the test channel, leaving only the log.
    #
    # Tricky details: the "iis + local" branch matches IIS 7.x layouts
    # where the URL already contains "kapok"; the other branch covers
    # both ASP.NET dev server and the real remote IIS using the
    # canonical authority URNs.
    #
    # Arguments:
    #   varName     -- Optional caller array name to receive the
    #                  values.  When empty, the global env array is
    #                  written.
    #   iis         -- Optional IIS override; empty triggers detection.
    #   local       -- Optional local-host override; empty triggers
    #                  detection.
    #   quiet       -- Optional boolean (default false).  When true,
    #                  no diagnostic dump is written.
    #   logOnly     -- Optional boolean (default false).  When true,
    #                  the dump is logged but not echoed to the test
    #                  channel.
    #   rootBaseUri -- Optional explicit root base URI.  When empty,
    #                  the RootBaseUri environment variable is used.
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   mutating the chosen environment-style array.
    # </help>

    #
    # NOTE: Figure out where the reset environment variables are going
    #       to reside (i.e. it may not be in the actual "::env" array).
    #
    if {[string length $varName] > 0} then {
      upvar 1 $varName array; # use specified variable
    } else {
      upvar #0 env array; # use global env array
    }

    #
    # HACK: Disable changing any of these variables if the user override
    #       is present.
    #
    if {[info exists ::no(resetServerEnvironmentVariables)]} then {
      set savedIis $iis
      set savedLocal $local
      set savedRootBaseUri $rootBaseUri
    } else {
      set savedIis $iis
      set iis [isUsingInternetInformationServices $iis]

      set savedLocal $local
      set local [isUsingLocalHost $local]

      #
      # HACK: For the Harpy test suite, fallback to the RootBaseUri
      #       environment variable if the "rootBaseUri" argument is
      #       not specified.
      #
      set savedRootBaseUri $rootBaseUri

      if {[string length $rootBaseUri] == 0 && \
          [info exists ::env(RootBaseUri)]} then {
        set rootBaseUri $::env(RootBaseUri)
      }

      if {$iis && $local} then {
        #
        # NOTE: These are for use with IIS 7.x (e.g. 7.5) on Windows 7,
        #       Windows Server 2008 R2, etc.  These will only work when
        #       not using the live remote server due to it containing
        #       the "kapok" portion already.
        #
        set array(ProvisionRelativeUri) kapok/service/provision.cgi?
        set array(RenewalRelativeUri) kapok/certificate/renew.cgi?
        set array(RequestRelativeUri) kapok/certificate/request.cgi?
        set array(RevocationRelativeUri) kapok/certificate/revoked.cgi?
        set array(SupportRelativeUri) kapok/support/check.cgi?
        set array(ScriptRelativeUri) kapok/wrapper/script.cgi?
        set array(StorageRelativeUri) kapok/var/storage.cgi?
        set array(TestRelativeUri) kapok/test/page.cgi?

        if {[string length $rootBaseUri] > 0} then {
          set array(LocalServerPort) [getPortFromBaseUri $rootBaseUri]
        } else {
          set array(LocalServerPort) 11452
        }

        set array(ServerPort) $array(LocalServerPort)
      } else {
        #
        # NOTE: These are for use with the ASP.NET Development Server
        #       included with Visual Studio 20XX (e.g. Visual Studio
        #       2008) -AND- remote IIS servers that use the official
        #       authority URNs.
        #
        set array(ProvisionRelativeUri) service/provision.cgi?
        set array(RenewalRelativeUri) certificate/renew.cgi?
        set array(RequestRelativeUri) certificate/request.cgi?
        set array(RevocationRelativeUri) certificate/revoked.cgi?
        set array(SupportRelativeUri) support/check.cgi?
        set array(ScriptRelativeUri) wrapper/script.cgi?
        set array(StorageRelativeUri) var/storage.cgi?
        set array(TestRelativeUri) test/page.cgi?

        #
        # NOTE: When operating locally, use specially reserved port;
        #       otherwise, use the default port for the URL scheme.
        #
        if {[string length $rootBaseUri] > 0} then {
          set array(LocalServerPort) [getPortFromBaseUri $rootBaseUri]
        } else {
          set array(LocalServerPort) 1195
        }

        if {$local} then {
          set array(ServerPort) $array(LocalServerPort)
        } else {
          unset -nocomplain array(ServerPort)
        }
      }

      #
      # NOTE: Are we forcing the use of "localhost"...?  This only works
      #       in the debug build.
      #
      if {$local && \
          [getHostFromBaseUri $rootBaseUri] eq "localhost"} then {
        set array(UseLocalHost) 1
      } else {
        unset -nocomplain array(UseLocalHost)
      }
    }

    #
    # NOTE: When not forbidden from doing so by the caller, emit final
    #       configuration to the test log.
    #
    if {!$quiet} then {
      if {$logOnly} then {
        set channel ""
      } else {
        package require Eagle.Test

        set channel [getTestChannelOrDefault]
      }

      dumpServerEnvironmentVariables \
          array $savedIis $iis $savedLocal $local $savedRootBaseUri \
          $rootBaseUri false $channel
    }
  }

  proc getServerUriForPing { {iis ""} {local ""} {rootBaseUri ""} } {
    # <help>
    # This procedure returns the URI to use when a test wants to ping a
    # Kapok server to confirm reachability.  It chooses an appropriate
    # base, relative endpoint, and the ping=true query parameter based
    # on the active configuration.
    #
    # How it works: rootBaseUri defaults to the RootBaseUri environment
    # variable when empty.  A scratch array is populated by calling
    # [resetServerEnvironmentVariables] in quiet mode, so the URI
    # defaults can be read without mutating the live env.  When
    # rootBaseUri is non-empty, the relative URI is taken from
    # PingRelativeUri (if set) or array(TestRelativeUri), and the URI
    # is built by joining rootBaseUri and the relative URI and
    # appending ping=true.  When PingBaseUri is set, the same logic is
    # applied against PingBaseUri.  As a last resort the URI is
    # synthesized as http://localhost:<LocalServerPort>/<TestRelativeUri>
    # plus ping=true.
    #
    # Arguments:
    #   iis         -- Optional IIS override forwarded to
    #                  [resetServerEnvironmentVariables].
    #   local       -- Optional local-host override forwarded to
    #                  [resetServerEnvironmentVariables].
    #   rootBaseUri -- Optional explicit root base URI; empty falls
    #                  back to the RootBaseUri environment variable.
    #
    # Results:
    #   Returns a string URI suitable for a ping HTTP GET.
    # </help>

    #
    # HACK: For the Harpy test suite, fallback to the RootBaseUri
    #       environment variable if the "rootBaseUri" argument is
    #       not specified.
    #
    if {[string length $rootBaseUri] == 0 && \
        [info exists ::env(RootBaseUri)]} then {
      set rootBaseUri $::env(RootBaseUri)
    }

    resetServerEnvironmentVariables \
        array $iis $local true false $rootBaseUri

    if {[string length $rootBaseUri] > 0} then {
      if {[info exists ::env(PingRelativeUri)]} then {
        set relativeUri $::env(PingRelativeUri)
      } else {
        set relativeUri $array(TestRelativeUri)
      }

      return [appendArgs [file join \
          $rootBaseUri $relativeUri] ping=true]
    } elseif {[info exists ::env(PingBaseUri)]} then {
      if {[info exists ::env(PingRelativeUri)]} then {
        set relativeUri $::env(PingRelativeUri)
      } else {
        set relativeUri $array(TestRelativeUri)
      }

      return [appendArgs [file join \
          $::env(PingBaseUri) $relativeUri] ping=true]
    }

    return [appendArgs [file join [appendArgs \
        http://localhost: $array(LocalServerPort)] \
        $array(TestRelativeUri)] ping=true]
  }

  proc maybeGetServerUriForPing { {iis ""} {local ""} {rootBaseUri ""} } {
    # <help>
    # This procedure returns the URI to use for pinging a Kapok server,
    # honoring caller-provided ping-specific globals when present, and
    # otherwise falling back to the standard detection performed by
    # [getServerUriForPing].
    #
    # How it works: when the global ::pingBaseUri is set and the
    # latch global ::setPingBaseUri is not, the ping base URI takes
    # precedence.  In that case, when ::pingRelativeUri is also set
    # and the matching ::setPingRelativeUri latch is not, the
    # returned URI is the join of those two values plus the literal
    # ping=true.  When only ::pingBaseUri is set, it is returned
    # unchanged.  Otherwise the call is delegated to
    # [getServerUriForPing] with the same iis, local, and rootBaseUri
    # arguments.
    #
    # Arguments:
    #   iis         -- Optional IIS override.
    #   local       -- Optional local-host override.
    #   rootBaseUri -- Optional explicit root base URI.
    #
    # Results:
    #   Returns a string URI suitable for a ping HTTP GET.
    # </help>

    #
    # HACK: For the Harpy and Kapok test suites, first check if a root
    #       base URI has been set specifically for server pings.  If so,
    #       use it; otherwise, fallback to the normal detection method.
    #
    if {[info exists ::pingBaseUri] && \
        ![info exists ::setPingBaseUri]} then {
      #
      # NOTE: Next, see if there is a relative URI, set by the caller,
      #       to be used for pinging the server.
      #
      if {[info exists ::pingRelativeUri] && \
          ![info exists ::setPingRelativeUri]} then {
        return [appendArgs [file join \
            $::pingBaseUri $::pingRelativeUri] ping=true]
      } else {
        return $::pingBaseUri
      }
    } else {
      return [getServerUriForPing $iis $local $rootBaseUri]
    }
  }

  proc checkForRemoteCertificateServer {
          channel {iis ""} {local ""} {rootBaseUri ""} } {
    # <help>
    # This procedure probes the remote Kapok certificate server and
    # registers the kapok.server test constraint when it appears to be
    # working, so subsequent server-dependent tests can be conditioned
    # on it.
    #
    # How it works: when the global ::no(kapok.server) override is not
    # set, the URI to probe is obtained from [maybeGetServerUriForPing].
    # The endpoint is downloaded with -trusted via [uri download],
    # using the network timeout type.  The expected response depends
    # on the URI: when the URI ends with a /test/page.cgi? form (i.e.
    # a pure ping), an empty response is treated as success; for any
    # other URI shape, the response must equal "Error: invalid
    # requestId".  On success kapok.server is added.  On response
    # mismatch or download error, diagnostics are emitted unless
    # ::no(kapok.server.verbose) is set.  When ::no(kapok.server) is
    # set, the constraint is added unconditionally and skipped is
    # logged.
    #
    # Tricky details: the comment in the original code flags two
    # known limitations -- the request is intentionally malformed and
    # the certificate renewal endpoint is assumed to be the primary
    # one always available when the server is online.
    #
    # Arguments:
    #   channel     -- The test channel for diagnostic output.
    #   iis         -- Optional IIS override forwarded to URI
    #                  resolution.
    #   local       -- Optional local-host override.
    #   rootBaseUri -- Optional explicit root base URI.
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   registering the kapok.server constraint and writing
    #   diagnostics.
    # </help>

    #
    # NOTE: This is not actually a properly formatted request to the server;
    #       however, that does not matter for the purposes of this check.
    #
    # BUGBUG: This assumes that the "certificate renewal" server endpoint is
    #         the "primary" one -AND- that it will always be available when
    #         the server is online.
    #
    if {![info exists ::no(kapok.server)]} then {
      set uri [maybeGetServerUriForPing $iis $local $rootBaseUri]
    }

    tputs $channel "---- checking for remote certificate server... "

    if {![info exists ::no(kapok.server)]} then {
      if {[catch {
        uri download -trusted -timeouttype network -inline $uri
      } data] == 0} then {
        if {[string match {*/test/page.cgi[?]*} $uri]} then {
          set wantData ""; # HACK: Empty response.
        } else {
          set wantData "Error: invalid requestId"
        }

        if {$data eq $wantData} then {
          #
          # NOTE: The remote server appears to be available and working
          #       properly.
          #
          addConstraint kapok.server

          tputs $channel [appendArgs "yes (" $uri ")\n"]
        } else {
          tputs $channel no\n

          if {![info exists ::no(kapok.server.verbose)]} then {
            tputs $channel [appendArgs \
                "---- remote server \"" $uri "\" response mismatch: " \
                $data \n]
          }
        }
      } else {
        tputs $channel error\n

        if {![info exists ::no(kapok.server.verbose)]} then {
          tputs $channel [appendArgs \
              "---- remote server \"" $uri "\" request failed: " \
              $data \n]
        }
      }
    } else {
      addConstraint kapok.server

      tputs $channel skipped\n
    }
  }

  proc getCoreOnlyEnvironmentVariableNames {} {
    # <help>
    # This procedure returns the list of environment variable names that
    # are consumed by the Eagle core but not by Harpy itself.  It is
    # merged into the broader certificate-environment list so that
    # save/restore cycles cover the full set of variables a Harpy test
    # may observe or modify.
    #
    # How it works: it returns a fixed Tcl list of names covering the
    # core-only toggles such as ForceModernAlgorithms, NetworkTimeout,
    # NoAutoRecord, NoLicensing and its variants,
    # NoLicensingPackageUnknown, NoPopulateOsExtra, NoPromptCount,
    # NoStartupRunCommands, NoTraceLimits, and NoWorkerThread.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns a Tcl list of environment variable names (strings).
    # </help>

    return [list \
        ForceModernAlgorithms \
        NetworkTimeout \
        NoAutoRecord \
        NoLicensing \
        NoLicensingPackage \
        NoLicensingPackageUnknown \
        NoPopulateOsExtra \
        NoPromptCount \
        NoStartupRunCommands \
        NoTraceLimits \
        NoWorkerThread]
  }

  proc getTestOnlyEnvironmentVariableNames {} {
    # <help>
    # This procedure returns the list of environment variable names that
    # are consumed only by the Harpy/Kapok test suite, not by the
    # shipping product.  Like [getCoreOnlyEnvironmentVariableNames],
    # the list contributes to the unified save/restore coverage.
    #
    # How it works: it returns a fixed Tcl list of test-only names --
    # getShellExecutableName (test override for the shell executable
    # name), MutateGlobalState (allow global state mutation during the
    # run), and Rollback (request rollback behavior).
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns a Tcl list of environment variable names (strings).
    # </help>

    return [list \
        getShellExecutableName \
        MutateGlobalState \
        Rollback]
  }

  proc getCertificateEnvironmentVariableNames {} {
    # <help>
    # This procedure returns the canonical, sorted union list of every
    # environment variable name that Harpy (including its SDK), Badge,
    # and Kapok recognize, plus the core-only and test-only names.
    # Higher-level helpers such as [saveCertificateEnvironment] and
    # [restoreCertificateEnvironment] use this list to snapshot and
    # restore the entire relevant environment for a test.
    #
    # How it works: a large literal Tcl list is built containing all
    # documented Harpy/Badge/Kapok variable names -- ranging from
    # Certificate and CertificateNamePrefix through every
    # Configuration* setting, every Harpy* feature flag, every renewal,
    # support, wrapper, and package toggle, and many others.  The
    # results of [getCoreOnlyEnvironmentVariableNames],
    # [getTestOnlyEnvironmentVariableNames],
    # [getServerEnvironmentVariableNames], and
    # [getXdgEnvironmentVariableNames] are then appended, and the
    # combined list is sorted with [lsort] before being returned.
    #
    # Tricky details: the literal list intentionally includes some
    # variables that are not currently honored at runtime (for example
    # NoScriptRelativeUri), so that a future implementation that
    # consults them is automatically covered by save/restore.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns a sorted Tcl list of environment variable names
    #   covering Harpy, Badge, Kapok, the Eagle core, the test suite,
    #   the server endpoints, and XDG.
    # </help>

    #
    # NOTE: The list returned from this procedure is intended to be a
    #       complete list of the environment variable names that are
    #       used by Harpy (including its SDK), Badge, and Kapok.  Not
    #       all of these are currently used (e.g. NoScriptRelativeUri).
    #       Generally, this returned list must include all environment
    #       variable names that are included in the lists returned by
    #       the [getXdgEnvironmentVariableNames] procedure and/or the
    #       [getServerEnvironmentVariableNames] procedure.
    #
    set result [list \
        AlwaysExpires \
        AlwaysLimitedQuantity \
        AlwaysVerifyLicense \
        AsynchronousConfiguration \
        AsynchronousLicensing \
        BootstrapDirectories \
        Certificate \
        CertificateNamePrefix \
        CertificatePath \
        CertificateSummaryFeatures \
        CertificateSummaryPairs \
        CertificateTraceFile \
        ConfigurationDirectory \
        ConfigurationEnvironmentOnly \
        ConfigurationEpilogueFileName \
        ConfigurationFailOnError \
        ConfigurationFileNames \
        ConfigurationFilePatterns \
        ConfigurationForceCommands \
        ConfigurationInterpreterSettings \
        ConfigurationNoUniqueFileNames \
        ConfigurationOverrideOnly \
        ConfigurationFileName0 \
        ConfigurationFileName1 \
        ConfigurationFileName2 \
        ConfigurationFileName3 \
        ConfigurationFileName4 \
        ConfigurationFileName5 \
        ConfigurationFileName6 \
        ConfigurationFileName7 \
        ConfigurationFileName8 \
        ConfigurationFileName9 \
        ConfigurationScriptText0 \
        ConfigurationScriptText1 \
        ConfigurationScriptText2 \
        ConfigurationScriptText3 \
        ConfigurationScriptText4 \
        ConfigurationScriptText5 \
        ConfigurationScriptText6 \
        ConfigurationScriptText7 \
        ConfigurationScriptText8 \
        ConfigurationScriptText9 \
        ConfigurationSignatureText0 \
        ConfigurationSignatureText1 \
        ConfigurationSignatureText2 \
        ConfigurationSignatureText3 \
        ConfigurationSignatureText4 \
        ConfigurationSignatureText5 \
        ConfigurationSignatureText6 \
        ConfigurationSignatureText7 \
        ConfigurationSignatureText8 \
        ConfigurationSignatureText9 \
        ConfigurationSkipEmbedded \
        ConfigurationSwapCommands \
        ConfigurationTraceCommands \
        ConfigurationTraceDirectory \
        ConfigurationTraceNewLines \
        CONFIGURATION_SUFFIX \
        DumpKeyPairs \
        EnablePolicyTracing \
        ForceAllowOnlyFipsAlgorithms \
        ForceEnableTrace \
        ForceEnableTraceLogFile \
        ForceLogLicense \
        ForceLogNetwork \
        ForceLogPerAppDomain \
        ForceLogPerProcess \
        ForceLogScript \
        ForceLogServer \
        FullPluginPolicyTracing \
        HarpyAggressiveCache \
        HarpyAllowAnyThread \
        HarpyAllowObsoleteConfiguration \
        HarpyApiId \
        HarpyApiKey \
        HarpyBinaryPath \
        HarpyEncryptedConfigurationsOnly \
        HarpyEvaluateWithConsole \
        HarpyFileTicket \
        HarpyForceSdkMode \
        HarpyForceDebuggerConfiguration \
        HarpyForceStackTrace \
        HarpyKeyPairTicket \
        HarpyLicenseFileName \
        HarpyLicenseTicket \
        HarpyMaximumRetries \
        HarpyNetworkTrace \
        HarpyNoAutoAcquire \
        HarpyNoCreateInterpreter \
        HarpyNoDisableCreation \
        HarpyNoInternal \
        HarpyNoIsolated \
        HarpyNoProbePlugins \
        HarpyNoTraceOnError \
        HarpyNoTrustedHashes \
        HarpyOtherTicket \
        HarpyPersistentTracing \
        HarpyPreserveTrace \
        HarpyRetryCreation \
        HarpyScriptTicket \
        HarpySecretUri \
        HarpySkipDebuggerDetection \
        HarpyStreamTicket \
        HarpyTicketId \
        HarpyTimeout \
        HarpyTraceTicket \
        HarpyTraceOnError \
        HarpyTreatAsIsolated \
        HarpyUpdateViaPackage \
        HarpyUseRemotePasswords \
        HarpyVerifyWithConsole \
        HarpyWebMaximumRetries \
        HarpyWellKnownPlugins \
        HashAlgorithm \
        Isolated \
        IsolatedConfiguration \
        KapokDataFromPackage \
        KAPOK_TEST_PATH \
        KAPOK_TOOL_PATH \
        LicenseAssemblyPath \
        LicenseExecutionPolicy \
        LicenseOtherAppDomain \
        MachineGuid \
        MachineVolumeSerialNumber \
        NoAnnounceInteractiveLoop \
        NoBackupCertificateFile \
        NoCertificateSummary \
        NoCertificateSummaryRestrictions \
        NoConfiguration \
        NoIsolated \
        NoLoadKeyRings \
        NoLoadLicenseKeyRings \
        NoLogServer \
        NoMergeKeyPairsForExpiration \
        NoNetworkRevocation \
        NoNetworkTime \
        NoRequestTimeout \
        NoSandboxShutdown \
        NoSandboxStatus \
        NoScriptPath \
        NotCommandFlags \
        NoTraceServer \
        NoTraceSettings \
        NoTrustedRenewal \
        NoWriteWithoutFail \
        NoWriteWithoutFailViaHost \
        PackageDatabase \
        PackageScriptBlockFlags \
        PackageScriptBlocks \
        PackageScriptFile \
        PackageServerEnabled \
        PackageServerSecurityFlags \
        PackageServerSecurityLevel \
        PackageSetupScript \
        PreLoadSQLite_BaseDirectory \
        PrimaryKeyRingOnly \
        PrimaryNetworkTime \
        privateKeyFileName \
        RenewalCertificateDatabase \
        RenewalLicenseKeyRingDatabase \
        RenewalNoRequestTimeout \
        RenewalPassThroughMode \
        RenewalScriptBlockFlags \
        RenewalScriptBlocks \
        RenewalScriptFile \
        RenewalScriptKeyRingDatabase \
        RenewalServerEnabled \
        RenewalServerSecurityFlags \
        RenewalServerSecurityLevel \
        RenewalSetupScript \
        RenewalTimeout \
        ScriptExecutionPolicy \
        ScriptInterpreterSettings \
        Security_Force_CanLoad \
        SpecificKeyRingOnly \
        SupportScriptBlockFlags \
        SupportScriptBlocks \
        SupportScriptFile \
        SupportServerEnabled \
        SupportServerSecurityFlags \
        SupportServerSecurityLevel \
        SupportSetupScript \
        templateFileName \
        toolPath \
        UseAnyPackage \
        UseBigCrypto \
        UseDefaultRenewCallback \
        UseEmptyId \
        UseFullPackageName \
        VerbosePolicyTrace \
        VerboseTracePriority \
        WrapperScriptBlockFlags \
        WrapperScriptBlocks \
        WrapperScriptFile \
        WrapperServerEnabled \
        WrapperServerSecurityFlags \
        WrapperServerSecurityLevel \
        WrapperSetupScript \
        WriteWithoutFail]

    eval lappend result [getCoreOnlyEnvironmentVariableNames]
    eval lappend result [getTestOnlyEnvironmentVariableNames]
    eval lappend result [getServerEnvironmentVariableNames]
    eval lappend result [getXdgEnvironmentVariableNames]

    return [lsort $result]
  }

  proc saveCertificateEnvironment {} {
    # <help>
    # This procedure captures a complete snapshot of every certificate-
    # related environment variable into the caller's savedEnv array.
    # It is the standard "remember everything" call that pairs with
    # [restoreCertificateEnvironment] in test fixtures.
    #
    # How it works: it links the literal-named savedEnv variable in the
    # caller's frame via [upvar] (no varName argument is accepted),
    # then delegates to [saveEnvironmentVariables] using the full list
    # returned by [getCertificateEnvironmentVariableNames].
    #
    # Arguments:
    #   None.  The destination variable name is fixed as savedEnv in
    #   the caller's frame.
    #
    # Results:
    #   No defined return value.  The effect is the side effect of
    #   populating the caller's savedEnv array.
    # </help>

    upvar 1 savedEnv savedEnv

    saveEnvironmentVariables \
        [getCertificateEnvironmentVariableNames] savedEnv
  }

  proc restoreCertificateEnvironment {} {
    # <help>
    # This procedure restores the certificate-related environment variables
    # from a previously captured snapshot in the caller's savedEnv array.  It
    # is the inverse of [saveCertificateEnvironment] and is meant to undo any
    # changes that a test made to the variables that influence certificate
    # selection (such as CertificateNamePrefix and CertificatePath).
    #
    # How it works: it aliases the caller's savedEnv array via upvar, asks
    # [getCertificateEnvironmentVariableNames] for the list of certificate
    # environment variable names, and forwards both to
    # [restoreEnvironmentVariables], which reinstates each name to its prior
    # value or unsets it when it did not previously exist.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; the side effect is the restoration of the
    #   certificate environment variables in the global env array.
    # </help>

    upvar 1 savedEnv savedEnv

    restoreEnvironmentVariables \
        [getCertificateEnvironmentVariableNames] savedEnv
  }

  proc resetCertificateEnvironment {} {
    # <help>
    # This procedure clears the two certificate-selection environment
    # variables (CertificateNamePrefix and CertificatePath) so that the test
    # interpreter runs in a known, baseline state where Harpy cannot find a
    # certificate via these hints.
    #
    # How it works: it makes the global env array visible and then issues a
    # single [unset -nocomplain] for the two named elements; the -nocomplain
    # flag means a missing element is silently tolerated, so this can be
    # invoked from any starting state.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; the side effect is that the env elements
    #   CertificateNamePrefix and CertificatePath no longer exist.
    # </help>

    global env

    unset -nocomplain env(CertificateNamePrefix) env(CertificatePath)
  }

  proc getPluginLicenseEnvironmentVariableNames { name } {
    # <help>
    # This procedure returns the complete, prioritized list of environment
    # variable names that Harpy consults when locating a license
    # certificate for a specific plugin -- such as Badge, Demo, Eagle,
    # Featherlight, HotKey, Kapok, or Zeus -- plus the catch-all
    # empty-string case used for the generic Certificate and
    # Override_Certificate names.  It is the central reference used by the
    # save, restore, reset and have helpers in this file.
    #
    # How it works: it dispatches on the name argument with a
    # [switch -exact] and, for each supported plugin, returns the
    # carefully ordered set of Override_*_Certificate and *_Certificate
    # variable names that Harpy searches in priority order (most specific
    # first, falling back through less qualified variants to the generic
    # Enterprise_Certificate and plugin_Certificate names).  The
    # empty-string case returns the very generic Override_Certificate and
    # Certificate pair; the default arm raises an error when an
    # unsupported plugin name is supplied.
    #
    # Tricky details: the ordering within each plugin matches Harpy's
    # actual certificate-search priority; preserving it is essential so
    # that saving, restoring, or resetting the variables touches the same
    # names the production lookup uses.  The Featherlight, Harpy and Badge
    # arms in particular include many qualified variants reflecting
    # historical name spellings.
    #
    # Arguments:
    #   name -- The plugin name.  Recognized values are the empty string
    #           and Badge, Demo, Eagle, Featherlight, Harpy, HotKey, Kapok,
    #           and Zeus.  Any other value raises an error.
    #
    # Results:
    #   Returns a list of environment variable name strings.  When the
    #   name is unsupported, an error is raised instead.
    # </help>

    switch -exact -- $name {
      "" {
        return [list \
            Override_Certificate \
            Certificate]
      }
      Badge {
        return [list \
            Override_Badge_Badge.Enterprise_Certificate \
            Override_Harpy_Badge.Enterprise_Certificate \
            Override_Badge.Enterprise_Certificate \
            Override_Badge_Enterprise_Certificate \
            Override_Enterprise_Certificate \
            Override_Badge_Certificate \
            Badge_Badge.Enterprise_Certificate \
            Harpy_Badge.Enterprise_Certificate \
            Badge.Enterprise_Certificate \
            Badge_Enterprise_Certificate \
            Enterprise_Certificate \
            Badge_Certificate \
            Override_Badge_Security.Certificates_Certificate \
            Override_Harpy_Security.Certificates_Certificate \
            Override_Security.Certificates_Certificate \
            Override_Badge_Certificates_Certificate \
            Override_Harpy_Certificates_Certificate \
            Override_Certificates_Certificate \
            Override_Badge_Certificate \
            Badge_Security.Certificates_Certificate \
            Harpy_Security.Certificates_Certificate \
            Security.Certificates_Certificate \
            Badge_Certificates_Certificate \
            Harpy_Certificates_Certificate \
            Certificates_Certificate \
            Badge_Certificate]
      }
      Demo {
        return [list \
            Override_Demo_Demo.Enterprise_Certificate \
            Override_Demo.Enterprise_Certificate \
            Override_Demo_Enterprise_Certificate \
            Override_Enterprise_Certificate \
            Override_Demo_Certificate \
            Demo_Demo.Enterprise_Certificate \
            Demo.Enterprise_Certificate \
            Demo_Enterprise_Certificate \
            Enterprise_Certificate \
            Demo_Certificate]
      }
      Eagle {
        return [list \
            Override_Eagle_Certificate \
            Eagle_Certificate]
      }
      Featherlight {
        return [list \
            Override_Featherlight_Featherlight.Environment_Certificate \
            Override_Featherlight.Environment_Certificate \
            Override_Featherlight_Environment_Certificate \
            Override_Environment_Certificate \
            Override_Featherlight_Certificate \
            Featherlight_Featherlight.Environment_Certificate \
            Featherlight.Environment_Certificate \
            Featherlight_Environment_Certificate \
            Environment_Certificate Featherlight_Certificate]
      }
      Harpy {
        return [list \
            Override_Harpy_Licensing.Enterprise_Certificate \
            Override_Licensing.Enterprise_Certificate \
            Override_Harpy_Enterprise_Certificate \
            Override_Enterprise_Certificate \
            Override_Harpy_Licensing.Standard_Certificate \
            Override_Licensing.Standard_Certificate \
            Override_Harpy_Standard_Certificate \
            Override_Standard_Certificate \
            Override_Harpy_Licensing.Core_Certificate \
            Override_Licensing.Core_Certificate \
            Override_Harpy_Core_Certificate \
            Override_Core_Certificate \
            Override_Harpy_Security.Core_Certificate \
            Override_Security.Core_Certificate \
            Override_Harpy_Certificate \
            Harpy_Licensing.Enterprise_Certificate \
            Licensing.Enterprise_Certificate \
            Harpy_Enterprise_Certificate \
            Enterprise_Certificate \
            Harpy_Licensing.Standard_Certificate \
            Licensing.Standard_Certificate \
            Harpy_Standard_Certificate \
            Standard_Certificate \
            Harpy_Licensing.Core_Certificate \
            Licensing.Core_Certificate \
            Harpy_Core_Certificate \
            Core_Certificate \
            Harpy_Security.Core_Certificate \
            Security.Core_Certificate \
            Harpy_Certificate]
      }
      HotKey {
        return [list \
            Override_HotKey_HotKey.Enterprise_Certificate \
            Override_HotKey.Enterprise_Certificate \
            Override_HotKey_Enterprise_Certificate \
            Override_Enterprise_Certificate \
            Override_HotKey_Certificate \
            HotKey_HotKey.Enterprise_Certificate \
            HotKey.Enterprise_Certificate \
            HotKey_Enterprise_Certificate \
            Enterprise_Certificate \
            HotKey_Certificate]
      }
      Kapok {
        return [list \
            Override_Kapok_Kapok.Enterprise_Certificate \
            Override_Kapok.Enterprise_Certificate \
            Override_Kapok_Enterprise_Certificate \
            Override_Enterprise_Certificate \
            Override_Kapok_Certificate \
            Kapok_Kapok.Enterprise_Certificate \
            Kapok.Enterprise_Certificate \
            Kapok_Enterprise_Certificate \
            Enterprise_Certificate \
            Kapok_Certificate]
      }
      Zeus {
        return [list \
            Override_Zeus_Zeus.Enterprise_Certificate \
            Override_Zeus.Enterprise_Certificate \
            Override_Zeus_Enterprise_Certificate \
            Override_Enterprise_Certificate \
            Override_Zeus_Certificate \
            Zeus_Zeus.Enterprise_Certificate \
            Zeus.Enterprise_Certificate \
            Zeus_Enterprise_Certificate \
            Enterprise_Certificate \
            Zeus_Certificate]
      }
      default {
        error [appendArgs "unsupported plugin name \"" $name \"]
      }
    }
  }

  proc havePluginLicenseEnvironmentVariableNames { name } {
    # <help>
    # This procedure counts how many of the environment variable names
    # used to locate a license certificate for a given plugin are presently
    # defined in the global env array.  Tests use it to detect whether the
    # environment already provides a certificate hint for a particular
    # plugin before launching a controlled scenario.
    #
    # How it works: it iterates the list returned by
    # [getPluginLicenseEnvironmentVariableNames] for the given plugin and
    # increments a counter once for each name that exists in env.  The
    # accumulated count is returned.
    #
    # Tricky details: the inner foreach loop reuses the parameter name
    # "name" as its iteration variable, deliberately shadowing the plugin
    # name argument after [getPluginLicenseEnvironmentVariableNames] has
    # been called.  This is intentional and harmless because the plugin
    # name is only needed once.
    #
    # Arguments:
    #   name -- The plugin name to query (recognized values are the same
    #           as for [getPluginLicenseEnvironmentVariableNames]).
    #
    # Results:
    #   Returns an integer giving the number of matching variables that
    #   are currently set in the env array.
    # </help>

    global env

    set result 0

    foreach name [getPluginLicenseEnvironmentVariableNames $name] {
      if {[info exists env($name)]} then {
        incr result
      }
    }

    return $result
  }

  proc getLicenseEnvironmentVariableNames { {harpyOnly true} } {
    # <help>
    # This procedure returns the complete list of environment variable
    # names that Harpy consults when locating license certificates,
    # aggregating the per-plugin names returned by
    # [getPluginLicenseEnvironmentVariableNames] across the desired scope.
    # It is the single source of truth for the save, restore, reset and
    # have helpers that operate on the licensing environment.
    #
    # How it works: it starts with an empty result list.  When harpyOnly
    # is false it iterates the auxiliary plugins (Badge, Demo,
    # Featherlight, HotKey, Kapok, Zeus) and appends each one's variable
    # names.  It then always appends the Harpy, Eagle, and empty-string
    # (generic) names so those are included regardless of scope.  The
    # accumulated list is returned.
    #
    # Tricky details: the use of [eval lappend] flattens each per-plugin
    # list into the result so the final list is a flat sequence of names.
    # The ordering matters because [restoreEnvironmentVariables] and
    # callers expect a consistent traversal order.
    #
    # Arguments:
    #   harpyOnly -- When true (default), only the Harpy, Eagle and
    #                generic certificate names are returned; when false,
    #                the names for all supported plugins are also included
    #                ahead of those.
    #
    # Results:
    #   Returns a list of environment variable name strings.
    # </help>

    #
    # NOTE: The list returned from this procedure is intended to be a
    #       complete list of the environment variable names that are
    #       used by for Harpy license certificates.
    #
    set result [list]

    if {!$harpyOnly} then {
      foreach name [list Badge Demo Featherlight HotKey Kapok Zeus] {
        eval lappend result \
            [getPluginLicenseEnvironmentVariableNames $name]
      }
    }

    foreach name [list Harpy Eagle ""] {
      eval lappend result \
          [getPluginLicenseEnvironmentVariableNames $name]
    }

    return $result
  }

  proc saveExecEnvironment {} {
    # <help>
    # This procedure captures the current value (or absence) of the shell
    # executable override environment variable into the caller's savedEnv
    # array, so it can be restored later (typically via
    # [restoreExecEnvironment]) after a test temporarily sets it to
    # redirect [customGetShellExecutableName].
    #
    # How it works: it aliases the caller's savedEnv array via upvar and
    # asks [saveEnvironmentVariables] to record the present-or-absent
    # status and value of a single literally named variable
    # "getShellExecutableName" -- the same name that
    # [customGetShellExecutableName] inspects to decide whether to use an
    # override.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; the side effect is that savedEnv in the
    #   caller now holds a snapshot of the getShellExecutableName
    #   environment variable.
    # </help>

    upvar 1 savedEnv savedEnv

    saveEnvironmentVariables [list getShellExecutableName] savedEnv
  }

  proc restoreExecEnvironment {} {
    # <help>
    # This procedure restores the shell-executable override environment
    # variable from a previously captured snapshot in the caller's savedEnv
    # array.  It is the inverse of [saveExecEnvironment] and undoes any
    # change a test made to the executable override read by
    # [customGetShellExecutableName].
    #
    # How it works: it aliases the caller's savedEnv array via upvar and
    # asks [restoreEnvironmentVariables] to reinstate the single literally
    # named variable "getShellExecutableName" from the snapshot, unsetting
    # it again if it was absent at save time.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; the side effect is the restoration of
    #   the getShellExecutableName element of the global env array.
    # </help>

    upvar 1 savedEnv savedEnv

    restoreEnvironmentVariables [list getShellExecutableName] savedEnv
  }

  proc customGetShellExecutableName {} {
    # <help>
    # This procedure returns the path of the host shell executable, with a
    # test-friendly override mechanism layered on top of the production
    # [getShellExecutableName] command.  It is intended to be aliased over
    # the original so that tests can substitute a different executable
    # without modifying the original implementation.
    #
    # How it works: it checks whether an alternate implementation named
    # __getShellExecutableName (the renamed original, by convention)
    # exists.  If so, it first checks the env array for an entry keyed by
    # the literal name getShellExecutableName -- if that environment
    # variable is set, its value is returned directly.  Otherwise, the
    # original __getShellExecutableName is invoked.  If no alternate is
    # registered, it simply calls the original getShellExecutableName.
    #
    # Tricky details: the env element looked up is literally named
    # "getShellExecutableName" (matching the original command's name), so
    # tests can override the shell executable path by setting that single
    # environment variable.  This works only after the production command
    # has been renamed to __getShellExecutableName.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the shell executable path string -- either from the env
    #   override, from the renamed original, or from the unmodified
    #   original command.
    # </help>

    global env

    set oldName getShellExecutableName
    set newName __getShellExecutableName

    if {[llength [info commands $newName]] > 0} then {
      if {[info exists env($oldName)]} then {
        return $env($oldName)
      }

      return [$newName]
    } else {
      return [$oldName]
    }
  }

  proc saveLicenseEnvironment { {harpyOnly true} } {
    # <help>
    # This procedure captures the current values of the license-related
    # environment variables into the caller's savedEnv array, so they can
    # be restored later (typically via [restoreLicenseEnvironment]) after a
    # test temporarily mutates them.
    #
    # How it works: it aliases the caller's savedEnv array via upvar, asks
    # [getLicenseEnvironmentVariableNames] for the appropriate list of
    # variable names, and forwards both to [saveEnvironmentVariables],
    # which records the present-or-absent status and value of each name.
    #
    # Arguments:
    #   harpyOnly -- When true (default), only the Harpy, Eagle and generic
    #                certificate variable names are saved; when false, the
    #                names for every supported plugin are also saved.
    #
    # Results:
    #   Returns the empty string; the side effect is that savedEnv in the
    #   caller now holds a snapshot of the license-related environment
    #   variables.
    # </help>

    upvar 1 savedEnv savedEnv

    saveEnvironmentVariables \
        [getLicenseEnvironmentVariableNames $harpyOnly] savedEnv
  }

  proc restoreLicenseEnvironment { {harpyOnly true} } {
    # <help>
    # This procedure restores the license-related environment variables
    # from a previously captured snapshot in the caller's savedEnv array.
    # It is the inverse of [saveLicenseEnvironment] and is meant to undo
    # any changes a test made to the certificate-selection variables so
    # that the surrounding environment is left as it was found.
    #
    # How it works: it aliases the caller's savedEnv array via upvar, asks
    # [getLicenseEnvironmentVariableNames] for the list of license
    # variable names, and forwards both to [restoreEnvironmentVariables],
    # which reinstates each name to its prior value or unsets it when it
    # did not previously exist.
    #
    # Arguments:
    #   harpyOnly -- When true (default), only the Harpy, Eagle and generic
    #                certificate variable names are restored; when false,
    #                the names for every supported plugin are also
    #                restored.  This must match the scope used at save
    #                time.
    #
    # Results:
    #   Returns the empty string; the side effect is the restoration of
    #   the license environment variables in the global env array.
    # </help>

    upvar 1 savedEnv savedEnv

    restoreEnvironmentVariables \
        [getLicenseEnvironmentVariableNames $harpyOnly] savedEnv
  }

  proc resetLicenseEnvironment { {harpyOnly true} } {
    # <help>
    # This procedure clears every license-related environment variable from
    # the global env array, so the test interpreter runs without any
    # inherited certificate hints that could affect Harpy's license lookup.
    # Tests call it to establish a clean baseline before exercising
    # controlled license scenarios.
    #
    # How it works: it makes the global env array visible, asks
    # [getLicenseEnvironmentVariableNames] for the appropriate list of
    # variable names, and issues [unset -nocomplain env($name)] for each
    # one.  The -nocomplain flag means missing names are silently
    # tolerated.
    #
    # Arguments:
    #   harpyOnly -- When true (default), only the Harpy, Eagle and generic
    #                certificate variable names are reset; when false, the
    #                names for every supported plugin (Badge, Demo,
    #                Featherlight, HotKey, Kapok, Zeus) are also cleared.
    #
    # Results:
    #   Returns the empty string; side effect is that the targeted env
    #   elements no longer exist.
    # </help>

    global env

    foreach name [getLicenseEnvironmentVariableNames $harpyOnly] {
      unset -nocomplain env($name)
    }
  }

  proc haveLicenseEnvironment { {harpyOnly true} } {
    # <help>
    # This procedure counts how many of the license-related environment
    # variable names are presently defined in the global env array.  It is
    # used by tests to detect whether the environment already provides
    # license certificates and therefore needs to be cleared before a
    # controlled test scenario, or to determine how many certificate hints
    # exist for diagnostics.
    #
    # How it works: it iterates the list returned by
    # [getLicenseEnvironmentVariableNames] for the requested scope and
    # increments a counter once for each name found via [info exists].
    # The accumulated count is returned.
    #
    # Arguments:
    #   harpyOnly -- When true (default), only the Harpy, Eagle and generic
    #                certificate variable names are considered; when false,
    #                the names for every supported plugin (Badge, Demo,
    #                Featherlight, HotKey, Kapok, Zeus) are also included.
    #
    # Results:
    #   Returns an integer giving the number of matching variables that
    #   are currently set in the env array.
    # </help>

    global env

    set result 0

    foreach name [getLicenseEnvironmentVariableNames $harpyOnly] {
      if {[info exists env($name)]} then {
        incr result
      }
    }

    return $result
  }

  proc getXdgEnvironmentVariableNames {} {
    # <help>
    # This procedure returns the canonical list of environment variable
    # names defined by the X Desktop Group's Base Directory Specification
    # that Harpy (including its SDK), Badge, and Kapok consult when
    # selecting configuration, data, key-ring, runtime, shell and startup
    # locations.  Centralizing the list here means [saveXdgEnvironment],
    # [restoreXdgEnvironment] and [resetXdgEnvironment] all act on the
    # same set of names.
    #
    # How it works: it simply constructs and returns a fixed list of XDG_*
    # variable names (XDG_CLOUD_DIRS, XDG_CLOUD_HOME, XDG_CONFIG_DIRS,
    # XDG_CONFIG_HOME, XDG_DATA_DIRS, XDG_DATA_HOME, XDG_KEYRING_DIRS,
    # XDG_KEYRING_HOME, XDG_RUNTIME_DIR, XDG_SHELLS_DIR, XDG_STARTUP_DIRS,
    # XDG_STARTUP_HOME).  The set deliberately includes Harpy-specific
    # additions (such as XDG_CLOUD_HOME, XDG_KEYRING_HOME and
    # XDG_SHELLS_DIR) alongside the standard XDG names.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns a list of XDG_* environment variable name strings.
    # </help>

    #
    # NOTE: The list returned from this procedure is intended to be a
    #       complete list of the environment variable names that are
    #       used by Harpy (including its SDK), Badge, or Kapok -AND-
    #       originate from the Base Directory Specification released
    #       by the X Desktop Group.
    #
    return [list \
        XDG_CLOUD_DIRS \
        XDG_CLOUD_HOME \
        XDG_CONFIG_DIRS \
        XDG_CONFIG_HOME \
        XDG_DATA_DIRS \
        XDG_DATA_HOME \
        XDG_KEYRING_DIRS \
        XDG_KEYRING_HOME \
        XDG_RUNTIME_DIR \
        XDG_SHELLS_DIR \
        XDG_STARTUP_DIRS \
        XDG_STARTUP_HOME]
  }

  proc saveXdgEnvironment {} {
    # <help>
    # This procedure captures the current values of the XDG Base Directory
    # Specification environment variables into the caller's savedEnv array,
    # so they can be restored later (typically via [restoreXdgEnvironment])
    # after a test temporarily mutates them.
    #
    # How it works: it aliases the caller's savedEnv array via upvar, asks
    # [getXdgEnvironmentVariableNames] for the canonical XDG_* variable
    # names, and forwards both to [saveEnvironmentVariables], which records
    # the present-or-absent status and value of each name.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; the side effect is that savedEnv in the
    #   caller now holds a snapshot of the XDG_* environment variables.
    # </help>

    upvar 1 savedEnv savedEnv

    saveEnvironmentVariables \
        [getXdgEnvironmentVariableNames] savedEnv
  }

  proc restoreXdgEnvironment {} {
    # <help>
    # This procedure restores the XDG Base Directory Specification
    # environment variables from a previously captured snapshot in the
    # caller's savedEnv array.  It is the inverse of [saveXdgEnvironment]
    # and is meant to undo any changes the test made to the XDG_* variables
    # so that the surrounding environment is left as it was found.
    #
    # How it works: it aliases the caller's savedEnv array via upvar, asks
    # [getXdgEnvironmentVariableNames] for the list of XDG_* variable
    # names, and forwards both to [restoreEnvironmentVariables], which
    # reinstates each name to its prior value or unsets it when it did not
    # previously exist.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; the side effect is the restoration of
    #   the XDG_* environment variables in the global env array.
    # </help>

    upvar 1 savedEnv savedEnv

    restoreEnvironmentVariables \
        [getXdgEnvironmentVariableNames] savedEnv
  }

  proc resetXdgEnvironment {} {
    # <help>
    # This procedure removes all of the XDG Base Directory Specification
    # environment variables from the global env array, so the test
    # interpreter runs without any inherited XDG configuration that could
    # influence Harpy, Badge, or Kapok's directory selection.
    #
    # How it works: it makes the global env array visible, asks
    # [getXdgEnvironmentVariableNames] for the canonical list of XDG_*
    # names (XDG_CLOUD_DIRS, XDG_CLOUD_HOME, XDG_CONFIG_DIRS,
    # XDG_CONFIG_HOME, XDG_DATA_DIRS, XDG_DATA_HOME, XDG_KEYRING_DIRS,
    # XDG_KEYRING_HOME, XDG_RUNTIME_DIR, XDG_SHELLS_DIR, XDG_STARTUP_DIRS,
    # XDG_STARTUP_HOME), and issues [unset -nocomplain env($name)] for
    # each so missing names are tolerated.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; side effect is that the listed XDG_*
    #   elements of the env array no longer exist.
    # </help>

    global env

    foreach name [getXdgEnvironmentVariableNames] {
      unset -nocomplain env($name)
    }
  }

  proc cleanupSecretModeFiles {} {
    # <help>
    # This procedure clears the cached global variables holding the script
    # paths used to toggle Harpy's secret mode, so that the next call to
    # [enableSecretMode] will rediscover the files.  It is useful when the
    # surrounding test environment, especially ::dataPath, has changed and
    # the previously located paths are no longer valid.
    #
    # How it works: it iterates the fixed list of four secret-mode global
    # names (enable, disable, and their import b64sig companions) and
    # issues [unset -nocomplain] on each, using [appendArgs] to build the
    # fully qualified :: name.  Outside Eagle the body is skipped.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; side effects are the removal of the
    #   listed global variables.
    # </help>

    if {[isEagle]} then {
      foreach varName [list \
          enableSecretModeFile enableSecretModeImportFile \
          disableSecretModeFile disableSecretModeImportFile] {
        unset -nocomplain [appendArgs :: $varName]
      }
    }
  }

  proc setupSecretModeFiles { path } {
    # <help>
    # This procedure locates and records the paths to the script files used
    # to enable or disable Harpy's secret mode, populating the matching
    # ::enableSecretModeFile, ::enableSecretModeImportFile,
    # ::disableSecretModeFile and ::disableSecretModeImportFile globals
    # when they are not already set.  It is invoked by [enableSecretMode]
    # before the first toggle.
    #
    # How it works: it iterates a hard-coded list pairing each file name
    # (enable_secret_mode.eagle, disable_secret_mode.eagle, and their
    # .b64sig import variants) with a global variable name.  For each
    # pair, if the global is missing, it loads the Eagle.Test package and
    # calls [recursiveGetFiles] to search the supplied path tree.  When at
    # least one match is found, the first match is normalized and stored
    # in the global.
    #
    # Arguments:
    #   path -- The root directory to search recursively for the script
    #           files; usually ::dataPath or the script base directory.
    #
    # Results:
    #   Returns the empty string; side effects populate the four ::
    #   globals when matching files are found.  Does nothing outside Eagle.
    # </help>

    if {[isEagle]} then {
      foreach {fileNameOnly fileVarName} [list \
          enable_secret_mode.eagle \
              enableSecretModeFile \
          enable_secret_mode.eagle.b64sig \
              enableSecretModeImportFile \
          disable_secret_mode.eagle \
              disableSecretModeFile \
          disable_secret_mode.eagle.b64sig \
              disableSecretModeImportFile] {
        set varName [appendArgs :: $fileVarName]

        if {![info exists $varName]} then {
          package require Eagle.Test

          set fileNames [recursiveGetFiles $path $fileNameOnly]

          if {[llength $fileNames] > 0} then {
            set $varName [file normalize [lindex $fileNames 0]]
          }
        }
      }
    }
  }

  proc enableSecretMode { enable {immediate true} } {
    # <help>
    # This procedure turns Harpy's secret mode on or off for the
    # interpreter by sourcing the prepared enable_secret_mode.eagle or
    # disable_secret_mode.eagle script.  Secret mode hides or scrubs
    # sensitive material in test output so that test logs can be safely
    # shared; it is toggled here so individual tests can opt in to that
    # behavior.
    #
    # How it works: it lazily calls [setupSecretModeFiles] to find the
    # four script files (enable, disable, and their b64sig import
    # companions) when any of the corresponding global path variables are
    # missing.  When enable is non-empty, it selects the enable or disable
    # file accordingly, then either sources it via [ksource -withcommands
    # -useplugin -usecontext] under uplevel 1 (when immediate is true) or
    # appends the file name to ConfigurationFileNames for a later pass.
    #
    # Tricky details: immediate sourcing requires the [ksource] command;
    # an error is raised when it is missing.  The selected file must exist
    # on disk.  Outside Eagle the procedure errors immediately, because
    # secret mode is an Eagle-only concept.
    #
    # Arguments:
    #   enable    -- True to enable secret mode, false to disable it; an
    #                empty string is a no-op (only the lazy setup of file
    #                paths is performed).
    #   immediate -- When true (default), the chosen script is sourced via
    #                [ksource] right away; when false, the file is queued
    #                via ConfigurationFileNames.
    #
    # Results:
    #   When immediate is true, returns the result of [ksource]; otherwise
    #   returns the empty string after appending the file name to the
    #   configuration list.
    # </help>

    if {[isEagle]} then {
      if {![info exists ::enableSecretModeFile] || \
          ![info exists ::enableSecretModeImportFile] || \
          ![info exists ::disableSecretModeFile] || \
          ![info exists ::disableSecretModeImportFile]} then {
        if {[info exists ::dataPath]} then {
          set path $::dataPath
        } else {
          set path [info base]
        }

        setupSecretModeFiles $path
      }

      if {[string length $enable] > 0} then {
        if {$immediate && \
            [llength [info commands ksource]] == 0} then {
          error "cannot change secret-mode, missing \[ksource\] command"
        }

        if {$enable} then {
          if {[info exists ::enableSecretModeFile]} then {
            set fileName $::enableSecretModeFile
          } else {
            error "cannot enable secret-mode, file name missing"
          }
        } else {
          if {[info exists ::disableSecretModeFile]} then {
            set fileName $::disableSecretModeFile
          } else {
            error "cannot disable secret-mode, file name missing"
          }
        }

        if {![file exists $fileName]} then {
          error [appendArgs \
              "cannot change secret-mode, file \"" $fileName \
              "\" missing"]
        }

        if {$immediate} then {
          return [uplevel 1 [list ksource \
              -withcommands -useplugin -usecontext -- $fileName]]
        } else {
          lappend ::env(ConfigurationFileNames) $fileName
        }
      }
    } else {
      error "cannot change secret-mode, unsupported in native Tcl"
    }
  }

  proc cleanupDemoModeFiles {} {
    # <help>
    # This procedure clears the cached global variables holding the script
    # paths used to toggle Harpy's demo mode, so that the next call to
    # [enableDemoMode] will rediscover the files.  It is useful when the
    # surrounding test environment, especially ::dataPath, has changed and
    # the previously located paths are no longer valid.
    #
    # How it works: it iterates the fixed list of four demo-mode global
    # names (enable, disable, and their import b64sig companions) and
    # issues [unset -nocomplain] on each, using [appendArgs] to build the
    # fully qualified :: name.  Outside Eagle the body is skipped.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; side effects are the removal of the
    #   listed global variables.
    # </help>

    if {[isEagle]} then {
      foreach varName [list \
          enableDemoModeFile enableDemoModeImportFile \
          disableDemoModeFile disableDemoModeImportFile] {
        unset -nocomplain [appendArgs :: $varName]
      }
    }
  }

  proc setupDemoModeFiles { path } {
    # <help>
    # This procedure locates and records the paths to the script files used
    # to enable or disable Harpy's demo mode, populating the matching
    # ::enableDemoModeFile, ::enableDemoModeImportFile,
    # ::disableDemoModeFile and ::disableDemoModeImportFile globals when
    # they are not already set.  It is invoked by [enableDemoMode] before
    # the first toggle.
    #
    # How it works: it iterates a hard-coded list pairing each file name
    # (enable_demo_mode.eagle, disable_demo_mode.eagle, and their .b64sig
    # import variants) with a global variable name.  For each pair, if the
    # global is missing, it loads the Eagle.Test package and calls
    # [recursiveGetFiles] to search the supplied path tree.  When at least
    # one match is found, the first match is normalized and stored in the
    # global.
    #
    # Arguments:
    #   path -- The root directory to search recursively for the script
    #           files; usually ::dataPath or the script base directory.
    #
    # Results:
    #   Returns the empty string; side effects populate the four ::
    #   globals when matching files are found.  Does nothing outside Eagle.
    # </help>

    if {[isEagle]} then {
      foreach {fileNameOnly fileVarName} [list \
          enable_demo_mode.eagle \
              enableDemoModeFile \
          enable_demo_mode.eagle.b64sig \
              enableDemoModeImportFile \
          disable_demo_mode.eagle \
              disableDemoModeFile \
          disable_demo_mode.eagle.b64sig \
              disableDemoModeImportFile] {
        set varName [appendArgs :: $fileVarName]

        if {![info exists $varName]} then {
          package require Eagle.Test

          set fileNames [recursiveGetFiles $path $fileNameOnly]

          if {[llength $fileNames] > 0} then {
            set $varName [file normalize [lindex $fileNames 0]]
          }
        }
      }
    }
  }

  proc enableDemoMode { enable {immediate true} } {
    # <help>
    # This procedure turns Harpy's demo mode on or off for the interpreter
    # by sourcing the prepared enable_demo_mode.eagle or
    # disable_demo_mode.eagle script.  Demo mode reconfigures Harpy to use
    # demonstration-style behavior (typically affecting licensing and
    # presentation) and is toggled here so tests can exercise both regular
    # and demo paths.
    #
    # How it works: it lazily calls [setupDemoModeFiles] to find the four
    # script files (enable, disable, and their b64sig import companions)
    # when any of the corresponding global path variables are missing.
    # When enable is non-empty, it picks the enable or disable file
    # accordingly, then either sources it via [ksource -withcommands
    # -useplugin -usecontext] under uplevel 1 (when immediate is true) or
    # appends the file name to ConfigurationFileNames for a later pass.
    #
    # Tricky details: immediate sourcing requires the [ksource] command;
    # an error is raised when it is missing.  The selected file must exist
    # on disk.  Outside Eagle the procedure errors immediately because demo
    # mode is an Eagle-only concept.
    #
    # Arguments:
    #   enable    -- True to enable demo mode, false to disable it; an
    #                empty string is a no-op (only the lazy setup of file
    #                paths is performed).
    #   immediate -- When true (default), the chosen script is sourced via
    #                [ksource] right away; when false, the file is queued
    #                via ConfigurationFileNames.
    #
    # Results:
    #   When immediate is true, returns the result of [ksource]; otherwise
    #   returns the empty string after appending the file name to the
    #   configuration list.
    # </help>

    if {[isEagle]} then {
      if {![info exists ::enableDemoModeFile] || \
          ![info exists ::enableDemoModeImportFile] || \
          ![info exists ::disableDemoModeFile] || \
          ![info exists ::disableDemoModeImportFile]} then {
        if {[info exists ::dataPath]} then {
          set path $::dataPath
        } else {
          set path [info base]
        }

        setupDemoModeFiles $path
      }

      if {[string length $enable] > 0} then {
        if {$immediate && \
            [llength [info commands ksource]] == 0} then {
          error "cannot change demo-mode, missing \[ksource\] command"
        }

        if {$enable} then {
          if {[info exists ::enableDemoModeFile]} then {
            set fileName $::enableDemoModeFile
          } else {
            error "cannot enable demo-mode, file name missing"
          }
        } else {
          if {[info exists ::disableDemoModeFile]} then {
            set fileName $::disableDemoModeFile
          } else {
            error "cannot disable demo-mode, file name missing"
          }
        }

        if {![file exists $fileName]} then {
          error [appendArgs \
              "cannot change demo-mode, file \"" $fileName \
              "\" missing"]
        }

        if {$immediate} then {
          return [uplevel 1 [list ksource \
              -withcommands -useplugin -usecontext -- $fileName]]
        } else {
          lappend ::env(ConfigurationFileNames) $fileName
        }
      }
    } else {
      error "cannot change demo-mode, unsupported in native Tcl"
    }
  }

  proc cleanupTestModeFiles {} {
    # <help>
    # This procedure clears the cached global variables holding the script
    # paths used to toggle Harpy's test mode, so that the next call to
    # [enableTestMode] will rediscover the files.  It is useful when the
    # surrounding test environment, especially ::dataPath, has changed and
    # the previously located paths are no longer valid.
    #
    # How it works: it iterates the fixed list of four test-mode global
    # names (enable, disable, and their import b64sig companions) and
    # issues [unset -nocomplain] on each, using [appendArgs] to build the
    # fully qualified :: name.  Outside Eagle the body is skipped.
    #
    # Arguments:
    #   None.
    #
    # Results:
    #   Returns the empty string; side effects are the removal of the
    #   listed global variables.
    # </help>

    if {[isEagle]} then {
      foreach varName [list \
          enableTestModeFile enableTestModeImportFile \
          disableTestModeFile disableTestModeImportFile] {
        unset -nocomplain [appendArgs :: $varName]
      }
    }
  }

  proc setupTestModeFiles { path } {
    # <help>
    # This procedure locates and records the paths to the script files used
    # to enable or disable Harpy's test mode, populating the matching
    # ::enableTestModeFile, ::enableTestModeImportFile,
    # ::disableTestModeFile and ::disableTestModeImportFile globals when
    # they are not already set.  It is invoked by [enableTestMode] before
    # the first toggle.
    #
    # How it works: it iterates a hard-coded list pairing each file name
    # (enable_test_mode.eagle, disable_test_mode.eagle, and their .b64sig
    # import variants) with a global variable name.  For each pair, if the
    # global is missing, it loads the Eagle.Test package and calls
    # [recursiveGetFiles] to search the supplied path tree.  When at least
    # one match is found, the first match is normalized and stored in the
    # global.
    #
    # Arguments:
    #   path -- The root directory to search recursively for the script
    #           files; usually ::dataPath or the script base directory.
    #
    # Results:
    #   Returns the empty string; side effects populate the four ::
    #   globals when matching files are found.  Does nothing outside Eagle.
    # </help>

    if {[isEagle]} then {
      foreach {fileNameOnly fileVarName} [list \
          enable_test_mode.eagle \
              enableTestModeFile \
          enable_test_mode.eagle.b64sig \
              enableTestModeImportFile \
          disable_test_mode.eagle \
              disableTestModeFile \
          disable_test_mode.eagle.b64sig \
              disableTestModeImportFile] {
        set varName [appendArgs :: $fileVarName]

        if {![info exists $varName]} then {
          package require Eagle.Test

          set fileNames [recursiveGetFiles $path $fileNameOnly]

          if {[llength $fileNames] > 0} then {
            set $varName [file normalize [lindex $fileNames 0]]
          }
        }
      }
    }
  }

  proc enableTestMode { enable {immediate true} } {
    # <help>
    # This procedure turns Harpy's test mode on or off for the interpreter
    # by sourcing the prepared enable_test_mode.eagle or
    # disable_test_mode.eagle script.  Test mode adjusts Harpy's behavior to
    # accommodate test runs (for example by relaxing certain checks or
    # enabling test-only hooks) and is toggled here so individual tests can
    # opt in to or out of that mode.
    #
    # How it works: it lazily calls [setupTestModeFiles] to find the four
    # script files (enable, disable, and their b64sig import companions)
    # when any of the corresponding global path variables are missing.
    # When enable is non-empty it selects the enable file or the disable
    # file accordingly, then either sources it via [ksource -withcommands
    # -useplugin -usecontext] under uplevel 1 (when immediate is true) or
    # appends the file name to ConfigurationFileNames in the env array for
    # later processing (when immediate is false).
    #
    # Tricky details: immediate sourcing requires the [ksource] command to
    # be available; an error is raised if it is missing.  The selected file
    # must exist on disk.  Outside Eagle the procedure errors immediately,
    # because test mode is an Eagle-only concept.
    #
    # Arguments:
    #   enable    -- True to enable test mode, false to disable it; an
    #                empty string is a no-op (only the lazy setup of file
    #                paths is performed).
    #   immediate -- When true (default), the chosen script is sourced via
    #                [ksource] right away; when false, the file is queued
    #                via ConfigurationFileNames.
    #
    # Results:
    #   When immediate is true, returns the result of [ksource]; otherwise
    #   returns the empty string after appending the file name to the
    #   configuration list.
    # </help>

    if {[isEagle]} then {
      if {![info exists ::enableTestModeFile] || \
          ![info exists ::enableTestModeImportFile] || \
          ![info exists ::disableTestModeFile] || \
          ![info exists ::disableTestModeImportFile]} then {
        if {[info exists ::dataPath]} then {
          set path $::dataPath
        } else {
          set path [info base]
        }

        setupTestModeFiles $path
      }

      if {[string length $enable] > 0} then {
        if {$immediate && \
            [llength [info commands ksource]] == 0} then {
          error "cannot change test-mode, missing \[ksource\] command"
        }

        if {$enable} then {
          if {[info exists ::enableTestModeFile]} then {
            set fileName $::enableTestModeFile
          } else {
            error "cannot enable test-mode, file name missing"
          }
        } else {
          if {[info exists ::disableTestModeFile]} then {
            set fileName $::disableTestModeFile
          } else {
            error "cannot disable test-mode, file name missing"
          }
        }

        if {![file exists $fileName]} then {
          error [appendArgs \
              "cannot change test-mode, file \"" $fileName \
              "\" missing"]
        }

        if {$immediate} then {
          return [uplevel 1 [list ksource \
              -withcommands -useplugin -usecontext -- $fileName]]
        } else {
          lappend ::env(ConfigurationFileNames) $fileName
        }
      }
    } else {
      error "cannot change test-mode, unsupported in native Tcl"
    }
  }

  proc cleanupFailSafeModeFiles {} {
    # <help>
    # This procedure clears the cached global variables holding the script
    # paths used to toggle Harpy's fail-safe mode, so that the next call to
    # [enableFailSafeMode] will rediscover the files.  It is useful when the
    # surrounding test environment, especially ::dataPath, has changed and
