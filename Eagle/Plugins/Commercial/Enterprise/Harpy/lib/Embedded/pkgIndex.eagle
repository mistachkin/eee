###############################################################################

if {![package vsatisfies [package provide Tcl] 8.4]} then {return}
if {![package vsatisfies [package provide Eagle] 1.0]} then {return}

###############################################################################

if {[string length [package ifneeded Licensing.Enterprise 1.0]] == 0} then {
  if {[info exists tag]} then {
    package ifneeded Licensing.Enterprise 1.0 \
        [list apply [list [list dir tag args] {
      load -publickeytoken $tag \
          -maybeverifiedonly -maybetrustedonly -- \
          [file join $dir Harpy.dll] Licensing.Enterprise
    }] $dir $tag] +Locked
  } else {
    package ifneeded Licensing.Enterprise 1.0 \
        [list apply [list [list dir args] {
      load -maybeverifiedonly -maybetrustedonly -- \
          [file join $dir Harpy.dll] Licensing.Enterprise
    }] $dir] +Locked
  }
}

###############################################################################

if {[string length [package ifneeded Licensing.Standard 1.0]] == 0} then {
  if {[info exists tag]} then {
    package ifneeded Licensing.Standard 1.0 \
        [list apply [list [list dir tag args] {
      load -publickeytoken $tag \
          -maybeverifiedonly -maybetrustedonly -- \
          [file join $dir Harpy.dll] Licensing.Standard
    }] $dir $tag] +Locked
  } else {
    package ifneeded Licensing.Standard 1.0 \
        [list apply [list [list dir args] {
      load -maybeverifiedonly -maybetrustedonly -- \
          [file join $dir Harpy.dll] Licensing.Standard
    }] $dir] +Locked
  }
}

###############################################################################

if {[string length [package ifneeded Licensing.Core 1.0]] == 0} then {
  #
  # NOTE: This package is shared with the "Harpy.Basic.dll" assembly
  #       from the "Basic" SKU.
  #
  if {[info exists tag]} then {
    package ifneeded Licensing.Core 1.0 \
        [list apply [list [list dir tag args] {
      foreach fileNameOnly [list \
          Harpy.dll Harpy.Basic.dll Harpy.Limited.dll] {
        set fileName [file join $dir $fileNameOnly]

        if {[file exists $fileName]} then {
          return [load -publickeytoken $tag \
              -maybeverifiedonly -maybetrustedonly -- \
              $fileName Licensing.Core]
        }
      }
    }] $dir $tag] +Locked
  } else {
    package ifneeded Licensing.Core 1.0 \
        [list apply [list [list dir args] {
      foreach fileNameOnly [list \
          Harpy.dll Harpy.Basic.dll Harpy.Limited.dll] {
        set fileName [file join $dir $fileNameOnly]

        if {[file exists $fileName]} then {
          return [load \
              -maybeverifiedonly -maybetrustedonly -- \
              $fileName Licensing.Core]
        }
      }
    }] $dir] +Locked
  }
}

###############################################################################

if {[string length [package ifneeded Security.Core 1.0]] == 0} then {
  #
  # NOTE: This package is shared with the "Harpy.Basic.dll" assembly
  #       from the "Basic" SKU.
  #
  if {[info exists tag]} then {
    package ifneeded Security.Core 1.0 \
        [list apply [list [list dir tag args] {
      foreach fileNameOnly [list \
          Harpy.dll Harpy.Basic.dll Harpy.Limited.dll] {
        set fileName [file join $dir $fileNameOnly]

        if {[file exists $fileName]} then {
          return [load -publickeytoken $tag \
              -maybeverifiedonly -maybetrustedonly -- \
              $fileName Security.Core]
        }
      }
    }] $dir $tag] +Locked
  } else {
    package ifneeded Security.Core 1.0 \
        [list apply [list [list dir args] {
      foreach fileNameOnly [list \
          Harpy.dll Harpy.Basic.dll Harpy.Limited.dll] {
        set fileName [file join $dir $fileNameOnly]

        if {[file exists $fileName]} then {
          return [load \
              -maybeverifiedonly -maybetrustedonly -- \
              $fileName Security.Core]
        }
      }
    }] $dir] +Locked
  }
}

###############################################################################

if {[string length [package ifneeded Harpy.Test 1.0]] == 0} then {
  package ifneeded Harpy.Test 1.0 [list apply [list [list dir args] {
    uplevel 1 [list source -library true -- [file join $dir test.eagle]]
  }] $dir] +Locked
}
