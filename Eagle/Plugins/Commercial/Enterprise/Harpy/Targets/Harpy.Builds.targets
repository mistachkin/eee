<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
  ******************************************************************************
  **                          Load Per-User Settings                          **
  ******************************************************************************
  -->

  <!--
      NOTE: If the per-user settings file exists, import it now.  The contained
            settings, if any, will override the default ones provided below.
  -->
  <Import Condition="'$(HarpyDir)' != '' And
                     !HasTrailingSlash('$(HarpyDir)') And
                     Exists('$(HarpyDir)\Targets\Harpy.Builds.targets.user')"
          Project="$(HarpyDir)\Targets\Harpy.Builds.targets.user" />

  <!--
  ******************************************************************************
  **                            Harpy Build Types                             **
  ******************************************************************************
  -->

  <!--
      NOTE: This is an "official release" build configuration.  This includes
            the certificate and key pair management commands, policies for the
            evaluation of signed scripts, and everything else.  As always, the
            resulting assembly is obfuscated.

      TODO: If any of the names for this build type change, make sure to update
            the "Harpy.targets" file as well.
  -->
  <PropertyGroup Condition="'$(AssemblyName)' == 'Harpy' And
                            ('$(HarpyBuildType)' == 'Default' Or
                             '$(HarpyBuildType)' == 'DefaultSdk' Or
                             '$(HarpyBuildType)' == 'Enterprise' Or
                             '$(HarpyBuildType)' == 'EnterpriseSdk' Or
                             '$(HarpyBuildType)' == 'Standard' Or
                             '$(HarpyBuildType)' == 'StandardSdk' Or
                             '$(HarpyBuildType)' == 'Full' Or
                             '$(HarpyBuildType)' == 'FullSdk')">
    <Obfuscate3 Condition="'$(Obfuscate3)' == ''">true</Obfuscate3>
    <DemoKeyPairs Condition="'$(DemoKeyPairs)' == ''">true</DemoKeyPairs>
    <ExtraDiagnostics Condition="'$(ExtraDiagnostics)' == ''">true</ExtraDiagnostics>
  </PropertyGroup>

  <!--
  ******************************************************************************
  -->

  <!--
      NOTE: This is an "official release" build configuration.  This includes
            the certificate and key pair management commands, policies for the
            evaluation of signed scripts, and everything else.  It disables
            obfuscation because that breaks things on Mono.

      TODO: If any of the names for this build type change, make sure to update
            the "Harpy.targets" file as well.
  -->
  <PropertyGroup Condition="'$(AssemblyName)' == 'Harpy' And
                            ('$(HarpyBuildType)' == 'MonoDefault' Or
                             '$(HarpyBuildType)' == 'MonoEnterprise' Or
                             '$(HarpyBuildType)' == 'MonoStandard' Or
                             '$(HarpyBuildType)' == 'MonoFull')">
    <Obfuscate3 Condition="'$(Obfuscate3)' == ''">false</Obfuscate3>
    <DemoKeyPairs Condition="'$(DemoKeyPairs)' == ''">true</DemoKeyPairs>
    <ExtraDiagnostics Condition="'$(ExtraDiagnostics)' == ''">true</ExtraDiagnostics>
  </PropertyGroup>

  <!--
  ******************************************************************************
  -->

  <!--
      NOTE: This is an "official release" build configuration.  It excludes the
            certificate and key pair management commands.  However, it includes
            the policies for the evaluation of signed scripts.  As always, the
            resulting assembly is obfuscated.
  -->
  <PropertyGroup Condition="'$(AssemblyName)' == 'Harpy' And
                            '$(HarpyBuildType)' == 'Basic'">
    <AssemblyName>$(AssemblyName).Basic</AssemblyName>
    <Obfuscate3 Condition="'$(Obfuscate3)' == ''">true</Obfuscate3>
    <DemoKeyPairs Condition="'$(DemoKeyPairs)' == ''">true</DemoKeyPairs>
    <DemoEdition Condition="'$(DemoEdition)' == ''">true</DemoEdition>
    <ExtraDiagnostics Condition="'$(ExtraDiagnostics)' == ''">true</ExtraDiagnostics>
    <PluginCommands Condition="'$(PluginCommands)' == ''">false</PluginCommands>
  </PropertyGroup>

  <!--
  ******************************************************************************
  -->

  <!--
      NOTE: This is an "official release" build configuration.  It excludes the
            certificate and key pair management commands.  However, it includes
            the policies for the evaluation of signed scripts.  It disables
            obfuscation because that breaks things on Mono.
  -->
  <PropertyGroup Condition="'$(AssemblyName)' == 'Harpy' And
                            '$(HarpyBuildType)' == 'MonoBasic'">
    <AssemblyName>$(AssemblyName).Basic</AssemblyName>
    <Obfuscate3 Condition="'$(Obfuscate3)' == ''">false</Obfuscate3>
    <DemoKeyPairs Condition="'$(DemoKeyPairs)' == ''">true</DemoKeyPairs>
    <DemoEdition Condition="'$(DemoEdition)' == ''">true</DemoEdition>
    <ExtraDiagnostics Condition="'$(ExtraDiagnostics)' == ''">true</ExtraDiagnostics>
    <PluginCommands Condition="'$(PluginCommands)' == ''">false</PluginCommands>
  </PropertyGroup>

  <!--
  ******************************************************************************
  -->

  <!--
      NOTE: This is an "official release" build configuration.  It excludes the
            certificate and key pair management commands.  However, it includes
            the policies for the evaluation of signed scripts.  As always, the
            resulting assembly is obfuscated.
  -->
  <PropertyGroup Condition="'$(AssemblyName)' == 'Harpy' And
                            '$(HarpyBuildType)' == 'Limited'">
    <AssemblyName>$(AssemblyName).Limited</AssemblyName>
    <Obfuscate3 Condition="'$(Obfuscate3)' == ''">true</Obfuscate3>
    <DemoKeyPairs Condition="'$(DemoKeyPairs)' == ''">true</DemoKeyPairs>
    <LimitedEdition Condition="'$(LimitedEdition)' == ''">true</LimitedEdition>
    <PluginCommands Condition="'$(PluginCommands)' == ''">false</PluginCommands>
  </PropertyGroup>

  <!--
  ******************************************************************************
  -->

  <!--
      NOTE: This is an "official release" build configuration.  It excludes the
            certificate and key pair management commands.  It also excludes the
            policies for the evaluation of signed scripts.  As always, the
            resulting assembly is obfuscated.  This build configuration is only
            designed for applications that directly add an assembly references
            to it and make calls into the ILicenseManager interface, etc.

      TODO: If any of the names for this build type change, make sure to update
            the "Harpy.targets" file as well.
  -->
  <PropertyGroup Condition="'$(AssemblyName)' == 'Harpy' And
                            '$(HarpyBuildType)' == 'Sdk'">
    <AssemblyName>$(AssemblyName).Sdk</AssemblyName>
    <Obfuscate3 Condition="'$(Obfuscate3)' == ''">true</Obfuscate3>
    <DemoKeyPairs Condition="'$(DemoKeyPairs)' == ''">false</DemoKeyPairs>
    <CertificatePlugin Condition="'$(CertificatePlugin)' == ''">false</CertificatePlugin>
    <CertificatePolicy Condition="'$(CertificatePolicy)' == ''">false</CertificatePolicy>
    <PluginCommands Condition="'$(PluginCommands)' == ''">false</PluginCommands>
  </PropertyGroup>
</Project>
