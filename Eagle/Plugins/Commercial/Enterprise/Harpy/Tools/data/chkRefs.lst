#
# NOTE: If it exists, attempt to include the official assembly reference
#       manifest for Eagle.
#
# HACK: If necessary, the "::eagle_platform(patchLevel)" array element value
#       can be overridden via "-preInitialize" command line argument so that
#       an arbitrary build of Eagle can be used to evaluate this script file.
#
if {[info exists ::env(EAGLE)] && [file exists \
    [file join $::env(EAGLE) Library Tools data chkRefs.lst]]} then {
  source [file join $::env(EAGLE) Library Tools data chkRefs.lst]
}

