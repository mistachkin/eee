#
# BUGBUG: For now, "mscorlib" version 2.0 ends up in the manifest of the
#         obfuscated assembly due to a bug in Crypto Obfuscator For .Net
#         v2020.  Seemingly, the root cause is the AssemblyInfoAttribute
#         emitted into the obfuscated assembly with an empty string as
#         its only constructor parameter.  There seems to be no way to
#         prevent this as of build 210317.  This means that the assembly
#         will probably not load properly unless the .NET Framework 2.0
#         is installed on the machine.
#
set references(ReleaseNetStandard20/lib/Badge1.0/Badge.dll) {
  {netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51}
  {Eagle, Version=$::eagle_platform(patchLevel), Culture=neutral, PublicKeyToken=29c6297630be05eb}
}

#
# BUGBUG: For now, "mscorlib" version 2.0 ends up in the manifest of the
#         obfuscated assembly due to a bug in Crypto Obfuscator For .Net
#         v2020.  Seemingly, the root cause is the AssemblyInfoAttribute
#         emitted into the obfuscated assembly with an empty string as
#         its only constructor parameter.  There seems to be no way to
#         prevent this as of build 210317.  This means that the assembly
#         will probably not load properly unless the .NET Framework 2.0
#         is installed on the machine.
#
set references(ReleaseNetStandard21/lib/Badge1.0/Badge.dll) {
  {netstandard, Version=2.1.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51}
  {Eagle, Version=$::eagle_platform(patchLevel), Culture=neutral, PublicKeyToken=29c6297630be05eb}
}

