#################################### Badge ####################################
###############################################################################

set references(ReleaseNetFx20/lib/Badge1.0/Badge.dll) {
  {mscorlib, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089}
  {Eagle, Version=$::eagle_platform(patchLevel), Culture=neutral, PublicKeyToken=29c6297630be05eb}
  {System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089}
