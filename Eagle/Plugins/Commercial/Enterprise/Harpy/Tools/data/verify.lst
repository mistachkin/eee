###############################################################################
#
# NOTE: This file contains official lists of all files that must be present in
#       the various archives generated during the Eagle release process.
#
# NOTE: This file MUST be updated whenever a file needs to be added, renamed,
#       or removed from a source, binary, or setup release archive; otherwise,
#       the entire release process will probably fail.  This file will be read
#       and evaluated by the Release Archive Verification Tool via the [source]
#       command during the final phases of the release process.  Please see the
#       "verify.eagle" file for details.
#
###############################################################################
#
# NOTE: If it exists, attempt to include the official release archive manifest
#       for Eagle.
#
if {[info exists ::env(EAGLE)] && [file exists \
    [file join $::env(EAGLE) Library Tools data verify.lst]]} then {
  source [file join $::env(EAGLE) Library Tools data verify.lst]
}

###############################################################################
#
# NOTE: This is the list of all NuGet metadata files that should be present in
#       all Eagle NuGet packages.
#
