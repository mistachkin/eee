###############################################################################

package require Licensing.Enterprise

if {[llength $argv] == 1} then {
  set scriptFileName [lindex $argv 0]
} else {
  set scriptFileName [file join \
      $::env(EAGLE) Plugins Commercial Enterprise Harpy \
      Configurations Harpy.v1.eagle]
}

set signatureFileName [appendArgs $scriptFileName .b64sig]

###############################################################################

proc getFileHeader { fileNameOnly publicKeyToken noHeader } {
  # <help>
  # This procedure returns the standard Eagle Enterprise file header comment
  # block that is prepended to the generated ".b64sig" signature file.  It
  # exists so the produced signature carries the same copyright, RCS, "do not
  # edit", and redistribution-prohibited warnings as the rest of the Harpy
  # configurations.
  #
  # How it works: when the noHeader flag is true it returns the empty string
  # immediately, suppressing all header output.  Otherwise it takes the canonic
  # header template (the brace-quoted block of comment lines defined inline),
  # substitutes the supplied file name and public key token into the
  # placeholder spans, normalizes line feeds to carriage-return-line-feed
  # pairs, trims the leading whitespace, and returns the result.
  #
  # Arguments:
  #   fileNameOnly    -- The bare (no directory) file name of the signature
  #                      file; it is displayed on the header's identification
  #                      line.
  #   publicKeyToken  -- The strong-name public key token of the key used to
  #                      sign; it is displayed alongside the file name.
  #   noHeader        -- When true, suppresses header generation entirely.
  #
  # Results:
  #   Returns the formatted header comment block (with CRLF line endings), or
  #   the empty string when the header was suppressed.
  # </help>

  if {$noHeader} then {return ""}

  return [string trimleft \
      [string map [list <fileNameOnly> $fileNameOnly \
                        <publicKeyToken> $publicKeyToken \n \r\n] {
###############################################################################
#
# <fileNameOnly> -- <publicKeyToken>
#
# Extensible Adaptable Generalized Logic Engine (Eagle)
# Enterprise Edition Script Signature File (Harpy)
#
# Copyright (c) 2007-2012 by Joe Mistachkin.  All rights reserved.
#
# See the file "license.terms" for information on usage and redistribution of
# this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
# RCS: @(#) $Id: $
#
###############################################################################
#
# WARNING: PLEASE DO NOT EDIT THIS FILE.  THE ASSOCIATED SOFTWARE MAY NOT WORK
#          PROPERLY IF THIS FILE IS ALTERED.
#
# WARNING: THIS FILE IS NOT LICENSED FOR REDISTRIBUTION.  IT IS A VIOLATION OF
#          THE LICENSE AGREEMENT TO COPY AND/OR USE THIS FILE FROM ANY MACHINE
#          THAT IS NOT DIRECTLY OWNED BY THE LICENSED ENTITY -AND- USED SOLELY
#          FOR THE PURPOSE OF SOFTWARE DEVELOPMENT.
#
###############################################################################

}]]
}

###############################################################################

if {1} then {
  if {[info exists privateKeyFileName]} then {
    set publicKeyToken [keypair token $privateKeyFileName]
    set privateKey [keypair open -public -private $privateKeyFileName]
  } else {
    set publicKeyToken [keypair token \
        $::env(EagleEnterpriseTrustRootPrivateKey)]

    set privateKey [keypair open \
        -public -private $::env(EagleEnterpriseTrustRootPrivateKey)]
  }

  set data [object invoke \
      -create System.IO.File ReadAllBytes $scriptFileName]

  set signature [certificate signhash -create $privateKey $data]

  set signatureText [object invoke \
      Convert ToBase64String $signature InsertLineBreaks]

  object invoke System.IO.File WriteAllText $signatureFileName \
      [appendArgs $signatureText \r\n]
}

###############################################################################

if {1} then {
  if {[info exists publicKeyFileName]} then {
    set publicKey [keypair open -public $publicKeyFileName]
  } else {
    set publicKey [keypair open \
        -public $::env(EagleEnterpriseTrustRootPublicKey)]
  }

  set data [object invoke \
      -create System.IO.File ReadAllBytes $scriptFileName]

  set signature [object invoke -create Convert FromBase64String \
      [object invoke -create System.IO.File ReadAllText \
      $signatureFileName]]

  certificate verifyhash $publicKey $data $signature
}

###############################################################################

if {1} then {
  if {![info exists noHeader]} then {set noHeader false}

  regsub -all -line -- {^([^\s])} $signatureText {  \1} signatureText

  object invoke System.IO.File WriteAllText $signatureFileName \
      [appendArgs [getFileHeader [file tail $signatureFileName] \
      $publicKeyToken $noHeader] $signatureText \r\n]
}
