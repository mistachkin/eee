###############################################################################

package require Eagle.Library
package require Eagle.Test

runTestPrologue

package require Harpy.Test

###############################################################################

set package_path [file dirname [file normalize $path]]

###############################################################################

#
# NOTE: Check test constraints specific to tests in this file.
#
for {set index 0} {$index < 10} {incr index} {
  set fileName [file join $path data [appendArgs demo $index .eagle]]

  if {![haveConstraint [appendArgs file_ [file tail $fileName]]]} then {
    checkForFile $test_channel $fileName
  }
}

unset -nocomplain fileName index

#
# NOTE: We need to make sure the plugin is actually loaded prior to
#       querying the compile options.
#
if {[catch {package require Demo.Enterprise} error] == 0} then {
  #
  # HACK: Pre-check for the demo command now so that we can show the
  #       plugin compile options.
  #
  if {![haveConstraint command.demo]} then {
    checkForCommand $test_channel demo
  }

  #
  # NOTE: Now, check if the demo command is actually available.  If so,
  #       report the plugin compile options; otherwise, report that we
  #       cannot.
  #
  if {[haveConstraint command.demo]} then {
    tputs $test_channel [appendArgs \
        "---- plugin \"Demo.Enterprise\" compile options: " \
        [formatList [demo options]] \n]
  } else {
    tputs $test_channel [appendArgs \
        "---- demo command not available\n"]
  }
} else {
  tputs $test_channel [appendArgs \
      "---- failed to load plugin: " $error \n]
}

unset -nocomplain error
tputs $test_channel "---- checking for plugin isolation... "

if {[isEagle] && ![haveConstraint demo.isolated]} then {
  #
  # NOTE: We need to make sure the plugin is actually loaded prior to
  #       querying the plugin flags.
  #
  if {[catch {package present Demo.Enterprise}] == 0} then {
    #
    # NOTE: Query the plugin flags for the plugin and search them for the
    #       "Isolated" flag.  If this flag is present then the plugin has
    #       been loaded into an isolated AppDomain and some functionality
    #       will be unavailable.
    #
    if {[lsearch -exact -- \
        [getPluginFlags {^Demo\.Enterprise, }] Isolated] != -1} then {
      #
      # NOTE: This plugin is running in isolated mode.
      #
      addConstraint demo.isolated

      tputs $test_channel yes\n
    } else {
      tputs $test_channel no\n
    }
  } else {
    tputs $test_channel error\n
  }
} else {
  tputs $test_channel skipped\n
}

###############################################################################

set prependQuietMode [string map [list \n ""] \
    [list apply [list [list fileName directory arguments] {
  if {[string first -security $arguments] != -1} then {
    return -code return [appendArgs {-quiet true } $arguments]
  }
}]]]

###############################################################################

proc disableHarpyConfiguration { channel } {
  if {![info exists ::saved_no_harpy_configuration]} then {
    set ::saved_no_harpy_configuration \
        [info exists ::env(NoConfiguration)]
  }

  set ::env(NoConfiguration) 1

  tputs $channel [appendArgs \
      "---- disabled Harpy plugin configuration, previously: " \
      $::saved_no_harpy_configuration \n]
}

###############################################################################

proc restoreHarpyConfiguration { channel } {
  if {[info exists ::saved_no_harpy_configuration]} then {
    set was_no_harpy_configuration $::saved_no_harpy_configuration
    unset ::saved_no_harpy_configuration
  } else {
    set was_no_harpy_configuration false; # TODO: Good default?
  }

  if {$was_no_harpy_configuration} then {
    set ::env(NoConfiguration) 1
  } else {
    unset ::env(NoConfiguration)
  }

  tputs $channel [appendArgs \
      "---- restored Harpy plugin configuration to: " \
      $was_no_harpy_configuration \n]
}

###############################################################################

unset -nocomplain resultSuffix

if {[haveConstraint gnuScreen]} then {
  set resultSuffix ""
} else {
  set resultSuffix \$
}

###############################################################################

disableHarpyConfiguration $test_channel

###############################################################################

saveEnvironmentVariables [list NoWritePrompt]; set env(NoWritePrompt) 1

###############################################################################

set pids [list]

###############################################################################

runTest {test demo-1.0 {simple demo} -body {
  set fileName [file join $path data demo0.eagle]

  set result [execTestShell [list -nocarriagereturns \
      -eventflags Wait -preprocessarguments $prependQuietMode] \
      -preInitialize [appendArgs \" \
          [list set env(NoPopulateOsExtra) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoAutoRecord) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoWorkerThread) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoPromptCommandCount) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoPromptActiveLoops) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoLicensing) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoHookGetTestLogForWatchCat) true] \"] \
      -preInitialize [appendArgs \" \
          [list debug pluginflags \
          [expr {[haveConstraint demo.isolated] ? "+Isolated" : "+None"}]] \"] \
      -initialize -postInitialize [appendArgs \" \
          [list package require Demo.Enterprise] \"] \
      -postInitialize [appendArgs \" \
          [list package require Eagle.Test] \"] \
      -postInitialize [appendArgs \" \
          [list enableFailSafeExitAfter true] \"] \
      -postInitialize [appendArgs \" \
          [list demo startup -path $fileName] \"]]

  set pid [info previouspid]; lappend pids $pid
  waitForProcesses [list $pid] 10000

  set result
} -cleanup {
  unset -nocomplain result fileName pid
} -constraints {eagle testExec command.demo file_demo0.eagle} -match regexp \
-result [appendArgs {^% set x 1; set y 2; incr x; puts \[list \$x \$y\]; exit
2 2
} $resultSuffix]}

###############################################################################

#
# WARNING: The result of this test relies upon trailing whitespace.
