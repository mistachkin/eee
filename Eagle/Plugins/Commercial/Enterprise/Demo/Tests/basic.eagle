  set pid [info previouspid]; lappend pids $pid
  waitForProcesses [list $pid] 10000

  set result
} -cleanup {
  unset -nocomplain result fileName pid
} -constraints {eagle testExec command.demo interactive userInteraction\
file_demo2.eagle} -match regexp -result [appendArgs {^% puts stdout DEMO; exit
DEMO
} $resultSuffix]}

