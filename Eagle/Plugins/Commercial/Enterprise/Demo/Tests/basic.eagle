          [list set env(NoPromptCommandCount) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoPromptActiveLoops) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoLicensing) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoHookGetTestLogForWatchCat) true] \"] \
      -preInitialize [appendArgs \" \
          [list debug pluginflags \
          [expr {[haveConstraint demo.isolated] ? "+Isolated" : "+None"}]] \"] \
      -initialize -postInitialize [appendArgs \" \
          [list package require Demo.Enterprise] \"] \
      -postInitialize [appendArgs \" \
          [list package require Eagle.Test] \"] \
      -postInitialize [appendArgs \" \
