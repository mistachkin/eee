  waitForProcesses [list $pid] 10000

  set result
} -cleanup {
  unset -nocomplain result fileName pid
} -constraints {eagle testExec command.demo file_demo1.eagle} -match regexp \
-result [appendArgs {^% #
% # NOTE: This is a comment block followed by a blank line\.
% #
% 
% set x 1; set y 2; incr x; list \$x \$y
2 2
% exit
} $resultSuffix]}

