###############################################################################

runTest {test demo-2.1 {unloading non-isolated plugin} -setup {
  package require Demo.Enterprise
} -body {
  set plugin [lindex [info loaded "" *Demo.Enterprise*] 0]

  list [object invoke -flags +NonPublic Interpreter.GetActive.Host TypeName] \
      [unload -- [lindex $plugin 0] [lindex $plugin 1]] \
      [object invoke -flags +NonPublic Interpreter.GetActive.Host TypeName] \
      [object assemblies "Demo, *"]
} -cleanup {
  unset -nocomplain plugin
} -constraints [fixConstraints {eagle command.object !demo.isolated}] -match \
regexp -result {^Demo \{\{Demo\.Enterprise, Demo, Version=\d+\.\d+\.\d+\.\d+,\
Culture=neutral, PublicKeyToken=[0-9a-f]{16}\} \d+\.\d+\.\d+\.\d+\} Console\
\{\{Demo, Version=\d+\.\d+\.\d+\.\d+, Culture=neutral,\
PublicKeyToken=[0-9a-f]{16}\}\}$}}

###############################################################################

runTest {test demo-2.2 {unloading isolated plugin} -setup {
  package require Demo.Enterprise
} -body {
  set plugin [lindex [info loaded "" *Demo.Enterprise*] 0]

  list [object invoke -objectvalueflags +ManualProxyGetType -proxytype \
      Eagle._Hosts.Core -flags +NonPublic Interpreter.GetActive.Host \
      TypeName] [unload -- [lindex $plugin 0] [lindex $plugin 1]] \
      [object invoke -objectvalueflags +ManualProxyGetType -proxytype \
      Eagle._Hosts.Core -flags +NonPublic Interpreter.GetActive.Host \
      TypeName] [object assemblies "Demo, *"]
} -cleanup {
  unset -nocomplain plugin
} -constraints {eagle command.object demo.isolated} -match regexp -result \
{^Demo \{\{Demo\.Enterprise, Demo, Version=\d+\.\d+\.\d+\.\d+, Culture=neutral,\
PublicKeyToken=[0-9a-f]{16}\} \d+\.\d+\.\d+\.\d+\} Console \{\}$}}

###############################################################################

#
# HACK: Kill any stale child processes now.  This is generally
#       needed only on non-Windows, e.g. Mono on Linux, et al;
#       however, we may as well do it everywhere.
#
if {[info exists pids]} then {
  foreach pid $pids {
    if {[isWindows]} then {
      #
      # NOTE: Use built-in [kill] command on Windows.
      #
      if {[catch {kill -force -- $pid}] == 0} then {
        tputs $test_channel [appendArgs \
            "---- forcibly KILLED child process " \
            $pid " using \[kill\] on Windows\n"]
      } else {
        tputs $test_channel [appendArgs \
            "---- child process " $pid \
            " may be dead already on Windows\n"]
      }
    } else {
      #
      # BUGBUG: Maybe this is more reliable on Linux?
      #
      if {[catch {
        exec -success Success kill -s KILL $pid
      }] == 0} then {
        tputs $test_channel [appendArgs \
            "---- forcibly KILLED child process " \
            $pid " using \[exec\] on POSIX\n"]
      } else {
        tputs $test_channel [appendArgs \
            "---- child process " $pid \
            " may be dead already on POSIX\n"]
      }
    }
  }
}

unset -nocomplain pid pids

###############################################################################

unset -nocomplain resultSuffix

###############################################################################

restoreEnvironmentVariables [list NoWritePrompt]

###############################################################################

restoreHarpyConfiguration $test_channel

###############################################################################

rename restoreHarpyConfiguration ""
rename disableHarpyConfiguration ""

###############################################################################

unset -nocomplain saved_no_harpy_configuration

###############################################################################

unset -nocomplain prependQuietMode package_path

###############################################################################

runTestEpilogue
