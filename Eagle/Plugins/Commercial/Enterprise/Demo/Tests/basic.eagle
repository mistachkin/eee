runTest {test demo-1.3 {demo with timed stop} -body {
  set fileName [file join $path data demo3.eagle]

  set result [execTestShell [list -nocarriagereturns \
      -eventflags Wait -preprocessarguments $prependQuietMode] \
      -preInitialize [appendArgs \" \
          [list set env(NoPopulateOsExtra) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoAutoRecord) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoWorkerThread) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoPromptCommandCount) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoPromptActiveLoops) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoLicensing) true] \"] \
      -preInitialize [appendArgs \" \
          [list set env(NoHookGetTestLogForWatchCat) true] \"] \
      -preInitialize [appendArgs \" \
          [list debug pluginflags \
          [expr {[haveConstraint demo.isolated] ? "+Isolated" : "+None"}]] \"] \
      -initialize -postInitialize [appendArgs \" \
          [list package require Demo.Enterprise] \"] \
      -postInitialize [appendArgs \" \
          [list object invoke Interpreter.GetActive Quiet true] \"] \
      -postInitialize [appendArgs \" \
          [list set env(Quiet) true] \"] \
      -postInitialize [appendArgs \" \
          [list package require Eagle.Test] \"] \
      -postInitialize [appendArgs \" \
          [list enableFailSafeExitAfter true] \"] \
      -postInitialize [appendArgs \" \
          [list demo startup -path $fileName] \"]]

  set pid [info previouspid]; lappend pids $pid
  waitForProcesses [list $pid] 10000

  set result
} -cleanup {
  unset -nocomplain result fileName pid
} -constraints {eagle compile.THREADING testExec command.demo\
file_demo3.eagle} -match regexp -result \
[appendArgs {^% proc threadStart \{\} \{ after 0 nop; vwait forever \}
% set t \[createThread threadStart\]
System#Threading#Thread#\d+
% startThread \$t; after 2000 \[list demo stop\]; demo playmilliseconds 1000
1000
% (?:p(?:u)?)?
------------------------------------------------------------------
% exit -force
} $resultSuffix]}

