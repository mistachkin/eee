apply [list [list] {
  package require Eagle.CIDR

  set countryCodes [lsort [list us]]

  upvar 1 cidrs cidrs

  foreach version [list 4 6] {
    foreach countryCode $countryCodes  {
      catch {
        loadCidrFileFast $::env(CIDR_DATA_ROOT) \
            $version $countryCode null cidrs
      }
    }
  }

  lappend cidrs(127.*) 127.0.0.0/8

  lappend cidrs(*) ::1/128 \
      mistachkin.net/32 mistachkin.net/128 \
      mistachkin.nyc/32 mistachkin.nyc/128

  return "CIDR \"allow\" lists fully loaded."
}]
