 * See the file "license.terms" for information on usage and redistribution of
 * this file, and for a DISCLAIMER OF ALL WARRANTIES.
 *
 * RCS: @(#) $Id: $
 *
-->
<configuration>
  <appSettings>
    <!--
    ***************************************************************************
    **                         Server Configuration                          **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* The script to evaluate just prior to loading settings
              for a server page.

        HACK: This can be used to force one set of database files to be used,
              e.g. the ones included with the NuGet package.

        BUGBUG: When a SettingMinimumIndex value is set to one, it is somewhat
                superfluous _unless_ there exists an (associated) non-indexed
                setting value as well.
    -->
    <!--
    <add key="ServerConfigurationScript"
         value="set ::env(HarpyAllowAnyThread) 1; apply [list [list] {package require Eagle.Test; foreach pair [getEnvironmentViaComSpec false] {set ::env([lindex $pair 0]) [lindex $pair 1]}}]; set ProvisionDatabase_SettingMinimumIndex 1; set RenewalCertificateDatabase_SettingMinimumIndex 1; set RenewalLicenseKeyRingDatabase_SettingMinimumIndex 1; set RenewalScriptKeyRingDatabase_SettingMinimumIndex 1; set SupportDatabase_SettingMinimumIndex 1; set VariableDatabase_SettingMinimumIndex 1; set RenewalLicenseKeyId_SettingMinimumIndex 1; set RenewalScriptKeyId_SettingMinimumIndex 1; set ::env(KAPOK_TEST_PATH) [object invoke Environment ExpandEnvironmentVariables {%EAGLE%\Plugins\Commercial\Enterprise\Kapok}]" />
    -->
    <add key="ServerConfigurationScript"
         value="set ::env(HarpyAllowAnyThread) 1; apply [list [list] {package require Eagle.Test; foreach pair [getEnvironmentViaComSpec false] {set ::env([lindex $pair 0]) [lindex $pair 1]}}]; if {[info exists ::env(KapokDataFromPackage)]} then {set ProvisionDatabase_SettingMinimumIndex 1; set RenewalCertificateDatabase_SettingMinimumIndex 1; set RenewalLicenseKeyRingDatabase_SettingMinimumIndex 1; set RenewalScriptKeyRingDatabase_SettingMinimumIndex 1; set SupportDatabase_SettingMinimumIndex 1; set VariableDatabase_SettingMinimumIndex 1; set RenewalLicenseKeyId_SettingMinimumIndex 1; set RenewalScriptKeyId_SettingMinimumIndex 1}; if {[info exists ::env(EAGLE)]} then {set ::env(KAPOK_TEST_PATH) [file join $::env(EAGLE) Plugins Commercial Enterprise Kapok]}" />

    <!--
    ***************************************************************************
    **                          Eagle Core Library                           **
    ***************************************************************************
    -->

    <!--
        TODO: *OPTIONAL* Make sure that Eagle can find the script library when
              it tries to initialize the interpreter(s).  Using an empty string
              for this value means "attempt to automatically detect based on
              the provided assembly location and the environment".
    -->
    <!--
    <add key="EAGLE_LIBRARY" value="" />
    -->

    <!--
        NOTE: *OPTIONAL* The Eagle library paths to use [for packages].  These
              are the locations where additional packages, such as Harpy, will
              be located.  This must be a properly formed Tcl list value.  If
              any plugins will be loaded in isolated mode, this will not work.
              In that case, the package paths must reside within the base path
              for the application domain.  Typically, any production deployment
              of this project will modify this setting to take this requirement
              into account.  The alternative library paths (commented out) can
              be used during development as long as a junction is created for
              each of the necessary packages within the selected build output
              directory.  Typically, this requires the EAGLE environment
              variable, which must be set to point to the root of either the
              Eagle source code or installation directory (i.e. the directory
              that contains a "lib" sub-directory).
    -->
    <add key="EAGLELIBPATH1" value="{%EAGLE%\bin\%CONFIGURATION%\lib}" />
    <add key="EAGLELIBPATH2" value="{%binDir%\..\lib}" />
    <add key="EAGLELIBPATH3" value="{%SystemDrive%\inetpub\wwwroot\Kapok\lib}" />

    <!--
    ***************************************************************************
    **                  Harpy Override License Certificate                   **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* One or more fully qualified paths to potentially
              valid license certificate files for the Harpy and/or Badge
              plugins.
    -->
    <!--
        NOTE: *WARNING* This license certificate is for use by the NuGet
              package only.
    -->
    <add key="PluginCertificate1"
         value="%binDir%\..\harpy-trial-certificate.xml" />

    <add key="PluginCertificate2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\certificate.exml" />

    <add key="PluginCertificate3" value="%Override_Plugin_Certificate%" />

    <add key="PluginCertificate4" value="%Override_Certificate%" />

    <add key="PluginCertificate8"
         value="%SystemDrive%\Certificates\harpy-certificate.xml" />

    <!--
        NOTE: *WARNING* This license certificate will work for development
              and testing use only.  It will NOT work for release builds.
    -->
    <add key="PluginCertificate9"
         value="%EAGLE%\Plugins\Commercial\Enterprise\certificate.exml" />

    <!--
    ***************************************************************************
    **                  Kapok Override License Certificate                   **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* One or more fully qualified paths to potentially
              valid license certificate files for the Kapok server itself.
    -->
    <!--
        NOTE: *WARNING* This license certificate is for use by the NuGet
              package only.
    -->
    <add key="ServerCertificate1"
         value="%binDir%\..\kapok-trial-certificate.xml" />

    <add key="ServerCertificate2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\certificate.exml" />

    <add key="ServerCertificate3" value="%Override_Server_Certificate%" />

    <add key="ServerCertificate4" value="%Override_Certificate%" />

    <add key="ServerCertificate8"
         value="%SystemDrive%\Certificates\kapok-certificate.xml" />

    <!--
        NOTE: *WARNING* This license certificate will work for development
              and testing use only.  It will NOT work for release builds.
    -->
    <add key="ServerCertificate9"
         value="%EAGLE%\Plugins\Commercial\Enterprise\certificate.exml" />

    <!--
    ***************************************************************************
    **                  Legacy Override License Certificate                  **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* The fully qualified path and file name to the valid
              license certificate for the Kapok server itself.  This setting
              should not be used in new applications; it is being retained
              for backward compatibility only.
    -->
    <!--
    <add key="Certificate"
         value="%SystemDrive%\Certificates\kapok-certificate.xml" />
    -->

    <!--
    ***************************************************************************
    **                      Provisioning Configuration                       **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* Is the provisioning server enabled?
    -->
    <add key="ProvisionServerEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Require a valid, non-expired license certificate for
              the server in order to process a client request?  This can slow
              down processing quite a bit; however, it is useful when license
              enforcement is required for legal or regulatory compliance.
    -->
    <add key="ProvisionServerLicensingEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint require an interpreter for
              any aspect of its request processing.  If so, this must be set
              to non-zero; otherwise, things will not work correctly.
    -->
    <add key="ProvisionServerCreateInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint allow its interpreter to
              be cached and then reused later?  If so, this should be set to
              non-zero; otherwise, things will not work correctly.
    -->
    <add key="ProvisionServerCacheInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* How long does this server endpoint want to allow its
              interpreters to be idle, in seconds?  If this value is negative,
              it will be exempt from automatic cleanup.
    -->
    <add key="ProvisionServerCacheSeconds" value="600" />

    <!--
        NOTE: *OPTIONAL* Is Harpy SDK "security" enabled for the provisioning
              server?  If this value is greater than one, it will be forcibly
              enabled, even when running within the debugger.  Without the
              correct signed registry setting, that may cause Harpy to fail to
              load.
    -->
    <add key="ProvisionServerSecurityLevel" value="0" />

    <!--
        NOTE: *OPTIONAL* What flags should be used when loading the Harpy SDK
              "security" subsystem?
    -->
    <add key="ProvisionServerSecurityFlags" value="Default +DisposeThread MaybeTraceResult" />

    <!--
        NOTE: *OPTIONAL* The script to evaluate just prior to evaluating the
              primary provisioning [Eagle] script file.
    -->
    <!--
    <add key="ProvisionSetupScript" value="" />
    -->

    <!--
        NOTE: *OPTIONAL* Is the provisioning [Eagle] script file really a
              mixed-mode file containing HTML and script blocks?
    -->
    <!--
    <add key="ProvisionScriptBlocks" value="false" />
    -->

    <!--
        NOTE: *OPTIONAL* What flags should be used when processing the script
              blocks, if any?
    -->
    <!--
    <add key="ProvisionScriptBlockFlags" value="Default" />
    -->

    <!--
        NOTE: *OPTIONAL* The set of environment variables that may be used by
              the evaluated script, if any.
    -->
    <add key="ProvisionServerEnvironment"
         value="toolPath {DirectoryName NoExists CreatePath} templateFileName FileName privateKeyFileName FileName" />

    <!--
        NOTE: *REQUIRED* The fully qualified path and file name to the license
              [Eagle] script file.  If "ProvisionServerSecurityLevel" is non-zero
              this script must be signed.
    -->
    <add key="ProvisionScriptFile1"
         value="%binDir%\..\Tools\provision.eagle" />
    <add key="ProvisionScriptFile2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Tools\provision.eagle" />
    <add key="ProvisionScriptFile3"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Scripts\provision.eagle" />

    <!--
        NOTE: *OPTIONAL* The fully qualified path and file name to the variable
              storage server database.
    -->
    <add key="ProvisionDatabase1"
         value="%binDir%\..\Data\var.db" />
    <add key="ProvisionDatabase2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Data\test\var.db" />
    <add key="ProvisionDatabase3"
         value="%KAPOK_TEST_PATH%\Data\var.db" />
    <add key="ProvisionDatabase4"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Data\var.db" />

    <!--
        NOTE: *OPTIONAL* Set output path for use by the provisioning endpoint.
    -->
    <add key="ProvisionServerEnvironment_toolPath1"
         value="%KAPOK_TOOL_PATH%" />
    <add key="ProvisionServerEnvironment_toolPath2"
         value="%TEMP%\kapok_provisioning_tests" />

    <!--
        NOTE: *OPTIONAL* Set the template license certificate file name for use
              by the provisioning endpoint.
    -->
    <add key="ProvisionServerEnvironment_templateFileName1"
         value="%binDir%\..\Data\template.xml" />
    <add key="ProvisionServerEnvironment_templateFileName2"
         value="%KAPOK_TOOL_PATH%\template.xml" />
    <add key="ProvisionServerEnvironment_templateFileName3"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Data\test\template.xml" />
    <add key="ProvisionServerEnvironment_templateFileName4"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Data\template.xml" />

    <!--
        NOTE: *OPTIONAL* Set the strong name key pair file name for use by the
              provisioning endpoint.
    -->
    <add key="ProvisionServerEnvironment_privateKeyFileName1"
         value="%binDir%\..\Keys\provision.snk" />
    <add key="ProvisionServerEnvironment_privateKeyFileName2"
         value="%KAPOK_TOOL_PATH%\provision.snk" />
    <add key="ProvisionServerEnvironment_privateKeyFileName3"
         value="%EAGLE%\Keys\provision.snk" />
    <add key="ProvisionServerEnvironment_privateKeyFileName4"
         value="%SystemDrive%\Keys\provision.snk" />

    <!--
    ***************************************************************************
    **                   Certificate Renewal Configuration                   **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* Is the certificate renewal server enabled?
    -->
    <add key="RenewalServerEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Require a valid, non-expired license certificate for
              the server in order to process a client request?  This can slow
              down processing quite a bit; however, it is useful when license
              enforcement is required for legal or regulatory compliance.
    -->
    <add key="RenewalServerLicensingEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint require an interpreter for
              any aspect of its request processing.  If so, this must be set
              to non-zero; otherwise, things will not work correctly.
    -->
    <add key="RenewalServerCreateInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint allow its interpreter to
              be cached and then reused later?  If so, this should be set to
              non-zero; otherwise, things will not work correctly.
    -->
    <add key="RenewalServerCacheInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* How long does this server endpoint want to allow its
              interpreters to be idle, in seconds?  If this value is negative,
              it will be exempt from automatic cleanup.
    -->
    <add key="RenewalServerCacheSeconds" value="600" />

    <!--
        NOTE: *OPTIONAL* Is Harpy SDK "security" enabled for the certificate
              renewal server?  If this value is greater than one, it will be
              forcibly enabled, even when running within the debugger.
              Without the correct signed registry setting, that may cause
              Harpy to fail to load.
    -->
    <add key="RenewalServerSecurityLevel" value="0" />

    <!--
        NOTE: *OPTIONAL* What flags should be used when loading the Harpy SDK
              "security" subsystem?
    -->
    <add key="RenewalServerSecurityFlags" value="Default +DisposeThread MaybeTraceResult" />

    <!--
        NOTE: *OPTIONAL* When non-zero, this will prevent the license renewal
              script from ever complaining about expired requests.
    -->
    <!--
    <add key="RenewalNoRequestTimeout" value="true" />
    -->

    <!--
        NOTE: *OPTIONAL* When non-zero, this will prevent the license renewal
              script from ever complaining about mismatched request hashes.
              Also, it will permit the entity name and value to be passed via
              the query string.

        HACK: In order for Harpy tests "harpy-36.*" to pass when targeting the
              locally running server, this value must be non-zero.
    -->
    <add key="RenewalPassThroughMode" value="true" />

    <!--
        NOTE: *OPTIONAL* The script to evaluate just prior to evaluating the
              primary renewal [Eagle] script file.
    -->
    <!--
    <add key="RenewalSetupScript" value="" />
    -->

    <!--
        NOTE: *OPTIONAL* Is the renewal [Eagle] script file really a mixed-mode
              file containing HTML and script blocks?
    -->
    <!--
    <add key="RenewalScriptBlocks" value="false" />
    -->

    <!--
        NOTE: *OPTIONAL* What flags should be used when processing the script
              blocks, if any?
    -->
    <!--
    <add key="RenewalScriptBlockFlags" value="Default" />
    -->

    <!--
        NOTE: *OPTIONAL* The set of environment variables that may be used by
              the evaluated script, if any.
    -->
    <!--
    <add key="RenewalServerEnvironment" value="" />
    -->

    <!--
        NOTE: *REQUIRED* The fully qualified path and file name to the renewal
              [Eagle] script file.  If "RenewalServerSecurityLevel" is non-zero
              this script must be signed.
    -->
    <add key="RenewalScriptFile1"
         value="%binDir%\..\Tools\renew.eagle" />
    <add key="RenewalScriptFile2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Tools\renew.eagle" />
    <add key="RenewalScriptFile3"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Scripts\renew.eagle" />

    <!--
        NOTE: *OPTIONAL* The fully qualified path and file name to the primary
              certificate database.
    -->
    <add key="RenewalCertificateDatabase1"
         value="%binDir%\..\Data\kapok.db" />
    <add key="RenewalCertificateDatabase2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Data\test\kapok.db" />
    <add key="RenewalCertificateDatabase3"
         value="%KAPOK_TEST_PATH%\Data\kapok.db" />
    <add key="RenewalCertificateDatabase4"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Data\demo.db" />

    <!--
        NOTE: *OPTIONAL* The fully qualified path and file name to the key ring
              database to use for license certificates.
    -->
    <add key="RenewalLicenseKeyRingDatabase1"
         value="%binDir%\..\Keys\keyRing.db" />
    <add key="RenewalLicenseKeyRingDatabase2"
         value="%EAGLE%\Keys\keyRing.db" />
    <add key="RenewalLicenseKeyRingDatabase3"
         value="%KAPOK_TEST_PATH%\Keys\package\keyRing.db" />
    <add key="RenewalLicenseKeyRingDatabase4"
         value="%SystemDrive%\Keys\keyRing.db" />
    <add key="RenewalLicenseKeyRingDatabase5"
         value="J:\keyRing.db" />

    <!--
        NOTE: *OPTIONAL* The unique identifier for the key to use for signing
              license certificates.  If not set, an attempt will be made to use
              the key based on the unique identifier found within the license
              certificate itself.
    -->
    <add key="RenewalLicenseKeyId1"
         value="0x6d5df9dbdd9098fd" />
    <add key="RenewalLicenseKeyId2"
         value="0x8bf43b4749e46a0b" />
    <add key="RenewalLicenseKeyId3"
         value="0x6d5df9dbdd9098fd" />
    <add key="RenewalLicenseKeyId4"
         value="0x5f8230f3e7b9b317" />
    <add key="RenewalLicenseKeyId5"
         value="0x8bf43b4749e46a0b" />

    <!--
        NOTE: *OPTIONAL* The fully qualified path and file name to the key ring
              database to use for script certificates.
    -->
    <add key="RenewalScriptKeyRingDatabase1"
         value="%binDir%\..\Keys\keyRing.db" />
    <add key="RenewalScriptKeyRingDatabase2"
         value="%EAGLE%\Keys\keyRing.db" />
    <add key="RenewalScriptKeyRingDatabase3"
         value="%KAPOK_TEST_PATH%\Keys\package\keyRing.db" />
    <add key="RenewalScriptKeyRingDatabase4"
         value="%SystemDrive%\Keys\keyRing.db" />
    <add key="RenewalScriptKeyRingDatabase5"
         value="J:\keyRing.db" />

    <!--
        NOTE: *OPTIONAL* The unique identifier for the key to use for signing
              script certificates.  If not set, an attempt will be made to use
              the key based on the unique identifier found within the script
              certificate itself.
    -->
    <add key="RenewalScriptKeyId1"
         value="0x6d5df9dbdd9098fd" />
    <add key="RenewalScriptKeyId2"
         value="0x5f8230f3e7b9b317" />
    <add key="RenewalScriptKeyId3"
         value="0x6d5df9dbdd9098fd" />
    <add key="RenewalScriptKeyId4"
         value="0x5f8230f3e7b9b317" />
    <add key="RenewalScriptKeyId5"
         value="0x5f8230f3e7b9b317" />

    <!--
        NOTE: *OPTIONAL* The request timeout, in seconds, for renewals.  For
              example, the value 2592000 represents about 30 days.
    -->
    <add key="RenewalTimeout" value="2592000" />

    <!--
    ***************************************************************************
    **                   Certificate Request Configuration                   **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* Is the license request server enabled?
    -->
    <add key="RequestServerEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Require a valid, non-expired license certificate for
              the server in order to process a client request?  This can slow
              down processing quite a bit; however, it is useful when license
              enforcement is required for legal or regulatory compliance.
    -->
    <add key="RequestServerLicensingEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint require an interpreter for
              any aspect of its request processing.  If so, this must be set
              to non-zero; otherwise, things will not work correctly.
    -->
    <add key="RequestServerCreateInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint allow its interpreter to
              be cached and then reused later?  If so, this should be set to
              non-zero; otherwise, things will not work correctly.
    -->
    <add key="RequestServerCacheInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* How long does this server endpoint want to allow its
              interpreters to be idle, in seconds?  If this value is negative,
              it will be exempt from automatic cleanup.
    -->
    <add key="RequestServerCacheSeconds" value="600" />

    <!--
        NOTE: *OPTIONAL* Is Harpy SDK "security" enabled for the provisioning
              server?  If this value is greater than one, it will be forcibly
              enabled, even when running within the debugger.  Without the
              correct signed registry setting, that may cause Harpy to fail to
              load.
    -->
    <add key="RequestServerSecurityLevel" value="0" />

    <!--
        NOTE: *OPTIONAL* What flags should be used when loading the Harpy SDK
              "security" subsystem?
    -->
    <add key="RequestServerSecurityFlags" value="Default +DisposeThread MaybeTraceResult" />

    <!--
        NOTE: *OPTIONAL* The script to evaluate just prior to evaluating the
              primary license request [Eagle] script file.
    -->
    <!--
    <add key="RequestSetupScript" value="" />
    -->

    <!--
        NOTE: *OPTIONAL* Is the license request [Eagle] script file really a
              mixed-mode file containing HTML and script blocks?
    -->
    <!--
    <add key="RequestScriptBlocks" value="false" />
    -->

    <!--
        NOTE: *OPTIONAL* What flags should be used when processing the script
              blocks, if any?
    -->
    <!--
    <add key="RequestScriptBlockFlags" value="Default" />
    -->

    <!--
        NOTE: *REQUIRED* The fully qualified path and file name to the license
              [Eagle] script file.  If "RequestServerSecurityLevel" is non-zero
              this script must be signed.
    -->
    <add key="RequestScriptFile1"
         value="%binDir%\..\Tools\request.eagle" />
    <add key="RequestScriptFile2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Tools\request.eagle" />
    <add key="RequestScriptFile3"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Scripts\request.eagle" />

    <!--
        NOTE: *OPTIONAL* The fully qualified path and file name to the primary
              certificate database.
    -->
    <add key="RequestCertificateDatabase1"
         value="%binDir%\..\Data\kapok.db" />
    <add key="RequestCertificateDatabase2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Data\test\kapok.db" />
    <add key="RequestCertificateDatabase3"
         value="%KAPOK_TEST_PATH%\Data\kapok.db" />
    <add key="RequestCertificateDatabase4"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Data\demo.db" />

    <!--
    ***************************************************************************
    **                 Certificate Revocation Configuration                  **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* Is the certificate revocation server enabled?
    -->
    <add key="RevocationServerEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Require a valid, non-expired license certificate for
              the server in order to process a client request?  This can slow
              down processing quite a bit; however, it is useful when license
              enforcement is required for legal or regulatory compliance.
    -->
    <add key="RevocationServerLicensingEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint require an interpreter for
              any aspect of its request processing.  If so, this must be set
              to non-zero; otherwise, things will not work correctly.
    -->
    <add key="RevocationServerCreateInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint allow its interpreter to
              be cached and then reused later?  If so, this should be set to
              non-zero; otherwise, things will not work correctly.
    -->
    <add key="RevocationServerCacheInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* How long does this server endpoint want to allow its
              interpreters to be idle, in seconds?  If this value is negative,
              it will be exempt from automatic cleanup.
    -->
    <add key="RevocationServerCacheSeconds" value="600" />

    <!--
        NOTE: *REQUIRED* The fully qualified path and file name to the list of
              revoked certificate identifiers.  This file must be signed using
              a key with the appropriate key usage.  The format of the file is
              a Tcl-style list containing two elements:

              1. The first element is a sub-list containing a list of revoked
                 certificates.  Each element of this sub-list is also a list,
                 containing three elements: unique identifier, timestamp, and
                 the reason for revocation.  If the timestamp is omitted, the
                 certificate is considered to always have been revoked.  If
                 the reason is omitted, there is no reason.

              2. The second element is a base64 encoded signature of the first
                 element.
    -->
    <add key="RevocationIdsListFile1"
         value="%binDir%\..\Data\revokedIds.txt" />
    <add key="RevocationIdsListFile2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Data\test\revokedIds.txt" />
    <add key="RevocationIdsListFile3"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Data\revokedIds.txt" />

    <!--
        NOTE: *REQUIRED* The fully qualified path and file name to the list of
              revoked public key tokens.  This file must be signed using a key
              with the appropriate key usage.  The format of the file is a
              Tcl-style list containing two elements:

              1. The first element is a sub-list containing a list of revoked
                 public keys.  Each element of this sub-list is also a list,
                 containing three elements: public key token, timestamp, and
                 the reason for revocation.  If the timestamp is omitted, the
                 public key is considered to always have been revoked.  If the
                 reason is omitted, there is no reason.

              2. The second element is a base64 encoded signature of the first
                 element.
    -->
    <add key="RevocationTokensListFile1"
         value="%binDir%\..\Data\revokedTokens.txt" />
    <add key="RevocationTokensListFile2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Data\test\revokedTokens.txt" />
    <add key="RevocationTokensListFile3"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Data\revokedTokens.txt" />

    <!--
    ***************************************************************************
    **                   Enterprise Support Configuration                    **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* Is the certificate support server enabled?
    -->
    <add key="SupportServerEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Require a valid, non-expired license certificate for
              the server in order to process a client request?  This can slow
              down processing quite a bit; however, it is useful when license
              enforcement is required for legal or regulatory compliance.
    -->
    <add key="SupportServerLicensingEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint require an interpreter for
              any aspect of its request processing.  If so, this must be set
              to non-zero; otherwise, things will not work correctly.
    -->
    <add key="SupportServerCreateInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint allow its interpreter to
              be cached and then reused later?  If so, this should be set to
              non-zero; otherwise, things will not work correctly.
    -->
    <add key="SupportServerCacheInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* How long does this server endpoint want to allow its
              interpreters to be idle, in seconds?  If this value is negative,
              it will be exempt from automatic cleanup.
    -->
    <add key="SupportServerCacheSeconds" value="600" />

    <!--
        NOTE: *OPTIONAL* Is Harpy SDK "security" enabled for the certificate
              support server?  If this value is greater than one, it will be
              forcibly enabled, even when running within the debugger.
              Without the correct signed registry setting, that may cause
              Harpy to fail to load.
    -->
    <add key="SupportServerSecurityLevel" value="0" />

    <!--
        NOTE: *OPTIONAL* What flags should be used when loading the Harpy SDK
              "security" subsystem?
    -->
    <add key="SupportServerSecurityFlags" value="Default +DisposeThread MaybeTraceResult" />

    <!--
        NOTE: *OPTIONAL* The script to evaluate just prior to evaluating the
              primary support [Eagle] script file.
    -->
    <!--
    <add key="SupportSetupScript" value="" />
    -->

    <!--
        NOTE: *OPTIONAL* Is the support [Eagle] script file really a mixed-mode
              file containing HTML and script blocks?
    -->
    <!--
    <add key="SupportScriptBlocks" value="false" />
    -->

    <!--
        NOTE: *OPTIONAL* What flags should be used when processing the script
              blocks, if any?
    -->
    <!--
    <add key="SupportScriptBlockFlags" value="Default" />
    -->

    <!--
        NOTE: *OPTIONAL* The set of environment variables that may be used by
              the evaluated script, if any.
    -->
    <!--
    <add key="SupportServerEnvironment" value="" />
    -->

    <!--
        NOTE: *REQUIRED* The fully qualified path and file name to the support
              [Eagle] script file.  If "SupportServerSecurityLevel" is non-zero
              this script must be signed.
    -->
    <add key="SupportScriptFile1"
         value="%binDir%\..\Tools\support.eagle" />
    <add key="SupportScriptFile2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Tools\support.eagle" />
    <add key="SupportScriptFile3"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Scripts\support.eagle" />

    <!--
        NOTE: *OPTIONAL* The fully qualified path and file name to the support
              database.
    -->
    <add key="SupportDatabase1"
         value="%binDir%\..\Data\kapok.db" />
    <add key="SupportDatabase2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Data\test\kapok.db" />
    <add key="SupportDatabase3"
         value="%KAPOK_TEST_PATH%\Data\kapok.db" />
    <add key="SupportDatabase4"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Data\demo.db" />

    <!--
    ***************************************************************************
    **                    Variable Storage Configuration                     **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* Is the variable storage server enabled?
    -->
    <add key="VariableServerEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Require a valid, non-expired license certificate for
              the server in order to process a client request?  This can slow
              down processing quite a bit; however, it is useful when license
              enforcement is required for legal or regulatory compliance.
    -->
    <add key="VariableServerLicensingEnabled" value="false" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint require an interpreter for
              any aspect of its request processing.  If so, this must be set
              to non-zero; otherwise, things will not work correctly.
    -->
    <add key="VariableServerCreateInterpreter" value="false" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint allow its interpreter to
              be cached and then reused later?  If so, this should be set to
              non-zero; otherwise, things will not work correctly.
    -->
    <add key="VariableServerCacheInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* How long does this server endpoint want to allow its
              interpreters to be idle, in seconds?  If this value is negative,
              it will be exempt from automatic cleanup.
    -->
    <add key="VariableServerCacheSeconds" value="600" />

    <!--
        NOTE: *OPTIONAL* Is Harpy SDK "security" enabled for the variable
              storage server?  To enable full isolation for Harpy, this
              value must be true.  If this value is greater than one, it
              will be forcibly enabled, even when running from within the
              debugger.  Without the correct signed registry setting, that
              may cause Harpy to fail to load.
    -->
    <!--
    <add key="VariableServerSecurityLevel" value="2" />
    -->
    <add key="VariableServerSecurityLevel" value="0" />

    <!--
        NOTE: *OPTIONAL* What flags should be used when loading the Harpy SDK
              "security" subsystem?  To enable full isolation for Harpy, use
              the flags commented out just below.
    -->
    <!--
    <add key="VariableServerSecurityFlags" value="+UseIsolation DisableIsolation" />
    -->
    <add key="VariableServerSecurityFlags" value="Default +DisposeThread MaybeTraceResult" />

    <!--
        NOTE: *OPTIONAL* The script to evaluate just prior to evaluating the
              variable storage server script file.
    -->
    <!--
    <add key="VariableSetupScript" value="" />
    -->

    <!--
        NOTE: *OPTIONAL* Is the variable storage server script file really a
              mixed-mode file containing HTML and script blocks?
    -->
    <add key="VariableScriptBlocks" value="false" />

    <!--
        NOTE: *OPTIONAL* What flags should be used when processing the script
              blocks, if any?
    -->
    <!--
    <add key="VariableScriptBlockFlags" value="Default" />
    -->

    <!--
        NOTE: *OPTIONAL* The set of environment variables that may be used by
              the evaluated script, if any.
    -->
    <!--
    <add key="VariableServerEnvironment" value="" />
    -->

    <!--
        NOTE: *OPTIONAL* The fully qualified path and file name to the variable
              storage server database.
    -->
    <add key="VariableDatabase1"
         value="%binDir%\..\Data\var.db" />
    <add key="VariableDatabase2"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Data\test\var.db" />
    <add key="VariableDatabase3"
         value="%KAPOK_TEST_PATH%\Data\var.db" />
    <add key="VariableDatabase4"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Data\var.db" />

    <!--
    ***************************************************************************
    **                      Script Wrapper Configuration                     **
    ***************************************************************************
    -->

    <!--
        NOTE: *OPTIONAL* Is the wrapped [Eagle] script server enabled?
    -->
    <add key="WrapperServerEnabled" value="true" />

    <!--
        NOTE: *OPTIONAL* Require a valid, non-expired license certificate for
              the server in order to process a client request?  This can slow
              down processing quite a bit; however, it is useful when license
              enforcement is required for legal or regulatory compliance.
    -->
    <add key="WrapperServerLicensingEnabled" value="false" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint require an interpreter for
              any aspect of its request processing.  If so, this must be set
              to non-zero; otherwise, things will not work correctly.
    -->
    <add key="WrapperServerCreateInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* Does this server endpoint allow its interpreter to
              be cached and then reused later?  If so, this should be set to
              non-zero; otherwise, things will not work correctly.
    -->
    <add key="WrapperServerCacheInterpreter" value="true" />

    <!--
        NOTE: *OPTIONAL* How long does this server endpoint want to allow its
              interpreters to be idle, in seconds?  If this value is negative,
              it will be exempt from automatic cleanup.
    -->
    <add key="WrapperServerCacheSeconds" value="600" />

    <!--
        NOTE: *OPTIONAL* Is Harpy SDK "security" enabled for the wrapped
              [Eagle] script server?  To enable full isolation for Harpy,
              this value must be true.  If this value is greater than one,
              it will be forcibly enabled, even when running from within
              the debugger.  Without the correct signed registry setting,
              that may cause Harpy to fail to load.
    -->
    <!--
    <add key="WrapperServerSecurityLevel" value="2" />
    -->
    <add key="WrapperServerSecurityLevel" value="0" />

    <!--
        NOTE: *OPTIONAL* What flags should be used when loading the Harpy SDK
              "security" subsystem?  To enable full isolation for Harpy, use
              the flags commented out just below.
    -->
    <!--
    <add key="WrapperServerSecurityFlags" value="+UseIsolation DisableIsolation" />
    -->
    <add key="WrapperServerSecurityFlags" value="Default +DisposeThread MaybeTraceResult" />

    <!--
        NOTE: *OPTIONAL* The script to evaluate just prior to evaluating the
              primary wrapped [Eagle] script file.
    -->
    <!--
    <add key="WrapperSetupScript" value="" />
    -->

    <!--
        NOTE: *OPTIONAL* Is the primary wrapped [Eagle] script file really a
              mixed-mode file containing HTML and script blocks?
    -->
    <add key="WrapperScriptBlocks" value="false" />

    <!--
        NOTE: *OPTIONAL* What flags should be used when processing the script
              blocks, if any?
    -->
    <!--
    <add key="WrapperScriptBlockFlags" value="Default" />
    -->

    <!--
        NOTE: *OPTIONAL* The set of environment variables that may be used by
              the evaluated script, if any.
    -->
    <!--
    <add key="WrapperServerEnvironment" value="" />
    -->

    <!--
        NOTE: *REQUIRED* The fully qualified path and file name to the primary
              wrapped [Eagle] script file.  If "WrapperServerSecurityLevel" is
              non-zero this script must be signed.
    -->
    <add key="WrapperScriptFile1"
         value="%binDir%\..\Tools\openAI.eagle" />
    <add key="WrapperScriptFile2"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Scripts\openAI.eagle" />
    <add key="WrapperScriptFile3"
         value="%binDir%\..\Tools\wrapped.eagle" />
    <add key="WrapperScriptFile4"
         value="%EAGLE%\Plugins\Commercial\Enterprise\Kapok\Tests\data\wrapped.eagle" />
    <add key="WrapperScriptFile5"
         value="%SystemDrive%\inetpub\wwwroot\Kapok\Scripts\wrapped.eagle" />

    <!--
    ***************************************************************************
    **                             Page Mappings                             **
    ***************************************************************************
    -->

    <!--
        NOTE: These page mappings used to map a request path to its associated
              managed class name.  These are (only) necessary when running via
              the ASP.NET Core runtime.
    -->
    <add key="PathClassNameMapping(/certificate/renew.cgi)" value="Kapok.certificate.renew" />
    <add key="PathClassNameMapping(/certificate/revoked.cgi)" value="Kapok.certificate.revoked" />
    <add key="PathClassNameMapping(/service/provision.cgi)" value="Kapok.service.provision" />
    <add key="PathClassNameMapping(/support/check.cgi)" value="Kapok.support.check" />
    <add key="PathClassNameMapping(/test/page.cgi)" value="Kapok.test.page" />
    <add key="PathClassNameMapping(/var/storage.cgi)" value="Kapok.var.storage" />
    <add key="PathClassNameMapping(/wrapper/script.cgi)" value="Kapok.wrapper.script" />

    <!--
    ***************************************************************************
    **                       Variable Storage Mappings                       **
    ***************************************************************************
    -->

    <add key="VariableMethodStorageCommand(Access)" value="MaybeValuesCommand Scalar {SELECT 1 FROM apiKeys WHERE apiKey {NoCase} = ? {NoCase} AND CAST(active AS INTEGER) != 0;} {}" />
    <add key="VariableMethodStorageCommand(Exist)" value="MaybeValuesCommand Scalar {SELECT 1 FROM vars WHERE name {NoCase} = ? {NoCase};} {}" />
    <add key="VariableMethodStorageCommand(Count)" value="MaybeValuesCommand Scalar {SELECT COUNT(*) FROM vars WHERE name {NoCase} GLOB ? {NoCase};} {SELECT COUNT(*) FROM vars;}" />
    <add key="VariableMethodStorageCommand(Names)" value="MaybeValuesCommand Reader {SELECT name FROM vars WHERE name {NoCase} GLOB ? {NoCase} ORDER BY id ASC;} {SELECT name FROM vars ORDER BY id ASC;}" />
    <add key="VariableMethodStorageCommand(Values)" value="MaybeValuesCommand Reader {SELECT value FROM vars WHERE value {NoCase} GLOB ? {NoCase} ORDER BY id ASC;} {SELECT value FROM vars ORDER BY id ASC;}" />
    <add key="VariableMethodStorageCommand(All)" value="MaybeValuesCommand Reader {SELECT name, value FROM vars WHERE name {NoCase} GLOB ? {NoCase} ORDER BY id ASC;} {SELECT name, value FROM vars ORDER BY id ASC;}" />
    <add key="VariableMethodStorageCommand(Get)" value="IfThenElseCommand {MaybeValuesCommand Scalar {SELECT 1 FROM vars WHERE name {NoCase} = ? {NoCase};} {}} {MaybeValuesCommand Scalar {SELECT value FROM vars WHERE name {NoCase} = ? {NoCase} ORDER BY id DESC LIMIT 1;} {}} {NopCommand Error {variable not found}}" />
    <add key="VariableMethodStorageCommand(Set)" value="IfThenElseCommand {MaybeValuesCommand Scalar {SELECT 1 FROM vars WHERE name {NoCase} = $name {NoCase};} {}} {MaybeWriteCommand NonQuery {UPDATE vars SET value = $value WHERE name {NoCase} = $name {NoCase};} {}} {MaybeWriteCommand NonQuery {INSERT INTO vars (name, value) VALUES ($name, $value);} {}}" />
    <add key="VariableMethodStorageCommand(Unset)" value="MaybeWriteCommand NonQuery {DELETE FROM vars WHERE name {NoCase} = ? {NoCase};} {}" />
    <add key="VariableMethodStorageCommand(Purge)" value="MaybeWriteCommand NonQuery {DELETE FROM vars WHERE name {NoCase} = ? {NoCase}; ANALYZE; VACUUM;} {}" />

    <add key="VariableMethodStorageFormat(Access)" value="DefaultFormat {} None None Unspecified {} {} {} {} {} 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(Exist)" value="DefaultFormat {} None None Unspecified {} {} false false false 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(Count)" value="DefaultFormat {} None None Unspecified {} {} {} {} {} 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(Names)" value="DefaultFormat {} None None Unspecified {} {} {} {} {} 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(Values)" value="DefaultFormat {} None None Unspecified {} {} {} {} {} 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(All)" value="DefaultFormat {} None None Unspecified {} {} {} {} {} 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(Get)" value="DefaultFormat {} None None Unspecified {} {} false false false 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(Set)" value="DefaultFormat {} None None Unspecified {} {} false false false 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(Unset)" value="DefaultFormat {} None None Unspecified {} {} {} {} {} 0 false false false false false false" />
    <add key="VariableMethodStorageFormat(Purge)" value="DefaultFormat {} None None Unspecified {} {} {} {} {} 0 false false false false false false" />

    <!--
    ***************************************************************************
    **                Trace Subsystem Configuration (Common)                 **
    ***************************************************************************
    -->

    <add key="TraceLogEncoding" value="UTF-8" />
    <add key="TraceLogFlags" value="+KeepOpen" />
    <add key="NoTraceLimits" value="1" />

    <!--
    ***************************************************************************
    **                 Trace Subsystem Configuration (Debug)                 **
    ***************************************************************************
    -->

    <add key="Debug.TraceLogName" value="KapokTraceDebug" />
    <add key="Debug.TraceLogFileName" value="%binDir%\..\Logs\kapok-debug.log" />
    <add key="Debug.TracePriorities" value="HasPrioritiesMask, EnableDateTimeFlag" />
    <add key="Debug.TraceCategories" value="provision,Server,StorageOps,WebGlobalState,WebPageOps,WebScriptOps,WebSettingsOps,WebStorageOps,WebTraceOps" />
    <add key="Debug.TraceFormat" value="{1} {0}{7}: {10}{11}" />

    <!--
    ***************************************************************************
    **                Trace Subsystem Configuration (Release)                **
    ***************************************************************************
    -->

    <add key="Release.TraceLogName" value="KapokTraceRelease" />
    <add key="Release.TraceLogFileName" value="%binDir%\..\Logs\kapok-release.log" />
    <add key="Release.TracePriorities" value="DefaultMask" />
    <add key="Release.TraceCategories" value="Server" />
  </appSettings>

  <!--
  *****************************************************************************
  **                          ASP.NET Configuration                          **
  *****************************************************************************
  -->

  <system.web>
    <!--
        NOTE: When using IIS Express 10.0 with Visual Studio 2017 and/or 2019,
              this block helps make it possible to send larger variable values
              to the variable storage server.  See "maxAllowedContentLength",
              below.  This applies to the ASP.NET runtime, not IIS Express.
              For the .NET Framework 2.0, this value is limited to 2097151.
    -->
    <httpRuntime maxRequestLength="2097151" />
    <!--
    <httpRuntime maxRequestLength="8388608" />
    -->

    <!--
        NOTE: We want to use the file extension "cgi" (i.e. generic server-side
              script) rather than the default "aspx"; therefore, enable runtime
              support for this.
    -->
    <httpHandlers>
      <add path="*.cgi"
           verb="*"
           type="System.Web.UI.PageHandlerFactory"
           validate="true" />
    </httpHandlers>

    <!--
        Set compilation debug="true" to insert debugging symbols into the
        compiled page. Because this affects performance, set this value to true
        only during development.
    -->
    <compilation debug="true">
      <!--
        NOTE: We want to use the file extension "cgi" (i.e. generic server-side
              script) rather than the default "aspx"; therefore, enable build
              support for this.
      -->
      <buildProviders>
        <add extension=".cgi"
             type="System.Web.Compilation.PageBuildProvider" />
      </buildProviders>
    </compilation>

    <!--
        The <authentication> section enables configuration of the security
        authentication mode used by ASP.NET to identify an incoming user.
    -->
    <authentication mode="Windows" />

    <!--
        The <customErrors> section enables configuration of what to do
        if/when an unhandled error occurs during the execution of a request.
        Specifically, it enables developers to configure html error pages to
        be displayed in place of a error stack trace.

    <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
      <error statusCode="403" redirect="NoAccess.htm" />
      <error statusCode="404" redirect="FileNotFound.htm" />
    </customErrors>
    -->
    <customErrors mode="Off" />
  </system.web>

  <!--
  *****************************************************************************
  **                        ASP.NET IIS Configuration                        **
  *****************************************************************************
  -->

  <!--
      NOTE: This section is necessary to use this project under IIS 7.5 on
            Windows 7 Ultimate 32-bit and/or 64-bit.
  -->
  <system.webServer>
    <!--
        NOTE: When using IIS Express 10.0 with Visual Studio 2017 and/or 2019,
              this line appears to be required.  Also, this is required when
              using IIS 7.5 on Windows 7 Ultimate 32-bit and/or 64-bit if the
              selected application pool is "ASP.NET v4.0".  It should not be
              used with the "classic" application pools.
    -->
    <!--
    <validation validateIntegratedModeConfiguration="false" />
    -->

    <!--
        NOTE: When using IIS Express 10.0 with Visual Studio 2017 and/or 2019,
              this block helps make it possible to send larger variable values
              to the variable storage server.  See "maxRequestLength", above.
              When using "real" IIS, this may have no effect (?).
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>

    <handlers>
      <!--
          NOTE: When using IIS Express 10.0 with Visual Studio 2017, these
                entries also appears to be required.  IIS Express 10.0 seems
                to assume the use of "integrated mode" and the .NET Framework
                4.0.
      -->
      <add name="KapokChecker"
           path="check.cgi"
           verb="GET,HEAD,POST,DEBUG"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />

      <add name="KapokProvision"
           path="provision.cgi"
           verb="GET,HEAD,POST,DEBUG"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />

      <add name="KapokRenewal"
           path="renew.cgi"
           verb="GET,HEAD,POST,DEBUG"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />

      <add name="KapokRequest"
           path="request.cgi"
           verb="GET,HEAD,POST,DEBUG"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />

      <add name="KapokRevocation"
           path="revoked.cgi"
           verb="GET,HEAD,POST,DEBUG"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />

      <add name="KapokTester"
           path="page.cgi"
           verb="GET,HEAD,POST,DEBUG"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />

      <add name="KapokVariable"
           path="storage.cgi"
           verb="GET,HEAD,POST,DEBUG"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />

      <add name="KapokWrapper"
           path="script.cgi"
           verb="GET,HEAD,POST,DEBUG"
           type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode,runtimeVersionv4.0" />

      <!--
      *************************************************************************
      -->

      <add name="KapokChecker32_v2"
           path="check.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness32" />

      <add name="KapokChecker64_v2"
           path="check.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework64\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness64" />

      <add name="KapokProvision32_v2"
           path="provision.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness32" />

      <add name="KapokProvision64_v2"
           path="provision.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework64\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness64" />

      <add name="KapokRenewal32_v2"
           path="renew.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness32" />

      <add name="KapokRenewal64_v2"
           path="renew.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework64\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness64" />

      <add name="KapokRequest32_v2"
           path="request.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness32" />

      <add name="KapokRequest64_v2"
           path="request.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework64\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness64" />

      <add name="KapokRevocation32_v2"
           path="revoked.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness32" />

      <add name="KapokRevocation64_v2"
           path="revoked.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework64\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness64" />

      <add name="KapokTester32_v2"
           path="page.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness32" />

      <add name="KapokTester64_v2"
           path="page.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework64\v2.0.50727\aspnet_isapi.dll"
           resourceType="Unspecified"
           requireAccess="Script"
           preCondition="classicMode,runtimeVersionv2.0,bitness64" />

      <add name="KapokVariable32_v2"
           path="storage.cgi"
           verb="GET,HEAD,POST,DEBUG"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework\v2.0.50727\aspnet_isapi.dll"
