apply [list [list] {
  package require Eagle.CIDR

  set countryCodes [lsort [list \
      af by mm cf cn cu cd et hk ir iq lb ly ml ni \
      kp ru so sd ss sy ve ye]]

  upvar 1 cidrs cidrs

  foreach version [list 4 6] {
    foreach countryCode $countryCodes  {
      catch {
        loadCidrFileFast $::env(CIDR_DATA_ROOT) \
            $version $countryCode null cidrs
      }
    }
  }

  return "CIDR \"deny\" lists fully loaded."
}]
