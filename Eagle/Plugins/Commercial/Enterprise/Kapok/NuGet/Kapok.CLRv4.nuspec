    <id>Kapok.CLRv4</id>
    <title>Eagle Enterprise Edition: Kapok Server (CLRv4)</title>
    <version>1.0.X.X</version>
    <authors>Eagle Development Team</authors>
    <description>
      Public key infrastructure-based software license enforcement.
      Supports automatic renewal of license &amp; script certificates.
    </description>
    <language>en-US</language>
    <projectUrl>https://urn.to/r/eagle</projectUrl>
    <iconUrl>https://eagle.to/images/eagle128.png</iconUrl>
    <licenseUrl>https://eagle.to/enterprise/license.html</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <tags>certificate eagle enforcement keypair licensing pki</tags>
    <copyright>Copyright &#x00A9; 2007-2012 by Joe Mistachkin.  All rights reserved.</copyright>
