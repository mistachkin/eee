<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
  ******************************************************************************
  **                          Load Per-User Settings                          **
  ******************************************************************************
  -->

  <!--
      NOTE: If the per-user settings file exists, import it now.  The contained
            settings, if any, will override the default ones provided below.
  -->
  <Import Condition="'$(KapokDir)' != '' And
                     !HasTrailingSlash('$(KapokDir)') And
                     Exists('$(KapokDir)\Targets\Kapok.AspNetCore.targets.user')"
          Project="$(KapokDir)\Targets\Kapok.AspNetCore.targets.user" />

  <!--
  ******************************************************************************
  **                      .NET Core Assembly References                       **
  ******************************************************************************
  -->

  <!--
      HACK: This file is only necessary because the .NET Core SDK MSBuild task
            CheckIfPackageReferenceShouldBeFrameworkReference does not appear
            to understand conditional MSBuild properties.
  -->
  <ItemGroup Condition="'$(EagleNetStandard20)' != 'false' And
                        '$(EagleNetStandard21)' == 'false' And
                        '$(EagleNetCoreReferences)' != 'false'">
    <PackageReference Include="Microsoft.AspNetCore.All" Version="2.0.9" />
  </ItemGroup>
  <ItemGroup Condition="'$(EagleNetStandard20)' != 'false' And
                        '$(EagleNetStandard21)' != 'false' And
                        '$(EagleNetCoreReferences)' != 'false'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
