<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
  ******************************************************************************
  **                          Load Per-User Settings                          **
  ******************************************************************************
  -->

  <!--
      NOTE: If the per-user settings file exists, import it now.  The contained
            settings, if any, will override the default ones provided below.
  -->
  <Import Condition="'$(KapokDir)' != '' And
                     !HasTrailingSlash('$(KapokDir)') And
                     Exists('$(KapokDir)\Targets\Kapok.Settings.targets.user')"
          Project="$(KapokDir)\Targets\Kapok.Settings.targets.user" />

  <!--
  ******************************************************************************
  **                             Kapok Properties                             **
  ******************************************************************************
  -->

  <PropertyGroup>
    <!--
        NOTE: Do we want to obfuscate the built assembly using LogicNP
              Software Crypto Obfuscator for .NET?  By default, this is
              disabled.
    -->
    <Obfuscate3 Condition="'$(Obfuscate3)' == ''">false</Obfuscate3>
  </PropertyGroup>
</Project>
