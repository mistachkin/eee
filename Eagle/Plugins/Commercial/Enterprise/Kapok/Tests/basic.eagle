          '30.00:00:00', 1, '2030-01-01 00:00:00'
      );
    }
  }

  #
  # WARNING: This data was stolen from the file "Harpy\Tools\data\test.sql".
  #          If that file is ever updated, this data will need to be updated
  #          as well.
  #
  if {[haveConstraint kapokDataFromPackage]} then {
    set sql(3) {
      INSERT OR REPLACE INTO Support (
          Id, CertificateId, Active, Expires
      ) VALUES (
          '22e1976a87ab1b44ee5e49349f0e1654b5b7170025acce8f292b8768016eedea' ||
          '70d0079db13c1c2e3d41e628b14bab1686c2b1cab1949ec9b426f20db25dd92a',
          'fb7bcbea-ec1c-4bdf-a2a3-c5b8687172e4',
          1, '2030-01-01 00:00:00'
      );
    }
  } else {
    set sql(3) {
      INSERT OR REPLACE INTO Support (
          Id, CertificateId, Active, Expires
      ) VALUES (
          '22e1976a87ab1b44ee5e49349f0e1654b5b7170025acce8f292b8768016eedea' ||
          '70d0079db13c1c2e3d41e628b14bab1686c2b1cab1949ec9b426f20db25dd92a',
          '1b40f0fe-a2fc-4c42-a644-45a851e1c75d',
          1, '2030-01-01 00:00:00'
      );
    }
  }

  set connection ""

  try {
    set connection [sql open -type SQLite [subst {Data Source=$fileName;}]]

    foreach name [lsort -integer [array names sql]] {
      sql execute $connection $sql($name)
    }
  } finally {
    if {[string length $connection] > 0} then {
      sql close $connection; unset connection
    }
  }
}

###############################################################################

proc nullIfEmptyOrDbNull { value } {
  if {[string length $value] == 0} then {
    return null
  }

  if {[object invoke Convert IsDBNull $value]} then {
    return null
  }

  return $value
}

###############################################################################

proc parseExactUtcDateTime { value } {
  set dateTime(1) [object invoke -create -alias \
      DateTime ParseExact $value "yyyy-MM-ddTHH:mm:ss.fffffffK" null]

  set dateTime(2) [$dateTime(1) -create ToUniversalTime]
  set dateTime(3) [object invoke -create DateTime SpecifyKind $dateTime(2) Utc]

  return $dateTime(3)
}

###############################################################################

proc byteListToArray { value reverse } {
  set length [llength $value]
  set result [object create -alias Byte\[\] $length]

  for {set index 0} {$index < $length} {incr index} {
    set byte [object invoke -create Byte Parse [lindex $value $index]]
    $result SetValue $byte $index
  }

  if {$reverse && [object invoke BitConverter IsLittleEndian]} then {
    object invoke Array Reverse $result
  }

  return $result
}

###############################################################################

proc dumpCertificateData { certificate channel } {
  if {[isNonNullObjectHandle $certificate]} then {
    set result [list]

    foreach fieldName [list \
        Id Protocol ProtocolVersion Vendor Origin Authority \
        Agreement Support TimeStamp Duration Key Number \
        SerialNumber HashAlgorithm Signature Type EntityType \
        EntityName EntityValue ExtraData Quantity Product \
        Version Features Restrictions] {
      set fieldValue [certificate metadata $certificate $fieldName]

      if {$fieldName eq "Signature"} then {
        set fieldValue [object invoke Convert ToBase64String \
            $fieldValue InsertLineBreaks]
      } elseif {$fieldName eq "Key"} then {
        set fieldValue [format 0x%lx [object invoke BitConverter \
            ToUInt64 [byteListToArray $fieldValue true] 0]]
      } elseif {$fieldName eq "Number"} then {
        set fieldValue [format 0x%lx $fieldValue]
      }

      if {[string length $fieldValue] > 0} then {
        lappend result [list $fieldName $fieldValue]
      } else {
        lappend result [list $fieldName <empty>]
      }
    }

    if {[llength $result] == 0} then {
      set result [list <empty>]; # IMPOSSIBLE
    }

    tputs $channel [appendArgs "---- dumpCertificateData: " $result \n]
  } else {
    tputs $channel "---- dumpCertificateData: <none>\n"
  }
}

###############################################################################

proc verifyTestCertificateData { fileName publicKey } {
  set count 0
  set connection ""

  try {
    set publicKeyToken [eval format \
        0x%02x%02x%02x%02x%02x%02x%02x%02x \
        [keypair metadata $publicKey PublicKeyToken]]

    set connection [sql open -type SQLite [subst {Data Source=$fileName;}]]

    set sql {
      SELECT Id, Protocol, ProtocolVersion, Vendor, Origin, Authority,
             Agreement, Support, TimeStamp, Duration, Key, Number,
             SerialNumber, HashAlgorithm, Signature, Type, EntityType,
             EntityName, EntityValue, ExtraData, Quantity, Product,
             Version, Features, Restrictions FROM Certificates;
    }

    set dataReader [sql execute -execute reader -format datareader -alias \
        $connection $sql]

    while {[$dataReader Read]} {
      #
      # HACK: Only verify the data for the primary test certificates.  This
      #       is necessary because the test database now contains data used
      #       for other test suites (e.g. Harpy).
      #
      if {[$dataReader GetString 10] ne $publicKeyToken} then {
        continue
      }

      if {[$dataReader GetString 14] eq "BAD_SIGNATURE"} then {
        continue
      }

      #
      # HACK: Fetch the original (mostly System.String) values from the data
      #       reader.  Then, convert empty strings and DBNull values to the
      #       special opaque object handle name "null".  This is necessary
      #       because these values are going to be used verbatim to set the
      #       property values of a Certificate object (just below).
      #
      for {set index 0} {$index < [$dataReader FieldCount]} {incr index} {
        set f1($index) [$dataReader -create GetValue $index]
        set f2($index) [nullIfEmptyOrDbNull $f1($index)]
      }

      set certificate [object create \
          -alias Licensing.Components.Public.Certificate]

      $certificate Id $f2(0)
      $certificate Protocol $f2(1)
      $certificate ProtocolVersion $f2(2)
      $certificate Vendor $f2(3)
      $certificate Origin $f2(4)
      $certificate Authority $f2(5)
      $certificate Agreement $f2(6)
      $certificate Support $f2(7)

      set f3(8) [parseExactUtcDateTime $f2(8)]

      $certificate TimeStamp $f3(8)
      $certificate Duration $f2(9)

      set f3(10) [object invoke -create \
          Licensing.Components.Public.Utility \
          ParsePublicKeyToken $f2(10)]

      $certificate Key $f3(10)

      if {$f2(11) ne "null"} then {
        $certificate Number $f2(11)
      }

      $certificate SerialNumber $f2(12)
      $certificate HashAlgorithm $f2(13)

      set f3(14) [object invoke -create Convert FromBase64String $f2(14)]

      $certificate Signature $f3(14)
      $certificate Type $f2(15)
      $certificate EntityType $f2(16)
      $certificate EntityName $f2(17)
      $certificate EntityValue $f2(18)
      $certificate ExtraData $f2(19)
      $certificate Quantity $f2(20)
      $certificate Product $f2(21)
      $certificate Version $f2(22)
      $certificate Features $f2(23)
      $certificate Restrictions $f2(24)

      #
      # HACK: This is not strictly necessary; however, this nested loop
      #       prevents the opaque object handles used by this procedure
      #       from "leaking".
      #
      foreach arrayName [list f3 f2 f1] {
        foreach name [array names $arrayName] {
          set value [set [appendArgs [set arrayName] ( $name )]]

          if {$value ne "null"} then {
            catch {object dispose $value}
          }

          unset [appendArgs [set arrayName] ( $name )]
        }
      }

      dumpCertificateData $certificate $::test_channel
      certificate verify $certificate $publicKey; # error?
      incr count; # another one was successfully verified.
    }
  } finally {
    if {[string length $connection] > 0} then {
      sql close $connection; unset connection
    }
  }

  return $count
}

###############################################################################

proc resetTestApiKeys { fileName } {
  set constraintName [appendArgs file_ [file tail $fileName]]

  if {![haveConstraint $constraintName]} then {
    tputs $::test_channel [appendArgs \
        "---- local database \"" $fileName \
        "\" not found, skipping reset...\n"]

    return
  }

  if {[haveConstraint kapokDataFromPackage]} then {
    set sql(1) {
      INSERT OR REPLACE INTO apiKeys (
          apiKey, active
      ) VALUES (
          '3cfcd953f9dc470db5e5087cd24b90d0', 1
      );
    }
  } else {
    set sql(1) {
      INSERT OR REPLACE INTO apiKeys (
          apiKey, active
      ) VALUES (
          '0908279b1d8f437e9420ce4642bbfad6', 1
      );
    }
  }

  set connection ""

  try {
    set connection [sql open \
        -type SQLite [subst {Data Source=$fileName;}]]

    foreach name [lsort -integer [array names sql]] {
      sql execute $connection $sql($name)
    }
  } finally {
    if {[string length $connection] > 0} then {
      sql close $connection; unset connection
    }
  }
}

###############################################################################

#
# NOTE: This test requires the [certificate] and [keypair] commands from
#       Harpy; however, they cannot be checked before loading the plugin
#       into the isolated interpreter and it would involve quite a bit of
#       extra code to setup and perform the necessary constraint checking
#       within the isolated interpreter.
#
runTest {test kapok-1.1 {verify test certificate data} -setup {
  saveCertificateEnvironment

  set interp [interp create -isolated -nosecurity]
  interp set $interp databaseFile(1) $databaseFile(1)
  interp set $interp publicKeyFile $publicKeyFile
  interp set $interp test_channel $test_channel

  #
  # NOTE: Copy the procedures to the created interpreter for use by the
  #       test body.
  #
  foreach procName [list \
      nullIfEmptyOrDbNull \
      parseExactUtcDateTime \
      byteListToArray \
      dumpCertificateData \
      verifyTestCertificateData] {
    interp eval $interp [list \
        proc $procName [info args $procName] \
        [info body $procName]]
  }; unset procName

  resetTestCertificateData $databaseFile(1)
} -body {
  set code [catch {interp eval $interp {
    unset -nocomplain env(UseLocalHost)
    unset -nocomplain env(ServerPort)
    unset -nocomplain env(AlwaysExpires)
    unset -nocomplain env(Override_Certificate)
    unset -nocomplain env(NoBackupCertificateFile)
    unset -nocomplain env(NoNetworkTime)
    unset -nocomplain env(RenewalRelativeUri)
    unset -nocomplain env(UseDefaultRenewCallback)
    package require Eagle.Test
    package require Licensing.Enterprise
    set publicKey [keypair open -public $publicKeyFile]
    set count [verifyTestCertificateData $databaseFile(1) $publicKey]
    if {$count != 2} then {
      unset -nocomplain publicKey count
      error "expected to verify 2 rows of certificate data"
    }
    unset -nocomplain publicKey count
  }} result]

  list $code $result
} -cleanup {
  catch {interp delete $interp}

  restoreCertificateEnvironment

  unset -nocomplain result code interp
} -constraints [fixSnkConstraints {eagle compile.APPDOMAINS\
compile.ISOLATED_INTERPRETERS $publicKeyFile file_kapok.db}] -result {0 {}}}

###############################################################################

runTest {test kapok-1.2 {license certificate renewal success} -setup {
  saveCertificateEnvironment
  saveLicenseEnvironment true

  set interp [interp create -isolated -nosecurity]
  file copy -force $certificateFile(1) $certificateFile(3)

  if {[info exists authorityBaseUri]} then {
    interp set $interp authorityBaseUri $authorityBaseUri
  }

  interp set $interp useLocalHost $useLocalHost
  interp set $interp serverPort $serverPort
  interp set $interp renewalBaseUri $renewalBaseUri
  interp set $interp renewalRelativeUri $renewalRelativeUri
  interp set $interp certificateFile(3) $certificateFile(3)

  interp set $interp useDataFromPackage \
      [haveConstraint kapokDataFromPackage]

  if {[info exists keyRingFile(1)]} then {
    interp set $interp keyRingFile(1) $keyRingFile(1)
  }

  resetTestCertificateData $databaseFile(1)
} -body {
  set code [catch {interp eval $interp {
    if {[info exists authorityBaseUri]} then {
      set env(AuthorityBaseUri) $authorityBaseUri
    } else {
      unset -nocomplain env(AuthorityBaseUri)
    }
    if {$useLocalHost && \
        [regexp -nocase -- {//localhost[:/]} $renewalBaseUri]} then {
      set env(UseLocalHost) 1
    } else {
      unset -nocomplain env(UseLocalHost)
    }
    set env(ServerPort) $serverPort
    set env(AlwaysExpires) 1
    set env(Override_Certificate) $certificateFile(3)
    set env(NoBackupCertificateFile) 1
    set env(NoNetworkTime) 1
    set env(RenewalRelativeUri) $renewalRelativeUri
    set env(UseDefaultRenewCallback) 1
    if {[info exists keyRingFile(1)]} then {
      set env(BootstrapDirectories) [file dirname $keyRingFile(1)]
    }
    if {$useDataFromPackage} then {
      package require Harpy.Test
      enableTestMode true false
      enableSkipLicense true true false
    }
    package require Licensing.Enterprise
  }} result]

  list $code $result
} -cleanup {
  catch {file delete $certificateFile(3)}
  catch {interp delete $interp}

  restoreCertificateEnvironment
  restoreLicenseEnvironment true

  unset -nocomplain result code interp
} -constraints [fixConstraints {eagle compile.APPDOMAINS\
compile.ISOLATED_INTERPRETERS kapok.server file_good.certificate.xml\
!file_test.certificate.xml file_kapok.db}] -match regexp -result \
{^0 1\.0\.\d+\.\d+$}}

