  }

  set setTestRelativeUri true
}

###############################################################################

if {![haveConstraint kapokDataFromPackage]} then {
  tputs $test_channel "---- checking for use of Kapok package data... "

  if {[info exists env(KapokDataFromPackage)]} then {
    addConstraint kapokDataFromPackage

    tputs $test_channel yes\n
  } else {
    tputs $test_channel no\n
  }
}

###############################################################################

set package_path [file dirname [file normalize $path]]
set package_key_path $key_path; # TODO: Support multiple?

if {[haveConstraint kapokDataFromPackage]} then {
  set certificateFile(1) [file join $path data good-certificate-package.xml]
  set certificateFile(2) [file join $path data bad-certificate-package.xml]
} else {
  set certificateFile(1) [file join $path data good-certificate-test.xml]
  set certificateFile(2) [file join $path data bad-certificate-test.xml]
}

set certificateFile(3) [file join [getTemporaryPath] test-certificate.xml]
set scriptFile(1) [file join $path data wrapped.eagle]

if {[info exists env(KAPOK_TEST_PATH)]} then {
  set databaseFile(1) [file join $env(KAPOK_TEST_PATH) Data kapok.db]
  set databaseFile(2) [file join $env(KAPOK_TEST_PATH) Data var.db]
} else {
  if {[haveConstraint kapokDataFromPackage]} then {
    set databaseFile(1) [file join $package_path Data package kapok.db]
    set databaseFile(2) [file join $package_path Data package var.db]
  } else {
    set databaseFile(1) [file join $package_path Data test kapok.db]
    set databaseFile(2) [file join $package_path Data test var.db]
  }
}

set privateKeyFile [file join $path data private.snk]
set templateFile [file join $path data template.xml]

if {[haveConstraint kapokDataFromPackage]} then {
  set keyRingFile(1) [file join \
      $package_path Keys package keyRing.License.enterprise.eagle]

  set keyRingFile(2) [file join \
      $package_path Keys package keyRing.enterprise.eagle]
} else {
  unset -nocomplain keyRingFile
}

###############################################################################

if {[haveConstraint kapokDataFromPackage]} then {
  set databaseFile(3) [file join $package_path Keys package kapok.db]
} elseif {[info exists custom_package_key_path]} then {
  set databaseFile(3) [file join $custom_package_key_path keyRing.db]
} else {
  set databaseFile(3) [file join $package_key_path keyRing.db]
}

###############################################################################

if {[info exists env(EagleEnterprisePublicKey)]} then {
  if {[haveConstraint kapokDataFromPackage]} then {
    set publicKeyFile [file join \
        $package_path Keys test KapokTestPublic.snk]
  } else {
    set publicKeyFile [file normalize $env(EagleEnterprisePublicKey)]
  }
} elseif {[info exists custom_package_key_path]} then {
  set publicKeyFile [file join \
      $custom_package_key_path EagleEnterprisePluginRootPublic.snk]
} else {
  set publicKeyFile [file join \
      $package_key_path EagleEnterprisePluginRootPublic.snk]
}

###############################################################################

set openAiPromptFile [file join $path data openAI-prompt-raw.txt]

set fakeOpenAiResponseFile [file join \
    $path data fake-openAI-response-signed.json]

###############################################################################

#
# NOTE: Check test constraints specific to tests in this file.
#
if {![haveConstraint file_good.certificate.xml]} then {
  checkForFile $test_channel $certificateFile(1) good.certificate.xml
}

if {![haveConstraint file_bad.certificate.xml]} then {
  checkForFile $test_channel $certificateFile(2) bad.certificate.xml
}

if {![haveConstraint file_test.certificate.xml]} then {
  checkForFile $test_channel $certificateFile(3) test.certificate.xml
}

if {![haveConstraint [appendArgs file_ [file tail $databaseFile(1)]]]} then {
  checkForFile $test_channel $databaseFile(1)
}

if {![haveConstraint [appendArgs file_ [file tail $databaseFile(2)]]]} then {
  checkForFile $test_channel $databaseFile(2)
}

if {![haveConstraint [appendArgs file_ [file tail $databaseFile(3)]]]} then {
  checkForFile $test_channel $databaseFile(3)
}

if {![haveConstraint [appendArgs file_ [file tail $scriptFile(1)]]]} then {
  checkForFile $test_channel $scriptFile(1)
}

if {![haveConstraint [appendArgs file_ [file tail $publicKeyFile]]]} then {
  checkForFile $test_channel $publicKeyFile
}

if {![haveConstraint [appendArgs file_ [file tail $privateKeyFile]]]} then {
  checkForFile $test_channel $privateKeyFile
}

if {![haveConstraint [appendArgs file_ [file tail $templateFile]]]} then {
  checkForFile $test_channel $templateFile
}

if {![haveConstraint file_openAI.prompt.raw.txt]} then {
  checkForFile $test_channel $openAiPromptFile openAI.prompt.raw.txt
}

if {![haveConstraint file_fake.openAI.response.json]} then {
  checkForFile $test_channel $fakeOpenAiResponseFile fake.openAI.response.json
}

###############################################################################

#
# NOTE: Check to see if the remote certificate server is available and is
#       apparently responding to requests.
#
if {![info exists no(checkForRemoteCertificateServer)]} then {
  if {[info exists testKapokEnv(RootBaseUri)]} then {
    checkForRemoteCertificateServer $test_channel false \
        [shouldUseLocalRelativeUris] $testKapokEnv(RootBaseUri)
  } elseif {[info exists env(RootBaseUri)]} then {
    checkForRemoteCertificateServer $test_channel false \
        [shouldUseLocalRelativeUris] $env(RootBaseUri)
  } else {
    checkForRemoteCertificateServer $test_channel false \
        [shouldUseLocalRelativeUris]
  }
}

###############################################################################

proc fixSnkConstraints { constraints } {
  global publicKeyFile

  return [fixConstraints [string map [list \
      \$publicKeyFile [appendArgs file_ [file tail $publicKeyFile]]] \
      $constraints]]
}

