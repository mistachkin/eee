###############################################################################

package require Eagle.Library
package require Eagle.Test

runTestPrologue

###############################################################################

package require Harpy.Test

tryToLoadKapok

###############################################################################

if {![info exists no(serverEnvironmentVariables)]} then {
  saveServerEnvironmentVariables savedKapokEnv true

  if {[info exists testKapokEnv(RootBaseUri)]} then {
    resetServerEnvironmentVariables testKapokEnv false \
        [shouldUseLocalRelativeUris] false false \
        $testKapokEnv(RootBaseUri)
  } elseif {[info exists env(RootBaseUri)]} then {
    resetServerEnvironmentVariables testKapokEnv false \
        [shouldUseLocalRelativeUris] false false \
        $env(RootBaseUri)
  } else {
    resetServerEnvironmentVariables testKapokEnv false \
        [shouldUseLocalRelativeUris]
  }
}

###############################################################################

if {![info exists useLocalHost]} then {
  set useLocalHost [haveConstraint configuration.Debug]
  set setUseLocalHost true
}

###############################################################################

if {![info exists authorityBaseUri]} then {
  if {[info exists testKapokEnv(AuthorityBaseUri)]} then {
    set authorityBaseUri $testKapokEnv(AuthorityBaseUri)
    set setAuthorityBaseUri true
  } elseif {[info exists env(AuthorityBaseUri)]} then {
    set authorityBaseUri $env(AuthorityBaseUri)
    set setAuthorityBaseUri true
  }
}

###############################################################################

if {![info exists serverPort]} then {
  if {[info exists testKapokEnv(ServerPort)]} then {
    set serverPort $testKapokEnv(ServerPort)
  } elseif {[info exists env(ServerPort)]} then {
    set serverPort $env(ServerPort)
  } elseif {[info exists testKapokEnv(UseLocalHost)] && \
      [info exists testKapokEnv(LocalServerPort)]} then {
    set serverPort $testKapokEnv(LocalServerPort)
  } elseif {[info exists env(UseLocalHost)] && \
      [info exists env(LocalServerPort)]} then {
    set serverPort $env(LocalServerPort)
  } else {
    set baseUri [info engine Uri]; # TODO: Good default?

    if {[regexp -nocase -- {^https://} $baseUri]} then {
      set serverPort 443
    } else {
      set serverPort 80
    }

    unset baseUri
  }

  set setServerPort true
}

###############################################################################

if {![info exists pingBaseUri]} then {
  if {[info exists testKapokEnv(PingBaseUri)]} then {
    set pingBaseUri $testKapokEnv(PingBaseUri)
  } elseif {[info exists env(PingBaseUri)]} then {
    set pingBaseUri $env(PingBaseUri)
  } elseif {[info exists testKapokEnv(UseLocalHost)] && \
      [info exists testKapokEnv(LocalServerPort)]} then {
    set pingBaseUri [appendArgs \
        http://localhost : $testKapokEnv(LocalServerPort) /]
  } elseif {[info exists env(UseLocalHost)] && \
      [info exists env(LocalServerPort)]} then {
    set pingBaseUri [appendArgs \
        http://localhost : $env(LocalServerPort) /]
  } else {
